package organisms

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// storedTakeName is where a stored Take sits and which model made it: how its row names it.
func storedTakeName(t domain.StoredTake) string {
	return "Scene " + intText(t.SceneIndex+1) + " · Shot " + intText(t.ShotIndex+1) + " · " + t.ModelName
}

// StoragePanelData is the disk usage of a Project.
type StoragePanelData struct {
	ProjectID string
	Storage   domain.StorageSummary
}

func hasUnneeded(s domain.StorageSummary) bool {
	n, _ := s.UnneededTakes()
	return n > 0
}

func unneededText(s domain.StorageSummary) string {
	n, size := s.UnneededTakes()
	return intText(n) + " 件 / " + domain.FormatBytes(size)
}

// StoragePanel shows the disk usage of the Project and the preview cache, and lets the user archive Takes that are not
// needed (Rejected, or not chosen where another Take of the Shot is Selected: spec/requirements/non-functional.md §4).
templ StoragePanel(d StoragePanelData) {
	<section id="storage-panel" class="flex flex-col gap-3">
		<dl class="grid grid-cols-1 gap-3 sm:grid-cols-3">
			<div class="rounded-lg border border-border p-3">
				<dt class="text-xs text-mute">Project のファイル</dt>
				<dd class="font-mono text-lg tabular-nums" data-testid="asset-bytes">{ domain.FormatBytes(d.Storage.AssetBytes) }</dd>
				<dd class="text-xs text-mute" data-testid="preview-bytes">{ "プレビューのキャッシュ（全 Project 共通）: " + domain.FormatBytes(d.Storage.PreviewBytes) }</dd>
			</div>
			<div class="rounded-lg border border-border p-3">
				<dt class="text-xs text-mute">ディスクの空き容量</dt>
				<dd class="font-mono text-lg tabular-nums" data-testid="free-bytes">
					if d.Storage.FreeKnown {
						{ domain.FormatBytes(d.Storage.FreeBytes) }
					} else {
						不明
					}
				</dd>
			</div>
			<div class="rounded-lg border border-border p-3">
				<dt class="text-xs text-mute">不要な Take</dt>
				<dd class="font-mono text-lg tabular-nums" data-testid="unneeded">{ unneededText(d.Storage) }</dd>
			</div>
		</dl>
		if hasUnneeded(d.Storage) {
			<form hx-post={ paths.Project(d.ProjectID, "storage", "archive-unneeded") } hx-target="#storage-panel" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" hx-confirm="不要な Take の動画ファイルを削除します。よろしいですか？">
				@atoms.Button(atoms.ToneDanger, "不要な Take をまとめてアーカイブ", templ.Attributes{
					"type": "submit",
				})
			</form>
		}
		if len(d.Storage.Takes) == 0 {
			<p class="text-sm text-mute">保存されている Take はありません。</p>
		} else {
			<ul class="flex flex-col divide-y divide-border text-sm">
				for _, t := range d.Storage.Takes {
					<li class="flex flex-wrap items-center justify-between gap-2 py-2">
						<span>
							{ storedTakeName(t) }
							<span class="text-mute">{ " · " + t.Status.Label() + " · " + domain.FormatBytes(t.SizeBytes) }</span>
							if t.Unneeded {
								@atoms.Badge(atoms.BadgeWarn, "不要")
							}
						</span>
						if t.Archivable {
							@atoms.SmallButtonFor(atoms.ToneNeutral, "アーカイブ", storedTakeName(t), templ.Attributes{
								"type":       "button",
								"hx-post":    paths.Project(d.ProjectID, "takes", t.TakeID, "archive"),
								"hx-target":  "#storage-panel",
								"hx-swap":    "outerHTML",
								"hx-confirm": "この Take の動画ファイルを削除します。よろしいですか？",
							})
						} else {
							<span class="text-xs text-mute" data-testid="take-in-use">選択中、または編集・音声のタイムラインで使用中のためアーカイブできません</span>
						}
					</li>
				}
			</ul>
		}
	</section>
}
