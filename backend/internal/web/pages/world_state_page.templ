package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/worldstate"
)

// WorldStatePage is GET /projects/:id/world-state: the current World State in an auxiliary view.
templ WorldStatePage(csrfToken string, d worldstate.Data) {
	@layout.AppLayout("World State: "+d.Project.Name, csrfToken, sidenav.InProject(sidenav.WorldState, d.Project)) {
		@pagehead.Main(pagehead.Wide) {
			@pagehead.Header("World State", d.Project.Name, "")
			@organisms.SeriesMembership(d.Project)
			@worldstate.View(d)
		}
	}
}
