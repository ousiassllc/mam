package modelmgr

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/commercial"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modelcard"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modelpick"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/refresh"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/modelmgr/installbtn"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// CatalogList is the list of models with the refresh button (#962); while an install is running it polls itself.
templ CatalogList(c Catalog) {
	<div
		id={ CatalogID }
		class="flex flex-col gap-3"
		data-testid="mm-catalog"
		if c.OOB {
			hx-swap-oob="true"
		}
		if c.Polling() {
			hx-get={ catalogURL(c) }
			hx-trigger={ Polling }
			hx-swap="outerHTML"
		}
	>
		@refresh.Bar(catalogURL(c), CatalogID, c.UpdatedAt)
		@notice(c.Message, "mm-catalog")
		if c.Blocked != "" {
			<p class="text-sm text-amber-300" data-testid="mm-catalog-blocked">{ c.Blocked }</p>
		}
		@modelpick.Summary(c.Filter)
		<ul id={ ModelsID } role="list" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-testid="mm-models">
			for _, m := range c.Models {
				@modelCard(m, c.Blocked != "")
			}
		</ul>
	</div>
}

// CatalogWithBar is the answer to the filter bar: the list and, out of band, the number on the funnel (and the panel, for a chip).
templ CatalogWithBar(c Catalog) {
	@CatalogList(c)
	@modelpick.Oob(c.Filter)
}

// StateTone is the badge of the install state of a model (also the one of its detail modal).
func StateTone(state string) (atoms.BadgeTone, string) {
	switch state {
	case "installed":
		return atoms.BadgeOK, "導入済み"
	case "installing":
		return atoms.BadgeInfo, "導入中"
	case "incomplete":
		return atoms.BadgeWarn, "ファイルが不足"
	}
	return atoms.BadgeNeutral, "未導入"
}

// ShowsTokenGuide says whether the detail carries the guidance for the missing token (the card has the badge 「HF トークンが必要」).
func ShowsTokenGuide(m Model) bool {
	return m.TokenGuide != "" && m.State != "installed" && m.State != "installing"
}

// ModelIcon is the picture of the card of a model: the tile of its kind (no image is fetched from the net).
func ModelIcon(m Model) atoms.IconName {
	if m.Kind == "video" {
		return atoms.IconVideo
	}
	return atoms.IconImage
}

// ModelDetailURL is what the card of a model opens: the modal with its sources, license, files and SHA-256.
func ModelDetailURL(id string) string { return paths.ModelManagerPart("models", id, "detail") }

// ModelCardID is the id of the card of a model (the element a swap of the list draws again with the same id).
func ModelCardID(id string) string { return "mm-model-" + id }

// modelBadges are the labels beside the state that must not be missed: an adult model, the login a model needs, a disk that is too full to
// install it, a GPU below what the model needs, and an OS / GPU generation it is not made for.
func modelBadges(m Model) []modelcard.Badge {
	out := modelcard.Facts{Adult: m.Adult, ParamsLabel: m.ParamsLabel, VRAMMinGB: m.VRAMMinGB}.Badges() // the badges every model card shares (成人向け, parameters, VRAM)
	if m.NeedsToken {
		out = append(out, modelcard.Badge{Tone: atoms.BadgeWarn, Label: "HF トークンが必要", Attrs: templ.Attributes{"data-testid": "mm-token-badge"}})
	}
	if m.NeedsNodes != "" && m.State != "installed" {
		out = append(out, modelcard.Badge{Tone: atoms.BadgeWarn, Label: "追加ノードが必要", Attrs: templ.Attributes{"data-testid": "mm-nodes-badge"}})
	}
	if m.LowDisk && m.State != "installed" && m.State != "installing" {
		out = append(out, modelcard.Badge{Tone: atoms.BadgeError, Label: "空きが足りません", Attrs: templ.Attributes{"data-testid": "mm-low-disk"}})
	}
	if m.PlatformWarning != "" {
		out = append(out, modelcard.Badge{Tone: atoms.BadgeWarn, Label: "この PC は対象外の見込み", Attrs: templ.Attributes{"data-testid": "mm-platform-warning"}})
	}
	switch m.VRAMFit {
	case "short":
		out = append(out, modelcard.Badge{Tone: atoms.BadgeError, Label: "VRAM が足りない見込み", Attrs: templ.Attributes{"data-testid": "mm-vram-fit", "data-fit": m.VRAMFit}})
	case "limited":
		out = append(out, modelcard.Badge{Tone: atoms.BadgeWarn, Label: "VRAM に余裕なし", Attrs: templ.Attributes{"data-testid": "mm-vram-fit", "data-fit": m.VRAMFit}})
	}
	return out
}

func modelCardData(m Model) modelcard.Card {
	tone, label := StateTone(m.State)
	return modelcard.Card{
		ID: ModelCardID(m.ID), Name: m.Name, Icon: ModelIcon(m), Meta: m.KindLabel + "・" + m.Size, DetailURL: ModelDetailURL(m.ID),
		State:      modelcard.Badge{Tone: tone, Label: label, Attrs: templ.Attributes{"data-testid": "mm-model-state"}},
		Badges:     modelBadges(m),
		Commercial: &m.License.Answer,
		Attrs:      templ.Attributes{"data-testid": "mm-model", "data-model": m.ID, "data-state": m.State, "data-commercial": m.License.Answer.Answer()},
	}
}

// modelCard is one model as a card (modelcard.Item: the same card as the runtimes and the files added from Hugging Face): its picture, name,
// kind and size, state and commercial-use icon, and the buttons. While an install runs the progress bar is on the card; the
// source, license, files and SHA-256 are in the modal that the card opens (modeldetail.Detail).
templ modelCard(m Model, blocked bool) {
	@modelcard.Item(modelCardData(m)) {
		if m.State == "installing" && m.Install != nil {
			@progressBar(*m.Install, m.Name+" の導入の進み具合")
		}
		if m.NeedsNodes != "" && m.State != "installed" {
			<p class="text-xs text-amber-300" data-testid="mm-nodes-note">{ m.NeedsNodes }</p>
		}
		@modelcard.Actions() {
			@modelActions(m, blocked)
		}
	}
}

templ modelActions(m Model, blocked bool) {
	switch m.State {
		case "installing":
			if m.Install != nil {
				@atoms.SmallButtonFor(atoms.ToneNeutral, "中断", m.Name, templ.Attributes{
					"type": "button", "hx-post": paths.ModelManagerPart("jobs", m.Install.JobID, "cancel"), "hx-target": "#" + CatalogID,
					"hx-swap": "outerHTML", "hx-sync": "this:drop", "hx-disabled-elt": "this",
					"hx-confirm": "「" + m.Name + "」の導入を中断します。ダウンロード済みの分は残り、導入し直すと続きから再開します。よろしいですか？",
				})
			}
		case "installed":
			@atoms.SmallButtonFor(atoms.ToneDanger, "削除", m.Name, templ.Attributes{
				"type": "button", "hx-delete": paths.ModelManagerPart("models", m.ID), "hx-target": "#" + CatalogID, "hx-swap": "outerHTML",
				"hx-sync": "this:drop", "hx-disabled-elt": "this",
				"hx-confirm": "「" + m.Name + "」を削除します。他の導入済みモデルと共有しているファイルは、そのモデルが残る間は消えません。よろしいですか？",
			})
		default:
			@installButton(m, blocked)
	}
}

templ installButton(m Model, blocked bool) {
	{{ label := installLabel(m) }}
	switch  {
		case blocked || m.LowDisk || m.NeedsNodes != "":
			@atoms.SmallButtonFor(atoms.ToneNeutral, label, m.Name, templ.Attributes{"type": "button", "disabled": true})
		case m.Consent && !m.Accepted:
			@atoms.SmallButtonFor(atoms.TonePrimary, "ライセンスを確認して導入", m.Name, templ.Attributes{
				"type": "button", "hx-get": paths.ModelManagerPart("models", m.ID, "consent"), "hx-target": "#" + DialogID, "hx-swap": "innerHTML",
				"data-testid": "mm-consent-open",
			})
		default:
			@atoms.SmallButtonFor(atoms.TonePrimary, label, m.Name, installbtn.Attrs(paths.ModelManagerPart("models", m.ID, "install"), "#"+CatalogID, m.Name, m.PlatformWarning))
	}
}

func installLabel(m Model) string {
	if m.State == "incomplete" {
		return "不足分を取得して復旧"
	}
	return "導入"
}

// ConsentDialog is the license of a model with the form that accepts it and starts the install. The server enforces
// the acceptance: the form is only how a user gives it.
templ ConsentDialog(c Consent) {
	<section
		class="flex flex-col gap-3 rounded-md border border-amber-500/60 bg-neutral-900 p-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
		role="dialog"
		aria-labelledby="mm-consent-title"
		tabindex="-1"
		data-inline-dialog
		data-return-focus={ modelCardSelector(c.ModelID) }
		data-testid="mm-consent"
	>
		<h3 id="mm-consent-title" class="text-sm font-semibold">「{ c.Name }」のライセンスを確認してください</h3>
		if c.Error != "" {
			<p class="text-sm text-red-300 focus-visible:outline-none" role="alert" tabindex="-1" data-testid="mm-consent-error">{ c.Error }</p>
		}
		<p class="text-sm"><a class="underline" href={ templ.SafeURL(c.License.URL) } target="_blank" rel="noopener noreferrer">{ c.License.Name }（{ c.License.Version }）の全文</a></p>
		<p class="text-sm text-neutral-200" data-testid="mm-consent-summary">{ c.License.Summary }</p>
		if c.AdultNotice != "" {
			<p class="text-sm text-amber-300" data-testid="mm-consent-adult">{ c.AdultNotice }</p>
		}
		if c.PlatformWarning != "" {
			<p class="text-sm text-amber-300" data-testid="mm-consent-platform-warning">{ c.PlatformWarning }</p>
		}
		if len(c.Sources) > 0 {
			<p class="text-xs text-neutral-300" data-testid="mm-consent-sources">原本の場所: { joinNames(c.Sources) }</p>
		}
		<p class="flex flex-wrap items-center gap-2 text-sm" data-testid="mm-consent-commercial">
			商用利用: { c.License.Commercial } @commercial.Badge(c.License.Answer)
		</p>
		if c.License.Regions != "" {
			<p class="text-sm text-amber-300" data-testid="mm-consent-regions">{ c.License.Regions }</p>
		}
		if c.License.Notice != "" {
			<p class="text-xs text-neutral-400">{ c.License.Notice }</p>
		}
		<p class="text-xs text-neutral-400">モデルの重みは mam が再配布するものではありません。導入すると、取得元から直接ダウンロードします。</p>
		<form
			class="flex flex-col gap-3"
			hx-post={ paths.ModelManagerPart("models", c.ModelID, "install") }
			hx-target={ "#" + CatalogID }
			hx-swap="outerHTML"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type=submit]"
			data-testid="mm-consent-form"
		>
			<input type="hidden" name={ FieldLicenseID } value={ c.License.ID }/>
			<input type="hidden" name={ FieldLicenseV } value={ c.License.Version }/>
			<label class="flex items-start gap-2 text-sm">
				@atoms.Choice("mt-1", templ.Attributes{"type": "checkbox", "name": FieldAgree, "value": "1", "required": true, "data-testid": "mm-agree"})
				<span>上のライセンスの内容を確認し、同意します</span>
			</label>
			<div class="flex gap-2">
				@atoms.Button(atoms.TonePrimary, "同意して導入", templ.Attributes{"type": "submit"})
				@atoms.Button(atoms.ToneNeutral, "閉じる", templ.Attributes{
					"type": "button", "hx-get": paths.ModelManagerPart("dialog"), "hx-target": "#" + DialogID, "hx-swap": "innerHTML",
					"data-inline-dialog-close": true,
				})
			</div>
		</form>
	</section>
}

// DialogClear empties the dialog area out of band: an install was accepted, the license question is answered.
templ DialogClear() {
	<div id={ DialogID } hx-swap-oob="innerHTML" data-testid="mm-dialog"></div>
}

// EngineWithCatalog is the engine card with the model list out of band: an action of the engine changed what can be
// installed.
templ EngineWithCatalog(e Engine, c Catalog) {
	@EngineCard(e)
	@CatalogList(c)
}

// CatalogWithTrial is the model list with the trial section out of band: installing or deleting a model changed the
// models a trial can use.
templ CatalogWithTrial(c Catalog, t TrialPanel) {
	@CatalogList(c)
	@TrialSection(t)
}

// CatalogWithDialogClear is the model list with the (answered) license dialog emptied out of band.
templ CatalogWithDialogClear(c Catalog) {
	@CatalogList(c)
	@DialogClear()
}
