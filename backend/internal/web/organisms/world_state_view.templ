package organisms

import (
	"net/url"
	"strconv"
	"strings"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
)

// WorldStateData is the state of the World State view (world_state_page).
type WorldStateData struct {
	Project domain.Project
	// Branch is the Branch the view shows; nil for the trunk.
	Branch *domain.Branch
	World  domain.WorldContext
	Locks  domain.LockSet
	// ProjectLocks is the AUTO / MANUAL / LOCK setting of Story and Music.
	ProjectLocks domain.ParameterLocks
	// Library is the Reference Library of the Project (images a reference slot can hold).
	Library []domain.ReferenceItem
	// Versions are the saved World State versions of the trunk, newest first (F-28).
	Versions []domain.VersionEntry
}

var fieldLabels = map[string]string{
	"hairstyle": "髪型 (hairstyle)", "wardrobe": "衣装 (wardrobe)", "voice": "声 (voice)", "personality": "性格 (personality)",
	"emotion": "感情 (emotion)", "position": "位置 (position)", "current_action": "動作 (current_action)",
	"material": "素材 (material)", "orientation": "向き (orientation)", "condition": "状態 (condition)",
	"time": "時間帯 (time)", "lighting_state": "照明 (lighting_state)", "weather": "天気 (weather)",
	"lens": "レンズ (lens)", "angle": "アングル (angle)", "movement": "動き (movement)",
	"character_goal": "目的 (character_goal)", "known_information": "既知の情報 (known_information)", "previous_event": "直前の出来事 (previous_event)",
}

func fieldLabel(name string) string {
	if l, ok := fieldLabels[name]; ok {
		return l
	}
	return name
}

// branchQuery is the query that addresses the Branch of the view ("" for the trunk).
func (d WorldStateData) branchQuery() string {
	if d.Branch == nil {
		return ""
	}
	return "?branch_id=" + url.QueryEscape(d.Branch.ID)
}

func (d WorldStateData) entityURL(plural, id string) string {
	return "/projects/" + d.Project.ID + "/" + plural + "/" + id
}

func (d WorldStateData) field(target domain.WorldTarget, id, name, value string) molecules.WorldStateFieldData {
	return molecules.WorldStateFieldData{
		ID: "ws-" + string(target) + "-" + id + "-" + name, Name: name, Label: fieldLabel(name), Value: value,
		Locked: d.Locks.Locked(target, id, name),
	}
}

func characterFields(d WorldStateData, c domain.WorldCharacter) []molecules.WorldStateFieldData {
	values := map[string]string{
		"hairstyle": c.Hairstyle, "wardrobe": c.Wardrobe, "voice": c.Voice, "personality": c.Personality,
		"emotion": c.Emotion, "position": c.Position, "current_action": c.CurrentAction,
	}
	return entityFields(d, domain.TargetCharacter, c.ID, values)
}

func productFields(d WorldStateData, p domain.WorldProduct) []molecules.WorldStateFieldData {
	return entityFields(d, domain.TargetProduct, p.ID, map[string]string{"material": p.Material, "orientation": p.Orientation, "condition": p.Condition})
}

func locationFields(d WorldStateData, l domain.WorldLocation) []molecules.WorldStateFieldData {
	return entityFields(d, domain.TargetLocation, l.ID, map[string]string{"time": l.Time, "lighting_state": l.LightingState, "weather": l.Weather})
}

func entityFields(d WorldStateData, target domain.WorldTarget, id string, values map[string]string) []molecules.WorldStateFieldData {
	names := domain.EditableFields(target)
	out := make([]molecules.WorldStateFieldData, len(names))
	for i, name := range names {
		out[i] = d.field(target, id, name, values[name])
	}
	return out
}

// fieldLockToggle is the AUTO / LOCK switch of one attribute (PUT /projects/:id/world-state/locks).
// The response is the whole view, so the switch replaces #world-state-view.
func (d WorldStateData) fieldLockToggle(target domain.WorldTarget, id, field string) atoms.LockToggleData {
	mode := domain.LockAuto
	if d.Locks.Locked(target, id, field) {
		mode = domain.LockLocked
	}
	hidden := []atoms.HiddenField{{Name: "target_type", Value: string(target)}}
	if id != "" {
		hidden = append(hidden, atoms.HiddenField{Name: "target_id", Value: id})
	}
	return atoms.LockToggleData{
		DOMID: "lock-" + string(target) + "-" + id + "-" + field, URL: "/projects/" + d.Project.ID + "/world-state/locks" + d.branchQuery(),
		Parameter: domain.LockParameter(field), Label: lockLabel(field), Mode: mode,
		Modes: []domain.LockMode{domain.LockAuto, domain.LockLocked}, Hidden: hidden,
		Target: "#world-state-view",
	}
}

var lockOnlyLabels = map[string]string{
	domain.LockParamIdentity: "顔・見た目 (identity)", domain.LockParamGeometry: "形状 (geometry)",
	domain.LockParamLabel: "ロゴ・ラベル (label)", domain.LockFieldLayoutReference: "レイアウト参照 (layout_reference)",
	domain.StoryFieldScene: "Scene (scene)",
}

func lockLabel(field string) string {
	if l, ok := lockOnlyLabels[field]; ok {
		return l
	}
	return fieldLabel(field)
}

// slotLabels names the reference slots.
var slotLabels = map[string]string{"face": "顔 (face)", "body": "全身 (body)", "geometry": "形状 (geometry)", "label": "ラベル (label)", "layout": "レイアウト (layout)"}

// slotForm is one reference slot of an entity: the current image and the Library images of the fitting kind.
type slotForm struct {
	Slot    domain.ReferenceSlot
	Current string // the asset ID now in the slot
	Items   []domain.ReferenceItem
}

func (d WorldStateData) slots(target domain.WorldTarget, current map[string]string) []slotForm {
	var out []slotForm
	for _, s := range domain.ReferenceSlots() {
		if s.Target != target {
			continue
		}
		f := slotForm{Slot: s, Current: current[s.Name]}
		for _, it := range d.Library {
			if it.Kind == s.Kind {
				f.Items = append(f.Items, it)
			}
		}
		out = append(out, f)
	}
	return out
}

func (d WorldStateData) empty() bool {
	return len(d.World.Characters)+len(d.World.Products)+len(d.World.Locations) == 0 && d.World.Version == 0
}

func versionText(v int) string {
	if v == 0 {
		return "まだ Shot が完了していません"
	}
	return "World State バージョン " + strconv.Itoa(v)
}

func storyScene(s domain.WorldStory) string {
	if s.Scene == 0 {
		return ""
	}
	return strconv.Itoa(s.Scene)
}

func joinKnown(items []string) string { return strings.Join(items, " / ") }

templ entityForm(d WorldStateData, target domain.WorldTarget, plural, id, name string, fields []molecules.WorldStateFieldData, slots map[string]string) {
	<div class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3">
		<form
			class="flex flex-col gap-2"
			hx-put={ d.entityURL(plural, id) + d.branchQuery() }
			hx-target="#world-state-view"
			hx-swap="outerHTML"
		>
			<p class="text-sm font-medium">{ name }</p>
			<div class="grid gap-2 sm:grid-cols-2">
				for _, f := range fields {
					@molecules.WorldStateField(f)
				}
			</div>
			<div>
				@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
			</div>
		</form>
		for _, sf := range d.slots(target, slots) {
			@referenceSlotForm(d, plural, id, sf)
		}
		<details class="text-sm">
			<summary class="cursor-pointer text-xs text-neutral-400">LOCK 設定（AUTO: AI が更新 / LOCK: 更新しない）</summary>
			<div class="mt-2 flex flex-col gap-1">
				for _, f := range domain.LockableFields(target) {
					@atoms.LockToggle(d.fieldLockToggle(target, id, f))
				}
			</div>
		</details>
	</div>
}

// referenceSlotForm assigns a Library image to a reference slot of an entity
// (PUT /projects/:id/{plural}/:id/reference).
templ referenceSlotForm(d WorldStateData, plural, id string, sf slotForm) {
	<form
		class="flex flex-wrap items-center gap-2 text-sm"
		hx-put={ d.entityURL(plural, id) + "/reference" + d.branchQuery() }
		hx-target="#world-state-view"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="slot" value={ sf.Slot.Name }/>
		<label class="w-40 shrink-0 text-xs text-neutral-400" for={ "slot-" + id + "-" + sf.Slot.Name }>{ slotLabels[sf.Slot.Name] } の参照画像</label>
		@atoms.Select(atoms.FieldSm, "", templ.Attributes{
			"id":   "slot-" + id + "-" + sf.Slot.Name,
			"name": "reference_id",
		}) {
			<option value="">（なし）</option>
			for _, it := range sf.Items {
				<option value={ it.ID } selected?={ it.AssetID == sf.Current }>{ it.Name }</option>
			}
		}
		if sf.Current != "" {
			<a class="text-xs text-indigo-300 underline" href={ templ.SafeURL("/projects/" + d.Project.ID + "/assets/" + sf.Current) } target="_blank" rel="noopener">現在の画像</a>
		}
		@atoms.Button(atoms.ToneNeutral, "割り当て", templ.Attributes{"type": "submit"})
	</form>
}

// WorldStateView shows the World State: Characters, Products, Locations (editable unless LOCKed)
// and the Camera and Story left by the latest Shot.
templ WorldStateView(d WorldStateData) {
	<div id="world-state-view" class="flex flex-col gap-6">
		if d.Branch != nil {
			<p class="text-sm text-indigo-300">
				Branch「{ d.Branch.Name }」の World State です。ここでの変更はトランクや他の Branch には影響しません。
				<a class="underline" href={ templ.SafeURL("/branches/" + d.Branch.ID) }>Branch の詳細へ</a>
			</p>
		}
		<p class="text-xs text-neutral-400">{ versionText(d.World.Version) }。LOCK した項目は Shot 完了時にも自動更新されません。</p>
		<section aria-label="Story / Music" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Story / Music</h2>
			for _, p := range domain.ProjectLockParameters() {
				@atoms.LockToggle(ProjectLockToggle(d.Project.ID, p, d.ProjectLocks))
			}
		</section>
		if d.empty() {
			<p class="text-sm text-neutral-400">登場人物・商品・場所はまだ登録されていません。</p>
		}
		<section aria-label="Characters" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Characters</h2>
			for _, c := range d.World.Characters {
				@entityForm(d, domain.TargetCharacter, "characters", c.ID, c.Name, characterFields(d, c), map[string]string{"face": c.FaceReferenceAssetID, "body": c.BodyReferenceAssetID})
			}
		</section>
		<section aria-label="Products" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Products</h2>
			for _, p := range d.World.Products {
				@entityForm(d, domain.TargetProduct, "products", p.ID, p.Name, productFields(d, p), map[string]string{"geometry": p.GeometryReferenceAssetID, "label": p.LabelReferenceAssetID})
			}
		</section>
		<section aria-label="Locations" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Locations</h2>
			for _, l := range d.World.Locations {
				@entityForm(d, domain.TargetLocation, "locations", l.ID, l.Name, locationFields(d, l), map[string]string{"layout": l.LayoutReferenceAssetID})
			}
		</section>
		<section aria-label="Camera" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Camera</h2>
			<dl class="flex flex-col gap-1">
				@molecules.WorldStateReadonly(fieldLabel("lens"), d.World.Camera.Lens, d.Locks.Locked(domain.TargetCamera, "", "lens"))
				@molecules.WorldStateReadonly(fieldLabel("position"), d.World.Camera.Position, d.Locks.Locked(domain.TargetCamera, "", "position"))
				@molecules.WorldStateReadonly(fieldLabel("angle"), d.World.Camera.Angle, d.Locks.Locked(domain.TargetCamera, "", "angle"))
				@molecules.WorldStateReadonly(fieldLabel("movement"), d.World.Camera.Movement, d.Locks.Locked(domain.TargetCamera, "", "movement"))
			</dl>
			@singletonLocks(d, domain.TargetCamera)
		</section>
		<section aria-label="Story" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Story</h2>
			<dl class="flex flex-col gap-1">
				@molecules.WorldStateReadonly("Scene", storyScene(d.World.Story), d.Locks.Locked(domain.TargetStory, "", domain.StoryFieldScene))
				@molecules.WorldStateReadonly(fieldLabel("character_goal"), d.World.Story.CharacterGoal, d.Locks.Locked(domain.TargetStory, "", "character_goal"))
				@molecules.WorldStateReadonly(fieldLabel("known_information"), joinKnown(d.World.Story.KnownInformation), d.Locks.Locked(domain.TargetStory, "", "known_information"))
				@molecules.WorldStateReadonly(fieldLabel("previous_event"), d.World.Story.PreviousEvent, d.Locks.Locked(domain.TargetStory, "", "previous_event"))
			</dl>
			@singletonLocks(d, domain.TargetStory)
		</section>
		@VersionHistoryPanel(VersionHistoryData{
			DOMID: "version-history-world", Title: "World State のバージョン", BasePath: "/projects/" + d.Project.ID + "/world-state",
			Target: "#world-state-view", Entries: d.Versions,
		})
	</div>
}

// singletonLocks are the LOCK switches of the Camera or the Story.
templ singletonLocks(d WorldStateData, target domain.WorldTarget) {
	<details class="text-sm">
		<summary class="cursor-pointer text-xs text-neutral-400">LOCK 設定（AUTO: AI が更新 / LOCK: 更新しない）</summary>
		<div class="mt-2 flex flex-col gap-1">
			for _, f := range domain.LockableFields(target) {
				@atoms.LockToggle(d.fieldLockToggle(target, "", f))
			}
		</div>
	</details>
}
