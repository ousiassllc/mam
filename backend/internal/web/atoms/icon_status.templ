package atoms

// Icons of the four states (Iconoir v7.12.2, copied as in icon.templ) and of the theme button. A state is told by an icon, a word and a
// colour together, never by the colour alone (the UI guide, C4): the toast, the connection notice and the inline alerts draw the icon of their
// state before the words. iconModel hands every name it does not know to iconStatus.

// Icons of the states and of the theme button.
const (
	IconSuccess IconName = "success"
	IconWarning IconName = "warning"
	IconDanger  IconName = "danger"
	IconInfo    IconName = "info"
	IconTheme   IconName = "theme"
)

// iconStatus draws the icons of the states and the theme button; an unknown name draws nothing.
templ iconStatus(name IconName, class string) {
	switch name {
		case IconSuccess:
			// check-circle
			@iconSVG(class) {
				<path d="M7 12.5L10 15.5L17 8.5" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke-linecap="round" stroke-linejoin="round"></path>
			}
		case IconWarning:
			// warning-triangle
			@iconSVG(class) {
				<path d="M20.0429 21H3.95705C2.41902 21 1.45658 19.3364 2.22324 18.0031L10.2662 4.01533C11.0352 2.67792 12.9648 2.67791 13.7338 4.01532L21.7768 18.0031C22.5434 19.3364 21.581 21 20.0429 21Z" stroke-linecap="round"></path>
				<path d="M12 9V13" stroke-linecap="round"></path>
				<path d="M12 17.01L12.01 16.9989" stroke-linecap="round" stroke-linejoin="round"></path>
			}
		case IconDanger:
			// warning-circle
			@iconSVG(class) {
				<path d="M12 7L12 13" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d="M12 17.01L12.01 16.9989" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke-linecap="round" stroke-linejoin="round"></path>
			}
		case IconInfo:
			// info-circle
			@iconSVG(class) {
				<path d="M12 11.5V16.5" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d="M12 7.51L12.01 7.49889" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke-linecap="round" stroke-linejoin="round"></path>
			}
		case IconTheme:
			// half-moon
			@iconSVG(class) {
				<path d="M3 11.5066C3 16.7497 7.25034 21 12.4934 21C16.2209 21 19.4466 18.8518 21 15.7259C12.4934 15.7259 8.27411 11.5066 8.27411 3C5.14821 4.55344 3 7.77915 3 11.5066Z" stroke-linecap="round" stroke-linejoin="round"></path>
			}
	}
}
