package credentials

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// providerChoice is the choice of the API provider the cloud video models (Kling) are called through, at the top of the panel: the
// provider's own API, or OpenRouter, fal.ai or Replicate, which resell the model by usage. A change is saved without a button, once the choice has settled
// (the form posts 600ms after the last change, so the arrow keys do not save each provider they pass) and answers with the whole panel, because the key cards under it follow the choice. Under it, how the choice serves each
// model: the price, why not, and whether its key is stored.
templ providerChoice(p *ProviderData) {
	<section class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4" aria-labelledby="api-provider-title" data-testid="api-provider">
		<div class="flex flex-col gap-1">
			<h4 id="api-provider-title" class="text-sm font-semibold text-ink">動画モデルの API プロバイダー</h4>
			<p class="text-sm text-mute">Kling などのクラウド動画モデルを、どこの API で呼ぶかを選びます。公式のほか、OpenRouter・fal.ai・Replicate は使った分だけ払えます（見積りと費用は選んだ先の単価で出ます）。選ぶと、その先のキー欄が下に出ます。</p>
		</div>
		if p.Problem != "" {
			<p class="text-sm text-warning" role="alert" data-testid="api-provider-problem">{ p.Problem }</p>
		} else {
			<form
				class="flex flex-col gap-3"
				hx-put={ paths.APIProvider() }
				hx-target="#credential-panel"
				hx-swap="outerHTML"
				hx-trigger="change delay:600ms"
				hx-sync="this:replace"
				data-testid="api-provider-form"
			>
				<fieldset class="flex flex-wrap gap-2" disabled?={ p.Pinned }>
					<legend class="sr-only">動画モデルの API プロバイダー</legend>
					for _, c := range p.Choices {
						<label class="group relative inline-flex cursor-pointer items-center has-[:disabled]:cursor-not-allowed">
							@atoms.Choice("peer sr-only", templ.Attributes{"type": "radio", "name": "provider", "value": c.Value, "checked": c.Checked, "data-testid": "api-provider-" + c.Value})
							<span class="inline-flex items-center gap-1 rounded-md border border-border px-3 py-2 text-sm text-ink transition-colors hover:border-mute peer-checked:border-accent peer-checked:bg-accent-soft peer-focus-visible:focus-ring peer-disabled:pointer-events-none peer-disabled:opacity-60 motion-reduce:transition-none">
								<span class="hidden group-has-[:checked]:inline" aria-hidden="true">✓</span>
								<span>{ c.Label }</span>
							</span>
						</label>
					}
				</fieldset>
				if p.Pinned {
					<p class="text-sm text-mute" role="status" data-testid="api-provider-pinned">起動オプションで固定されているため、この画面では変更できません</p>
				}
			</form>
			@providerModels(p.Models, false)
		}
	</section>
}

// ProviderModelsOOB is the list of how the chosen provider serves each model, as the answer of a save or a delete of a key: it replaces the list of the panel out of band, so
// that "OpenRouter の API キー: 設定済み" follows the key that was just stored or removed. It renders nothing when the panel has no such list (the choice is not offered).
templ ProviderModelsOOB(p *ProviderData) {
	if p != nil && p.Problem == "" {
		@providerModels(p.Models, true)
	}
}

templ providerModels(models []ProviderModel, oob bool) {
	<ul
		id={ ProviderModelsID }
		role="list"
		class="flex flex-col gap-2"
		data-testid="api-provider-models"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, m := range models {
			@providerModel(m)
		}
	</ul>
}

templ providerModel(m ProviderModel) {
	<li class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm" data-testid="api-provider-model" data-model={ m.Label }>
		<span class="font-semibold text-ink">{ m.Label }</span>
		if m.Supported {
			@atoms.Badge(atoms.BadgeOK, "使えます")
			if m.Prices != "" {
				<span class="text-mute">{ m.Prices }</span>
			}
			if m.KeyLabel != "" && m.KeySet {
				<span class="text-mute">・{ m.KeyLabel } の API キー: 設定済み</span>
			} else if m.KeyLabel != "" {
				@atoms.Badge(atoms.BadgeWarn, m.KeyLabel+" の API キーが未設定")
			}
		} else {
			@atoms.Badge(atoms.BadgeWarn, "このプロバイダーでは使えません")
			<span class="min-w-0 break-words text-warning" data-testid="api-provider-why">{ m.Why }</span>
		}
	</li>
}
