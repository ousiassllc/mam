.DEFAULT_GOAL := help

# Tool versions. templ follows go.mod: the committed *_templ.go files are generated by that
# version and their runtime (github.com/a-h/templ) is the module of the same version.
TEMPL_VERSION := $(shell go list -m -f '{{.Version}}' github.com/a-h/templ)
# Code generation runs this exact version, never whatever `templ` is first on PATH: a stale binary writes
# *_templ.go that differ from CI's (and from the go.mod runtime). `fmt` / `fmt-check` use PATH's templ (formatting only).
TEMPL_RUN := go run github.com/a-h/templ/cmd/templ@$(TEMPL_VERSION)
AIR_VERSION ?= v1.64.5
GOLANGCI_LINT_VERSION ?= v2.12.2
LINTERLY_VERSION ?= v0.3.3
GOVULNCHECK_VERSION ?= v1.8.0

.PHONY: help dev build build-all generate assets test test-go test-static test-scripts lint lint-go lint-static lint-lines linterly-baseline vuln fmt fmt-check tools clean

help: ## show targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-14s %s\n", $$1, $$2}'

static/node_modules: static/package-lock.json
	npm ci --prefix static
	@touch $@

dev: static/node_modules ## watch mode: air (Go) + templ generate --watch + esbuild/tailwind --watch
	@MAM_STATIC_DIR=static/src/dist ./static/node_modules/.bin/concurrently -k -n air,templ,static \
		"air" \
		"$(TEMPL_RUN) generate --watch" \
		"npm run dev --prefix static"

build: ## production build into bin/mam (templ -> esbuild -> tailwind -> go build)
	./scripts/build.sh

build-all: ## production build for every platform (windows/darwin/linux x amd64/arm64) into bin/mam-<os>-<arch>
	./scripts/build.sh --all

generate: ## templ generate (with the go.mod templ version, not PATH's)
	$(TEMPL_RUN) generate ./backend/...

assets: static/node_modules ## build front-end assets into static/src/dist
	npm run build --prefix static

test: test-go test-static test-scripts ## run every test

test-go: generate ## Go tests (then the tests over 3 s are listed)
	bash -o pipefail -c 'go test -race -timeout 30m -json ./... | scripts/slow-tests.sh'

test-static: static/node_modules ## front-end unit tests
	npm test --prefix static

test-scripts: ## shell script tests
	bash scripts/linterly-baseline_test.sh
	bash scripts/makefile_test.sh
	bash scripts/slow-tests_test.sh
	bash scripts/complexity-ratchet_test.sh
	bash scripts/sign-checksums_test.sh
	bash scripts/third-party-notices_test.sh

lint: lint-go lint-static ## golangci-lint + tsc + biome lint

lint-go: generate ## golangci-lint
	golangci-lint run ./...

lint-static: static/node_modules ## tsc + biome lint
	npm run typecheck --prefix static
	npm run lint --prefix static

lint-lines: ## fail when a file / directory got over the linterly line limit beyond .linterly-baseline
	./scripts/linterly-baseline.sh check

vuln: ## govulncheck: fail on a known vulnerability reachable from the code (Go standard library + modules), for the Linux host and the Windows target (cmd/wails)
	govulncheck ./...
	GOOS=windows CGO_ENABLED=0 govulncheck ./...

linterly-baseline: ## rewrite .linterly-baseline from the current linterly result (after splitting files)
	./scripts/linterly-baseline.sh update

fmt: static/node_modules ## format Go code, templ templates and front-end TypeScript
	templ fmt backend
	golangci-lint fmt ./...
	npm run format --prefix static

fmt-check: static/node_modules ## fail when Go code, templates or front-end TypeScript are not formatted
	@test -z "$$(gofmt -l backend static)" || (gofmt -l backend static; exit 1)
	@templ fmt -fail backend
	npm run format:check --prefix static

tools: ## install the pinned dev tools (templ, air, golangci-lint, linterly, govulncheck) and the npm deps
	go install github.com/a-h/templ/cmd/templ@$(TEMPL_VERSION)
	go install github.com/air-verse/air@$(AIR_VERSION)
	go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$(GOLANGCI_LINT_VERSION)
	go install github.com/ousiassllc/linterly/cmd/linterly@$(LINTERLY_VERSION)
	go install golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION)
	$(MAKE) --no-print-directory static/node_modules

clean: ## remove bin, tmp and the built front-end assets
	rm -rf bin tmp static/src/dist/app.*
