package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sceneshot"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
)

// SceneShotPage is GET /projects/:id/scenes/:sceneId: the Scene / Shot / Take hierarchy in an auxiliary view.
templ SceneShotPage(csrfToken string, d sceneshot.Data) {
	@layout.AppLayout("Scene / Shot: "+d.Project.Name, csrfToken, sidenav.InProject(sidenav.SceneShot, d.Project)) {
		@pagehead.Main(pagehead.Wide) {
			@pagehead.Header("Scene / Shot", d.Project.Name, "")
			@sceneshot.View(d)
		}
	}
}
