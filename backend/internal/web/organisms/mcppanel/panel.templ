package mcppanel

import (
	"time"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// TokenRow is one issued token. It never carries the value, only the start of it that tells tokens apart.
type TokenRow struct {
	ID         string
	Name       string
	Prefix     string
	CreatedAt  time.Time
	LastUsedAt *time.Time // nil: never used
	Revoked    bool
}

// NewToken is a token that was just issued. Its value is shown here, once, and never again.
type NewToken struct {
	Name  string
	Value string
}

// Data is the "MCP サーバー" section. Addr is where the server listens now (empty: not listening), Saved the
// bind address in mcp.json, Problem why the two differ or why MCP is off, Candidates the addresses of this
// machine the bind address can be set to. Notice is a success, Error is why an action was refused (the
// form then holds what was typed: TypedAddress, TypedName). Issued is the token issued by the last action.
type Data struct {
	Addr         string
	Saved        string
	Problem      string
	Candidates   []string
	Tokens       []TokenRow
	Notice       string
	Error        string
	Issued       *NewToken
	TypedAddress string
	TypedName    string
	MaxNameLen   int
}

// Section is the "MCP サーバー" section of the global settings screen: Panel under its title.
templ Section(d Data) {
	@molecules.SettingsSection("MCP サーバー", "エージェント（Grok Bot など）から、画面と同じ操作を MCP（Streamable HTTP）で行えます。接続にはここで発行するトークンが必要です。待ち受け先は 127.0.0.1 か tailnet の IP（100.x）にできます。") {
		@Panel(d)
	}
}

// SectionIf is Section, or nothing when d is nil.
templ SectionIf(d *Data) {
	if d != nil {
		@Section(*d)
	}
}

// Panel is the whole section: the address, the bind-address form, the issued token (once), the issue form
// and the token list. Every action (PUT / POST / DELETE) answers with the panel itself.
templ Panel(d Data) {
	<section id="mcp-panel" class="flex flex-col gap-4">
		if d.Problem != "" {
			<p class="text-sm text-amber-300" role="alert" data-testid="mcp-problem">{ d.Problem }</p>
		}
		if d.Notice != "" {
			<p class="text-sm text-emerald-300" role="status" data-testid="mcp-notice">{ d.Notice }</p>
		}
		if d.Error != "" {
			<p class="text-sm text-red-300" role="alert" data-testid="mcp-error">{ d.Error }</p>
		}
		@address(d)
		@bindForm(d)
		if d.Issued != nil {
			@issued(*d.Issued)
		}
		@issueForm(d)
		@tokenList(d.Tokens)
	</section>
}

templ address(d Data) {
	<p class="text-sm">
		<span class="text-neutral-400">待ち受け中のアドレス:</span>
		if d.Addr != "" {
			<code class="font-medium" data-testid="mcp-addr">{ "http://" + d.Addr + "/mcp" }</code>
		} else {
			<span class="font-medium" data-testid="mcp-addr">待ち受けていません</span>
		}
	</p>
}

templ bindForm(d Data) {
	<form
		class="flex flex-wrap items-end gap-2"
		hx-put={ paths.MCPBind() }
		hx-target="#mcp-panel"
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		autocomplete="off"
	>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="mcp-bind-address">
			<span>待ち受け先の IP アドレス（127.0.0.1 または tailnet の 100.64.0.0/10）</span>
			@atoms.Input(atoms.FieldMd, "w-56", templ.Attributes{
				"id":           "mcp-bind-address",
				"name":         "bind_address",
				"type":         "text",
				"value":        bindValue(d),
				"list":         "mcp-bind-candidates",
				"required":     true,
				"autocomplete": "off",
				"inputmode":    "decimal",
			})
			<datalist id="mcp-bind-candidates">
				for _, c := range d.Candidates {
					<option value={ c }></option>
				}
			</datalist>
		</label>
		@atoms.Button(atoms.TonePrimary, "切り替える", templ.Attributes{"type": "submit"})
	</form>
}

func bindValue(d Data) string {
	if d.TypedAddress != "" {
		return d.TypedAddress
	}
	return d.Saved
}

templ issued(t NewToken) {
	<div class="flex flex-col gap-2 rounded-md border border-emerald-500/50 px-3 py-2" role="status" data-testid="mcp-issued">
		<p class="text-sm">トークン「{ t.Name }」を発行しました。<strong>この値は今しか表示されません。</strong>いまコピーして、エージェントの設定に貼り付けてください。</p>
		<code class="break-all rounded bg-neutral-950 px-2 py-1 text-sm select-all" data-testid="mcp-issued-value">{ t.Value }</code>
	</div>
}

templ issueForm(d Data) {
	<form
		class="flex flex-wrap items-end gap-2"
		hx-post={ paths.MCPTokens() }
		hx-target="#mcp-panel"
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		autocomplete="off"
	>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="mcp-token-name">
			<span>トークンの名前（どのエージェント用か）</span>
			@atoms.Input(atoms.FieldMd, "w-56", templ.Attributes{
				"id":           "mcp-token-name",
				"name":         "name",
				"type":         "text",
				"value":        d.TypedName,
				"required":     true,
				"maxlength":    maxLength(d.MaxNameLen),
				"autocomplete": "off",
			})
		</label>
		@atoms.Button(atoms.TonePrimary, "トークンを発行", templ.Attributes{"type": "submit"})
	</form>
}

templ tokenList(tokens []TokenRow) {
	if len(tokens) == 0 {
		<p class="text-sm text-neutral-400" data-testid="mcp-no-tokens">発行済みのトークンはありません。トークンがないと MCP には接続できません。</p>
	} else {
		<ul class="flex flex-col divide-y divide-neutral-800 text-sm" data-testid="mcp-tokens">
			for _, t := range tokens {
				@tokenRow(t)
			}
		</ul>
	}
}

templ tokenRow(t TokenRow) {
	<li class="flex flex-wrap items-center justify-between gap-2 py-3" data-testid="mcp-token" data-token-id={ t.ID }>
		<div class="flex min-w-0 flex-col gap-1">
			<span class="flex items-center gap-2">
				<span class="font-medium">{ t.Name }</span>
				if t.Revoked {
					@atoms.Badge(atoms.BadgeError, "失効済み")
				} else {
					@atoms.Badge(atoms.BadgeOK, "有効")
				}
			</span>
			<span class="text-xs text-neutral-400">
				<code>mam_mcp_{ t.Prefix }…</code>
				／ 作成: { formatTime(t.CreatedAt) }
				／ 最終利用:
				if t.LastUsedAt != nil {
					{ formatTime(*t.LastUsedAt) }
				} else {
					未使用
				}
			</span>
		</div>
		if !t.Revoked {
			@atoms.ButtonFor(atoms.ToneDanger, "失効", t.Name, templ.Attributes{
				"type":       "button",
				"hx-delete":  paths.MCPToken(t.ID),
				"hx-target":  "#mcp-panel",
				"hx-swap":    "outerHTML",
				"hx-confirm": "トークン「" + t.Name + "」を失効します。このトークンでの接続はすぐに切れ、元に戻せません。よろしいですか？",
			})
		}
	</li>
}
