package projectimport

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Data is the state of the bundle import form.
type Data struct {
	Error string
}

// Form imports a project bundle (paths.ProjectImport): the archive of the settings screen's bundle export.
templ Form(d Data) {
	<form
		id="project-import-form"
		class="mt-4 flex flex-wrap items-center gap-2 rounded-lg border border-border p-3 text-sm"
		hx-post={ paths.ProjectImport() }
		hx-encoding="multipart/form-data"
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
	>
		<label for="project-import-file" class="text-ink">プロジェクトバンドルを読み込む</label>
		<input id="project-import-file" type="file" name="bundle" required accept=".zip,application/zip" class="text-sm"/>
		@atoms.Button(atoms.ToneNeutral, "読み込む", templ.Attributes{
			"type": "submit",
		})
		if d.Error != "" {
			<p class="basis-full text-sm text-danger" role="alert">{ d.Error }</p>
		}
	</form>
}
