package chatgptpanel

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// methodTabs chooses which text generation login the section shows.
templ methodTabs(d Data) {
	<div class="flex flex-wrap gap-2" role="tablist" aria-label="ログインの方式" data-testid="chatgpt-methods">
		@methodTab(MethodOfficial, "Sign in with ChatGPT（公式・個人の Go / Plus / Pro）", d.Method)
		@methodTab(MethodCodex, "Codex 経由（組織の Business / Enterprise / Edu・個人も可）", d.Method)
	</div>
}

templ methodTab(method, label, current string) {
	<button
		type="button"
		role="tab"
		aria-selected={ method == current }
		class={ "rounded-md border px-3 py-1 text-sm", templ.KV("border-sky-400 bg-sky-500/20 text-sky-200", method == current), templ.KV("border-neutral-600 text-neutral-300", method != current) }
		hx-get={ methodURL(method) }
		hx-target={ panelTarget }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		data-testid={ "chatgpt-method-" + method }
	>{ label }</button>
}

// codexGuidance points an official sign-in that cannot work (the organization refused it, or the account is a workspace
// one) to the Codex login. The official login stays as it is: nothing is signed out.
templ codexGuidance(d Data) {
	if (d.Official.Login != nil && d.Official.Login.UseCodex) || (d.Official.SignedIn && d.Official.WorkspacePlan) {
		<div class="flex flex-col gap-2 rounded-md border border-amber-500/50 px-3 py-2" data-testid="chatgpt-use-codex">
			<p class="text-sm text-amber-300">組織のアカウントは Codex 経由のログインを使ってください。Business / Enterprise / Edu のワークスペースのアカウントは、OpenAI の仕様で、公式の方式ではプランを使えません。</p>
			<form hx-get={ methodURL(MethodCodex) } hx-target={ panelTarget } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
				@atoms.Button(atoms.TonePrimary, "Codex 経由のログインへ", templ.Attributes{"type": "submit", "data-testid": "chatgpt-use-codex-button"})
			</form>
		</div>
	}
}

// codexBlock is the Codex login: terms, engine, account, usage limits, login, models.
templ codexBlock(d Data) {
	<div class="flex flex-col gap-3" data-testid="chatgpt-codex">
		<h3 class="text-sm font-semibold">ChatGPT 経由の Codex（テキスト生成のみ）</h3>
		<p class="text-xs text-neutral-400">
			Codex の app-server（OpenAI の公式のプログラム）をこの PC で動かし、そこで ChatGPT にログインします。Business / Enterprise / Edu のワークスペースのアカウントでも、個人のアカウントでも使えます。画像・動画・音声の生成には使いません。LLM の割り当てでは、プロバイダー「chatgpt-codex」を選びます。
		</p>
		<p class="rounded-md border border-amber-500/50 px-3 py-2 text-sm text-amber-300" data-testid="chatgpt-codex-terms">
			この方式はローカル・オープンソースの利用のためのもので、商用・ホスティング（mam をサーバーで動かして他の人に提供する形）での提供には使えません。ワークスペースの Codex の利用上限を使います。
		</p>
		@codexEngine(d.Codex)
		@codexAccount(d.Codex)
		@loginMessage(d.Codex.Login)
		if d.Codex.EngineReady() {
			<div class="flex flex-wrap items-center gap-2">
				if !d.Codex.SignedIn {
					@loginButton(codexKind, "browser", "ブラウザでログイン", d.Codex.Login)
					@loginButton(codexKind, "device", "デバイスコードでログイン", nil)
				}
				@codexRefreshButton()
				if d.Codex.SignedIn {
					@codexLogout()
				}
			</div>
			<p class="text-xs text-neutral-400">
				使うには、ワークスペースの所有者が「Codex をローカルで使う」権限（Codex Local）をメンバーに許可している必要があります。デバイスコードでログインするには、デバイスコードのログインも許可されている必要があります（beta）。
			</p>
		}
		if d.Codex.JustSignedIn {
			<p class="text-sm text-emerald-300" data-testid="chatgpt-codex-assign-hint">
				ログインしました。「LLM の割り当て」で、使う Agent のプロバイダーを「chatgpt-codex」にすると、この方式で動きます（自動では切り替えません）。
			</p>
		}
		@codexModels(d.Codex)
	</div>
}

templ codexEngine(c Codex) {
	<div class="flex flex-col gap-2 rounded-md border border-neutral-700 px-3 py-2" data-testid="chatgpt-codex-engine">
		<p class="text-sm">
			<span class="font-medium">エンジン（Codex app-server）</span>
			switch c.Engine.State {
				case "ready", "running":
					@atoms.Badge(atoms.BadgeOK, engineLabel(c.Engine.State))
				case "failed":
					@atoms.Badge(atoms.BadgeError, engineLabel(c.Engine.State))
				case "installing":
					@atoms.Badge(atoms.BadgeInfo, engineLabel(c.Engine.State))
				default:
					@atoms.Badge(atoms.BadgeNeutral, engineLabel(c.Engine.State))
			}
			if c.Engine.Version != "" {
				<span class="ml-2 text-xs text-neutral-400" data-testid="chatgpt-codex-version">バージョン: { c.Engine.Version }</span>
			}
		</p>
		if s := engineSource(c.Engine.Source); s != "" {
			<p class="text-xs text-neutral-400">{ s }</p>
		}
		if c.Engine.Error != "" {
			<pre class="whitespace-pre-wrap text-xs text-red-300" role="alert" data-testid="chatgpt-codex-engine-error">{ c.Engine.Error }</pre>
		}
		if c.Engine.UpdateAvailable {
			<p class="text-xs text-amber-300" data-testid="chatgpt-codex-update">この mam が確かめた版は { c.Engine.PinnedVersion } です。取得済みの { c.Engine.Version } は使いません。もう一度取得してください。</p>
		}
		if c.Engine.Install.Running {
			<div class="flex flex-col gap-1" role="status" data-testid="chatgpt-codex-install">
				<progress class="w-full" max="100" value={ percentText(c.Engine.Install.Percent) }></progress>
				<p class="text-xs">{ c.Engine.Install.Message }（{ percentText(c.Engine.Install.Percent) }%）</p>
				<form hx-post={ paths.ChatGPTCodexInstallCancel() } hx-target={ panelTarget } hx-swap="outerHTML" hx-sync="this:drop" hx-params="none" hx-disabled-elt="find button[type=submit]">
					@atoms.Button(atoms.ToneNeutral, "中断", templ.Attributes{"type": "submit", "data-testid": "chatgpt-codex-install-cancel"})
				</form>
			</div>
		} else {
			if c.Engine.Install.Error != "" {
				<p class="text-sm text-red-300" role="alert" data-testid="chatgpt-codex-install-error">{ c.Engine.Install.Error }</p>
			}
			if c.Engine.Supported && c.Engine.Source != "custom" && (c.Engine.State == "not_installed" || c.Engine.UpdateAvailable) {
				<form hx-post={ paths.ChatGPTCodexInstall() } hx-target={ panelTarget } hx-swap="outerHTML" hx-sync="this:drop" hx-params="none" hx-disabled-elt="find button[type=submit]">
					<p class="mb-2 text-xs text-neutral-400">
						初回は Codex の実行ファイルを OpenAI の公式のリリース（GitHub）からダウンロードします（約 90 MB。展開後は約 270 MB。SHA-256 とサイズを確かめます。Apache-2.0）。mam の実行ファイルと同じ場所の codex ディレクトリに置きます。
					</p>
					@atoms.Button(atoms.TonePrimary, "Codex をダウンロード", templ.Attributes{"type": "submit", "data-testid": "chatgpt-codex-install-button"})
				</form>
			}
		}
		if !c.Engine.Supported {
			<p class="text-xs text-neutral-400" data-testid="chatgpt-codex-unsupported">この環境では取得できません（取得は Windows 版だけです）。自分で入れた codex の実行ファイルのパスを指定してください。</p>
		}
		@codexPathForm(c)
	</div>
}

templ codexPathForm(c Codex) {
	<form class="flex flex-wrap items-center gap-2" hx-put={ paths.ChatGPTCodexPath() } hx-target={ panelTarget } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
		<label class="text-xs text-neutral-400" for="chatgpt-codex-path">自分で入れた codex のパス</label>
		@atoms.Input(atoms.FieldSm, "min-w-64 flex-1", templ.Attributes{"id": "chatgpt-codex-path", "name": "path", "type": "text", "value": c.Engine.CustomPath, "placeholder": "C:\\Tools\\codex\\codex.exe", "data-testid": "chatgpt-codex-path"})
		@atoms.Button(atoms.ToneNeutral, "パスを設定", templ.Attributes{"type": "submit", "data-testid": "chatgpt-codex-path-set"})
	</form>
}

templ codexAccount(c Codex) {
	<div class="flex flex-col gap-1 text-sm" data-testid="chatgpt-status-codex">
		if !c.SignedIn {
			<p class="text-neutral-300">ログインしていません</p>
		} else {
			<p>
				@atoms.Badge(atoms.BadgeOK, "ログイン済み")
				<span class="ml-2 font-medium" data-testid="chatgpt-email">{ c.Email }</span>
				if c.Plan != "" {
					<span class="ml-2 text-xs text-neutral-400" data-testid="chatgpt-plan">プラン: { c.Plan }</span>
				}
			</p>
			<p class="text-xs text-neutral-400">トークンは Codex が自分で保存・更新します（mam は読みも保存もしません）。保存先: { codexStore(c.CredentialsStore) }</p>
			if len(c.Limits) > 0 {
				<ul class="flex flex-col gap-0.5 text-xs" data-testid="chatgpt-codex-limits">
					for _, l := range c.Limits {
						<li>{ limitText(l) }</li>
					}
				</ul>
			}
		}
	</div>
}

templ codexRefreshButton() {
	<form hx-post={ paths.ChatGPTCodexRefresh() } hx-target={ panelTarget } hx-swap="outerHTML" hx-sync="this:drop" hx-params="none" hx-disabled-elt="find button[type=submit]">
		@atoms.Button(atoms.ToneNeutral, "状態と利用上限を更新", templ.Attributes{"type": "submit", "data-testid": "chatgpt-codex-refresh"})
	</form>
}

// codexLogout signs out of Codex; the box also deletes the downloaded engine and mam's own CODEX_HOME.
templ codexLogout() {
	<form
		class="flex flex-wrap items-center gap-2"
		hx-delete={ paths.ChatGPTCodex() }
		hx-target={ panelTarget }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		hx-confirm="ログアウトします。Codex が保存したトークンを消します。よろしいですか？"
	>
		<label class="flex items-center gap-2 text-xs text-neutral-300">
			<input type="checkbox" name="remove" value="true" data-testid="chatgpt-codex-remove"/>
			取得した Codex 本体と mam 専用の CODEX_HOME も削除する
		</label>
		@atoms.Button(atoms.ToneDanger, "ログアウト", templ.Attributes{"type": "submit", "data-testid": "chatgpt-logout-codex"})
	</form>
}

templ codexModels(c Codex) {
	if c.SignedIn && c.EngineReady() {
		<div class="flex flex-col gap-2" data-testid="chatgpt-codex-models">
			<form hx-get={ paths.ChatGPTCodexModels() } hx-target={ panelTarget } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
				@atoms.Button(atoms.ToneNeutral, "利用できるモデルを表示", templ.Attributes{"type": "submit", "data-testid": "chatgpt-codex-models-show"})
			</form>
			if c.ModelsAsked {
				if len(c.Models) == 0 {
					<p class="text-sm text-neutral-400">表示できるモデルがありません。</p>
				} else {
					<p class="text-xs text-neutral-400">「LLM の割り当て」のモデル欄に、次のモデル名（太字）を入力します。画像の入力に対応するモデルには「画像可」と付きます。</p>
					<ul class="flex flex-col gap-1 text-sm" data-testid="chatgpt-codex-model-list">
						for _, m := range c.Models {
							<li>
								<code class="font-medium select-all">{ m.Slug }</code>
								<span class="text-xs text-neutral-400">{ m.DisplayName }</span>
								if m.Images {
									<span class="text-xs text-sky-300">画像可</span>
								}
							</li>
						}
					</ul>
				}
			}
		</div>
	}
}
