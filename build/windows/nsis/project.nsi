Unicode true

####
## Installer of the Windows desktop version (spec/architecture/desktop.md §4). scripts/package-windows.sh
## builds it through `wails3 package GOOS=windows`, which passes -DINFO_PRODUCTVERSION (X.Y.Z) and
## -DARG_WAILS_AMD64_BINARY (bin\mam.exe). wails_tools.nsh supplies the other INFO_* defaults.
####
!include "wails_tools.nsh"

# The version information for this two must consist of 4 parts
VIProductVersion "${INFO_PRODUCTVERSION}.0"
VIFileVersion    "${INFO_PRODUCTVERSION}.0"

VIAddVersionKey "CompanyName"     "${INFO_COMPANYNAME}"
VIAddVersionKey "FileDescription" "${INFO_PRODUCTNAME} Installer"
VIAddVersionKey "ProductVersion"  "${INFO_PRODUCTVERSION}"
VIAddVersionKey "FileVersion"     "${INFO_PRODUCTVERSION}"
VIAddVersionKey "LegalCopyright"  "${INFO_COPYRIGHT}"
VIAddVersionKey "ProductName"     "${INFO_PRODUCTNAME}"

# Enable HiDPI support. https://nsis.sourceforge.io/Reference/ManifestDPIAware
ManifestDPIAware true

!include "MUI.nsh"

!define MUI_ICON "..\icon.ico"
!define MUI_UNICON "..\icon.ico"
# !define MUI_WELCOMEFINISHPAGE_BITMAP "resources\leftimage.bmp" #Include this to add a bitmap on the left side of the Welcome Page. Must be a size of 164x314
!define MUI_FINISHPAGE_NOAUTOCLOSE # Wait on the INSTFILES page so the user can take a look into the details of the installation steps
!define MUI_ABORTWARNING # This will warn the user if they exit from the installer.
# ffmpeg is not bundled: the Judge, previews and Export use the ffmpeg / ffprobe found on PATH (or set in the settings), or the one that the app downloads on a click into $INSTDIR\ffmpeg (spec/architecture/ffmpeg-download.md).
!define MUI_FINISHPAGE_TITLE "${INFO_PRODUCTNAME} has been installed"
!define MUI_FINISHPAGE_TEXT "Start ${INFO_PRODUCTNAME} from the Start menu or the desktop shortcut.$\r$\n$\r$\nffmpeg is not included. To use the Judge, previews and Export, open Settings > ffmpeg in ${INFO_PRODUCTNAME} and press the download button (about 110 MB, checked against a pinned SHA-256; it connects only when you press it). If you installed ffmpeg yourself (for example: winget install Gyan.FFmpeg), ${INFO_PRODUCTNAME} uses that one. ${INFO_PRODUCTNAME} starts without ffmpeg.$\r$\n$\r$\nYour projects and settings are kept in %AppData%\mam and are not removed when you uninstall."

!insertmacro MUI_PAGE_WELCOME # Welcome to the installer page.
# !insertmacro MUI_PAGE_LICENSE "resources\eula.txt" # Adds a EULA page to the installer
!insertmacro MUI_PAGE_DIRECTORY # In which folder install page.
!insertmacro MUI_PAGE_INSTFILES # Installing page.
!insertmacro MUI_PAGE_FINISH # Finished installation page.

!insertmacro MUI_UNPAGE_INSTFILES # Uninstalling page

!insertmacro MUI_LANGUAGE "English" # Set the Language of the installer

## The following two statements can be used to sign the installer and the uninstaller. The path to the binaries are provided in %1
#!uninstfinalize 'signtool --file "%1"'
#!finalize 'signtool --file "%1"'

Name "${INFO_PRODUCTNAME}"
OutFile "..\..\..\bin\${INFO_PROJECTNAME}-${INFO_PRODUCTVERSION}-windows-${ARCH}-setup.exe" # Name of the installer's file.
!if "${WAILS_INSTALL_SCOPE}" == "user"
    InstallDir "$LOCALAPPDATA\Programs\${INFO_PRODUCTNAME}"
!else
    InstallDir "$PROGRAMFILES64\${INFO_PRODUCTNAME}"
!endif
ShowInstDetails show # This will always show the installation details.

# An automatic update (the app quits and runs `setup.exe /S`, spec/architecture/desktop.md §Auto update) starts
# the installer while the old process may still be ending. Files of a running exe cannot be overwritten, so a
# silent install first waits (up to 60 s) until the installed exe can be opened for writing, which is not
# possible while it runs. An installer that is not silent, or a first install, does not wait.
Function waitForAppToExit
    StrCpy $1 0
    waitLoop:
        IfFileExists "$INSTDIR\${PRODUCT_EXECUTABLE}" 0 waitDone
        ClearErrors
        FileOpen $0 "$INSTDIR\${PRODUCT_EXECUTABLE}" a
        IfErrors 0 waitFree
        IntOp $1 $1 + 1
        IntCmp $1 120 waitDone waitMore waitDone
    waitMore:
        Sleep 500
        Goto waitLoop
    waitFree:
        FileClose $0
    waitDone:
FunctionEnd

Function .onInit
   !insertmacro wails.checkArchitecture
   IfSilent 0 initDone
   Call waitForAppToExit
   initDone:
FunctionEnd

Section
    !insertmacro wails.setShellContext

    !insertmacro wails.webview2runtime

    SetOutPath $INSTDIR
    
    !insertmacro wails.files
    # The license of MAM (AGPL-3.0) and the third-party notices (generated by scripts/third-party-notices.sh).
    File "..\..\..\LICENSE"
    File "..\..\..\THIRD_PARTY_NOTICES.md"

    CreateShortcut "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"
    CreateShortCut "$DESKTOP\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"

    !insertmacro wails.associateFiles
    !insertmacro wails.associateCustomProtocols
    
    !insertmacro wails.writeUninstaller
SectionEnd

# NSIS skips every page during a /S install - including the finish page - so nothing there can start the app
# again after an automatic update. This does: a silent install that succeeded starts the new exe. It is started
# by the installer of the user (WAILS_INSTALL_SCOPE=user: no elevation), so the app does not run as administrator.
Function .onInstSuccess
    IfSilent 0 relaunchDone
    SetOutPath "$INSTDIR"
    Exec '"$INSTDIR\${PRODUCT_EXECUTABLE}"'
    relaunchDone:
FunctionEnd

# The uninstaller waits (up to 10 s) until the installed exe can be opened for writing, as waitForAppToExit does for an update:
# a running mam.exe keeps its files locked. Quitting mam ends its ComfyUI child with it (the engine is in a Job Object with
# KILL_ON_JOB_CLOSE, internal/modelmgr/proc), so there is nothing else to stop; the child needs a moment to let go of its files,
# which the retry of the removal below covers.
Function un.onInit
    StrCpy $1 0
    unWaitLoop:
        IfFileExists "$INSTDIR\${PRODUCT_EXECUTABLE}" 0 unWaitDone
        ClearErrors
        FileOpen $0 "$INSTDIR\${PRODUCT_EXECUTABLE}" a
        IfErrors 0 unWaitFree
        IntOp $1 $1 + 1
        IntCmp $1 20 unWaitDone unWaitMore unWaitDone
    unWaitMore:
        Sleep 500
        Goto unWaitLoop
    unWaitFree:
        FileClose $0
    unWaitDone:
FunctionEnd

Section "uninstall" 
    !insertmacro wails.setShellContext

    # The data directory (%AppData%\mam: SQLite, generated media, logs) is deliberately kept.

    # The engine and the models of the model manager are in $INSTDIR\comfyui (spec/architecture/model-manager/model-manager.md §2),
    # and the local runtimes (GPT-SoVITS) in $INSTDIR\localai (spec/architecture/model-manager/local-runtime.md §2),
    # so this removes them too. The folders are tried again for up to 5 s: their files may be locked for a moment after the process ended.
    StrCpy $1 0
    removeLoop:
        RMDir /r $INSTDIR
        IfFileExists "$INSTDIR\comfyui\*.*" removeAgain 0
        IfFileExists "$INSTDIR\localai\*.*" removeAgain removeDone
    removeAgain:
        IntOp $1 $1 + 1
        IntCmp $1 10 removeDone removeMore removeDone
    removeMore:
        Sleep 500
        Goto removeLoop
    removeDone:

    Delete "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk"
    Delete "$DESKTOP\${INFO_PRODUCTNAME}.lnk"

    !insertmacro wails.unassociateFiles
    !insertmacro wails.unassociateCustomProtocols

    !insertmacro wails.deleteUninstaller
SectionEnd
