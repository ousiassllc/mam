package atoms

// Icons of the side menu (Lucide v1.61.0, copied as in icon.templ; the file is split from icon.templ to stay under the
// line limit). Icon hands every name it does not know to iconNav, which hands the rest to iconModel (icon_model.templ).

// Icons of the side menu: the screens of the app and the views of a Project, and the button that folds the menu.
const (
	IconProjects   IconName = "projects"
	IconChat       IconName = "chat"
	IconBrief      IconName = "brief"
	IconEdit       IconName = "edit"
	IconCost       IconName = "cost"
	IconBranch     IconName = "branch"
	IconWorld      IconName = "world"
	IconLibrary    IconName = "library"
	IconNotes      IconName = "notes"
	IconSeries     IconName = "series"
	IconPanelClose IconName = "panel-close"
	IconPanelOpen  IconName = "panel-open"
)

// iconNav draws the icons of the side menu; an unknown name draws nothing.
templ iconNav(name IconName, class string) {
	switch name {
		case IconProjects:
			// folder-kanban
			@iconSVG(class) {
				<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"></path>
				<path d="M8 10v4"></path>
				<path d="M12 10v2"></path>
				<path d="M16 10v6"></path>
			}
		case IconChat:
			// message-square
			@iconSVG(class) {
				<path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path>
			}
		case IconBrief:
			// file-text
			@iconSVG(class) {
				<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path>
				<path d="M14 2v5a1 1 0 0 0 1 1h5"></path>
				<path d="M10 9H8"></path>
				<path d="M16 13H8"></path>
				<path d="M16 17H8"></path>
			}
		case IconEdit:
			// scissors
			@iconSVG(class) {
				<circle cx="6" cy="6" r="3"></circle>
				<path d="M8.12 8.12 12 12"></path>
				<path d="M20 4 8.12 15.88"></path>
				<circle cx="6" cy="18" r="3"></circle>
				<path d="M14.8 14.8 20 20"></path>
			}
		case IconCost:
			// sliders-horizontal
			@iconSVG(class) {
				<path d="M10 5H3"></path>
				<path d="M12 19H3"></path>
				<path d="M14 3v4"></path>
				<path d="M16 17v4"></path>
				<path d="M21 12h-9"></path>
				<path d="M21 19h-5"></path>
				<path d="M21 5h-7"></path>
				<path d="M8 10v4"></path>
				<path d="M8 12H3"></path>
			}
		case IconBranch:
			// git-branch
			@iconSVG(class) {
				<path d="M15 6a9 9 0 0 0-9 9V3"></path>
				<circle cx="18" cy="6" r="3"></circle>
				<circle cx="6" cy="18" r="3"></circle>
			}
		case IconWorld:
			// globe
			@iconSVG(class) {
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
				<path d="M2 12h20"></path>
			}
		case IconLibrary:
			// library
			@iconSVG(class) {
				<path d="m16 6 4 14"></path>
				<path d="M12 6v14"></path>
				<path d="M8 8v12"></path>
				<path d="M4 4v16"></path>
			}
		case IconNotes:
			// sticky-note
			@iconSVG(class) {
				<path d="M21 9a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 15 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z"></path>
				<path d="M15 3v5a1 1 0 0 0 1 1h5"></path>
			}
		case IconSeries:
			// users
			@iconSVG(class) {
				<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
				<path d="M16 3.128a4 4 0 0 1 0 7.744"></path>
				<path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
				<circle cx="9" cy="7" r="4"></circle>
			}
		case IconPanelClose:
			// panel-left-close
			@iconSVG(class) {
				<rect width="18" height="18" x="3" y="3" rx="2"></rect>
				<path d="M9 3v18"></path>
				<path d="m16 15-3-3 3-3"></path>
			}
		case IconPanelOpen:
			// panel-left-open
			@iconSVG(class) {
				<rect width="18" height="18" x="3" y="3" rx="2"></rect>
				<path d="M9 3v18"></path>
				<path d="m14 9 3 3-3 3"></path>
			}
		default:
			@iconModel(name, class)
	}
}
