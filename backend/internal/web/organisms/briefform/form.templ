// Package briefform is the form that confirms and edits the Creative Brief (auxiliary view).
package briefform

import (
	"strconv"
	"strings"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Data is the state of the Brief editing form. Errors are keyed by form field name.
type Data struct {
	Project domain.Project
	Brief   domain.Brief
	Assets  []domain.Asset
	Errors  map[string]string
	Saved   bool
	// ReferencesText overrides the References textarea (the user's rejected input).
	ReferencesText string
}

func referencesText(d Data) string {
	if d.ReferencesText != "" {
		return d.ReferencesText
	}
	b := d.Brief
	var urls []string
	for _, r := range b.References {
		if strings.HasPrefix(r, "http://") || strings.HasPrefix(r, "https://") {
			urls = append(urls, r)
		}
	}
	return strings.Join(urls, "\n")
}

// Form confirms and edits the Creative Brief (the Brief is normally built in the chat). A value that is only a proposal
// (recommended, or read from the request) says so next to its label; saving accepts every value shown (#1114).
templ Form(d Data) {
	<form
		id="brief-form"
		class="flex flex-col gap-4"
		hx-put={ paths.Project(d.Project.ID, "brief") }
		hx-target="this"
		hx-swap="outerHTML"
	>
		for _, f := range domain.RequiredBriefFields() {
			<div>
				<label for={ "brief-" + string(f) } class="mb-1 flex items-center gap-2 text-sm">
					{ f.Label() }
					if d.Brief.Get(f) == "" && d.Brief.IsDelegated(f) {
						@atoms.Badge(atoms.BadgeNeutral, "AIに任せる")
					}
					if d.Brief.Get(f) != "" {
						@sourceBadge(d.Brief.SourceOf(f))
					}
				</label>
				@atoms.Input(atoms.FieldLg, "w-full", templ.Attributes{
					"id":    "brief-" + string(f),
					"name":  string(f),
					"type":  "text",
					"value": d.Brief.Get(f),
				})
				if msg := d.Errors[string(f)]; msg != "" {
					<p class="mt-1 text-sm text-danger" role="alert">{ msg }</p>
				}
			</div>
		}
		if d.Brief.Style != "" {
			<p class="text-sm text-mute">スタイル（Series 正本）: { d.Brief.Style }</p>
		}
		<div>
			<label for="brief-additional-instruction" class="mb-1 flex items-center gap-2 text-sm">
				Additional Instruction
				if d.Brief.AdditionalInstruction != "" {
					@sourceBadge(d.Brief.SourceOf(domain.BriefAdditionalInstruction))
				}
			</label>
			@atoms.Textarea(atoms.FieldLg, "w-full", templ.Attributes{
				"id":        "brief-additional-instruction",
				"name":      "additional_instruction",
				"rows":      "3",
				"maxlength": strconv.Itoa(domain.MaxMessageRunes),
			}, d.Brief.AdditionalInstruction)
			if msg := d.Errors["additional_instruction"]; msg != "" {
				<p class="mt-1 text-sm text-danger" role="alert">{ msg }</p>
			}
		</div>
		<div>
			<label for="brief-references" class="mb-1 block text-sm">References（URL、1行に1件）</label>
			@atoms.Textarea(atoms.FieldLg, "w-full", templ.Attributes{
				"id":   "brief-references",
				"name": "references",
				"rows": "3",
			}, referencesText(d))
			if msg := d.Errors["references"]; msg != "" {
				<p class="mt-1 text-sm text-danger" role="alert">{ msg }</p>
			}
		</div>
		if len(d.Assets) > 0 {
			<div>
				<p class="mb-1 text-sm">Assets / References（添付）</p>
				@molecules.AttachmentStrip(d.Project.ID, d.Assets)
			</div>
		}
		<div class="flex items-center gap-3">
			@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{
				"type": "submit",
			})
			if hasTentative(d.Brief) {
				<span class="text-sm text-mute">保存すると、表示中の値（推奨・未確認の値を含む）をすべて確定します</span>
			}
			if d.Saved {
				<span class="text-sm text-success" role="status">保存しました</span>
			}
		</div>
	</form>
}
