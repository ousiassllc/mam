package credentials

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/settingsui"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

const unavailableReason = "キーストアを利用できません"

// Section is the "API キー" section of the category: Panel under its title (an h3: the category's h2 is above it).
templ Section(d Data) {
	@molecules.SettingsSectionH3("API キー", "外部モデルの API キーを登録します。キーは OS のセキュアストレージに保存され、画面には設定済みかどうかだけが表示されます。保存したキーは再起動なしで次の呼び出しから使われます。") {
		@Panel(d)
	}
}

// Panel lists the providers as cards: "設定済み" / "未設定", what the key is for, and the buttons that open the modal of
// its key and delete it. The key is typed into the modal and never rendered again. A save answers with the card of its
// provider only (RowOOB); only a key store that cannot be read answers with the whole panel.
templ Panel(d Data) {
	<div id="credential-panel" class="flex flex-col gap-3">
		if d.Unavailable {
			<p class="text-sm text-amber-300" role="alert" data-testid="credential-unavailable">キーストアを利用できません。OS のキーチェーン（Secret Service など）を確認してから、画面を再読み込みしてください</p>
		}
		if d.Notice != "" {
			<p class="text-sm text-emerald-300" role="status" data-testid="credential-notice">{ d.Notice }</p>
		}
		<ul id={ ListID } role="list" class="grid grid-cols-1 gap-4 xl:grid-cols-2">
			for _, p := range d.Providers {
				@row(p, d.Unavailable, false)
			}
		</ul>
	</div>
}

// Row is the card of one provider. A delete answers with it alone (outerHTML on the card).
templ Row(p ProviderView) {
	@row(p, false, false)
}

// RowOOB is the card of one provider as the answer of a save: it replaces the card with its id out of band.
templ RowOOB(p ProviderView) {
	@row(p, false, true)
}

templ row(p ProviderView, unavailable, oob bool) {
	@settingsui.CardItem(p.card(oob, unavailable)) {
		if unavailable {
			@atoms.SmallButtonFor(atoms.ToneNeutral, openLabel(p), p.Label, templ.Attributes{"type": "button", "disabled": true, "title": unavailableReason, "data-focus-key": FocusKey(p.Provider)})
		} else if p.Configured {
			@atoms.SmallButtonFor(atoms.ToneNeutral, openLabel(p), p.Label, modal.OpenAttrs(paths.CredentialEdit(p.Provider), FocusKey(p.Provider)))
		} else {
			@atoms.SmallButtonFor(atoms.TonePrimary, openLabel(p), p.Label, modal.OpenAttrs(paths.CredentialEdit(p.Provider), FocusKey(p.Provider)))
		}
		if p.Configured && !unavailable {
			@atoms.SmallButtonFor(atoms.ToneDanger, "削除", p.Label, templ.Attributes{
				"type":       "button",
				"hx-delete":  paths.Credential(p.Provider),
				"hx-target":  "#" + RowID(p.Provider),
				"hx-swap":    "outerHTML",
				"hx-sync":    "this:drop",
				"hx-confirm": p.Label + " の API キーを削除します。よろしいですか？",
			})
		}
	}
}

func openLabel(p ProviderView) string {
	if p.Configured {
		return "変更"
	}
	return "設定"
}
