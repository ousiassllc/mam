package llmcard

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/apperr"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/errorbox"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/settingsui"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

const (
	description = "LM Studio・自分で入れた Ollama・llama.cpp server など、OpenAI 互換の API（/v1/chat/completions・/v1/models）を出すサーバーを、LLM のプロバイダー「local」として使います。API キーは要りません（サーバーが求めるときだけ入れます）。モデルは、サーバーが持っているものから「LLM の割り当て」で選びます。"
	baseURLHelp = "例: Ollama は http://localhost:11434、LM Studio は http://localhost:1234、llama.cpp server は http://localhost:8080。同じ PC か LAN・tailnet のサーバーを指定します（http も使えます。リンクローカルのアドレスは使えません）。末尾の /v1 は付けても付けなくても構いません。"
	noteText    = "今は別のサーバーを使っています。ここに書いた URL は「別のサーバー」を選んだときに使われます。"
)

// ConnectionSection is the section "別のサーバーにつなぐ": the card of the address, the key, the switch of the unload, and the save and the connection test. A save replaces it whole.
templ ConnectionSection(d Connection) {
	<ul id={ ConnectionID } role="list" class="grid grid-cols-1 gap-4" data-testid="mm-llm-connection">
		@settingsui.CardItem(d.card()) {
			if d.Note {
				<p class="text-sm text-mute" data-testid="mm-llm-connection-note">{ noteText }</p>
			}
			<form id="mm-llm-connection-form" class="flex w-full flex-col gap-3" hx-put={ paths.ModelManagerLocalLLMConnection() } hx-target={ "#" + ConnectionID } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-testid="mm-llm-connection-form">
				<div class="flex flex-col gap-1">
					<label class="text-sm text-ink" for="mm-llm-base-url">ベース URL</label>
					@atoms.Input(atoms.FieldSm, "w-full", templ.Attributes{
						"id": "mm-llm-base-url", "name": "base_url", "type": "text", "value": d.BaseURL, "placeholder": d.DefaultBaseURL,
						"autocomplete": "off", "spellcheck": "false", "disabled": d.Pinned, "data-testid": "mm-llm-base-url",
						"aria-invalid": invalid(d.Blame == "base_url"), "aria-describedby": "mm-llm-base-url-help",
					})
					<p id="mm-llm-base-url-help" class="text-sm text-mute">{ baseURLHelp }</p>
				</div>
				<div class="flex flex-col gap-1">
					<label class="text-sm text-ink" for="mm-llm-api-key">API キー（任意）</label>
					@atoms.Input(atoms.FieldSm, "w-full", templ.Attributes{
						"id": "mm-llm-api-key", "name": "api_key", "type": "password", "value": "", "placeholder": keyPlaceholder(d),
						"autocomplete": "off", "spellcheck": "false", "data-testid": "mm-llm-api-key", "aria-invalid": invalid(d.Blame == "api_key"),
					})
					if d.KeyConfigured {
						<label class="flex items-center gap-2 text-xs text-ink">
							@atoms.Choice("", templ.Attributes{"type": "checkbox", "name": "clear_key", "value": "1", "data-testid": "mm-llm-clear-key"})
							保存したキーを削除する
						</label>
					}
				</div>
				<label class="flex items-start gap-2 text-sm text-ink">
					@atoms.Choice("mt-1", templ.Attributes{"type": "checkbox", "name": "unload", "value": "1", "checked": d.Unload, "disabled": d.Pinned, "data-testid": "mm-llm-unload"})
					<span>画像・動画を作る前に、Ollama のモデルをメモリから降ろす<span class="block text-xs text-mute">ComfyUI と GPU を取り合わないためのスイッチです（Ollama の keep_alive=0）。Ollama 以外のサーバーでは何もしません。使うときは、次の LLM の呼び出しでモデルを読み込み直すため少し待ちます。</span></span>
				</label>
				if !d.Pinned {
					<input type="hidden" name="unload_present" value="1"/>
				}
				<div class="flex flex-wrap items-center gap-2">
					@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit", "data-testid": "mm-llm-save"})
					@atoms.Button(atoms.ToneNeutral, "接続テスト", templ.Attributes{
						"type": "button", "hx-post": paths.ModelManagerLocalLLMConnectionTest(), "hx-include": "#mm-llm-connection-form", "hx-target": "#" + ResultID, "hx-swap": "innerHTML",
						"hx-sync": "this:replace", "hx-disabled-elt": "this", "data-testid": "mm-llm-test",
					})
				</div>
			</form>
			<div id={ ResultID } class="w-full" aria-live="polite" data-testid="mm-llm-result"></div>
		}
	</ul>
}

// invalid is the value of aria-invalid: "true" for the field to blame, absent for the others (a bare attribute is read as false).
func invalid(yes bool) any {
	if yes {
		return "true"
	}
	return false
}

func keyPlaceholder(d Connection) string {
	switch {
	case d.KeyUnreadable:
		return "キーストアを読めません"
	case d.KeyConfigured && d.KeyHint != "":
		return "設定済み（末尾 " + d.KeyHint + "）。空欄なら変更しません"
	case d.KeyConfigured:
		return "設定済み。空欄なら変更しません"
	}
	return "空欄（キー不要のサーバー）"
}

func (d Connection) card() settingsui.Card {
	c := settingsui.Card{
		ID: "mm-llm-connection-card", TestID: "mm-llm-connection-card", Title: "別のサーバー（OpenAI 互換）", Description: description,
		Tone: atoms.BadgeNeutral, State: "プロバイダー local",
	}
	if d.KeyConfigured {
		c.Marks = []settingsui.Mark{{Tone: atoms.BadgeOK, Text: "キーあり"}}
	}
	switch {
	case d.Pinned:
		c.Summary = "起動オプション（--llm-config / MAM_LLM_CONFIG）で設定ファイルが固定されているため、ベース URL とスイッチはこの画面では変えられません。"
	case d.Problem != "":
		c.Summary = "保存済みの設定ファイルを読み込めません（表示は既定値です）: " + d.Problem
	case d.Error != "":
		c.Summary = d.Error
	case d.Notice != "":
		c.Notice = d.Notice
	}
	return c
}

// Result is the answer of a connection test: what happened, the models the server has, or the common error of the failure.
templ Result(r TestResult) {
	if r.OK {
		<div class="flex flex-col gap-1 rounded-lg border border-success/60 bg-success/10 p-3 text-sm text-ink" role="status" data-testid="mm-llm-test-ok">
			<p>{ r.Message }</p>
			if len(r.Models) > 0 {
				<ul class="list-inside list-disc text-xs text-ink" data-testid="mm-llm-models">
					for _, m := range r.Models {
						<li class="break-all">{ m }</li>
					}
				</ul>
				if r.Count > len(r.Models) {
					<p class="text-sm text-mute">ほか { strconv.Itoa(r.Count - len(r.Models)) } 件</p>
				}
			}
		</div>
	} else if r.Failure != nil {
		@errorbox.Box(errorbox.Props{View: *r.Failure, Lang: apperr.LangJa, ID: "mm-llm-test"})
	} else {
		<p class="text-sm text-danger" role="alert" data-testid="mm-llm-test-failed">{ r.Message }</p>
	}
}
