package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
)

// BranchPage is GET /projects/:id/branches and GET /branches/:id: the Branch tree in an auxiliary view.
templ BranchPage(csrfToken string, d organisms.BranchPageData) {
	@layout.AppLayout("Branch: "+d.Project.Name, csrfToken, sidenav.InProject(sidenav.Branch, d.Project)) {
		@pagehead.Main(pagehead.Wide) {
			@pagehead.Header("Branch", d.Project.Name, "")
			@organisms.BranchView(d)
		}
	}
}
