package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
)

// TakeComparisonPage is GET /shots/:id/takes: the Take comparison in an auxiliary view.
templ TakeComparisonPage(csrfToken string, d organisms.TakeComparisonData) {
	@layout.AppLayout("Take 比較: "+d.Project.Name, csrfToken, sidenav.InProject(sidenav.SceneShot, d.Project)) {
		@pagehead.Main(pagehead.Wide) {
			@pagehead.Header("Take 比較", d.Project.Name, "")
			@organisms.TakeComparison(d)
		}
	}
}
