package modelmgr

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modelcard"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/refresh"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

func itoa(n int) string { return strconv.Itoa(n) }

templ notice(m Message, id string) {
	if m.Notice != "" {
		<p class="text-sm text-success" role="status" data-testid={ id + "-notice" }>{ m.Notice }</p>
	}
	if m.Error != "" {
		<p class="text-sm text-danger" role="alert" data-testid={ id + "-error" }>{ m.Error }</p>
	}
}

// progressBar is the progress of a running install.
templ progressBar(p Progress, label string) {
	<div class="flex flex-col gap-1" role="status" aria-live="polite" data-testid="mm-progress" data-job={ p.JobID }>
		<progress class="w-full" max="100" value={ itoa(p.Percent) } aria-label={ label }></progress>
		<p class="break-words text-sm text-ink">
			{ p.Message }（{ itoa(p.Percent) }%）
			if p.Bytes != "" {
				<span class="text-mute">{ p.Bytes }</span>
			}
		</p>
	</div>
}

func stateBadge(state string) (atoms.BadgeTone, string) {
	switch state {
	case "running":
		return atoms.BadgeOK, "起動中"
	case "starting":
		return atoms.BadgeInfo, "起動しています"
	case "failed":
		return atoms.BadgeError, "起動に失敗"
	}
	return atoms.BadgeNeutral, "停止中"
}

// EngineCard is the card of the bundled ComfyUI engine: the same card as a model (modelcard.Item), with its picture, state and buttons; what the
// engine is, where it comes from and why it cannot run here is in the modal the card opens (modeldetail.EngineDetail). While an install or a start
// is in progress it polls itself; a card with buttons ends them with the refresh button (#962).
templ EngineCard(e Engine) {
	@modelcard.Item(engineCard(e)) {
		@notice(e.Message, "mm-engine")
		switch  {
			case !e.Supported, !e.Writable:
			case e.Install != nil:
				@progressBar(*e.Install, "ComfyUI の導入の進み具合")
				@modelcard.Actions() {
					@atoms.SmallButtonFor(atoms.ToneNeutral, "中断する", EngineName, templ.Attributes{
						"type": "button", "hx-post": paths.ModelManagerPart("jobs", e.Install.JobID, "cancel"), "hx-target": "#" + EngineID, "hx-swap": "outerHTML",
						"hx-sync": "this:drop", "hx-disabled-elt": "this",
						"hx-confirm": "ComfyUI の導入を中断します。ダウンロード済みの分は残り、もう一度導入すると続きから再開します。よろしいですか？",
					})
					@refresh.Bar(engineURL(e), EngineID, e.UpdatedAt)
				}
			case e.Installed && !e.Broken:
				@installedCard(e)
			default:
				<div id={ GPUID } class="relative z-raised" hx-get={ paths.ModelManagerPart("engine", "gpu") } hx-trigger="load" hx-swap="outerHTML">
					<p class="text-sm text-mute">GPU を検出しています…</p>
				</div>
		}
	}
}

templ installedCard(e Engine) {
	if e.State == "failed" && e.ProcessError != "" {
		<pre class="max-h-48 overflow-auto whitespace-pre-wrap rounded-md bg-surface p-2 text-xs text-danger" role="alert" data-testid="mm-engine-failure">{ e.ProcessError }</pre>
	}
	@modelcard.Actions() {
		if e.State == "running" || e.State == "starting" {
			@atoms.SmallButtonFor(atoms.ToneNeutral, "停止", EngineName, templ.Attributes{
				"type": "button", "hx-post": paths.ModelManagerPart("engine", "stop"), "hx-target": "#" + EngineID,
				"hx-swap": "outerHTML", "hx-sync": "this:drop", "hx-disabled-elt": "this",
			})
		} else {
			@atoms.SmallButtonFor(atoms.TonePrimary, "起動", EngineName, templ.Attributes{
				"type": "button", "hx-post": paths.ModelManagerPart("engine", "start"), "hx-target": "#" + EngineID,
				"hx-swap": "outerHTML", "hx-sync": "this:drop", "hx-disabled-elt": "this",
			})
		}
		if e.UpdateAvailable {
			<form
				class="contents"
				hx-post={ paths.ModelManagerPart("engine", "install") }
				hx-target={ "#" + EngineID }
				hx-swap="outerHTML"
				hx-sync="this:drop"
				hx-disabled-elt="find button[type=submit]"
				data-testid="mm-engine-update"
			>
				<input type="hidden" name={ FieldVariant } value={ e.Variant }/>
				if e.CPU {
					<input type="hidden" name={ FieldCPU } value="1"/>
				}
				@atoms.SmallButtonFor(atoms.TonePrimary, "更新する", EngineName, templ.Attributes{"type": "submit"})
			</form>
		}
		@atoms.SmallButtonFor(atoms.ToneNeutral, autoStartLabel(e.AutoStart), EngineName, templ.Attributes{
			"type": "button", "hx-put": paths.ModelManagerPart("engine", "autostart"), "hx-vals": atoms.HxVals(map[string]string{FieldOn: autoStartValue(!e.AutoStart)}),
			"hx-target": "#" + EngineID, "hx-swap": "outerHTML", "hx-sync": "this:drop", "hx-disabled-elt": "this",
			"aria-pressed": strconv.FormatBool(e.AutoStart), "data-testid": "mm-engine-autostart",
		})
		@atoms.SmallButtonFor(atoms.ToneDanger, "削除", EngineName, templ.Attributes{
			"type": "button", "hx-delete": paths.ModelManagerPart("engine"), "hx-target": "#" + EngineID, "hx-swap": "outerHTML",
			"hx-sync": "this:drop", "hx-disabled-elt": "this",
			"hx-confirm": "ComfyUI エンジンを削除します（導入したモデルのファイルは残ります）。よろしいですか？",
		})
		@refresh.Bar(engineURL(e), EngineID, e.UpdatedAt)
	}
}

func autoStartLabel(on bool) string {
	if on {
		return "自動起動: オン"
	}
	return "自動起動: オフ"
}

func autoStartValue(on bool) string {
	if on {
		return "1"
	}
	return "0"
}
