package audio

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/settingsui"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// DetailModal is the body of the modal of a card: what is too long for it. For the cloud provider that is what it is and where its key
// is; for the local one, where it stands and why it cannot run, the video memory it needs, the source and the license, and the limits of
// its commercial use. It only reads: choosing and saving are on the screen.
templ DetailModal(p Provider, which string) {
	if which == WhichCloud {
		@modal.Frame(p.CloudLabel, p.Description) {
			@cloudKey(p)
			@providerNote(p)
			@closeButton()
		}
	} else if p.Local != nil {
		@modal.Frame(p.LocalLabel, p.Description) {
			<div class="flex min-w-0 flex-col gap-3 text-sm text-ink" data-testid={ "audio-local-" + p.Field }>
				<p class="flex items-center gap-2">
					<span>いまの状態</span>
					@atoms.BadgeWith(p.Local.Tone, p.Local.State, templ.Attributes{"data-testid": "audio-state-badge-" + p.Field})
				</p>
				@localState(p)
				@providerNote(p)
			</div>
			@modal.Actions() {
				@atoms.ButtonLink(atoms.ToneNeutral, "モデルマネージャーを開く", templ.SafeURL(paths.ModelManagerCategory(paths.MMLocalRuntimes)), templ.Attributes{"data-testid": "audio-detail-open-manager-" + p.Field})
				@atoms.Button(atoms.TonePrimary, "閉じる", templ.Attributes{"type": "button", "data-modal-close": true, "autofocus": true})
			}
		}
	}
}

templ closeButton() {
	@modal.Actions() {
		@atoms.Button(atoms.TonePrimary, "閉じる", templ.Attributes{"type": "button", "data-modal-close": true, "autofocus": true})
	}
}

// providerNote is the line under a choice: what the choice does not change.
templ providerNote(p Provider) {
	if p.Note != "" {
		<p class="text-sm text-mute" data-testid={ "audio-note-" + p.Field }>{ p.Note }</p>
	}
}

// localState is the facts about a local provider: why it cannot be chosen on this PC, why it cannot be used now, the video memory it
// needs, where it comes from, its license and the limits of its commercial use.
templ localState(p Provider) {
	<div id={ "audio-state-" + p.Field } class="flex min-w-0 flex-col gap-2 text-xs text-mute">
		if !p.Local.Supported {
			@settingsui.Banner(atoms.IconWarning, "note", "audio-unsupported-"+p.Field, "この PC では "+p.Local.Name+" を選べません。"+p.CloudLabel+" のまま使えます。") {
				<p class="break-words text-ink" data-testid={ "audio-support-reason-" + p.Field }>{ p.Local.SupportReason }</p>
				if p.Selected == p.value() {
					<p class="break-words text-ink" data-testid={ "audio-saved-local-" + p.Field + localSuffix(p) + "-detail" }>保存済みの設定はローカルですが、この PC では動かせないため、今は使われません（保存するとクラウドに切り替わります）。</p>
				}
			}
		} else if p.Local.Reason != "" {
			@settingsui.Note(atoms.IconInfo, "status", "audio-reason-"+p.Field) {
				{ p.Local.Reason }
			}
		}
		if p.Local.ProcessError != "" {
			<pre class="max-h-40 overflow-auto whitespace-pre-wrap break-all rounded-md bg-bone p-2" data-testid={ "audio-process-error-" + p.Field }>{ p.Local.ProcessError }</pre>
		}
		if p.Local.VRAM != "" {
			<p data-testid={ "audio-vram-" + p.Field }>{ p.Local.VRAM }</p>
		}
		<p class="break-words" data-testid={ "audio-source-" + p.Field }>
			出典: <a class="break-all underline" href={ templ.SafeURL(p.Local.SourceURL) } rel="noopener noreferrer" target="_blank">{ p.Local.SourceURL }</a>
			／ ライセンス: 
			if p.Local.LicenseURL != "" {
				<a class="underline" href={ templ.SafeURL(p.Local.LicenseURL) } rel="noopener noreferrer" target="_blank">{ p.Local.License }</a>
			} else {
				{ p.Local.License }
			}
			。重みと依存ファイルの出典・ライセンスは、モデルマネージャーの一覧にあります。
		</p>
		if p.Local.Model != "" {
			<p data-testid={ "audio-model-" + p.Field }>使うモデル: { p.Local.Model }（変えるにはモデルマネージャーの「モデルの選択」）</p>
		}
		if len(p.Local.Cautions) > 0 {
			@settingsui.Banner(atoms.IconWarning, "note", "audio-cautions-"+p.Field, "使うときの制限（モデルカードより）") {
				<ul class="list-disc pl-5 text-ink">
					for _, c := range p.Local.Cautions {
						<li class="break-words">{ c }</li>
					}
				</ul>
			}
		}
		if p.Local.Condition != "" {
			@settingsui.Note(atoms.IconInfo, "note", "audio-condition-"+p.Field) {
				{ p.Local.Condition }
			}
		}
		if len(p.Local.Unclear) > 0 {
			@settingsui.Banner(atoms.IconWarning, "note", "audio-unclear-"+p.Field, "商用利用が確認できていない（不可・不明）重み・依存ファイルが "+itoa(len(p.Local.Unclear))+" 件あります") {
				<ul class="flex flex-col gap-1 text-ink" data-testid={ "audio-unclear-items-" + p.Field }>
					for _, name := range p.Local.Unclear {
						<li class="break-words">「{ name }」</li>
					}
				</ul>
				<p class="text-mute">商用の動画に使う前に、モデルマネージャーの一覧で出典とライセンスを確認してください。</p>
			}
		}
	</div>
}
