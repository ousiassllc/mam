package upscalebox

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Box is the "make it larger" box of the detail of a result: one scale and one workflow of the installed upscale models, one
// button. The result is made as a result of its own in the history; the box says where it came from when this result is itself one.
templ Box(f Form) {
	if f.Show || f.SourceURL != "" {
		<div id={ ID } class="flex flex-col gap-2 rounded-md border border-neutral-700 p-4" data-testid="gt-upscale">
			if f.SourceURL != "" {
				<p class="text-sm" data-testid="gt-upscale-source">
					<a class="underline" href={ templ.SafeURL(f.SourceURL) }>{ f.SourceText }</a>
				</p>
			}
			if f.Show {
				<h3 class="text-sm font-medium">大きくする（アップスケール）</h3>
				if f.Notice != "" {
					<p class="text-sm text-emerald-300" role="status" data-testid="gt-upscale-notice">{ f.Notice }</p>
				}
				if f.Error != "" {
					<p class="text-sm text-red-300" role="alert" data-testid="gt-upscale-error">{ f.Error }</p>
				}
				if len(f.Choices) == 0 {
					<p class="text-sm text-neutral-400" data-testid="gt-upscale-none">
						アップスケール用のモデルが入っていません。
						<a class="underline" href={ templ.SafeURL(f.ModelsURL) }>モデルマネージャー</a>で入れてください。
					</p>
				} else {
					<form
						class="flex flex-wrap items-end gap-3"
						hx-post={ paths.GenerationTestPart("results", f.ResultID, "upscale") }
						hx-target={ "#" + ID }
						hx-swap="outerHTML"
						hx-sync="this:drop"
						hx-disabled-elt="find button[type=submit]"
					>
						<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-upscale-scale">
							<span>倍率</span>
							@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": "gt-upscale-scale", "name": FieldScale}) {
								for _, n := range f.Scales {
									<option value={ itoa(n) }>{ itoa(n) }倍</option>
								}
							}
						</label>
						<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-upscale-model">
							<span>方式（モデル）</span>
							@atoms.Select(atoms.FieldMd, "max-w-md", templ.Attributes{"id": "gt-upscale-model", "name": FieldModel}) {
								for _, c := range f.Choices {
									<option value={ c.ID } disabled?={ c.Disabled != "" }>{ c.Label }（{ c.Detail }）{ c.Disabled }</option>
								}
							}
						</label>
						@atoms.Button(atoms.TonePrimary, "大きくする", templ.Attributes{"type": "submit", "data-testid": "gt-upscale-submit"})
					</form>
				}
			}
		</div>
	}
}
