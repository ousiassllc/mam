package atoms

// Icons of the four states (Lucide v1.61.0, copied as in icon.templ) and of the theme button. A state is told by an icon, a word and a
// colour together, never by the colour alone (the UI guide, C4): the toast, the connection notice and the inline alerts draw the icon of their
// state before the words. iconModel hands every name it does not know to iconStatus.

// Icons of the states and of the theme button.
const (
	IconSuccess IconName = "success"
	IconWarning IconName = "warning"
	IconDanger  IconName = "danger"
	IconInfo    IconName = "info"
	IconTheme   IconName = "theme"
)

// iconStatus draws the icons of the states and the theme button; an unknown name draws nothing.
templ iconStatus(name IconName, class string) {
	switch name {
		case IconSuccess:
			// circle-check
			@iconSVG(class) {
				<circle cx="12" cy="12" r="10"></circle>
				<path d="m9 12 2 2 4-4"></path>
			}
		case IconWarning:
			// triangle-alert
			@iconSVG(class) {
				<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
				<path d="M12 9v4"></path>
				<path d="M12 17h.01"></path>
			}
		case IconDanger:
			// circle-alert
			@iconSVG(class) {
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 8v4"></path>
				<path d="M12 16h.01"></path>
			}
		case IconInfo:
			// info
			@iconSVG(class) {
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 16v-4"></path>
				<path d="M12 8h.01"></path>
			}
		case IconTheme:
			// contrast
			@iconSVG(class) {
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 18a6 6 0 0 0 0-12v12z"></path>
			}
	}
}
