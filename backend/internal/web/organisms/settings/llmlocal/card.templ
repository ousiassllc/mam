package llmlocal

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

const description = "Ollama・LM Studio・llama.cpp server など、OpenAI 互換の API を出すサーバーを LLM のプロバイダー「local」として使うための設定です。使うサーバーの選択・llama.cpp の導入と起動・別のサーバーの URL は、モデルマネージャーでまとめて設定します。"

// Card is the card, in a list of one: the state of the server in use and the link to where it is set. The whole card is the link.
templ Card(d Data) {
	<ul role="list" class="grid grid-cols-1 gap-4">
		@molecules.ToolCardItem(d.card())
	</ul>
}

func (d Data) card() molecules.ToolCard {
	tone := atoms.BadgeNeutral
	text := d.State
	if d.Problem != "" {
		tone, text = atoms.BadgeWarn, d.State+"（"+d.Problem+"）"
	}
	return molecules.ToolCard{
		ID: "llm-local", Href: templ.SafeURL(paths.ModelManagerCategory(paths.MMLocalLLM)), Icon: atoms.IconNetwork, Title: "ローカル LLM サーバー", Description: description,
		CTA: "モデルマネージャーで設定する", TestID: "llm-local-link", ItemAttrs: templ.Attributes{"data-testid": "llm-local-card"},
		Status: []molecules.StatusLine{{Tone: tone, Text: text, Attrs: templ.Attributes{"data-testid": "llm-local-state"}}},
	}
}
