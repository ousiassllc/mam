package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/help"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/modelmgr"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ModelManagerPage is GET /model-manager: the bundled ComfyUI engine, the local image and video models to install,
// and the trial generations. It belongs to no Project.
templ ModelManagerPage(csrfToken string, d modelmgr.Data) {
	@layout.AppLayout("モデルマネージャー", csrfToken) {
		<main class="mx-auto flex max-w-4xl flex-col gap-8 p-8">
			<div>
				@atoms.BackLink(paths.Home(), "← プロジェクト一覧に戻る")
				<div class="mt-3">
					@help.Row(help.ID("モデルマネージャー"), "モデルマネージャー", modelManagerLead()) {
						<h1 class="text-xl font-semibold">モデルマネージャー</h1>
					}
				</div>
			</div>
			@modelmgr.Body(d)
		</main>
	}
}

// modelManagerLead is what the screen is for, behind the "?" beside its title.
templ modelManagerLead() {
	<p>
		ローカルの画像・動画モデルを導入して、すぐに試し生成できます。すべてのプロジェクトで共通です（接続先の登録は
		<a class="underline" href={ templ.SafeURL(paths.Settings()) }>設定</a>）。
	</p>
}
