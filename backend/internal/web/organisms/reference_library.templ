package organisms

import (
	"strings"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ReferenceLibraryData is the state of the Reference Library view (reference_library_page).
type ReferenceLibraryData struct {
	Project domain.Project
	// Q, Kind and Tag are the filter that produced Items, as the search form shows them.
	Q, Kind, Tag string
	Items        []domain.ReferenceItem
}

func referenceURL(projectID, id string) string {
	return paths.Project(projectID, "references", id)
}

func sourceLabel(s domain.ReferenceSource) string {
	if s == domain.SourceGenerated {
		return "AI 生成"
	}
	return "アップロード"
}

// ReferenceLibrary lists the reference images of the Project with a search form and the upload form
// (F-11, spec/spec.md §10.1). Searching swaps the whole view; every action answers with it.
templ ReferenceLibrary(d ReferenceLibraryData) {
	<div id="reference-library" class="flex flex-col gap-6">
		<form
			class="flex flex-wrap items-end gap-2"
			hx-get={ paths.Project(d.Project.ID, "references") }
			hx-target="#reference-library"
			hx-swap="outerHTML"
		>
			<div>
				<label for="ref-q" class="mb-1 block text-xs text-neutral-400">名前・タグ</label>
				@atoms.Input(atoms.FieldMd, "", templ.Attributes{
					"id":    "ref-q",
					"name":  "q",
					"type":  "search",
					"value": d.Q,
				})
			</div>
			<div>
				<label for="ref-kind" class="mb-1 block text-xs text-neutral-400">種別</label>
				@atoms.Select(atoms.FieldMd, "", templ.Attributes{
					"id":   "ref-kind",
					"name": "kind",
				}) {
					<option value="">すべて</option>
					for _, k := range domain.LibraryKinds() {
						<option value={ string(k) } selected?={ string(k) == d.Kind }>{ k.Label() }</option>
					}
				}
			</div>
			<div>
				<label for="ref-tag" class="mb-1 block text-xs text-neutral-400">タグ（完全一致）</label>
				@atoms.Input(atoms.FieldMd, "", templ.Attributes{
					"id":    "ref-tag",
					"name":  "tag",
					"type":  "text",
					"value": d.Tag,
				})
			</div>
			@atoms.Button(atoms.ToneNeutral, "検索", templ.Attributes{"type": "submit"})
		</form>
		if len(d.Items) == 0 {
			<p class="text-sm text-neutral-400">該当する参照画像はありません。</p>
		} else {
			<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				for _, it := range d.Items {
					<li class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3">
						<img
							src={ paths.Project(d.Project.ID, "assets", it.AssetID) }
							alt={ it.Name }
							loading="lazy"
							class="aspect-video w-full rounded object-contain bg-neutral-900"
						/>
						<div class="flex items-center gap-2">
							@atoms.Badge(atoms.BadgeNeutral, it.Kind.Label())
							<span class="text-sm font-medium">{ it.Name }</span>
						</div>
						<p class="text-xs text-neutral-400">
							{ sourceLabel(it.Source) }
							if len(it.Tags) > 0 {
								· { strings.Join(it.Tags, " / ") }
							}
						</p>
						<div>
							@atoms.Button(atoms.ToneDanger, "ライブラリから外す", templ.Attributes{
								"hx-delete":  referenceURL(d.Project.ID, it.ID),
								"hx-target":  "#reference-library",
								"hx-swap":    "outerHTML",
								"hx-confirm": "ライブラリから外しますか？（画像と、Shot に付いた参照は残ります）",
							})
						</div>
					</li>
				}
			</ul>
		}
		<form class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3" hx-post={ paths.Project(d.Project.ID, "references") } hx-encoding="multipart/form-data" hx-target="#reference-library" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
			<h2 class="text-sm font-semibold">参照画像を登録</h2>
			<div class="grid gap-2 sm:grid-cols-2">
				<div>
					<label for="ref-file" class="mb-1 block text-xs text-neutral-400">画像（jpg / png / webp / gif、20MB まで）</label>
					<input id="ref-file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required class="w-full text-sm"/>
				</div>
				<div>
					<label for="ref-new-kind" class="mb-1 block text-xs text-neutral-400">種別</label>
					@atoms.Select(atoms.FieldMd, "w-full", templ.Attributes{
						"id":       "ref-new-kind",
						"name":     "kind",
						"required": true,
					}) {
						for _, k := range domain.LibraryKinds() {
							<option value={ string(k) }>{ k.Label() }</option>
						}
					}
				</div>
				<div>
					<label for="ref-new-name" class="mb-1 block text-xs text-neutral-400">名前（100 文字以内。Character / Product / Location は登場する名前と揃える）</label>
					@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
						"id":        "ref-new-name",
						"name":      "name",
						"type":      "text",
						"required":  true,
						"maxlength": intText(domain.MaxReferenceNameRunes),
					})
				</div>
				<div>
					<label for="ref-new-tags" class="mb-1 block text-xs text-neutral-400">タグ（カンマ区切り、10 個まで）</label>
					@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
						"id":   "ref-new-tags",
						"name": "tags",
						"type": "text",
					})
				</div>
			</div>
			<div>
				@atoms.Button(atoms.TonePrimary, "登録", templ.Attributes{"type": "submit"})
			</div>
		</form>
	</div>
}
