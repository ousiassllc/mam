package audio

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Section is the category: one form with, for the voice and for the lip sync, a heading over the cards of its providers (the cloud one
// and the local one, one chosen), the fallback to the cloud and the save. The answer of a save replaces it by PanelID. What is too long
// for a card (the source, the license, the limits of the commercial use) is in its detail, a modal (detail.templ).
templ Section(d Data) {
	<div id={ PanelID } class="flex flex-col gap-4" data-testid="audio-panel">
		if d.Problem != "" {
			<p class="text-sm text-danger" role="alert" data-testid="audio-problem">{ d.Problem }</p>
		} else {
			if d.Notice != "" {
				<p class="text-sm text-success" role="status" data-testid="audio-notice">{ d.Notice }</p>
			}
			if d.Error != "" {
				<p class="text-sm text-danger" role="alert" data-testid="audio-error">{ d.Error }</p>
			}
			<form class="flex flex-col gap-4" hx-put={ paths.AudioSettings() } hx-target={ "#" + PanelID } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-testid="audio-form">
				@choice(d.Voice)
				@choice(d.LipSync)
				<label class="flex items-start gap-2 text-sm" data-testid="audio-fallback">
					@atoms.Choice("mt-1", templ.Attributes{"type": "checkbox", "name": FieldFallback, "value": "1", "checked": d.Fallback, "data-testid": "audio-fallback-input"})
					<span>
						ローカルが使えないときは、クラウドに切り替える（API 費用が出ます）
						<span class="block text-xs text-mute">実行を始める前の検査で、ローカルが使えない（この PC で動かせない・導入されていない・重みが無い・参照音声が無い話者がいる）と分かったときだけ、その実行の全体をクラウドで作ります。実行の途中で切り替えることはなく、切り替えたときはチャットに書きます。オフのときは、理由を出して止まります（クラウドの費用は出ません）。</span>
					</span>
				</label>
				<div>
					@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit", "data-testid": "audio-save"})
				</div>
			</form>
		}
	</div>
}

// choice is one choice: its heading (what it is for is behind the "?") over the cards of its providers, in two columns like the
// cards of the API keys.
templ choice(p Provider) {
	@molecules.SettingsSectionH3(p.Title, p.Description) {
		<ul role="list" class="grid grid-cols-1 gap-4 xl:grid-cols-2" data-testid={ "audio-" + p.Field }>
			@cloudCard(p)
			if p.Local != nil {
				@localCard(p)
			}
			if p.Irodori != nil {
				@localCard(p.As(WhichIrodori))
			}
		</ul>
		if p.CloneNotice != "" {
			<p class="mt-3 rounded-md border border-warning/60 bg-warning/10 p-3 text-sm text-warning" role="note" data-testid={ "audio-clone-notice-" + p.Field }>{ p.CloneNotice }</p>
		}
	}
}
