package audio

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/settingsui"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// chosenClass is the look of the card whose radio is on: the frame turns to the colour of the chosen ones. The choice is also said in
// words by the radio's own label ("選択中"), never by the colour alone.
const chosenClass = "has-[:checked]:border-accent"

// commercialMark is on a local provider that has a condition or a weight whose commercial use is not clear, whatever the card shows.
const commercialMark = "商用注意"

func cardID(p Provider, which string) string { return p.ID + "-" + which }

// cloudCard is the card of the cloud provider: its name, what it costs, whether its API key is stored and the radio that chooses it.
templ cloudCard(p Provider) {
	@settingsui.CardItem(cloudCardOf(p)) {
		@chooser(p, p.CloudValue, p.CloudLabel, cloudChecked(p), false, "audio-"+p.Field+"-cloud")
		@atoms.SmallButtonFor(atoms.ToneNeutral, "詳細", p.CloudLabel, detailAttrs(p, WhichCloud))
		if !p.CloudKeySet {
			@atoms.SmallButtonLinkFor(atoms.TonePrimary, "API キーを設定", p.CloudLabel, templ.SafeURL(paths.SettingsCategory(paths.SettingsAPIKeys)), nil)
		}
	}
}

func cloudCardOf(p Provider) settingsui.Card {
	c := settingsui.Card{
		ID: cardID(p, WhichCloud), TestID: "audio-card", TitleLevel: 4, Title: p.CloudLabel,
		Attrs:       templ.Attributes{"data-field": p.Field, "data-which": WhichCloud},
		Description: "クラウドで作ります。API 費用が出ます。", Class: chosenClass, Details: cloudKey(p),
	}
	if p.CloudKeySet {
		c.Tone, c.State = atoms.BadgeOK, "API キー設定済み"
	} else {
		c.Tone, c.State = atoms.BadgeWarn, "API キー未設定"
	}
	return c
}

// cloudKey is whether the API key of the cloud provider is stored, and where to store it.
templ cloudKey(p Provider) {
	<p class="break-words text-sm text-mute" data-testid={ "audio-key-" + p.Field }>
		if p.CloudKeySet {
			API キー（{ p.CloudKey }）: 設定済み
		} else {
			API キー（{ p.CloudKey }）: 未設定。
			<a class="underline" href={ templ.SafeURL(paths.SettingsCategory(paths.SettingsAPIKeys)) }>「API キーとログイン」で登録してください</a>
		}
	</p>
}

// localCard is the card of the local provider: its name, where it stands (the badge), the "商用注意" mark when its commercial use has a
// condition, the radio that chooses it (disabled when this PC cannot run it) and the way to the model manager.
templ localCard(p Provider) {
	@settingsui.CardItem(localCardOf(p)) {
		@chooser(p, p.value(), p.LocalLabel, p.ChosenLocal(), !p.Local.Supported, "audio-"+p.Field+"-"+p.slug())
		@atoms.SmallButtonFor(atoms.ToneNeutral, "詳細", p.LocalLabel, detailAttrs(p, p.slug()))
		@atoms.SmallButtonLinkFor(atoms.ToneNeutral, "モデルマネージャーを開く", p.LocalLabel, templ.SafeURL(paths.ModelManagerCategory(paths.MMLocalRuntimes)), templ.Attributes{"data-testid": "audio-open-manager-" + p.Field + localSuffix(p)})
	}
}

func localCardOf(p Provider) settingsui.Card {
	c := settingsui.Card{
		ID: cardID(p, p.slug()), TestID: "audio-card", TitleLevel: 4, Title: p.LocalLabel,
		Attrs:       templ.Attributes{"data-field": p.Field, "data-which": p.slug()},
		Description: "この PC で作ります。API 費用は出ません。", Class: chosenClass, Tone: p.Local.Tone, State: p.Local.State, Details: localBrief(p),
	}
	if p.Local.NeedsCommercialNote() {
		c.Marks = []settingsui.Mark{{Tone: atoms.BadgeWarn, Text: commercialMark}}
	}
	return c
}

// localBrief is the one line a card says of a local provider that is chosen but cannot run here; the rest is in its detail.
templ localBrief(p Provider) {
	if p.Selected == p.value() && !p.Local.Supported {
		<p class="break-words text-sm text-warning" role="status" data-testid={ "audio-saved-local-" + p.Field + localSuffix(p) }>保存済みの設定はローカルですが、この PC では動かせないため、今は使われません（保存するとクラウドに切り替わります）。</p>
	}
	if len(p.Local.Unclear) > 0 {
		<p class="break-words text-sm text-warning" data-testid={ "audio-unclear-line-" + p.Field + localSuffix(p) }>商用利用が確認できていない（不可・不明）重み・依存ファイルが { itoa(len(p.Local.Unclear)) } 件あります（詳細を見てください）。</p>
	}
}

// chooser is the radio of a card, drawn as a button that says "選ぶ" and, once it is on, "選択中" (the card's frame glows with it). A
// radio that cannot be chosen (the local provider this PC cannot run) says so.
templ chooser(p Provider, value, title string, checked, disabled bool, testID string) {
	<label class="group relative inline-flex cursor-pointer items-center has-[:disabled]:cursor-not-allowed">
		@atoms.Choice("peer sr-only", templ.Attributes{"type": "radio", "name": p.Field, "value": value, "checked": checked, "disabled": disabled, "data-testid": testID})
		<span class="inline-flex items-center gap-1 rounded-md border border-border px-3 py-1 text-xs text-ink transition-colors hover:border-mute peer-checked:border-accent peer-checked:bg-accent-soft peer-focus-visible:focus-ring peer-disabled:pointer-events-none peer-disabled:opacity-60 motion-reduce:transition-none">
			<span class="sr-only">{ title }を</span>
			if disabled {
				<span>選べません</span>
			} else {
				<span class="group-has-[:checked]:hidden">選ぶ</span>
				<span class="hidden group-has-[:checked]:inline">✓ 選択中</span>
			}
		</span>
	</label>
}

// detailAttrs open the detail of a card.
func detailAttrs(p Provider, which string) templ.Attributes {
	a := modal.OpenAttrs(paths.AudioDetail(p.Slug, which), "audio-detail-"+p.Slug+"-"+which)
	a["data-testid"] = "audio-detail-" + p.Field + "-" + which
	return a
}
