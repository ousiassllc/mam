package credentials

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// TestResultID is the status line that the "接続テスト" fills.
const TestResultID = "credential-test-result"

// Modal is the body of the modal that sets the API key of a provider: what the key is for, where to get one, the key's
// password field, a "接続テスト" when the provider has a free read-only call, and the buttons. The key is sent once; the
// field is never filled in, not even after a refusal.
templ Modal(f Form, maxKeyBytes int) {
	@modal.Frame(f.Provider.Label+" の API キー", f.Provider.Purpose) {
		if f.Error != "" {
			@modal.Error(f.Error)
		}
		<p class="text-sm text-neutral-400">
			キーは OS のセキュアストレージに保存され、画面には設定済みかどうかだけが出ます。
			if f.Provider.Configured {
				空のまま保存すると、保存済みのキーのままです。
			}
		</p>
		if f.Provider.KeyURL != "" {
			<p class="text-sm">
				<a class="text-indigo-300 underline" href={ templ.SafeURL(f.Provider.KeyURL) } target="_blank" rel="noopener noreferrer" data-testid="credential-key-link">{ f.Provider.Label } のキーを取得するページ（外部サイト・新しいタブで開きます）</a>
			</p>
		}
		<form
			class="flex flex-col gap-3"
			hx-put={ paths.Credential(f.Provider.Provider) }
			hx-target={ "#" + modal.BodyID }
			hx-swap="innerHTML"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type=submit]"
			autocomplete="off"
		>
			<label class="flex flex-col gap-1 text-sm" for={ "api-key-" + f.Provider.Provider }>
				<span class="font-medium">API キー</span>
				@atoms.Input(atoms.FieldMd, "w-full", keyAttrs(f, maxKeyBytes))
			</label>
			<p id={ TestResultID } role="status" class="min-h-5 text-sm text-neutral-300" data-testid="credential-test-result"></p>
			@modal.Actions() {
				if f.Provider.CanTest && !f.Unavailable {
					@atoms.Button(atoms.ToneNeutral, "接続テスト", templ.Attributes{
						"type":            "button",
						"hx-post":         paths.CredentialTest(f.Provider.Provider),
						"hx-target":       "#" + TestResultID,
						"hx-swap":         "innerHTML",
						"hx-sync":         "this:drop",
						"hx-disabled-elt": "this",
						"data-testid":     "credential-test",
					})
				} else if !f.Provider.CanTest {
					<p class="mr-auto text-xs text-neutral-400" data-testid="credential-no-test">接続テストはありません。保存したあと、最初の生成で確かめられます。</p>
				}
				@modal.Cancel("キャンセル")
				if f.Unavailable {
					@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit", "disabled": true, "title": unavailableReason})
				} else {
					@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
				}
			}
		</form>
	}
}

// keyAttrs are the attributes of the key field: a password field that the browser does not remember, refilled never.
func keyAttrs(f Form, maxKeyBytes int) templ.Attributes {
	a := templ.Attributes{
		"id":           "api-key-" + f.Provider.Provider,
		"name":         "api_key",
		"type":         "password",
		"autocomplete": "off",
		"maxlength":    strconv.Itoa(maxKeyBytes),
		"placeholder":  keyPlaceholder(f.Provider.Configured),
		"autofocus":    true,
		"spellcheck":   "false",
	}
	if f.Error != "" {
		a["aria-invalid"] = "true"
		a["aria-describedby"] = modal.ErrorID
	}
	return a
}

func keyPlaceholder(configured bool) string {
	if configured {
		return "新しいキーで置き換える"
	}
	return "API キーを貼り付け"
}

// TestResult is the line "接続テスト" fills: what the provider answered to the key. It is a status, not an alert: a
// rejected key is an answer, not a failure of the screen.
templ TestResult(tone atoms.BadgeTone, text string) {
	@atoms.Badge(tone, text)
}
