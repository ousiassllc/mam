{
 "id": "txt2img-krea2-turbo",
 "label": "Krea 2 Turbo（fp8）: テキストから画像",
 "media": "image",
 "description": "ComfyUI 標準ノードだけの Krea 2 Turbo 系（蒸留で 8 ステップ・cfg 1 で描く。Qwen3-VL 4B のテキストエンコーダーと Qwen-Image の VAE を使う）のワークフロー。Comfy 公式のテンプレート image_krea2_turbo_t2i（Comfy-Org/workflow_templates）のサブグラフに従い、UNETLoader → KSampler（8 ステップ・cfg 1・euler/simple）、否定のプロンプトは持たず（肯定の条件を ConditioningZeroOut で 0 にしたものを否定に使う）、テキストエンコーダーは CLIPLoader の type krea2。拡散モデルの名前は使うモデルに合わせて変える。同梱の ComfyUI（v0.42.1）が Krea 2 を持つことはソースで確認した。GPU では未実行（構造のテストのみ）。",
 "model": {
  "media": "image",
  "workflow": {
   "prompt_weight": "unsupported",
   "assignments": [
    {"param": "prompt", "node": "6", "input": "text"},
    {"param": "seed", "node": "3", "input": "seed"},
    {"param": "width", "node": "5", "input": "width"},
    {"param": "height", "node": "5", "input": "height"},
    {"param": "steps", "node": "3", "input": "steps"},
    {"param": "cfg", "node": "3", "input": "cfg"},
    {"param": "sampler", "node": "3", "input": "sampler_name"},
    {"param": "scheduler", "node": "3", "input": "scheduler"}
   ],
   "graph": {
    "10": {"class_type": "UNETLoader", "inputs": {"unet_name": "lustifyNSFWCheckpoint_v10Krea2.safetensors", "weight_dtype": "default"}},
    "11": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default"}},
    "12": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["11", 0]}},
    "13": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["6", 0]}},
    "5": {"class_type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 8, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "denoise": 1, "model": ["10", 0], "positive": ["6", 0], "negative": ["13", 0], "latent_image": ["5", 0]}},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["12", 0]}},
    "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "mam/image", "images": ["8", 0]}}
   },
   "output_node": "9"
  }
 }
}
