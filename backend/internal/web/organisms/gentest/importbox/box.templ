package importbox

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ID is the DOM id of the import form.
const ID = "gt-import"

// MaxNameLen is the longest name of an imported reference image (the form's maxlength; the service checks the same).
const MaxNameLen = domain.MaxReferenceNameRunes

func itoa(n int) string { return strconv.Itoa(n) }

// Project is a Project a result can be imported into.
type Project struct{ ID, Name string }

// Form is the form that imports a result into a Project.
type Form struct {
	// Notice and Error are the green and the red line of the form.
	Notice, Error string
	ResultID      string
	Image         bool
	Projects      []Project
	// Done says the import was made: the form shows the outcome instead of the fields.
	Done string
}

// Box imports the result into a Project as a Reference Library image or an asset and, for an image, optionally assigns it
// to a slot of a Character, Product or Location. Any succeeded result can be imported; the favorite mark is only a hint.
templ Box(f Form) {
	<form
		id={ ID }
		class="flex flex-col gap-3 rounded-md border border-border p-4"
		hx-post={ paths.GenerationTestPart("results", f.ResultID, "import") }
		hx-target={ "#" + ID }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		data-testid="gt-import"
	>
		<h3 class="text-sm font-semibold">プロジェクトに取り込む</h3>
		if f.Notice != "" {
			<p class="text-sm text-success" role="status" data-testid="gt-import-notice">{ f.Notice }</p>
		}
		if f.Error != "" {
			<p class="text-sm text-danger" role="alert" data-testid="gt-import-error">{ f.Error }</p>
		}
		if f.Done != "" {
			<p class="text-sm text-success" data-testid="gt-import-done">{ f.Done }</p>
		}
		<div class="flex flex-wrap items-end gap-3">
			<label class="flex flex-col gap-1 text-xs text-mute" for="gt-import-project">
				<span>プロジェクト</span>
				@atoms.Select(atoms.FieldMd, "max-w-xs", templ.Attributes{"id": "gt-import-project", "name": "project_id", "required": true}) {
					for _, p := range f.Projects {
						<option value={ p.ID }>{ p.Name }</option>
					}
				}
			</label>
			<label class="flex flex-col gap-1 text-xs text-mute" for="gt-import-as">
				<span>取り込み先</span>
				@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": "gt-import-as", "name": "as"}) {
					if f.Image {
						<option value="reference">参照画像（Reference Library）</option>
					}
					<option value="asset">アセット</option>
				}
			</label>
		</div>
		if f.Image {
			<div class="flex flex-wrap items-end gap-3">
				<label class="flex flex-col gap-1 text-xs text-mute" for="gt-import-kind">
					<span>参照の種類（参照画像のとき）</span>
					@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": "gt-import-kind", "name": "kind"}) {
						<option value="character">キャラクター</option>
						<option value="product">プロダクト</option>
						<option value="location">ロケーション</option>
						<option value="style">スタイル</option>
						<option value="lighting">ライティング</option>
					}
				</label>
				<label class="flex flex-col gap-1 text-xs text-mute" for="gt-import-name">
					<span>名前（参照画像のとき）</span>
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{"id": "gt-import-name", "name": "name", "type": "text", "maxlength": itoa(MaxNameLen)})
				</label>
				<label class="flex flex-col gap-1 text-xs text-mute" for="gt-import-tags">
					<span>タグ（カンマ区切り）</span>
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{"id": "gt-import-tags", "name": "tags", "type": "text"})
				</label>
			</div>
			<fieldset class="flex flex-wrap items-end gap-3 text-xs text-mute">
				<legend class="mb-1">続けてスロットに割り当てる（省略可。種類が合うものだけ。LOCK されたスロットは変えられません）</legend>
				<label class="flex flex-col gap-1" for="gt-assign-target">
					<span>対象</span>
					@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": "gt-assign-target", "name": "assign_target"}) {
						<option value="">割り当てない</option>
						<option value="character">キャラクター</option>
						<option value="product">プロダクト</option>
						<option value="location">ロケーション</option>
					}
				</label>
				<label class="flex flex-col gap-1" for="gt-assign-id">
					<span>対象の ID</span>
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{"id": "gt-assign-id", "name": "assign_id", "type": "text"})
				</label>
				<label class="flex flex-col gap-1" for="gt-assign-slot">
					<span>スロット（face・body など）</span>
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{"id": "gt-assign-slot", "name": "assign_slot", "type": "text"})
				</label>
			</fieldset>
		}
		@atoms.Button(atoms.TonePrimary, "取り込む", templ.Attributes{"type": "submit", "data-testid": "gt-import-submit"})
	</form>
}
