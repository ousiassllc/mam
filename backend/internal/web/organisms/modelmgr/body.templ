package modelmgr

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modelpick"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Body is the screen without the page frame: the engine, the models, the trial generations, the Hugging Face token
// and the external ComfyUI, one section each (molecules.SettingsSection). engineHelp (data.go) is the help of the engine section.
templ Body(d Data) {
	<div id="model-manager-body" class="flex flex-col gap-8" data-testid="model-manager">
		@molecules.SettingsSection("ComfyUI エンジン", engineHelp) {
			<ul role="list" class="grid grid-cols-1 gap-4 lg:grid-cols-2">
				@EngineCard(d.Engine)
			</ul>
			<div class="flex flex-col gap-2">
				@atoms.Button(atoms.ToneNeutral, "すでに動いている ComfyUI を検出", templ.Attributes{
					"type": "button", "hx-post": paths.ModelManagerPart("engine", "detect"), "hx-target": "#" + DetectID, "hx-swap": "outerHTML",
					"hx-sync": "this:drop", "hx-disabled-elt": "this", "data-testid": "mm-detect-button",
				})
				<div id={ DetectID }></div>
			</div>
		}
		if d.Runtimes != nil {
			@molecules.SettingsSection("ローカル音声・口パク", "声（GPT-SoVITS）と口パク（MuseTalk）をこの PC で作る実行環境を、mam が取得して起動・停止します。インストーラーには含まれず、ここから導入します。カードをタップすると、重みと依存ファイルの出典・ライセンス・ファイル一覧・SHA-256 が見られます。実行環境は mam とは別のプログラムで、公式の配布先から実行時に取得し、SHA-256 を確かめてから使います。「自動起動」をオンにすると、mam の起動時に自動で起動します（オフのときは、最初に使うときに起動）。アンインストールすると、導入先も一緒に消えます。この PC で使えないときは、クラウド（ElevenLabs・Sync Labs）を選べます。") {
				@d.Runtimes
			}
		}
		if d.Nodes != nil {
			@molecules.SettingsSection("追加ノード", "ControlNet の画像前処理や IP-Adapter など、ComfyUI に機能を足すプログラム（カスタムノード）です。mam が確認して固定したものだけが、ここから導入でき、読み込まれます。それ以外のフォルダは読み込みません。導入の前に、注意事項とライセンスへの同意が要ります。カードをタップすると、固定したコミット・SHA-256・ライセンス・商用利用の可否・必要な Python パッケージ・ソースの確認結果が見られます。導入と削除のときは、動いている ComfyUI を一度止めて再起動します。") {
				@d.Nodes
			}
		}
		@molecules.SettingsSection("モデル", "導入すると、画像・動画のモデルとして選べます（設定の「画像・動画モデル」・Shot の生成）。カードをタップすると、出典・ライセンス・ファイル一覧・SHA-256 が見られます。ダウンロードは取得元から直接で、SHA-256 を確かめます。ライセンスの同意が要るモデルは、同意してから導入します。導入先の空きが足りないときや、GPU のメモリが足りない見込みのときは、カードにそう出ます。成人向けモデル（非検閲のモデル・LoRA）は、18 歳以上の確認と注意書きへの同意の後に、一覧・導入・試し生成に出ます。") {
			@AdultCard(d.Adult)
			@CommercialCard(d.Commercial)
			<div id={ DialogID } data-testid="mm-dialog"></div>
			@modelpick.Bar(d.Catalog.Filter)
			@CatalogList(d.Catalog)
		}
		@molecules.SettingsSection("試し生成", "導入したモデル（登録済みの外部の ComfyUI のモデルも）で、プロジェクトの外で 1 枚・1 本だけ試します。") {
			@TrialSection(d.Trial)
		}
		@molecules.SettingsSection("Hugging Face から導入", "Hugging Face のモデルファイル（.safetensors）を、URL・owner/repo・キーワードから探して導入します。コミットに固定し、LFS の SHA-256 とサイズを確かめます。GGUF は一覧に出しますが導入できません。pickle 形式（.ckpt・.pt など）は導入しません。") {
			@HFImportSection(d.HFImport)
		}
		@molecules.SettingsSection("Hugging Face のトークン（任意）", "ログインや同意が必要なモデル（LTX-2.5 など）を取得するときだけ使います。") {
			@HFCard(d.HF)
		}
		@molecules.SettingsSection("外部の ComfyUI", "別のマシン（tailnet を含む）や ComfyUI Desktop など、mam が起動していない ComfyUI にあるモデルを確かめます。") {
			@ExternalCard(d.External)
		}
		@modal.Host()
	</div>
}
