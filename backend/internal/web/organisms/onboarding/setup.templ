package onboarding

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/chatgpt"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/credentials"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/llm"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/media"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// StatusID is the id of the line that says whether an API key or a ChatGPT login is set.
const StatusID = "onboarding-credentials-status"

// CredentialsStatus is what the first setup step knows about the credentials.
type CredentialsStatus struct {
	Tone atoms.BadgeTone
	Text string
}

// CredentialsBody is the step "API キーまたは ChatGPT ログイン": the state line over the same cards the settings screen's
// "API キーとログイン" category has (the keys go to the OS key store through the same routes). login is nil when the
// ChatGPT sign-in is not there.
templ CredentialsBody(status CredentialsStatus, keys credentials.Data, login *chatgpt.Data) {
	<p class="text-sm text-neutral-300">
		生成には、外部モデルの API キーか、ChatGPT のログインのどちらか 1 つ（最低 1 つ）が要ります。使うものを入れてください。入れた値は設定画面と同じ場所に保存され、キーは OS のセキュアストレージに入ります。
	</p>
	@CredentialsStatusLine(status)
	@credentials.Section(keys)
	@chatgpt.SectionIf(login)
}

// CredentialsStatusLine is the state line. It reads itself again when a modal closes (a key saved, a login that ended) and
// when any request that is not a GET ends on the page (an API key deleted, a ChatGPT sign-out: they close no modal). Its own
// reload is a GET, so it does not trigger itself again (htmx:afterSettle from:body would).
templ CredentialsStatusLine(s CredentialsStatus) {
	<p
		id={ StatusID }
		role="status"
		class="flex items-center gap-2 rounded-md border border-neutral-800 px-3 py-2 text-sm"
		hx-get={ paths.OnboardingCredentialsStatus() }
		hx-trigger="modal-close from:body, htmx:afterRequest[detail.requestConfig.verb!='get'] from:body"
		hx-swap="outerHTML"
		data-testid="onboarding-credentials-status"
	>
		@atoms.Badge(s.Tone, s.Text)
	</p>
}

// ModelsBody is the step "モデルの割り当て": optional, the defaults work. The two assignments of the settings screen are
// folded in, each in its own <details>, with the same tables and modals.
templ ModelsBody(text llm.Data, images media.Data) {
	<p class="text-sm text-neutral-300">
		既定の割り当てのままでも進めます。変えたいときだけ開いてください。たとえば ChatGPT のログインだけで使うときは、テキスト生成のプロバイダーに「chatgpt-subscription」を選ぶと、そのログインが使われます。
	</p>
	<p class="text-xs text-neutral-400">保存した内容は、設定画面と同じく、テキスト生成は llm.json、画像・動画は models.json に書かれます。</p>
	<details class="rounded-md border border-neutral-800 px-3 py-2" data-testid="onboarding-llm">
		<summary class="cursor-pointer text-sm font-medium">テキスト生成（LLM）の割り当て</summary>
		<div class="mt-3">
			@llm.Section(text)
		</div>
	</details>
	<details class="rounded-md border border-neutral-800 px-3 py-2" data-testid="onboarding-media">
		<summary class="cursor-pointer text-sm font-medium">画像・動画モデルの割り当て</summary>
		<div class="mt-3">
			@media.Section(images)
		</div>
	</details>
}

// OS is the operating system the text of a step is for. It mirrors service/onboarding.OS (organisms do not import the
// service layer); the handler maps one to the other (viewOS).
type OS string

// The systems with their own text.
const (
	OSWindows OS = "windows"
	OSMac     OS = "macos"
	OSOther   OS = "other"
)

// FFmpeg is where ffmpeg and ffprobe were found; an empty path is a tool that was not found.
type FFmpeg struct {
	OS      OS
	FFmpeg  string
	FFprobe string
}

// Found is whether both tools are there.
func (f FFmpeg) Found() bool { return f.FFmpeg != "" && f.FFprobe != "" }

// FFmpegBody is the step "ffmpeg": where it was found, or how to install it on this operating system.
templ FFmpegBody(f FFmpeg) {
	<p class="text-sm text-neutral-300">
		ffmpeg と ffprobe は、品質判定（Judge）・Take のプレビュー・部分採用で使います。無くても mam は起動しますが、これらは使えなくなります。mam を起動した環境の PATH から探します。
	</p>
	if f.Found() {
		<div class="flex flex-col gap-1 rounded-md border border-emerald-500/60 px-3 py-2" role="status" data-testid="onboarding-ffmpeg-found">
			<p class="text-sm">
				@atoms.Badge(atoms.BadgeOK, "見つかりました")
				<span class="ml-2">ffmpeg と ffprobe が PATH にあります。</span>
			</p>
			<p class="text-xs text-neutral-400">ffmpeg: <code class={ codeClass }>{ f.FFmpeg }</code></p>
			<p class="text-xs text-neutral-400">ffprobe: <code class={ codeClass }>{ f.FFprobe }</code></p>
			<p class="text-xs text-neutral-400">mam を起動したあとに入れたときは、mam を再起動すると反映されます（ffmpeg は起動時に探します）。</p>
		</div>
	} else {
		<div class="flex flex-col gap-3 rounded-md border border-amber-500/60 px-3 py-2" role="status" data-testid="onboarding-ffmpeg-missing">
			<p class="text-sm">
				@atoms.Badge(atoms.BadgeWarn, "見つかりません")
				<span class="ml-2">{ missingText(f) }</span>
			</p>
			@installGuide(f.OS)
			<p class="text-sm text-neutral-300">入れたあとは、mam を一度終了して、起動し直してください（ffmpeg は起動時に探します）。</p>
			<p><a href={ templ.SafeURL(paths.OnboardingStep(paths.OnboardingFFmpeg)) } class={ linkClass } data-testid="onboarding-ffmpeg-recheck">もう一度確認する</a></p>
		</div>
	}
}

func missingText(f FFmpeg) string {
	switch {
	case f.FFmpeg == "" && f.FFprobe == "":
		return "ffmpeg も ffprobe も見つかりません。"
	case f.FFmpeg == "":
		return "ffmpeg が見つかりません（ffprobe は見つかりました）。"
	}
	return "ffprobe が見つかりません（ffmpeg は見つかりました）。"
}

// installGuide is how to install ffmpeg: winget on Windows, Homebrew on macOS, and a general line elsewhere.
templ installGuide(os OS) {
	switch os {
		case OSWindows:
			<div class="flex flex-col gap-1" data-testid="onboarding-ffmpeg-windows">
				<p class="text-sm text-neutral-300">Windows では、PowerShell（またはコマンドプロンプト）で次のコマンドを実行します（winget は Windows 11 と、最近の Windows 10 に入っています）。</p>
				<p><code class={ codeClass }>winget install Gyan.FFmpeg</code></p>
			</div>
		case OSMac:
			<div class="flex flex-col gap-1" data-testid="onboarding-ffmpeg-macos">
				<p class="text-sm text-neutral-300">Mac では、ターミナルで Homebrew を使って次のコマンドを実行します（ffprobe も一緒に入ります）。Homebrew が無いときは、先に <a class={ linkClass } href="https://brew.sh" target="_blank" rel="noopener noreferrer">brew.sh</a> の手順で入れてください。</p>
				<p><code class={ codeClass }>brew install ffmpeg</code></p>
				<p class="text-xs text-neutral-400">入れたのに見つからないときは、mam を動かしている環境の PATH に Homebrew の場所（Apple Silicon では /opt/homebrew/bin）が入っていない可能性があります。</p>
			</div>
		default:
			<div class="flex flex-col gap-1" data-testid="onboarding-ffmpeg-other">
				<p class="text-sm text-neutral-300">お使いのパッケージマネージャーで、ffmpeg（ffprobe を含みます）を入れてください。</p>
			</div>
	}
}

// Mac is the macOS step: the codex path (when the ChatGPT sign-in is there) and the pointer to Comfy Desktop.
type Mac struct {
	// Codex is whether the ChatGPT sign-in, and so the codex path, is there.
	Codex bool
	// CodexPath is the path set now ("" for none).
	CodexPath string
}

// The place the steps send the reader to put the Comfy Desktop address in (the settings screen).
const comfyDesktopDocs = "https://docs.comfy.org/installation/desktop/macos"

// CodexResultID is the id of the sentence that tells what a save of the codex path did.
const CodexResultID = "onboarding-codex-result"

// MacBody is the step "Mac の準備": where codex is, and that ComfyUI is an external one (Comfy Desktop) whose address goes
// into "ローカル・代替モデル". mam bundles no ComfyUI.
templ MacBody(m Mac) {
	if m.Codex {
		<section class="flex flex-col gap-2 rounded-md border border-neutral-800 px-4 py-3" aria-labelledby="onboarding-codex-title" data-testid="onboarding-codex">
			<h3 id="onboarding-codex-title" class="text-base font-semibold">Codex の場所（任意）</h3>
			<p class="text-sm text-neutral-300">ChatGPT の組織のアカウントを Codex 経由で使うとき、自分で入れた codex の実行ファイルの場所を指定します。ターミナルで <code class={ codeClass }>which codex</code> を実行すると分かります。使わないなら飛ばしてください。</p>
			<form class="flex flex-wrap items-center gap-2" hx-put={ paths.OnboardingCodexPath() } hx-target={ "#" + CodexResultID } hx-swap="innerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
				<label class="text-xs text-neutral-400" for="onboarding-codex-path">codex のパス</label>
				@atoms.Input(atoms.FieldSm, "min-w-64 flex-1", templ.Attributes{"id": "onboarding-codex-path", "name": "path", "type": "text", "value": m.CodexPath, "placeholder": "/opt/homebrew/bin/codex", "data-testid": "onboarding-codex-path"})
				@atoms.SmallButtonFor(atoms.ToneNeutral, "パスを設定", "Codex のパス", templ.Attributes{"type": "submit", "data-testid": "onboarding-codex-path-set"})
			</form>
			<p id={ CodexResultID } class="text-sm"></p>
		</section>
	}
	<section class="flex flex-col gap-2 rounded-md border border-neutral-800 px-4 py-3" aria-labelledby="onboarding-comfy-title" data-testid="onboarding-comfy">
		<h3 id="onboarding-comfy-title" class="text-base font-semibold">ComfyUI は外部のものを使います</h3>
		<p class="text-sm text-neutral-300">
			mam は ComfyUI を同梱しません。ローカルで画像・動画を作りたいときは、公式の <strong>Comfy Desktop</strong>（macOS 13 以降・Apple Silicon）を入れて、その接続先の URL を mam に入れます。Comfy Desktop は、.dmg から入れるだけで、Python と MPS の設定まで自動で行います。
		</p>
		<ol role="list" class="list-decimal pl-6 text-sm text-neutral-300">
			<li>
				<a class={ linkClass } href={ templ.SafeURL(comfyDesktopDocs) } target="_blank" rel="noopener noreferrer">公式の手順（Comfy Desktop for macOS）</a> で入れて、起動します。
			</li>
			<li>Comfy Desktop の接続先の URL を確かめます（たいていは <code class={ codeClass }>http://127.0.0.1:8000</code>）。</li>
			<li>
				mam の「設定」→
				<a class={ linkClass } href={ templ.SafeURL(paths.LocalModels()) } data-testid="onboarding-local-models-link">ローカル・代替モデル</a>
				で接続先を追加します。種類は ComfyUI、URL は 2 で確かめた値です。
			</li>
		</ol>
		<p class="text-xs text-neutral-400">これは今すぐでなくても構いません。ガイドを閉じたあとでも、設定画面から入れられます。</p>
	</section>
}

// CodexResult is the sentence under the codex path field: what the save did.
templ CodexResult(ok bool, message string) {
	if ok {
		<span role="status" class="text-emerald-300" data-testid="onboarding-codex-result">{ message }</span>
	} else {
		<span role="alert" class="text-red-300" data-testid="onboarding-codex-result">{ message }</span>
	}
}
