package organisms

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// SeriesViewData is the state of the Series page (series_page): the canon and the Episodes.
type SeriesViewData struct {
	Series   domain.Series
	Canon    domain.SeriesCanon
	Versions []domain.SeriesVersion
	Episodes []domain.Project
	// Templates are the Brand Templates a new Episode can start from.
	Templates []domain.BrandTemplate
}

var seriesFieldLabels = map[string]string{
	"hairstyle": "髪型 (hairstyle)", "wardrobe": "衣装 (wardrobe)", "voice": "声 (voice)", "personality": "性格 (personality)",
}

func seriesCharacterValues(c domain.WorldCharacter) map[string]string {
	return map[string]string{"hairstyle": c.Hairstyle, "wardrobe": c.Wardrobe, "voice": c.Voice, "personality": c.Personality}
}

func episodeLabel(p domain.Project) string {
	return "第" + strconv.Itoa(p.EpisodeNumber) + "話"
}

// SeriesView shows a Series: its canonical Style, Characters, Products and Locations (Characters
// and the Style are editable; the edits never reach an existing Episode), the Episodes with a form
// to start the next one, and the history of the canon.
templ SeriesView(d SeriesViewData) {
	<div id="series-view" class="flex flex-col gap-6">
		<p class="text-xs text-neutral-400">
			Series 正本 バージョン { strconv.Itoa(d.Series.Version) }。正本を更新しても、すでに作成した Episode には反映されません（次の Episode から適用されます）。
		</p>
		<section aria-label="Style" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Style</h2>
			<form class="flex flex-wrap items-end gap-2" hx-put={ paths.Series(d.Series.ID, "style") } hx-target="#series-view" hx-swap="outerHTML">
				<label class="flex min-w-64 flex-1 flex-col gap-1 text-xs text-neutral-400" for="series-style">
					スタイル（絵柄・色調・質感など）
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{
						"id":        "series-style",
						"name":      "style",
						"type":      "text",
						"value":     d.Series.Style,
						"maxlength": intText(domain.MaxStyleRunes),
					})
				</label>
				@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
			</form>
			if d.Series.StyleReferenceAssetID != "" {
				<p class="text-xs text-neutral-400">Style の参照画像を Episode の Reference Library に引き継ぎます。</p>
			}
		</section>
		<section aria-label="Characters" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Characters</h2>
			if len(d.Canon.Characters) == 0 {
				<p class="text-sm text-neutral-400">登録された Character はありません。</p>
			}
			for _, c := range d.Canon.Characters {
				<form
					class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3"
					hx-put={ paths.Series(d.Series.ID, "characters", c.ID) }
					hx-target="#series-view"
					hx-swap="outerHTML"
				>
					<p class="text-sm font-medium">{ c.Name }</p>
					<div class="grid gap-2 sm:grid-cols-2">
						for _, name := range domain.SeriesCharacterFields() {
							<label class="flex flex-col gap-1 text-xs text-neutral-400" for={ "series-" + c.ID + "-" + name }>
								{ seriesFieldLabels[name] }
								@atoms.Input(atoms.FieldMd, "", templ.Attributes{
									"id":        "series-" + c.ID + "-" + name,
									"name":      name,
									"type":      "text",
									"value":     seriesCharacterValues(c)[name],
									"maxlength": intText(domain.MaxWorldValueRunes),
								})
							</label>
						}
					</div>
					<div>
						@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
					</div>
				</form>
			}
		</section>
		<section aria-label="Products and Locations" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Products / Locations</h2>
			<ul class="flex flex-col gap-1 text-sm">
				for _, p := range d.Canon.Products {
					<li>Product: { p.Name }</li>
				}
				for _, l := range d.Canon.Locations {
					<li>Location: { l.Name }</li>
				}
			</ul>
		</section>
		<section aria-label="Notes" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Notes</h2>
			<a class="text-sm text-indigo-300 underline" href={ templ.SafeURL(paths.Series(d.Series.ID, "notes")) }>Series の制作メモを開く（Episode 開始時に Project へコピーされます）</a>
		</section>
		<section aria-label="Episodes" class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-neutral-200">Episodes</h2>
			<ul class="flex flex-col gap-1 text-sm">
				for _, p := range d.Episodes {
					<li>
						<a class="text-indigo-300 underline" href={ templ.SafeURL(paths.Project(p.ID)) }>{ episodeLabel(p) }: { p.Name }</a>
					</li>
				}
			</ul>
			<form class="flex flex-wrap items-end gap-2" hx-post={ paths.Series(d.Series.ID, "episodes") }>
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="series-previous-episode">
					前の話（最終 World State を開始状態にする）
					@atoms.Select(atoms.FieldMd, "", templ.Attributes{
						"id":   "series-previous-episode",
						"name": "previous_episode_id",
					}) {
						<option value="">（引き継がない）</option>
						for _, p := range d.Episodes {
							<option value={ p.ID }>{ episodeLabel(p) }</option>
						}
					}
				</label>
				@BrandTemplateSelect("series-brand-template", d.Templates)
				@atoms.Button(atoms.TonePrimary, "次の Episode を作成", templ.Attributes{"type": "submit"})
			</form>
		</section>
		<section aria-label="History" class="flex flex-col gap-1">
			<h2 class="text-sm font-semibold text-neutral-200">正本の更新履歴</h2>
			<ul class="text-xs text-neutral-400">
				for _, v := range d.Versions {
					<li>バージョン { strconv.Itoa(v.Number) } · { v.CreatedAt.Local().Format("2006-01-02 15:04") }</li>
				}
			</ul>
		</section>
	</div>
}

// SeriesMembership is on the World State page: the Series the Project belongs to, or the form
// that makes a Series of it (its Characters, Products and Locations become the canon).
templ SeriesMembership(p domain.Project) {
	<section aria-label="Series" class="mb-6 flex flex-col gap-2 rounded-md border border-neutral-700 p-3">
		<h2 class="text-sm font-semibold text-neutral-200">Series</h2>
		if p.SeriesID != "" {
			<a class="text-sm text-indigo-300 underline" href={ templ.SafeURL(paths.Series(p.SeriesID)) }>Series の正本と Episode を開く（この Project は第{ strconv.Itoa(p.EpisodeNumber) }話）</a>
		} else {
			<form class="flex flex-wrap items-end gap-2" hx-post={ paths.SeriesList() }>
				<input type="hidden" name="from_project_id" value={ p.ID }/>
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="series-name">
					Series 名（この Project の Character / Product / Location を正本として登録します）
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{
						"id":          "series-name",
						"name":        "name",
						"type":        "text",
						"maxlength":   intText(domain.MaxSeriesNameRunes),
						"placeholder": p.Name,
					})
				</label>
				@atoms.Button(atoms.ToneNeutral, "Series にする", templ.Attributes{"type": "submit"})
			</form>
		}
	</section>
}
