package gentesttier

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ExposedPicker is where the "画面に出す値" of a model's ComfyUI workflow are chosen (Issue #977): the nodes' inputs of its graph, each with a box to tick, the
// name the screen shows and, for a number, the range. What is saved shows in the detail tier as fields of their own. It is no graph editor: the graph is changed
// in the node screen, and only which of its inputs the form offers is chosen here.
templ ExposedPicker(d PickerData) {
	<section id={ PickerID } class="flex flex-col gap-4 rounded-md border border-border p-4" aria-labelledby="gt-picker-title" data-testid="gt-exposed-picker">
		<h2 id="gt-picker-title" class="text-sm font-semibold text-ink">画面に出す値を選ぶ</h2>
		<p class="text-sm text-ink">モデル（ComfyUI のワークフロー）のノードの入力を選ぶと、保存した入力が、こだわりの詳細設定に入力欄として出ます。生成のたびにその値がグラフに入り、結果に残ります。グラフそのものを変えるときは、ノード画面を使います。</p>
		if d.Notice != "" {
			<p class="text-sm text-success" role="status" data-testid="gt-picker-notice">{ d.Notice }</p>
		}
		if d.Err != "" {
			<p class="text-sm text-warning" role="alert" data-testid="gt-picker-error">{ d.Err }</p>
		}
		if len(d.Models) == 0 {
			<p class="text-sm text-mute" data-testid="gt-picker-nomodel">選べるモデルがありません。モデルマネージャーでモデルを導入するか、ワークフローを取り込んでください。</p>
		} else {
			<nav aria-label="モデル" data-testid="gt-picker-models">
				<ul class="flex flex-wrap gap-2 text-sm">
					for _, m := range d.Models {
						<li>
							if m.Selected {
								<span class="rounded-md bg-accent-soft px-3 py-1.5 text-ink" aria-current="page">{ m.Label }（{ strconv.Itoa(m.Exposed) } 件）</span>
							} else {
								<a class={ tabClass } href={ templ.SafeURL(ExposedPickerHref(m.ID)) }>{ m.Label }（{ strconv.Itoa(m.Exposed) } 件）</a>
							}
						</li>
					}
				</ul>
			</nav>
		}
		if d.Model != "" {
			@pickerForm(d)
		}
	</section>
}

templ pickerForm(d PickerData) {
	<form class="flex flex-col gap-3" hx-post={ paths.GenerationTestPart("comfy", "exposed") } hx-target={ "#" + PickerID } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-testid="gt-picker-form">
		<input type="hidden" name={ FieldPickModel } value={ d.Model }/>
		<h3 class="text-sm font-semibold text-ink">{ d.ModelLabel } の入力</h3>
		if len(d.Choosable()) == 0 {
			<p class="text-sm text-mute">このグラフに、画面に出せる入力（ほかのノードがつないでいない数値・文字・選択肢）がありません。</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full min-w-[40rem] text-left text-xs text-ink" data-testid="gt-picker-table">
					<caption class="sr-only">画面に出せる入力</caption>
					<thead>
						<tr class="text-mute">
							<th scope="col" class="py-1 pr-2">出す</th>
							<th scope="col" class="py-1 pr-2">ノード・入力</th>
							<th scope="col" class="py-1 pr-2">今の値</th>
							<th scope="col" class="py-1 pr-2">型</th>
							<th scope="col" class="py-1 pr-2">画面での名前</th>
							<th scope="col" class="py-1">範囲・選択肢</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range d.Choosable() {
							@pickerRow(r, d.Editable)
						}
					</tbody>
				</table>
			</div>
		}
		if d.Editable {
			<div class="flex flex-wrap items-center gap-3">
				@atoms.Button(atoms.TonePrimary, "保存する", templ.Attributes{"type": "submit", "data-testid": "gt-picker-save"})
				<span class="text-xs text-mute">チェックを外して保存すると、その入力は画面から消えます（グラフの値は元のまま）</span>
			</div>
		} else {
			<p class="text-sm text-warning" data-testid="gt-picker-readonly">このモデルの設定は、ここでは変えられません（設定ファイルが固定されています）。</p>
		}
		if len(d.Others()) > 0 {
			<details class="text-xs text-mute" data-testid="gt-picker-others">
				<summary class="cursor-pointer">選べない入力（{ strconv.Itoa(len(d.Others())) } 件）と、その理由</summary>
				<ul class="mt-2 flex flex-col gap-0.5">
					for _, r := range d.Others() {
						<li><span class="text-ink">{ r.Node } { r.Class }.{ r.Input }</span>: { r.Reason }</li>
					}
				</ul>
			</details>
		}
	</form>
}

templ pickerRow(r PickerRow, editable bool) {
	<tr class="border-t border-border" data-testid="gt-picker-row">
		<td class="py-1.5 pr-2">
			@atoms.Choice("", templ.Attributes{
				"type": "checkbox", "name": FieldPickRow, "value": r.Key, "checked": r.Chosen, "disabled": !editable, "aria-label": r.Class + "." + r.Input + "（ノード " + r.Node + "）を画面に出す",
			})
		</td>
		<th scope="row" class="py-1.5 pr-2 font-normal text-ink">{ r.Class }.{ r.Input } <span class="text-mute">ノード { r.Node }</span></th>
		<td class="py-1.5 pr-2 break-all">{ r.Value }</td>
		<td class="py-1.5 pr-2">{ r.Type }</td>
		<td class="py-1.5 pr-2">
			@atoms.Input(atoms.FieldSm, "w-44", templ.Attributes{"name": FieldPickLabel + r.Key, "type": "text", "maxlength": itoa(MaxPickLabel), "value": r.Label, "disabled": !editable, "aria-label": r.Key + " の画面での名前"})
		</td>
		<td class="py-1.5">
			if r.Type == "int" || r.Type == "float" {
				<span class="flex items-center gap-1">
					@atoms.Input(atoms.FieldSm, "w-20", templ.Attributes{"name": FieldPickMin + r.Key, "type": "number", "step": "any", "value": r.Min, "disabled": !editable, "aria-label": r.Key + " の下限"})
					〜
					@atoms.Input(atoms.FieldSm, "w-20", templ.Attributes{"name": FieldPickMax + r.Key, "type": "number", "step": "any", "value": r.Max, "disabled": !editable, "aria-label": r.Key + " の上限"})
				</span>
			} else if r.Options != "" {
				<span class="break-all">{ r.Options }</span>
			} else {
				<span class="text-mute">文字（4000 文字まで）</span>
			}
		</td>
	</tr>
}
