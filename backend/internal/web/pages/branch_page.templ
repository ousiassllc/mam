package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
)

// BranchPage is GET /projects/:id/branches and GET /branches/:id: the Branch tree in an auxiliary view.
templ BranchPage(csrfToken string, d organisms.BranchPageData) {
	@layout.AppLayout("Branch: "+d.Project.Name, csrfToken) {
		<main class="mx-auto max-w-5xl p-8">
			@atoms.ChatBackLink(d.Project.ID)
			<h1 class="mb-1 mt-3 text-xl font-semibold">Branch</h1>
			<p class="mb-6 text-sm text-neutral-400">{ d.Project.Name }</p>
			@organisms.BranchView(d)
		</main>
	}
}
