package notelist

import (
	"slices"
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Data is the state of the note list (notes_page): the notes of a Project or of a Series.
type Data struct {
	// BasePath is the notes resource of the scope: /projects/:id/notes or /series/:id/notes.
	BasePath string
	// Series is true for the canonical notes of a Series (no promotion to the World State).
	Series bool
	Notes  []domain.NoteView
	// Only is the note an action answers about ("" for the whole list). Every other note the page has (OnPage)
	// comes as an empty placeholder that htmx replaces with the note already on the page (hx-preserve), so
	// the text typed into the form of another note survives the action (#694). The groups are still drawn
	// from the server, so the note acted on lands in the group it now belongs to.
	Only string
	// OnPage is the ids of the notes the page shows, sent with the action (OnPageField).
	OnPage []string
}

// OnPageField is the name of the hidden field of each note that tells the server the page has it.
const OnPageField = "on-page"

// noteGroup is a heading of the list with its notes.
type noteGroup struct {
	Title string
	Notes []domain.NoteView
}

// groupNotes splits the active notes into the pinned ones and one group per category (in category
// order); archived notes are returned apart.
func groupNotes(notes []domain.NoteView) (groups []noteGroup, archived []domain.NoteView) {
	var pinned []domain.NoteView
	byCategory := map[domain.NoteCategory][]domain.NoteView{}
	for _, n := range notes {
		switch {
		case n.Archived():
			archived = append(archived, n)
		case n.Pinned:
			pinned = append(pinned, n)
		default:
			byCategory[n.Category] = append(byCategory[n.Category], n)
		}
	}
	if len(pinned) > 0 {
		groups = append(groups, noteGroup{Title: "ピン留め", Notes: pinned})
	}
	for _, c := range domain.NoteCategories() {
		if len(byCategory[c]) > 0 {
			groups = append(groups, noteGroup{Title: c.Label(), Notes: byCategory[c]})
		}
	}
	return groups, archived
}

// View is the notes screen body: the form that adds a note above the list of the notes. The list
// (#note-list) is the part every response replaces; the form is outside it, so an action on one note
// never discards the text typed in the form (Created is the one response that carries a fresh form).
templ View(d Data) {
	<div id="note-view" class="flex flex-col gap-6">
		@noteAddForm(d, false)
		@Groups(d)
	</div>
}

// Created answers the creation of a note: the list with the notes the page has as placeholders (d.OnPage)
// and the new one in full (#742), and the form emptied out of band.
templ Created(d Data) {
	@Groups(d)
	@noteAddForm(d, true)
}

// noteAddForm is the form that adds a note; oob makes it replace the one on the page.
templ noteAddForm(d Data, oob bool) {
	<form
		id="note-add-form"
		class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3"
		hx-post={ d.BasePath }
		hx-target="#note-list"
		hx-swap="outerHTML"
		hx-include={ "#note-list input[name='" + OnPageField + "']" }
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		if oob {
			hx-swap-oob="true"
		}
	>
		<h2 class="text-sm font-semibold">メモを追加</h2>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="note-new-title">
			タイトル（空なら本文の先頭行）
			@atoms.Input(atoms.FieldMd, "", templ.Attributes{
				"id":        "note-new-title",
				"name":      "title",
				"type":      "text",
				"maxlength": strconv.Itoa(domain.MaxNoteTitleRunes),
			})
		</label>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="note-new-content">
			本文
			@atoms.Textarea(atoms.FieldMd, "", templ.Attributes{
				"id":        "note-new-content",
				"name":      "content",
				"rows":      "4",
				"maxlength": strconv.Itoa(domain.MaxNoteContentRunes),
				"required":  true,
			}, "")
		</label>
		<div class="flex flex-wrap items-end gap-3">
			<label class="flex flex-col gap-1 text-xs text-neutral-400" for="note-new-category">
				カテゴリ
				@atoms.Select(atoms.FieldMd, "", templ.Attributes{
					"id":   "note-new-category",
					"name": "category",
				}) {
					<option value="">AI に分類させる</option>
					for _, c := range domain.NoteCategories() {
						<option value={ string(c) }>{ c.Label() }</option>
					}
				}
			</label>
			<label class="flex items-center gap-1 text-sm">
				<input type="hidden" name="pinned" value="false"/>
				@atoms.Choice("", templ.Attributes{
					"type":  "checkbox",
					"name":  "pinned",
					"value": "true",
				})
				ピン留め
			</label>
			@atoms.Button(atoms.TonePrimary, "追加", templ.Attributes{"type": "submit"})
		</div>
	</form>
}

// Groups lists the notes by pin and category, the archived notes apart, and, per note, the version
// history (version_history_panel) whose restore buttons answer with this list. With d.Only set, the
// notes other than that one are placeholders (see Data.Only).
templ Groups(d Data) {
	{{ groups, archived := groupNotes(d.Notes) }}
	<div id="note-list" class="flex flex-col gap-6" hx-include={ "#note-list input[name='" + OnPageField + "']" }>
		if len(groups) == 0 {
			<p class="text-sm text-neutral-400">メモはまだありません。チャットで「覚えておいて」と伝えても追加できます。</p>
		}
		for _, g := range groups {
			<section aria-label={ g.Title } class="flex flex-col gap-2">
				<h2 class="text-sm font-semibold text-neutral-200">{ g.Title }</h2>
				for _, n := range g.Notes {
					@noteWithHistory(d, n)
				}
			</section>
		}
		if len(archived) > 0 {
			<details class="flex flex-col gap-2">
				<summary class="cursor-pointer text-sm font-semibold text-neutral-300">{ "アーカイブ済み (" + strconv.Itoa(len(archived)) + ")" }</summary>
				<div class="mt-2 flex flex-col gap-2">
					for _, n := range archived {
						@noteWithHistory(d, n)
					}
				</div>
			</details>
		}
	</div>
}

// keeps reports whether n is drawn as the placeholder of the note already on the page: the page said it
// has n and an action did not name n (Only; the creation of a note names none, its note is not on the
// page). A note the page does not have (added elsewhere since) is drawn in full, or it would stay an
// empty placeholder no element replaces (#697).
func (d Data) keeps(n domain.NoteView) bool {
	return d.Only != n.ID && slices.Contains(d.OnPage, n.ID)
}

// noteWithHistory is a note card with the version history under it, or the placeholder of the note the
// page already has (see Data.Only).
templ noteWithHistory(d Data, n domain.NoteView) {
	if d.keeps(n) {
		<div id={ "note-item-" + n.ID } hx-preserve></div>
	} else {
		@noteItem(n)
	}
}

// noteItem carries the id of its note in a hidden field: the actions on any note include the fields of
// the list (hx-include of #note-list), which tells the server which notes the page has.
templ noteItem(n domain.NoteView) {
	<div id={ "note-item-" + n.ID } class="flex flex-col gap-2">
		<input type="hidden" name={ OnPageField } value={ n.ID }/>
		@molecules.NoteCard(n)
		<details class="pl-3 text-sm">
			<summary class="cursor-pointer text-xs text-neutral-400">バージョン履歴</summary>
			<div class="mt-2">
				@organisms.VersionHistoryPanel(organisms.VersionHistoryData{
					DOMID: "note-history-" + n.ID, Title: "メモのバージョン", BasePath: paths.Note(n.ID),
					Target: "#note-list", Entries: n.Versions,
				})
			</div>
		</details>
	</div>
}
