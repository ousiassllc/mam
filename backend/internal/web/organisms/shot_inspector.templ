package organisms

import (
	"fmt"
	"strings"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ShotInspectorData is the state of the Shot Inspector (GET /shots/:id).
type ShotInspectorData struct {
	Project domain.Project
	Scene   domain.Scene
	Shot    domain.Shot
	Spec    *domain.ShotSpec // nil until a spec exists
	Takes   []domain.Take
	Locks   domain.ParameterLocks
	// Pack is the Reference Pack of the Shot; Library the Reference Library images that can be added to it.
	Pack    []domain.Reference
	Library []domain.ReferenceItem
	// SpecText is the spec as the edit form shows it; SpecError is why a manual edit was rejected.
	SpecText  string
	SpecError string
	// Versions are the saved versions of the spec, newest first (F-28).
	Versions []domain.VersionEntry
	// Judged is the latest Judge result of each Take that was judged, by Take ID.
	Judged map[string]domain.JudgeResult
}

// generationModel is the model the next Take is made with: the one LOCKed for the Shot, otherwise
// the one of its latest Take, otherwise the Orchestrator's choice.
func (d ShotInspectorData) generationModel() string {
	if m := d.Locks.Text(domain.ParamVideoModel); m != "" && d.Locks.Mode(domain.ParamVideoModel) != domain.LockAuto {
		return m
	}
	if n := len(d.Takes); n > 0 && d.Takes[n-1].ModelName != "" {
		return d.Takes[n-1].ModelName
	}
	return "自動選択（生成時に決定）"
}

// judgeSummary is the one line of a Take's latest Judge result: the verdict and confidence.
func judgeSummary(r domain.JudgeResult) (atoms.BadgeTone, string) {
	label := fmt.Sprintf("Judge: %s（確信度 %.0f%%）", r.Result, r.OverallConfidence*100)
	if r.Result == domain.JudgePass {
		return atoms.BadgeOK, label
	}
	return atoms.BadgeError, label
}

// issueLine is one Issue of a Judge result as the Take List shows it.
func issueLine(is domain.JudgeIssue) string {
	var b strings.Builder
	if is.LockViolation {
		b.WriteString("LOCK 違反 / ")
	}
	b.WriteString(string(is.Severity) + " / " + is.Type)
	if is.TimeRange != "" {
		b.WriteString(" / " + is.TimeRange)
	}
	if is.Description != "" {
		b.WriteString(": " + is.Description)
	}
	return b.String()
}

func shotURL(id string) string { return "/shots/" + id }

// LockToggleFor is the AUTO / MANUAL / LOCK switch of a parameter of the Shot.
func LockToggleFor(shotID string, p domain.LockParameter, locks domain.ParameterLocks) atoms.LockToggleData {
	d := atoms.LockToggleData{DOMID: "lock-" + shotID + "-" + string(p), URL: shotURL(shotID) + "/locks", Parameter: p, Mode: locks.Mode(p)}
	if p == domain.ParamVideoModel {
		d.Models, d.Model = domain.VideoModels(), locks.Text(p)
	}
	return d
}

// ProjectLockToggle is the AUTO / MANUAL / LOCK switch of Story or Music.
func ProjectLockToggle(projectID string, p domain.LockParameter, locks domain.ParameterLocks) atoms.LockToggleData {
	return atoms.LockToggleData{DOMID: "lock-" + projectID + "-" + string(p), URL: paths.Project(projectID, "locks"), Parameter: p, Mode: locks.Mode(p)}
}

// specRows lists the parts of the Canonical Shot Spec as label / value rows.
func specRows(s domain.ShotSpec) [][2]string {
	rows := [][2]string{{"Objective", s.ShotObjective}, {"Duration", s.Duration}}
	if c := s.Character; c != nil {
		rows = append(rows, [2]string{"Character", joinNonEmpty(c.ID, "identity: "+c.Identity, "wardrobe: "+c.Wardrobe, "hair: "+c.Hair)})
	}
	if p := s.Product; p != nil {
		rows = append(rows, [2]string{"Product", joinNonEmpty(p.ID, "geometry: "+p.Geometry, "label: "+p.Label, "orientation: "+p.Orientation)})
	}
	if l := s.Location; l != nil {
		rows = append(rows, [2]string{"Location", joinNonEmpty(l.ID, l.Time, l.Weather)})
	}
	for _, b := range s.Acting {
		rows = append(rows, [2]string{"Acting " + b.Time, b.Action})
	}
	rows = append(rows,
		[2]string{"Camera", joinNonEmpty(s.Camera.Lens, s.Camera.Framing, s.Camera.Movement)},
		[2]string{"Lighting", joinNonEmpty(s.Lighting.Inherit, s.Lighting.KeyDirection, s.Lighting.Mood)},
		[2]string{"Continuity", fmt.Sprintf("start_from_previous_final_state: %t", s.Continuity.StartFromPreviousFinalState)},
	)
	if len(s.Constraints) > 0 {
		rows = append(rows, [2]string{"Constraints", strings.Join(s.Constraints, ", ")})
	}
	return rows
}

func joinNonEmpty(parts ...string) string {
	var out []string
	for _, p := range parts {
		if !strings.HasSuffix(p, ": ") && strings.TrimSpace(p) != "" {
			out = append(out, p)
		}
	}
	return strings.Join(out, " / ")
}

// ShotInspector is the Inspector of one Shot (F-05, F-06): its Canonical Shot Spec, the Take list and
// the AUTO / MANUAL / LOCK switch of every parameter, plus the forms to edit the spec by hand and to
// give a natural language direction. HTMX swaps the whole inspector.
templ ShotInspector(d ShotInspectorData) {
	<div id="shot-inspector" class="flex flex-col gap-6">
		<header>
			<h2 class="text-lg font-semibold">{ fmt.Sprintf("Scene %d / Shot %d", d.Scene.OrderIndex+1, d.Shot.OrderIndex+1) }</h2>
			<p class="mt-1 text-sm">{ d.Shot.Objective }</p>
			<p class="text-sm text-neutral-400">
				{ domain.FormatDuration(d.Shot.Duration) }
				· { string(d.Shot.State) }
				· MODE { strings.ToUpper(string(d.Project.Mode)) }
			</p>
			<a href={ templ.SafeURL(paths.Project(d.Project.ID, "branches")) } class="mt-1 inline-block text-xs text-neutral-400 underline hover:text-neutral-100">Branch を作る</a>
		</header>
		<section aria-label="AUTO / MANUAL / LOCK" class="flex flex-col gap-2">
			<h3 class="text-sm font-semibold">Locks</h3>
			<p class="text-xs text-neutral-400">AUTO は AI が決定、MANUAL はあなたの指定、LOCK は現在値を固定して AI の変更を禁止します。</p>
			for _, p := range domain.ShotLockParameters() {
				@atoms.LockToggle(LockToggleFor(d.Shot.ID, p, d.Locks))
			}
		</section>
		<section aria-label="Canonical Shot Spec" class="flex flex-col gap-2">
			<h3 class="text-sm font-semibold">Canonical Shot Spec</h3>
			if d.Spec == nil {
				<p class="text-sm text-neutral-400">Shot Spec はまだありません。生成を始めると AI が作成します。</p>
			} else {
				<dl class="grid gap-x-4 gap-y-1 text-sm md:grid-cols-[10rem_1fr]">
					for _, r := range specRows(*d.Spec) {
						<dt class="text-xs text-neutral-400">{ r[0] }</dt>
						<dd>{ r[1] }</dd>
					}
				</dl>
			}
			<form hx-put={ shotURL(d.Shot.ID) + "/shot-spec" } hx-target="#shot-inspector" hx-swap="outerHTML" class="flex flex-col gap-2">
				<label for="shot-spec-text" class="text-xs text-neutral-400">Shot Spec を直接編集（JSON。英語で記述。LOCK 中の項目は変更できません）</label>
				@atoms.Textarea(atoms.FieldSm, "font-mono", templ.Attributes{
					"id":   "shot-spec-text",
					"name": "shot_spec",
					"rows": "12",
				}, d.SpecText)
				if d.SpecError != "" {
					<p class="text-sm text-red-300" role="alert">{ d.SpecError }</p>
				}
				<div>
					@atoms.Button(atoms.TonePrimary, "Shot Spec を保存", templ.Attributes{"type": "submit"})
				</div>
			</form>
		</section>
		<section aria-label="Reference Pack" class="flex flex-col gap-2">
			<h3 class="text-sm font-semibold">Reference Pack</h3>
			if len(d.Pack) == 0 {
				<p class="text-sm text-neutral-400">Reference Pack はまだありません。</p>
			} else {
				<ul class="flex flex-col gap-1 text-sm">
					for _, r := range d.Pack {
						<li class="flex items-center gap-2">
							@atoms.Badge(atoms.BadgeNeutral, r.Kind.Label())
							<span>{ r.Name }</span>
							if r.LibraryItem != "" {
								<span class="text-xs text-neutral-400">（ライブラリから追加）</span>
							}
						</li>
					}
				</ul>
			}
			if len(d.Library) > 0 {
				<form hx-post={ shotURL(d.Shot.ID) + "/references" } hx-target="#shot-inspector" hx-swap="outerHTML" class="flex flex-wrap items-center gap-2">
					<label for="pin-reference" class="text-xs text-neutral-400">ライブラリの参照画像を追加</label>
					@atoms.Select(atoms.FieldSm, "", templ.Attributes{
						"id":       "pin-reference",
						"name":     "reference_id",
						"required": true,
					}) {
						for _, it := range d.Library {
							<option value={ it.ID }>{ it.Kind.Label() + " / " + it.Name }</option>
						}
					}
					@atoms.Button(atoms.ToneNeutral, "Reference Pack に追加", templ.Attributes{"type": "submit"})
				</form>
			}
		</section>
		<section aria-label="演出指示" class="flex flex-col gap-2">
			<h3 class="text-sm font-semibold">演出指示</h3>
			<form hx-post={ shotURL(d.Shot.ID) + "/director-command" } hx-target="#shot-inspector" hx-swap="outerHTML" class="flex flex-col gap-2">
				<label for="director-command" class="text-xs text-neutral-400">自然言語で指示（例: もう少し寄って。ラベルは固定して）。この Shot だけが再生成されます</label>
				@atoms.Textarea(atoms.FieldMd, "", templ.Attributes{
					"id":        "director-command",
					"name":      "content",
					"rows":      "2",
					"maxlength": "4000",
					"required":  true,
				}, "")
				<div>
					@atoms.Button(atoms.TonePrimary, "指示する", templ.Attributes{"type": "submit"})
				</div>
			</form>
		</section>
		@VersionHistoryPanel(VersionHistoryData{
			DOMID: "version-history-shot-" + d.Shot.ID, Title: "Shot Spec のバージョン", BasePath: shotURL(d.Shot.ID),
			Target: "#shot-inspector", Entries: d.Versions,
		})
		<section aria-label="Generation Model" class="flex flex-col gap-2">
			<h3 class="text-sm font-semibold">Generation Model</h3>
			<p class="text-sm">{ d.generationModel() }</p>
			<p class="text-xs text-neutral-400">モデル別のプロンプトは各 Take の「生成の経緯」で確認できます。</p>
		</section>
		<section aria-label="Take 一覧" class="flex flex-col gap-2">
			<h3 class="text-sm font-semibold">Take List / Judge Results</h3>
			if len(d.Takes) == 0 {
				<p class="text-sm text-neutral-400">Take はまだありません。</p>
			} else {
				<ol class="flex flex-col gap-1 text-sm">
					for i, t := range d.Takes {
						<li class="flex flex-col gap-2">
							<div class="flex items-center gap-2">
								<span>{ fmt.Sprintf("Take %d", i+1) }</span>
								@atoms.Badge(atoms.BadgeNeutral, string(t.Status))
								<span class="text-xs text-neutral-400">{ t.ModelName }</span>
								@atoms.Button(atoms.ToneNeutral, "生成の経緯", templ.Attributes{
									"type": "button", "hx-get": "/takes/" + t.ID + "/trace", "hx-target": "#take-trace-slot-" + t.ID, "hx-swap": "innerHTML",
								})
							</div>
							if res, ok := d.Judged[t.ID]; ok {
								<div class="flex flex-col gap-1" data-judge-result>
									{{ tone, label := judgeSummary(res) }}
									@atoms.Badge(tone, label)
									if len(res.Issues) > 0 {
										<ul class="list-disc pl-5 text-xs text-neutral-300">
											for _, is := range res.Issues {
												<li>{ issueLine(is) }</li>
											}
										</ul>
									}
								</div>
							}
							<div id={ "take-trace-slot-" + t.ID }></div>
						</li>
					}
				</ol>
			}
		</section>
	</div>
}
