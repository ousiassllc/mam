{
 "id": "musetalk",
 "name": "MuseTalk 1.5",
 "purpose": "lip_sync",
 "version": "1.5-0a89dec4",
 "source_url": "https://github.com/TMElyralab/MuseTalk/tree/0a89dec45a0192b824e3cf4daf96c239440c5ed8",
 "description": "既存の動画（または 1 枚の顔写真）と音声から、口元を音声に合わせた動画を作る MuseTalk 1.5 の実行環境。公式は Windows 向けの配布物を出していないため、公式の手順（Python 3.10・PyTorch 2.0.1 + CUDA 11.8・mmcv 2.0.1 ほか）と同じ版を、python.org・PyPI・PyTorch・OpenMMLab の公式の配布先から固定の URL と SHA-256 で取得して、mam が組み立てます。MuseTalk のコードは GitHub のコミット固定のアーカイブです。重み（約 6 GB）は別に取得します。Windows に Microsoft Visual C++ 再頒布可能パッケージ（x64）が入っている必要があります（PyTorch が使います）。",
 "build": {
  "site_packages": "python/Lib/site-packages",
  "files": [
   {
    "dest": "python/python310._pth",
    "lines": [
     "python310.zip",
     ".",
     "Lib/site-packages",
     "..",
     "import site"
    ]
   },
   {"dest": "mam_musetalk_common.py", "overlay": "mam_musetalk_common.py"},
   {"dest": "mam_musetalk_engine.py", "overlay": "mam_musetalk_engine.py"},
   {"dest": "mam_musetalk_server.py", "overlay": "mam_musetalk_server.py"}
  ]
 },
 "launch": {
  "python": "python/python.exe",
  "path_dirs": [
   "python"
  ],
  "entry": "mam_musetalk_server.py",
  "args": [
   "-I",
   "-u",
   "-X",
   "utf8",
   "mam_musetalk_server.py",
   "--host",
   "127.0.0.1",
   "--port",
   "{port}",
   "--use-float16"
  ],
  "ready_path": "/health",
  "env": [
   "HF_HUB_OFFLINE=1",
   "TRANSFORMERS_OFFLINE=1",
   "HF_DATASETS_OFFLINE=1",
   "HF_HUB_DISABLE_TELEMETRY=1",
   "DO_NOT_TRACK=1"
  ],
  "start_timeout_sec": 300,
  "token_env": "MAM_RUNTIME_TOKEN"
 },
 "vram": {
  "min_gb": 4,
  "source": "公式の README（Gradio Demo の節）に、Windows の NVIDIA GeForce RTX 3050 Ti Laptop（ビデオメモリ 4 GB）で、fp16 で 8 秒の動画を約 5 分で生成できたとある。mam は同じ fp16 で起動する。mam 自身の実機では未確認。",
  "estimate": false
 },
 "support": {
  "os": "windows",
  "arch": "amd64",
  "os_reasons": {
   "darwin": "macOS では MuseTalk 1.5 を自動導入できません。公式の PyTorch 版は macOS（Apple Silicon）の GPU に対応しておらず、第三者の MLX 版（mlx-community/MuseTalk-1.5-q4）は mam の自動導入の対象にしていません。mam が自動で導入するのは Windows + NVIDIA の GPU の組み合わせだけです。",
   "linux": "Linux では MuseTalk 1.5 の自動導入に対応していません。mam が自動で導入するのは Windows + NVIDIA の GPU の組み合わせだけです。",
   "default": "この OS では MuseTalk 1.5 の自動導入に対応していません。mam が自動で導入するのは Windows + NVIDIA の GPU の組み合わせだけです。"
  },
  "arch_reason": "この CPU（64 ビットの x86 以外）では MuseTalk 1.5 の自動導入に対応していません。mam が自動で導入するのは Windows + NVIDIA の GPU の組み合わせだけです。",
  "no_gpu_reason": "GPU を取得できなかったため、MuseTalk 1.5 を導入できません。自動導入には NVIDIA の GPU が必要です。",
  "not_nvidia_reason": "NVIDIA の GPU が見つからないため、MuseTalk 1.5 を導入できません。自動導入は NVIDIA の GPU（CUDA）だけに対応していて、AMD・Intel の GPU では使えません。",
  "low_vram_reason": "{gpu} のビデオメモリは {vram_gb} GB で、MuseTalk 1.5 に必要な {min_vram_gb} GB に足りないため導入できません。",
  "max_compute_cap": 12.0,
  "compute_cap_reason": "{gpu} は NVIDIA の RTX 50 シリーズ（Blackwell）で、MuseTalk の公式の手順が使う PyTorch 2.0.1（CUDA 11.8）が対応していないため、MuseTalk 1.5 を導入できません。",
  "fallback": "代わりに、クラウドの口パク（Sync Labs）を使ってください。"
 },
