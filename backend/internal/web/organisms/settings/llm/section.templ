package llm

import (
	"slices"
	"strings"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/help"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/settingsui"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Section is the category: the notice that a saved assignment applies at once, the notes of the file (pinned, unreadable) and of the plan sign-in, the
// button that puts the whole table back to the defaults, and the table of the Agents that run with those that do not
// folded below it. The whole table's answers (a reset, PUT /settings/llm) replace it by PanelID. A pinned file is a table
// to read: no button edits or resets it.
templ Section(d Data) {
	<section id={ PanelID } class="flex flex-col gap-3">
		@help.Row(help.ID(helpSubject), helpSubject, planHelp()) {
			<p class="text-sm text-ink" data-testid="llm-apply-note">保存した割り当ては、次の呼び出しからすぐ使われます（再起動は要りません）。</p>
		}
		if d.Pinned {
			<p class="text-sm text-ink" data-testid="llm-pinned">起動オプション（--llm-config / MAM_LLM_CONFIG）で固定されています。この画面では変更できません。</p>
		}
		if d.Problem != "" {
			@settingsui.Banner(atoms.IconWarning, "alert", "llm-problem", "保存済みの設定ファイルを読み込めません（表示は既定値です）") {
				<p class="break-words text-ink" data-testid="llm-problem-detail">{ d.Problem }</p>
			}
		}
		if d.KeyBanner != nil {
			@settingsui.Banner(atoms.IconKey, "status", "llm-key-banner", bannerTitle(*d.KeyBanner)) {
				<ul class="flex flex-col gap-1 text-ink" data-testid="llm-key-shortages">
					for _, s := range d.KeyBanner.Shortages {
						<li class="break-words" data-testid="llm-key-shortage">
							<span class="font-semibold">{ s.Provider }</span>
							<span>{ shortageText(s) }</span>
						</li>
					}
				</ul>
				<div>
					@atoms.ButtonLink(atoms.ToneNeutral, "API キーを設定", templ.SafeURL(d.KeyBanner.Route), templ.Attributes{"data-testid": "llm-key-link"})
				</div>
			}
		}
		if len(d.Warnings) > 0 {
			@settingsui.Banner(atoms.IconKey, "status", "llm-warnings", "使えない割り当てがあります") {
				<ul class="flex flex-col gap-1 text-ink">
					for _, w := range d.Warnings {
						<li class="break-words" data-testid="llm-warning">
							<span class="font-semibold">{ w.Provider }</span>: { w.Reason }
							<span class="text-mute">（{ strings.Join(w.Uses, "、") } が指しています）</span>
						</li>
					}
				</ul>
				if routes := warningRoutes(d.Warnings); len(routes) > 0 {
					<div class="flex flex-wrap gap-2">
						for _, r := range routes {
							@atoms.ButtonLink(atoms.ToneNeutral, "設定を開く", templ.SafeURL(r), templ.Attributes{"data-testid": "llm-warning-link"})
						}
					</div>
				}
			}
		}
		if d.Notice != "" {
			<p class="text-sm text-success" role="status" data-testid="llm-notice">{ d.Notice }</p>
		}
		if d.Error != "" {
			<p class="text-sm text-danger" role="alert" data-testid="llm-error">{ d.Error }</p>
		}
		if !d.Pinned {
			<div>
				@atoms.Button(atoms.ToneNeutral, "すべて既定に戻す", templ.Attributes{
					"type":            "button",
					"hx-delete":       paths.LLMSettings(),
					"hx-target":       "#" + PanelID,
					"hx-swap":         "outerHTML",
					"hx-sync":         "this:drop",
					"hx-disabled-elt": "this",
					"hx-confirm":      "すべての Agent の LLM の割り当てを既定に戻します。よろしいですか？",
					"data-testid":     "llm-reset",
				})
			</div>
		}
		@table(TableID, "LLM の割り当て（Agent ごと）", d.Rows, d.Pinned)
		if len(d.Unused) > 0 {
			<details class="rounded-md border border-border px-3 py-2" data-testid="llm-unused">
				<summary class="cursor-pointer text-sm text-ink">現在は使われません</summary>
				<p class="my-2 text-sm text-mute">これらの Agent は今のところ LLM を呼びません。割り当ては保存され、使われるようになったときに効きます。</p>
				@table(UnusedTableID, "LLM の割り当て（現在は使われない Agent）", d.Unused, d.Pinned)
			</details>
		}
	</section>
}

// warningRoutes are the screens that fix the warnings, each once and in the order the warnings name them: one button for each screen, not one for each line.
func warningRoutes(ws []Warning) []string {
	var routes []string
	for _, w := range ws {
		if w.Route != "" && !slices.Contains(routes, w.Route) {
			routes = append(routes, w.Route)
		}
	}
	return routes
}

// helpSubject is what the "?" beside the restart notice explains.
const helpSubject = "テキスト生成の割り当て"

// planHelp is behind the "?" of the restart notice: when a saved assignment is used and how to use a ChatGPT plan.
templ planHelp() {
	<p>保存した割り当ては、次の呼び出しからすぐ使われます。実行中の呼び出しは、始めたときの割り当てのまま終わります。llm.json を手で書き換えた base_url・タイムアウト・リトライ・サーキットブレーカーだけは、再起動すると反映されます（その設定があるときは、画面の上に「再起動して反映」が出ます）。</p>
	<p class="mt-2" data-testid="llm-chatgpt-note">
		プロバイダー「chatgpt-subscription」を選ぶと、ChatGPT のプランを使います（Using ChatGPT plan）。組織（Business / Enterprise / Edu）のアカウントは、「API キーとログイン」の Codex 経由でログインして、プロバイダー「chatgpt-codex」を選びます（テキスト生成だけ）。モデル名は、ログインしたあと、「API キーとログイン」の ChatGPT の欄で確認できます。
		<a class="underline" href="https://chatgpt.com/settings/usage" target="_blank" rel="noopener noreferrer">Manage usage</a>
	</p>
}

templ table(id, caption string, rows []Row, pinned bool) {
	@settingsui.SettingsTable(id, caption, columns(pinned)) {
		for _, r := range rows {
			@row(r, pinned, false)
		}
	}
}

func columns(pinned bool) []settingsui.Column {
	cols := []settingsui.Column{
		{Header: "Agent"},
		{Header: "用途", Class: purposeClass},
		{Header: "プライマリ"},
		{Header: "代替"},
		{Header: "変更"},
	}
	if !pinned {
		cols = append(cols, settingsui.Column{Header: "操作", SROnly: true})
	}
	return cols
}

// purposeClass hides the purpose column of a window narrower than xl: the side navigation takes a fifth of a 1024 px window,
// and the cells of a column that narrow break the names of the models, so the purpose is then under the name of the Agent.
const purposeClass = "hidden xl:table-cell"

// RowOOB is the row of an Agent as the answer of a save: it replaces the row with its id out of band. Put it first in the
// answer: a <tr> is read as a row only at the head of the response.
templ RowOOB(r Row) {
	@row(r, false, true)
}

templ row(r Row, pinned, oob bool) {
	@settingsui.TableRowItem(settingsui.TableRow{ID: RowID(r.Agent), TestID: "llm-row", Attrs: templ.Attributes{"data-agent": r.Agent}, OOB: oob}) {
		@settingsui.RowHead("") {
			{ r.Label }
			<span class="mt-1 block text-xs font-normal text-mute xl:hidden">{ r.Purpose }</span>
			@rowNote(r.Note, "xl:hidden")
		}
		@settingsui.Cell(purposeClass + " text-mute") {
			{ r.Purpose }
			@rowNote(r.Note, "")
		}
		@settingsui.Cell("min-w-40") {
			{ r.Primary.Summary() }
			@chip(r.PrimaryChip)
		}
		@settingsui.Cell("min-w-40") {
			{ r.Fallback.Summary() }
			@chip(r.FallbackChip)
		}
		@settingsui.Cell("whitespace-nowrap") {
			<span class="flex flex-col items-start gap-1">
				if r.Customized() {
					@atoms.Badge(atoms.BadgeInfo, "変更あり")
				} else {
					@atoms.Badge(atoms.BadgeNeutral, "既定")
				}
			</span>
		}
		if !pinned {
			@settingsui.Cell("whitespace-nowrap") {
				@atoms.SmallButtonFor(atoms.ToneNeutral, "編集", r.Label, modal.OpenAttrs(paths.LLMAgentEdit(r.Agent), FocusKey(r.Agent)))
			}
		}
	}
}

// chip is the small label under the name of a target whose API key is not registered, on a line of its own: the short word as a quiet badge (a light ground with the muted
// ink). The full reason is the tooltip and, for a screen reader, the text after the word. The banner above the table is the way to fix it, once for all of them.
templ chip(c Chip) {
	if c.Label != "" {
		<span class="mt-1 block w-fit">
			@atoms.BadgeWith(atoms.BadgeMuted, c.Label, templ.Attributes{"title": c.Title, "data-testid": "llm-chip"})
			<span class="sr-only">：{ c.Title }</span>
		</span>
	}
}

// rowNote is what the row does now when its primary cannot be used and its alternative can, under the purpose: the muted ink, no colour of a state. class is what the place adds (the
// copy under the name of the Agent is only for a window narrower than xl, where the purpose column is hidden).
templ rowNote(text, class string) {
	if text != "" {
		<span class={ "mt-1 block text-xs font-normal text-mute", class } data-testid="llm-row-note">{ text }</span>
	}
}
