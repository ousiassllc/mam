package organisms

import (
	"fmt"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
)

// EditorPanelData is the editing state of a Project (GET /projects/:id/editor): Rough Cut, Editor
// Judge, Audio, Final QC and Export (F-18 Simple, F-20 Simple, F-26).
type EditorPanelData struct {
	Project domain.Project
	// TimelineID is the latest Edit Timeline version ("" before the first Rough Cut).
	TimelineID string
	Clips      int
	Duration   float64
	Judge      *domain.EditorJudgeResult
	Audio      *domain.AudioTimelineVersion
	QC         *domain.FinalQCResult
	Exports    []domain.Export
	// Defaults are the export options preselected.
	Defaults domain.ExportOptions
	// CanRender is false without ffmpeg.
	CanRender bool
}

func editorURL(projectID string) string { return "/projects/" + projectID + "/editor" }

func editorAPIURL(projectID string) string { return "/api/v1/projects/" + projectID + "/edit-timeline" }

// CanJudge reports whether the Editor Judge can be run now.
func (d EditorPanelData) CanJudge() bool {
	return d.TimelineID != "" && (d.Project.State == domain.StateEditing || d.Project.State == domain.StateEditJudging)
}

// CanAudio reports whether the audio can be made now.
func (d EditorPanelData) CanAudio() bool {
	return d.CanRender && d.Project.State == domain.StateAudio
}

// CanFinalQC reports whether Final QC can be run now.
func (d EditorPanelData) CanFinalQC() bool {
	return d.Audio != nil && (d.Project.State == domain.StateAudio || d.Project.State == domain.StateFinalQC)
}

// CanExport reports whether the video can be exported now.
func (d EditorPanelData) CanExport() bool {
	return d.CanRender && (d.Project.State == domain.StateReady || d.Project.State == domain.StateExported)
}

func verdictLabel(v domain.EditorVerdict) string {
	switch v {
	case domain.EditorPass:
		return "PASS"
	case domain.EditorReEdit:
		return "Re-edit"
	}
	return "素材不足"
}

func verdictTone(pass bool) atoms.BadgeTone {
	if pass {
		return atoms.BadgeOK
	}
	return atoms.BadgeWarn
}

func clipPosition(index int) string {
	if index <= 0 {
		return "全体"
	}
	return fmt.Sprintf("クリップ %d", index)
}

func aspectOptions() []string { return domain.ExportAspectRatios() }

func resolutionOptions() []string { return domain.ExportResolutions() }

func codecOptions() []string { return domain.ExportCodecs() }

func exportURL(projectID, exportID string) string {
	return "/projects/" + projectID + "/exports/" + exportID + "/video"
}

// EditorWorkspace hosts mam-timeline-editor (loaded from the JSON API) and the stage buttons.
templ EditorWorkspace(d EditorPanelData) {
	<section id="editor-workspace" class="flex flex-col gap-6" aria-label="編集">
		<div class="flex flex-wrap items-center gap-3">
			<h2 class="text-lg font-semibold">編集・音声・書き出し</h2>
			@ProjectStateBadge(d.Project.State, false)
		</div>
		<mam-timeline-editor api-url={ editorAPIURL(d.Project.ID) }></mam-timeline-editor>
		@EditorActions(d)
	</section>
}

// EditorActions is the row of stages. It reloads itself when the timeline editor saved.
templ EditorActions(d EditorPanelData) {
	<div
		id="editor-actions"
		class="flex flex-col gap-5"
		hx-get={ editorURL(d.Project.ID) + "/actions" }
		hx-trigger="timeline-updated from:body"
		hx-swap="outerHTML"
	>
		<section class="flex flex-col gap-2" aria-label="Rough Cut">
			<h3 class="text-sm font-semibold">1. Rough Cut</h3>
			<p class="text-xs text-neutral-400">各 Shot の採用 Take（Selected Take）を Scene 順に並べます。作り直すと、手動編集は新しい版に置き換わります。</p>
			<div class="flex items-center gap-3">
				if d.TimelineID == "" {
					@atoms.Button(atoms.TonePrimary, "Rough Cut を作成", templ.Attributes{
						"type": "button", "hx-post": editorURL(d.Project.ID) + "/edit/rough-cut",
						"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
					})
				} else {
					@atoms.Button(atoms.ToneNeutral, "Rough Cut を作り直す", templ.Attributes{
						"type": "button", "hx-post": editorURL(d.Project.ID) + "/edit/rough-cut",
						"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
						"hx-confirm": "Rough Cut を作り直します。手動の編集は新しい版に置き換わります。よろしいですか？",
					})
					<span class="text-xs text-neutral-400">{ fmt.Sprintf("%d クリップ / %.1f 秒", d.Clips, d.Duration) }</span>
				}
			</div>
		</section>
		<section class="flex flex-col gap-2" aria-label="Editor Judge">
			<h3 class="text-sm font-semibold">2. Editor Judge</h3>
			<div class="flex items-center gap-3">
				@atoms.Button(atoms.ToneNeutral, "Editor Judge を実行", templ.Attributes{
					"type": "button", "hx-post": "/edit-timelines/" + d.TimelineID + "/judge",
					"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this", "disabled": !d.CanJudge(),
				})
				if d.Judge != nil {
					@atoms.Badge(verdictTone(d.Judge.Verdict == domain.EditorPass), verdictLabel(d.Judge.Verdict))
				}
			</div>
			if d.Judge != nil && len(d.Judge.Findings) > 0 {
				<ul class="flex flex-col gap-1 text-sm" data-editor-findings>
					for _, f := range d.Judge.Findings {
						<li><span class="text-xs text-neutral-400">{ clipPosition(f.ClipIndex) }</span> { f.Issue } → { f.Action }</li>
					}
				</ul>
			}
		</section>
		<section class="flex flex-col gap-2" aria-label="Audio">
			<h3 class="text-sm font-semibold">3. 音声（簡易版）</h3>
			<p class="text-xs text-neutral-400">脚本のセリフ・ナレーションを ElevenLabs で音声化し、Take の音声とミックスして −14 LUFS に整えます。</p>
			<div class="flex items-center gap-3">
				@atoms.Button(atoms.ToneNeutral, "音声を作成", templ.Attributes{
					"type": "button", "hx-post": editorURL(d.Project.ID) + "/audio/generate",
					"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this", "disabled": !d.CanAudio(),
				})
				if d.Audio != nil {
					<span class="text-xs text-neutral-400" data-audio-summary>
						{ fmt.Sprintf("セリフ %d 行 / %.1f 秒 / %.1f LUFS", len(d.Audio.Timeline.Clips), d.Audio.Timeline.DurationSeconds, d.Audio.Timeline.MeasuredLUFS) }
					</span>
				}
			</div>
			if !d.CanRender {
				<p class="text-xs text-amber-300">ffmpeg / ffprobe が見つからないため、音声と書き出しは使えません。</p>
			}
		</section>
		<section class="flex flex-col gap-2" aria-label="Final QC">
			<h3 class="text-sm font-semibold">4. Final QC</h3>
			<div class="flex items-center gap-3">
				@atoms.Button(atoms.ToneNeutral, "Final QC を実行", templ.Attributes{
					"type": "button", "hx-post": editorURL(d.Project.ID) + "/final-qc",
					"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this", "disabled": !d.CanFinalQC(),
				})
				if d.QC != nil {
					@atoms.Badge(verdictTone(d.QC.Verdict == domain.FinalQCPass), qcLabel(d.QC.Verdict))
				}
			</div>
			if d.QC != nil && len(d.QC.Findings) > 0 {
				<ul class="flex flex-col gap-1 text-sm" data-qc-findings>
					for _, f := range d.QC.Findings {
						<li>{ f.Message }</li>
					}
				</ul>
			}
		</section>
		<section class="flex flex-col gap-2" aria-label="Export">
			<h3 class="text-sm font-semibold">5. 書き出し</h3>
			<form
				hx-post={ editorURL(d.Project.ID) + "/export" }
				hx-target="#editor-actions"
				hx-swap="outerHTML"
				hx-disabled-elt="find button"
				class="flex flex-wrap items-end gap-3"
			>
				<label class="flex flex-col gap-1 text-xs text-neutral-400">
					Aspect Ratio
					<select name="aspect_ratio" class="rounded-md border border-neutral-600 bg-neutral-950 px-2 py-1 text-sm text-neutral-100">
						for _, o := range aspectOptions() {
							<option value={ o } selected?={ o == d.Defaults.AspectRatio }>{ o }</option>
						}
					</select>
				</label>
				<label class="flex flex-col gap-1 text-xs text-neutral-400">
					解像度
					<select name="resolution" class="rounded-md border border-neutral-600 bg-neutral-950 px-2 py-1 text-sm text-neutral-100">
						for _, o := range resolutionOptions() {
							<option value={ o } selected?={ o == d.Defaults.Resolution }>{ o }</option>
						}
					</select>
				</label>
				<label class="flex flex-col gap-1 text-xs text-neutral-400">
					コーデック
					<select name="codec" class="rounded-md border border-neutral-600 bg-neutral-950 px-2 py-1 text-sm text-neutral-100">
						for _, o := range codecOptions() {
							<option value={ o } selected?={ o == d.Defaults.Codec }>{ o }</option>
						}
					</select>
				</label>
				@atoms.Button(atoms.TonePrimary, "書き出す", templ.Attributes{"type": "submit", "disabled": !d.CanExport()})
			</form>
			if len(d.Exports) > 0 {
				<ul class="flex flex-col gap-1 text-sm" data-exports>
					for _, e := range d.Exports {
						<li class="flex flex-wrap items-center gap-2">
							<a class="text-indigo-300 underline" href={ templ.SafeURL(exportURL(d.Project.ID, e.ID)) } download>{ e.ExportedAt.Local().Format("2006-01-02 15:04") + " の書き出し" }</a>
							<span class="text-xs text-neutral-400">{ e.AspectRatio + " / " + e.Resolution + " / " + e.Codec }</span>
						</li>
					}
				</ul>
			}
		</section>
	</div>
}

func qcLabel(v domain.FinalQCVerdict) string {
	if v == domain.FinalQCPass {
		return "PASS"
	}
	return "FAIL"
}
