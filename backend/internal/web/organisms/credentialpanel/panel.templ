package credentialpanel

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/chatgptpanel"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ProviderView is one row of the panel: a provider, its label and whether its key is set.
// It never carries the key.
type ProviderView struct {
	Provider   string
	Label      string
	Configured bool
}

// Data is the API keys on the settings screen: which provider has a key. The value of
// a key is never part of it. Unavailable means the OS key store could not be read (no Secret Service,
// locked, ...): the panel then says so instead of listing providers. Notice is what succeeded although
// the key store cannot be read afterwards (a key that was saved, so that it is not taken for a failure).
// The reason a save was refused is shown by the row of its provider (Row), not by the panel.
// ChatGPT is the "ChatGPT でログイン" section, which follows the keys (a sign-in takes the place of a key): nil leaves it out.
type Data struct {
	Providers   []ProviderView
	Unavailable bool
	Notice      string
	ChatGPT     *chatgptpanel.Data
}

// Section is the "API キー" section of the global settings screen: Panel under its title, then the ChatGPT sign-in section.
templ Section(d Data) {
	@molecules.SettingsSection("API キー", "外部モデルの API キーを登録します。キーは OS のセキュアストレージに保存され、画面には設定済みかどうかだけが表示されます。保存したキーは再起動なしで次の呼び出しから使われます。") {
		@Panel(d)
	}
	@chatgptpanel.SectionIf(d.ChatGPT)
}

// Panel lists the providers with "設定済み" / "未設定", a form to save a key (PUT) and a
// button to delete it (DELETE). The key is sent once and never rendered again. A save or a delete
// answers with the row of its provider only (Row), so the keys typed into the other rows
// are kept; only a key store that cannot be read answers with the whole panel.
templ Panel(d Data) {
	<section id="credential-panel" class="flex flex-col gap-3">
		if d.Unavailable {
			<p class="text-sm text-amber-300" role="alert" data-testid="credential-unavailable">キーストアを利用できません。OS のキーチェーン（Secret Service など）を確認してから、画面を再読み込みしてください</p>
		}
		if d.Notice != "" {
			<p class="text-sm text-emerald-300" role="status" data-testid="credential-notice">{ d.Notice }</p>
		}
		<ul class="flex flex-col divide-y divide-neutral-800 text-sm">
			for _, p := range d.Providers {
				@Row(p, "")
			}
		</ul>
	</section>
}

func credentialRowID(provider string) string { return "credential-row-" + provider }

// Row is one provider: its state, the form that saves its key and, when errorMessage is set, the
// reason the last save was refused. It replaces itself (and nothing else) on a save or a delete.
templ Row(p ProviderView, errorMessage string) {
	<li id={ credentialRowID(p.Provider) } class="flex flex-col gap-2 py-3" data-testid="credential-row" data-provider={ p.Provider }>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<span class="font-medium">{ p.Label }</span>
			if p.Configured {
				@atoms.Badge(atoms.BadgeOK, "設定済み")
			} else {
				@atoms.Badge(atoms.BadgeNeutral, "未設定")
			}
		</div>
		<form
			class="flex flex-wrap items-center gap-2"
			hx-put={ paths.Credential(p.Provider) }
			hx-target={ "#" + credentialRowID(p.Provider) }
			hx-swap="outerHTML"
			autocomplete="off"
		>
			<label class="sr-only" for={ "api-key-" + p.Provider }>{ p.Label } の API キー</label>
			@atoms.Input(atoms.FieldMd, "min-w-0 flex-1", templ.Attributes{
				"id":           "api-key-" + p.Provider,
				"name":         "api_key",
				"type":         "password",
				"autocomplete": "off",
				"placeholder":  keyPlaceholder(p.Configured),
			})
			@atoms.ButtonFor(atoms.TonePrimary, "保存", p.Label, templ.Attributes{"type": "submit"})
			if p.Configured {
				@atoms.ButtonFor(atoms.ToneNeutral, "削除", p.Label, templ.Attributes{
					"type":       "button",
					"hx-delete":  paths.Credential(p.Provider),
					"hx-params":  "none", // inside the api_key form: never send its values (the key) in the DELETE URL
					"hx-target":  "#" + credentialRowID(p.Provider),
					"hx-swap":    "outerHTML",
					"hx-confirm": p.Label + " の API キーを削除します。よろしいですか？",
				})
			}
		</form>
		if errorMessage != "" {
			<p class="text-sm text-red-300" role="alert">{ errorMessage }</p>
		}
	</li>
}

func keyPlaceholder(configured bool) string {
	if configured {
		return "新しいキーで置き換える"
	}
	return "API キーを貼り付け"
}
