// Package pick is the choice that is a card: tap it and its frame glows (#906, #915). It replaces the radio button or
// checkbox with its label wherever the user picks one thing or several out of a short list; a switch-like setting
// (on/off, an agreement that has to be ticked) stays a checkbox. The control underneath is a real radio or checkbox that is only
// hidden (sr-only, the peer of the frame), so the keyboard (arrows, Space), the form, a screen reader ("radio button, checked")
// and the tests work as with a bare input; the selection is the border, the glow and the fill, not colour alone (the
// frames that have room add a mark), and the keyboard focus is a ring.
package pick

// GlowFrame is the look of the frame that is the card without the dimming of a disabled one: the border, glow and fill of the chosen one, and the ring of the focused one. The
// hover border is only for a card that is not chosen (peer-not-checked): a plain hover:border-mute is drawn after peer-checked:border-accent and would turn the frame of the chosen
// card grey under the pointer. A disabled card takes no pointer. A card that dims its own parts (modelcard: the badge that says why stays readable) uses this.
const GlowFrame = "transition-colors peer-not-checked:hover:border-mute peer-checked:border-accent peer-checked:bg-accent-soft peer-focus-visible:focus-ring peer-disabled:pointer-events-none motion-reduce:transition-none"

// Glow is GlowFrame with the dimmed look of a disabled card (the whole frame). The layout of the card (padding, direction) is the caller's.
const Glow = GlowFrame + " peer-disabled:opacity-60"

// OpenFrame is the look of the frame of a card that opens something (a detail) instead of being chosen: on hover the border and glow of the card
// that is chosen (the same tokens as Glow), and the ring of the keyboard focus when the control that opens the card (data-card-open, the
// name in modelcard.Item) has it. The layout of the card is the caller's.
const OpenFrame = "transition-colors hover:border-accent has-[[data-card-open]:focus-visible]:focus-ring motion-reduce:transition-none"

// Card is a label around the hidden control (attrs: type, name, value, checked, disabled, data-*, hx-*) and the frame
// that holds the children. layout is the classes of the frame for its content (padding, flex direction, text size).
templ Card(attrs templ.Attributes, layout string) {
	<label class="relative block cursor-pointer has-[:disabled]:cursor-not-allowed">
		<input class="peer sr-only" { attrs... }/>
		<span class={ "block rounded-md border border-border", Glow, layout }>
			{ children... }
		</span>
	</label>
}
