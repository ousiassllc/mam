{
 "id": "img2video-ltx-13b-distilled", "label": "LTX-Video 13B 0.9.8 Distilled: 先頭フレームから動画", "media": "video",
 "description": "Lightricks の LTX-Video 13B 0.9.8 Distilled（fp8 の ltxv-13b-0.9.8-distilled-fp8.safetensors、テキストエンコーダー t5xxl_fp8_e4m3fn.safetensors）の、先頭フレームの画像から動画を作る、標準ノードだけのワークフロー（LoadImage → LTXVPreprocess → LTXVImgToVideo → LTXVConditioning → CFGGuider → SamplerCustomAdvanced → VAEDecode）。txt2video-ltx-13b-distilled と同じ蒸留の値（8 つのシグマ・cfg 1・euler_ancestral・24fps。拡大モデルを使わない 1 段）に、公式の 13B 蒸留の I2V ワークフロー（ComfyUI-LTXVideo の 13b-distilled/ltxv-13b-dist-i2v-base-fp8.json の LTXVBaseSampler）の画像の値を写した: 画像の強さ 0.8（LTXVImgToVideo の strength）・動画らしく見せる圧縮 30（LTXVPreprocess の img_compression。公式の crf 30）。LTXVBaseSampler はカスタムノードなので、同じ蒸留の公式の低レベルワークフロー（low_level/ltxvideo-i2v-distilled.json）が使う標準の LTXVPreprocess・LTXVImgToVideo で組んだ。先頭フレームは画像のサイズに合わせて中央から切り取られる。GPU では未実行（構造のテストのみ）。",
 "model": {"media": "video", "video": {"durations": [2, 3, 4, 5], "resolutions": ["480p", "720p"]}, "workflow": {
  "prompt_weight": "weak",
  "graph": {
   "44": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "ltxv-13b-0.9.8-distilled-fp8.safetensors"}},
   "38": {"class_type": "CLIPLoader", "inputs": {"clip_name": "t5xxl_fp8_e4m3fn.safetensors", "type": "ltxv", "device": "default"}},
   "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["38", 0]}},
   "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["38", 0]}},
   "78": {"class_type": "LoadImage", "inputs": {"image": "example.png"}},
   "82": {"class_type": "LTXVPreprocess", "inputs": {"image": ["78", 0], "img_compression": 30}},
   "95": {"class_type": "LTXVImgToVideo", "inputs": {"width": 768, "height": 512, "length": 97, "batch_size": 1, "strength": 0.8, "positive": ["6", 0], "negative": ["7", 0], "vae": ["44", 2], "image": ["82", 0]}},
   "69": {"class_type": "LTXVConditioning", "inputs": {"frame_rate": 24, "positive": ["95", 0], "negative": ["95", 1]}},
   "97": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
   "100": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.9937, 0.9875, 0.9812, 0.975, 0.9094, 0.725, 0.4219, 0.0"}},
   "99": {"class_type": "CFGGuider", "inputs": {"cfg": 1, "model": ["44", 0], "positive": ["69", 0], "negative": ["69", 1]}},
   "102": {"class_type": "RandomNoise", "inputs": {"noise_seed": 0}},
   "101": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["102", 0], "guider": ["99", 0], "sampler": ["97", 0], "sigmas": ["100", 0], "latent_image": ["95", 2]}},
   "8": {"class_type": "VAEDecode", "inputs": {"samples": ["101", 1], "vae": ["44", 2]}},
   "80": {"class_type": "CreateVideo", "inputs": {"fps": 24, "images": ["8", 0]}},
   "81": {"class_type": "SaveVideo", "inputs": {"filename_prefix": "video/mam", "format": "auto", "codec": "auto", "video": ["80", 0]}}
  },
  "assignments": [
   {"param": "prompt", "node": "6", "input": "text"},
   {"param": "negative_prompt", "node": "7", "input": "text"},
   {"param": "seed", "node": "102", "input": "noise_seed"},
   {"param": "width", "node": "95", "input": "width"},
   {"param": "height", "node": "95", "input": "height"},
   {"param": "frames", "node": "95", "input": "length"},
   {"param": "fps", "node": "80", "input": "fps"},
   {"param": "fps", "node": "69", "input": "frame_rate"},
   {"param": "first_frame", "node": "78", "input": "image"}
  ],
  "output_node": "81", "fps": 24, "frames_step": 8, "size_multiple": 32
 }}
