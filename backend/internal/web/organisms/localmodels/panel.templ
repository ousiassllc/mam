package localmodels

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// IDs of the elements the actions swap.
const (
	PanelID  = "local-models-panel"
	EditorID = "local-models-editor"
)

// SectionIf is Section, or nothing when d is nil.
templ SectionIf(d *Data) {
	if d != nil {
		@Section(*d)
	}
}

// Section is the "ローカル・代替モデル" section of the global settings screen: Panel under its title.
templ Section(d Data) {
	@molecules.SettingsSection("ローカル・代替モデル", "自分の PC や tailnet 上のサーバーで動かしている ComfyUI（画像・動画）と OpenAI 互換の画像 API を登録し、組み込みのモデルと同じように「画像・動画モデル」で選べるようにします。保存するとすぐに反映されます。登録した接続先には http・localhost・LAN・tailnet のアドレスを使えます（リンクローカルは使えません）。") {
		@Panel(d)
	}
}

// Panel is the whole section: the endpoints with their models, the buttons that open a form, and the
// form that is open. Every action answers with the panel itself (outerHTML of #local-models-panel).
templ Panel(d Data) {
	<section id={ PanelID } class="flex flex-col gap-4" data-testid="local-models">
		if d.Problem != "" {
			<p class="text-sm text-red-300" role="alert" data-testid="local-models-problem">{ d.Problem }</p>
		} else {
			if d.Pinned {
				<p class="text-sm text-amber-300" role="status" data-testid="local-models-pinned">{ d.PinnedNote }</p>
			}
			if d.Notice != "" {
				<p class="text-sm text-emerald-300" role="status" data-testid="local-models-notice">{ d.Notice }</p>
			}
			if d.Error != "" {
				<p class="text-sm text-red-300" role="alert" data-testid="local-models-error">{ d.Error }</p>
			}
			@endpointList(d)
			@atoms.Button(atoms.TonePrimary, "接続先を追加", guarded(d, templ.Attributes{
				"type":      "button",
				"hx-get":    paths.LocalEndpoints() + "/new",
				"hx-target": "#" + EditorID,
				"hx-swap":   "innerHTML",
			}))
			<div id={ EditorID } class="flex flex-col gap-3" data-testid="local-models-editor">
				@EditorBody(d)
			</div>
		}
	</section>
}

// guarded is attrs of a control that changes the settings file; for a pinned file it is a disabled button
// that says why (the request is never sent).
func guarded(d Data, attrs templ.Attributes) templ.Attributes {
	if !d.Pinned {
		return attrs
	}
	return templ.Attributes{"type": "button", "disabled": true, "title": d.PinnedNote}
}

templ endpointList(d Data) {
	if len(d.Endpoints) == 0 {
		<p class="text-sm text-neutral-400" data-testid="local-models-empty">接続先はまだ登録されていません。</p>
	} else {
		<ul class="flex flex-col divide-y divide-neutral-800 text-sm" data-testid="local-endpoints">
			for _, e := range d.Endpoints {
				@endpointRow(d, e)
			}
		</ul>
	}
}

func testID(endpoint string) string { return "local-test-" + endpoint }

templ endpointRow(d Data, e Endpoint) {
	<li class="flex flex-col gap-3 py-4" data-testid="local-endpoint" data-endpoint={ e.Name }>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div class="flex min-w-0 flex-col gap-1">
				<span class="flex flex-wrap items-center gap-2">
					<span class="font-medium">{ e.Name }</span>
					@atoms.Badge(atoms.BadgeInfo, e.KindLabel)
				</span>
				<code class="break-all text-xs text-neutral-300" data-testid="local-endpoint-url">{ e.BaseURL }</code>
				<span class="text-xs text-neutral-400">同時実行 { itoa(e.MaxConcurrency) } ／ タイムアウト { itoa(e.TimeoutSeconds) } 秒</span>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				@atoms.SmallButtonFor(atoms.ToneNeutral, "接続テスト", e.Name, templ.Attributes{
					"type":            "button",
					"hx-post":         paths.LocalEndpoint(e.Name, "test"),
					"hx-target":       "#" + testID(e.Name),
					"hx-swap":         "innerHTML",
					"hx-sync":         "this:drop",
					"hx-disabled-elt": "this",
				})
				@atoms.SmallButtonFor(atoms.ToneNeutral, "編集", e.Name, guarded(d, templ.Attributes{
					"type":      "button",
					"hx-get":    paths.LocalEndpoint(e.Name, "edit"),
					"hx-target": "#" + EditorID,
					"hx-swap":   "innerHTML",
				}))
				@atoms.SmallButtonFor(atoms.ToneDanger, "削除", e.Name, guarded(d, templ.Attributes{
					"type":       "button",
					"hx-delete":  paths.LocalEndpoint(e.Name),
					"hx-target":  "#" + PanelID,
					"hx-swap":    "outerHTML",
					"hx-confirm": "接続先「" + e.Name + "」と、その接続先のモデルをすべて削除します（API キーも消えます）。よろしいですか？",
				}))
			</div>
		</div>
		<div id={ testID(e.Name) } role="status" aria-live="polite" data-testid="local-endpoint-test"></div>
		@KeyRow(e.Name, e.Key)
		@modelList(d, e)
	</li>
}

templ modelList(d Data, e Endpoint) {
	<div class="flex flex-col gap-2 pl-3">
		if len(e.Models) == 0 {
			<p class="text-xs text-neutral-400">モデルはまだ定義されていません。</p>
		} else {
			<ul class="flex flex-col gap-2" data-testid="local-models-list">
				for _, m := range e.Models {
					@modelRow(d, e, m)
				}
			</ul>
		}
		<div>
			@atoms.SmallButtonFor(atoms.ToneNeutral, "モデルを追加", e.Name, guarded(d, templ.Attributes{
				"type":      "button",
				"hx-get":    paths.LocalEndpoint(e.Name, "models", "new"),
				"hx-target": "#" + EditorID,
				"hx-swap":   "innerHTML",
			}))
		</div>
	</div>
}

templ modelRow(d Data, e Endpoint, m Model) {
	<li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-neutral-800 px-3 py-2" data-testid="local-model" data-model-id={ m.ID }>
		<div class="flex min-w-0 flex-col gap-1">
			<span class="flex flex-wrap items-center gap-2">
				<span class="font-medium">{ m.Name }</span>
				if m.Media == MediaVideo {
					@atoms.Badge(atoms.BadgeNeutral, "動画")
				} else {
					@atoms.Badge(atoms.BadgeNeutral, "画像")
				}
			</span>
			<code class="break-all text-xs text-neutral-300" data-testid="local-model-id">{ m.ID }</code>
			<span class="text-xs text-neutral-400">{ m.Summary }</span>
			if len(m.UsedBy) > 0 {
				<span class="text-xs text-neutral-400" data-testid="local-model-used-by">使用中: { joinNames(m.UsedBy) }</span>
			}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			@atoms.SmallButtonFor(atoms.ToneNeutral, "編集", m.ID, guarded(d, templ.Attributes{
				"type":      "button",
				"hx-get":    paths.LocalEndpoint(e.Name, "models", m.Name, "edit"),
				"hx-target": "#" + EditorID,
				"hx-swap":   "innerHTML",
			}))
			@atoms.SmallButtonFor(atoms.ToneDanger, "削除", m.ID, guarded(d, templ.Attributes{
				"type":       "button",
				"hx-delete":  paths.LocalEndpoint(e.Name, "models", m.Name),
				"hx-target":  "#" + PanelID,
				"hx-swap":    "outerHTML",
				"hx-confirm": "モデル「" + m.ID + "」を削除します。よろしいですか？",
			}))
		</div>
	</li>
}

// KeyRow is the API key of an endpoint: whether one is set and its last characters (never the key), the
// form that saves one and the button that removes it. It replaces itself on a save or a clear, so that
// nothing else on the screen is touched. The key works also while the settings file is pinned.
templ KeyRow(endpoint string, k Key) {
	<div id={ keyRowID(endpoint) } class="flex flex-col gap-1" data-testid="local-endpoint-key">
		<form
			class="flex flex-wrap items-center gap-2"
			hx-put={ paths.LocalEndpoint(endpoint, "key") }
			hx-target={ "#" + keyRowID(endpoint) }
			hx-swap="outerHTML"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type=submit]"
			autocomplete="off"
		>
			<span class="text-xs text-neutral-400">API キー（任意）:</span>
			if k.Unavailable {
				<span data-testid="local-key-state">
					@atoms.Badge(atoms.BadgeWarn, "キーストアを利用できません")
				</span>
			} else if k.Configured {
				<span data-testid="local-key-state">
					@atoms.Badge(atoms.BadgeOK, keyState(k))
				</span>
			} else {
				<span data-testid="local-key-state">
					@atoms.Badge(atoms.BadgeNeutral, "未設定")
				</span>
			}
			<label class="sr-only" for={ "local-key-" + endpoint }>{ endpoint } の API キー</label>
			@atoms.Input(atoms.FieldSm, "min-w-0 w-56", templ.Attributes{
				"id":           "local-key-" + endpoint,
				"name":         FieldAPIKey,
				"type":         "password",
				"autocomplete": "new-password",
				"placeholder":  keyPlaceholder(k.Configured),
			})
			@atoms.SmallButtonFor(atoms.TonePrimary, "キーを保存", endpoint, templ.Attributes{"type": "submit"})
			if k.Configured {
				@atoms.SmallButtonFor(atoms.ToneNeutral, "キーを削除", endpoint, templ.Attributes{
					"type":       "button",
					"hx-delete":  paths.LocalEndpoint(endpoint, "key"),
					"hx-params":  "none", // inside the key form: never send its values with a DELETE
					"hx-target":  "#" + keyRowID(endpoint),
					"hx-swap":    "outerHTML",
					"hx-confirm": "接続先「" + endpoint + "」の API キーを削除します。よろしいですか？",
				})
			}
		</form>
		if k.Error != "" {
			<p class="text-xs text-red-300" role="alert" data-testid="local-key-error">{ k.Error }</p>
		}
	</div>
}

// TestResult is the line a connection test answers with.
templ TestResult(t TestView) {
	<div class="flex flex-col gap-1 text-xs" data-testid="local-test-result">
		if t.OK {
			<p class="text-emerald-300">{ t.Message }</p>
		} else {
			<p class="text-red-300" role="alert">{ t.Message }</p>
		}
		if t.Note != "" {
			<p class="text-amber-300" data-testid="local-test-note">{ t.Note }</p>
		}
		if len(t.Models) > 0 {
			<p class="text-neutral-400" data-testid="local-test-models">モデル: { joinNames(t.Models) }</p>
		}
	</div>
}
