// Package refresh is the refresh button of a part of a screen that changes by itself (#925, #962): when it was read and the button that
// reads it again. The generation test history, the engine, the model list, the local runtimes and the trial results of the model manager use
// it, so that every screen with a running job refreshes the same way. It is a package of its own so that molecules stays inside its line limit.
package refresh

import "github.com/ousiassllc/mam/backend/internal/web/atoms"

// Bar is when a part of the screen was read (small, "15:04:05") and the button that reads it again: the icon only, named
// "更新" for the screen reader. The button swaps the part it sits in (the element with id target) by what url answers; while
// the request is out the icon turns. Its id is fixed so that HTMX gives it the focus again when a swap replaces it. A request of the
// button is the reader's own: the poll guard (static/src/components/poll/poll-guard.ts) never holds it back, and hx-sync makes it take
// the place of a poll of the same part that is out. It sits at the end of the line or the column it is put in (ml-auto).
templ Bar(url, target, updatedAt string) {
	<div class="ml-auto flex shrink-0 items-center gap-2">
		if updatedAt != "" {
			<span class="text-xs text-mute" data-testid="refresh-updated">最終更新 <time>{ updatedAt }</time></span>
		}
		<button
			type="button"
			id={ target + "-refresh" }
			class="group inline-flex h-7 w-7 items-center justify-center rounded-md border border-border text-ink transition-colors hover:border-mute hover:text-ink focus-visible:focus-ring motion-reduce:transition-none"
			hx-get={ url }
			hx-target={ "#" + target }
			hx-swap="outerHTML"
			hx-sync={ "#" + target + ":replace" }
			aria-label="更新"
			title="更新"
			data-testid="refresh"
		>
			@atoms.Icon(atoms.IconUpdate, "h-4 w-4 group-[.htmx-request]:animate-spin motion-reduce:animate-none")
		</button>
	</div>
}
