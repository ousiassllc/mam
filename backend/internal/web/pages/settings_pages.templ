package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/settingsui"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/restart"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
)

// GlobalSettingsPageData is one page of the global settings screen: the overview or a category (spec/components/settings-screen.md §4).
type GlobalSettingsPageData struct {
	// Title is the <title> of the page; every category has its own (WCAG 2.4.2).
	Title string
	// Canonical is the URL that stands for the page when another one shows it too ("" for none).
	Canonical string
	Nav       []settingsui.NavItem
	// Body is the category: its h2 and what it holds (settingsui.Category). An HTMX request gets it alone.
	Body templ.Component
	// Restart is the "再起動して反映" panel, drawn above the category when HasRestart (the app has a restart service).
	Restart    restart.Data
	HasRestart bool
}

// GlobalSettingsPage is the frame of the global settings screen (the settings that belong to no Project): the h1,
// the side navigation and the category on its right, and the modal that the category's buttons fill.
templ GlobalSettingsPage(csrfToken string, d GlobalSettingsPageData) {
	@layout.AppLayoutAt(d.Title, csrfToken, d.Canonical, sidenav.At(sidenav.Settings)) {
		@pagehead.Main(pagehead.Wider) {
			@pagehead.Header("設定", "", "すべてのプロジェクトで共通の設定です。")
			<div class="flex flex-col gap-8 lg:flex-row">
				@settingsui.Nav(d.Nav)
				<div class="min-w-0 flex-1">
					if d.HasRestart {
						@restart.Slot(d.Restart)
					}
					@d.Body
				</div>
			</div>
			@modal.Host()
		}
	}
}
