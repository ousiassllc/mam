package organisms

import (
	"encoding/json"
	"fmt"
	"net/url"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// EditorPanelData is the editing state of a Project (GET /projects/:id/edit): Rough Cut, Editor
// Judge, Audio, Final QC and Export (F-18 Simple, F-20 Simple, F-26).
type EditorPanelData struct {
	Project domain.Project
	// BranchID is the Branch being edited ("" is the trunk): every Branch has its own Edit Timeline.
	BranchID string
	// PendingShots is how many additional Shots of the Editor → Reshoot Loop are still being made.
	PendingShots int
	// TimelineID is the latest Edit Timeline version ("" before the first Rough Cut).
	TimelineID string
	Clips      int
	Duration   float64
	Judge      *domain.EditorJudgeResult
	Audio      *domain.AudioTimelineVersion
	// TrunkAudio is the latest Audio Timeline of the trunk: Final QC inspects it, not the Branch shown.
	TrunkAudio *domain.AudioTimelineVersion
	// Voices are the cloned voices of the Project's speakers.
	Voices  []domain.VoiceClone
	QC      *domain.FinalQCResult
	Exports []domain.Export
	// Defaults are the export options preselected.
	Defaults domain.ExportOptions
	// CanRender is false without ffmpeg.
	CanRender bool
}

func branchQuery(branchID string) string {
	if branchID == "" {
		return ""
	}
	return "?branch_id=" + url.QueryEscape(branchID)
}

// branchVals is the hx-vals that tell a stage action which Branch it works on.
func branchVals(branchID string) string {
	raw, err := json.Marshal(map[string]string{"branch_id": branchID})
	if err != nil { // only strings: Marshal cannot fail
		panic(err)
	}
	return string(raw)
}

// CanRequestShots reports whether the Director can be asked for the additional Shots the Editor
// Judge found missing.
func (d EditorPanelData) CanRequestShots() bool {
	return d.Judge != nil && d.Judge.Verdict == domain.EditorNeedShot && d.Project.State == domain.StateEditJudging && d.PendingShots == 0
}

func needLabel(n *domain.ShotNeed) string {
	kind := "インサートショット"
	if n.Kind == domain.ClipReaction {
		kind = "リアクションショット"
	}
	return fmt.Sprintf("%s %.1f 秒（クリップ %d の後）", kind, n.Seconds(), n.AfterClip)
}

// CanRoughCut reports whether a Rough Cut can be made (or made again) now: the Project is in a state
// it can take an edit in (domain.ProjectState.CanEdit, the one the server refuses by with 409 and the
// editor's read-only flag follows).
func (d EditorPanelData) CanRoughCut() bool { return d.Project.State.CanEdit() }

// CanJudge reports whether the Editor Judge can be run now.
func (d EditorPanelData) CanJudge() bool {
	return d.TimelineID != "" && (d.Project.State == domain.StateEditing || d.Project.State == domain.StateEditJudging || d.Project.State == domain.StateRepairing)
}

// CanAudio reports whether the audio can be made now: the series shown has an Edit Timeline to make
// it for (the server refuses with 404 without one).
func (d EditorPanelData) CanAudio() bool {
	return d.CanRender && d.Project.State == domain.StateAudio && d.TimelineID != ""
}

// CanFinalQC reports whether Final QC can be run now. It inspects the trunk whatever series is
// shown, so the audio it needs is the trunk's (TrunkAudio), not the Branch's.
func (d EditorPanelData) CanFinalQC() bool {
	return d.TrunkAudio != nil && (d.Project.State == domain.StateAudio || d.Project.State == domain.StateFinalQC)
}

// FinalQCBlockedByTrunk is true when only the missing audio of the trunk keeps Final QC from running
// from a Branch's panel.
func (d EditorPanelData) FinalQCBlockedByTrunk() bool {
	return d.BranchID != "" && d.TrunkAudio == nil && (d.Project.State == domain.StateAudio || d.Project.State == domain.StateFinalQC)
}

// CanExport reports whether the video can be exported now: the Project is in a state it can be
// exported from (domain.ProjectState.CanExport) and the series shown (the trunk or the Branch) has
// audio made for its latest Edit Timeline (domain.AudioTimelineVersion.CurrentFor): the server
// refuses an export with 404 / 409 otherwise.
func (d EditorPanelData) CanExport() bool {
	return d.CanRender && d.Project.State.CanExport() && d.Audio.CurrentFor(d.TimelineID)
}

// ExportBlocker is the reason the export button is disabled although the Project can be exported
// from its state ("" when the button is enabled, or the state or ffmpeg is what disables it).
func (d EditorPanelData) ExportBlocker() string {
	switch {
	case !d.CanRender || !d.Project.State.CanExport() || d.CanExport():
		return ""
	case d.Audio == nil:
		return "この系列にはまだ音声がないため、書き出せません。"
	}
	return "この系列の音声が最新の編集に対応していないため、書き出せません。"
}

func verdictLabel(v domain.EditorVerdict) string {
	switch v {
	case domain.EditorPass:
		return "PASS"
	case domain.EditorReEdit:
		return "Re-edit"
	}
	return "素材不足"
}

func verdictTone(pass bool) atoms.BadgeTone {
	if pass {
		return atoms.BadgeOK
	}
	return atoms.BadgeWarn
}

func clipPosition(index int) string {
	if index <= 0 {
		return "全体"
	}
	return fmt.Sprintf("クリップ %d", index)
}

func aspectOptions() []string { return domain.ExportAspectRatios() }

func resolutionOptions() []string { return domain.ExportResolutions() }

func codecOptions() []string { return domain.ExportCodecs() }

func exportURL(projectID, exportID string) string {
	return paths.Project(projectID, "exports", exportID, "video")
}

// EditorWorkspace hosts mam-timeline-editor (loaded from the JSON API) and the stage buttons.
templ EditorWorkspace(d EditorPanelData) {
	<section id="editor-workspace" class="flex flex-col gap-6" aria-label="編集">
		<div class="flex flex-wrap items-center gap-3">
			<h2 class="text-lg font-semibold">編集・音声・書き出し</h2>
			@ProjectStateBadge(d.Project.State, false)
		</div>
		<mam-timeline-editor api-url={ paths.APIProject(d.Project.ID, "edit-timeline") + branchQuery(d.BranchID) }></mam-timeline-editor>
		@EditorActions(d)
	</section>
}

// EditorActionsFragment is what a stage action or the reload of #editor-actions answers with: the
// stage buttons and, out of band, the Project state badge of the page header, which the stage
// (Rough Cut, Final QC, an additional Shot request, ...) may have moved.
templ EditorActionsFragment(d EditorPanelData) {
	@EditorActions(d)
	@ProjectStateBadge(d.Project.State, true)
}

// EditorActions is the row of stages. It reloads itself when the timeline editor saved.
templ EditorActions(d EditorPanelData) {
	<div
		id="editor-actions"
		class="flex flex-col gap-5"
		hx-get={ paths.Project(d.Project.ID, "edit", "actions") + branchQuery(d.BranchID) }
		hx-trigger="timeline-updated from:body"
		hx-swap="outerHTML"
	>
		<section class="flex flex-col gap-2" aria-label="Rough Cut">
			<h3 class="text-sm font-semibold">1. Rough Cut</h3>
			<p class="text-xs text-neutral-400">各 Shot の採用 Take（Selected Take）を Scene 順に並べます。作り直すと、手動編集は新しい版に置き換わります。</p>
			<div class="flex items-center gap-3">
				if d.TimelineID == "" {
					@atoms.Button(atoms.TonePrimary, "Rough Cut を作成", templ.Attributes{
						"type": "button", "hx-post": paths.Project(d.Project.ID, "edit", "rough-cut"), "hx-vals": branchVals(d.BranchID),
						"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this", "disabled": !d.CanRoughCut(),
					})
				} else {
					@atoms.Button(atoms.ToneNeutral, "Rough Cut を作り直す", templ.Attributes{
						"type": "button", "hx-post": paths.Project(d.Project.ID, "edit", "rough-cut"), "hx-vals": branchVals(d.BranchID),
						"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
						"hx-confirm": "Rough Cut を作り直します。手動の編集は新しい版に置き換わります。よろしいですか？", "disabled": !d.CanRoughCut(),
					})
					<span class="text-xs text-neutral-400">{ fmt.Sprintf("%d クリップ / %.1f 秒", d.Clips, d.Duration) }</span>
				}
			</div>
		</section>
		<section class="flex flex-col gap-2" aria-label="Editor Judge">
			<h3 class="text-sm font-semibold">2. Editor Judge</h3>
			<div class="flex items-center gap-3">
				@atoms.Button(atoms.ToneNeutral, "Editor Judge を実行", templ.Attributes{
					"type": "button", "hx-post": paths.EditTimeline(d.TimelineID, "judge"),
					"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this", "disabled": !d.CanJudge(),
				})
				if d.Judge != nil {
					@atoms.Badge(verdictTone(d.Judge.Verdict == domain.EditorPass), verdictLabel(d.Judge.Verdict))
				}
			</div>
			if d.Judge != nil && len(d.Judge.Findings) > 0 {
				<ul class="flex flex-col gap-1 text-sm" data-editor-findings>
					for _, f := range d.Judge.Findings {
						<li>
							<span class="text-xs text-neutral-400">{ clipPosition(f.ClipIndex) }</span> { f.Issue } → { f.Action }
							if f.Need != nil {
								<span class="text-xs text-amber-300" data-need-shot>{ " 追加 Shot: " + needLabel(f.Need) }</span>
							}
						</li>
					}
				</ul>
			}
			if d.CanRequestShots() {
				<div class="flex items-center gap-3">
					@atoms.Button(atoms.TonePrimary, "追加 Shot を要求（Director へ差し戻し）", templ.Attributes{
						"type": "button", "hx-post": paths.EditTimeline(d.TimelineID, "request-additional-shot"),
						"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
					})
					<span class="text-xs text-neutral-400">足りない素材を Director に作らせ、できたら編集に戻ります。</span>
				</div>
			}
			if d.PendingShots > 0 {
				<p class="text-xs text-amber-300" data-pending-shots>{ fmt.Sprintf("追加 Shot を %d 件生成中です。できたら自動で編集タイムラインに入ります。", d.PendingShots) }</p>
			}
		</section>
		<section class="flex flex-col gap-2" aria-label="Audio">
			<h3 class="text-sm font-semibold">3. 音声（Audio Director）</h3>
			<p class="text-xs text-neutral-400">
				Scene の感情と編集テンポに合わせて、セリフ・ナレーション（ElevenLabs TTS）に加えて Quality Policy の範囲で BGM・Ambience・SE・Foley（ElevenLabs）と Lip Sync（Sync Labs。MAX QUALITY のみ）を作り、
				Take の音声とミックスして −14 LUFS に整えます。作るたびに新しい版になり、Branch ごとに版を管理します。
			</p>
			<div class="flex items-center gap-3">
				@atoms.Button(atoms.ToneNeutral, "音声を作成", templ.Attributes{
					"type": "button", "hx-post": paths.Project(d.Project.ID, "audio", "generate"), "hx-vals": branchVals(d.BranchID),
					"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this", "disabled": !d.CanAudio(),
				})
				if d.Audio != nil {
					<span class="text-xs text-neutral-400" data-audio-summary>{ audioSummary(d.Audio) }</span>
				}
			</div>
			if d.Audio != nil && len(d.Audio.Timeline.Scenes) > 0 {
				<ul class="flex flex-col gap-1 text-xs text-neutral-300" data-audio-scenes>
					for _, s := range d.Audio.Timeline.Scenes {
						<li>{ audioSceneText(s) }</li>
					}
				</ul>
			}
			if d.Audio != nil && len(d.Audio.Timeline.Skipped) > 0 {
				<ul class="flex flex-col gap-1 text-xs text-amber-300" data-audio-skipped>
					for _, s := range d.Audio.Timeline.Skipped {
						<li>{ audioSkippedText(s) }</li>
					}
				</ul>
			}
			if !d.CanRender {
				<p class="text-xs text-amber-300">ffmpeg / ffprobe が見つからないため、音声と書き出しは使えません。</p>
			}
			<form
				hx-post={ paths.Project(d.Project.ID, "audio", "voices") }
				hx-encoding="multipart/form-data"
				hx-target="#editor-actions"
				hx-swap="outerHTML"
				hx-disabled-elt="find button"
				hx-vals={ branchVals(d.BranchID) }
				class="flex flex-wrap items-end gap-3"
				aria-label="音声クローン"
			>
				<label class="flex flex-col gap-1 text-xs text-neutral-400">
					話者名（脚本の「話者: セリフ」の話者）
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{
						"type":      "text",
						"name":      "speaker",
						"required":  true,
						"maxlength": "20",
					})
				</label>
				<label class="flex flex-col gap-1 text-xs text-neutral-400">
					声のサンプル（10 MB 以下。数十秒の録音）
					<input type="file" name="sample" required accept="audio/*" class="text-sm text-neutral-100"/>
				</label>
				@atoms.Button(atoms.ToneNeutral, "声をクローン", templ.Attributes{"type": "submit"})
			</form>
			if len(d.Voices) > 0 {
				<ul class="flex flex-col gap-1 text-xs text-neutral-300" data-audio-voices>
					for _, v := range d.Voices {
						<li>{ v.Speaker + "（クローン音声）" }</li>
					}
				</ul>
			}
		</section>
		<section class="flex flex-col gap-2" aria-label="Final QC">
			<h3 class="text-sm font-semibold">4. Final QC</h3>
			<div class="flex items-center gap-3">
				@atoms.Button(atoms.ToneNeutral, "Final QC を実行", templ.Attributes{
					"type": "button", "hx-post": paths.Project(d.Project.ID, "final-qc"), "hx-vals": branchVals(d.BranchID),
					"hx-target": "#editor-actions", "hx-swap": "outerHTML", "hx-disabled-elt": "this", "disabled": !d.CanFinalQC(),
				})
				if d.QC != nil {
					@atoms.Badge(verdictTone(d.QC.Verdict == domain.FinalQCPass), qcLabel(d.QC.Verdict))
				}
			</div>
			if d.FinalQCBlockedByTrunk() {
				<p class="text-xs text-amber-300" data-qc-trunk-missing>トランクの音声を先に作成してください。Final QC はトランクの音声を検査します。</p>
			}
			if d.BranchID != "" {
				<p class="text-xs text-neutral-400" data-qc-trunk-note>Final QC は Branch ではなく、主系列（トランク）の最新版を検査します。</p>
			}
			if d.QC != nil && len(d.QC.Findings) > 0 {
				<ul class="flex flex-col gap-1 text-sm" data-qc-findings>
					for _, f := range d.QC.Findings {
						<li>{ f.Message }</li>
					}
				</ul>
			}
		</section>
		<section class="flex flex-col gap-2" aria-label="Export">
			<h3 class="text-sm font-semibold">5. 書き出し</h3>
			<form
				hx-post={ paths.Project(d.Project.ID, "export") }
				hx-target="#editor-actions"
				hx-swap="outerHTML"
				hx-disabled-elt="find button"
				hx-vals={ branchVals(d.BranchID) }
				class="flex flex-wrap items-end gap-3"
			>
				<label class="flex flex-col gap-1 text-xs text-neutral-400">
					Aspect Ratio
					@atoms.Select(atoms.FieldMd, "", templ.Attributes{
						"name": "aspect_ratio",
					}) {
						for _, o := range aspectOptions() {
							<option value={ o } selected?={ o == d.Defaults.AspectRatio }>{ o }</option>
						}
					}
				</label>
				<label class="flex flex-col gap-1 text-xs text-neutral-400">
					解像度
					@atoms.Select(atoms.FieldMd, "", templ.Attributes{
						"name": "resolution",
					}) {
						for _, o := range resolutionOptions() {
							<option value={ o } selected?={ o == d.Defaults.Resolution }>{ o }</option>
						}
					}
				</label>
				<label class="flex flex-col gap-1 text-xs text-neutral-400">
					コーデック
					@atoms.Select(atoms.FieldMd, "", templ.Attributes{
						"name": "codec",
					}) {
						for _, o := range codecOptions() {
							<option value={ o } selected?={ o == d.Defaults.Codec }>{ o }</option>
						}
					}
				</label>
				@atoms.Button(atoms.TonePrimary, "書き出す", templ.Attributes{"type": "submit", "disabled": !d.CanExport()})
			</form>
			if d.ExportBlocker() != "" {
				<p class="text-xs text-amber-300" data-export-blocked>{ d.ExportBlocker() }</p>
			}
			if len(d.Exports) > 0 {
				<ul class="flex flex-col gap-1 text-sm" data-exports>
					for _, e := range d.Exports {
						<li class="flex flex-wrap items-center gap-2">
							<a class="text-indigo-300 underline" href={ templ.SafeURL(exportURL(d.Project.ID, e.ID)) } download>{ e.ExportedAt.Local().Format("2006-01-02 15:04") + " の書き出し" }</a>
							<span class="text-xs text-neutral-400">{ e.AspectRatio + " / " + e.Resolution + " / " + e.Codec }</span>
						</li>
					}
				</ul>
			}
		</section>
	</div>
}

func qcLabel(v domain.FinalQCVerdict) string {
	if v == domain.FinalQCPass {
		return "PASS"
	}
	return "FAIL"
}
