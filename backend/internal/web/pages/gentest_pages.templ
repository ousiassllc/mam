package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	gentest "github.com/ousiassllc/mam/backend/internal/web/organisms/gentest"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// generationNav is the links between the pages of the generation test: tabs, the current one lit.
templ generationNav(current string) {
	<nav class="flex flex-wrap gap-1 border-b border-neutral-800 pb-2 text-sm" aria-label="生成テスト">
		for _, l := range []struct{ Key, Label, Href string }{
			{"new", "生成する", paths.GenerationTest()},
			{"match", "画像から似せる", paths.GenerationTestMatch()},
			{"history", "履歴", paths.GenerationTestHistory()},
			{"prompts", "プロンプト履歴", paths.GenerationTestPrompts()},
		} {
			if l.Key == current {
				<span class="rounded-md bg-neutral-800 px-3 py-1.5 font-medium text-neutral-100" aria-current="page">{ l.Label }</span>
			} else {
				<a class="rounded-md px-3 py-1.5 text-neutral-400 transition-colors hover:bg-neutral-800/60 hover:text-neutral-100 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-400 motion-reduce:transition-none" href={ templ.SafeURL(l.Href) }>{ l.Label }</a>
			}
		}
	</nav>
}

// generationShell is the frame of every page of the generation test: it belongs to no Project. The lead (what the page is
// for) is behind the "?" beside the title.
templ generationShell(title, csrfToken, current, lead string) {
	@layout.AppLayout(title, csrfToken, sidenav.At(sidenav.GenerationTest)) {
		@pagehead.Main(pagehead.Wide) {
			@pagehead.Header(title, "", lead)
			@generationNav(current)
			{ children... }
		}
	}
}

// GenerationTestPage is GET /generation-test: choose models and prompts, see the estimate, run, compare.
templ GenerationTestPage(csrfToken string, c gentest.Compose) {
	@generationShell("生成テスト", csrfToken, "new", "プロジェクトに属さない画像・動画の生成です。モデルとプロンプトを組み合わせて並べて比べ、気に入った結果だけプロジェクトに取り込めます。結果は Take・コスト台帳には入りません。") {
		@gentest.ComposeForm(c)
		@gentest.ConfirmEmpty()
		@gentest.BatchEmpty()
		@modal.Host()
	}
}

// GenerationMatchPage is GET /generation-test/match: from one reference image the AI writes a prompt and fixes it until the generated image looks like it.
templ GenerationMatchPage(csrfToken string, c gentest.MatchCompose) {
	@generationShell("画像から似せる", csrfToken, "match", "参考の画像から英語のプロンプトを作り、似るまで直して生成し直します。作ったプロンプトと各回の結果は履歴に残り、いちばん似ていた回のプロンプトをそのまま使えます。") {
		@gentest.MatchForm(c)
		@gentest.ConfirmEmpty()
		@gentest.MatchEmpty()
	}
}

// GenerationHistoryPage is GET /generation-test/history.
templ GenerationHistoryPage(csrfToken string, h gentest.History) {
	@generationShell("生成テストの履歴", csrfToken, "history", "これまでの生成結果（新しい順）。削除するまで残ります。") {
		@gentest.HistoryList(h)
	}
}

// GenerationResultPage is GET /generation-test/results/:id.
templ GenerationResultPage(csrfToken string, d gentest.Detail) {
	@generationShell("生成結果", csrfToken, "history", "この結果を作った設定と入力です。プロジェクトに取り込めます。") {
		@gentest.ResultDetail(d)
	}
}

// GenerationPromptsPage is GET /generation-test/prompts.
templ GenerationPromptsPage(csrfToken string, p gentest.Prompts) {
	@generationShell("プロンプト履歴", csrfToken, "prompts", "生成テストで使ったプロンプト（同じ組は 1 件）。生成結果とは別に、削除するまで残ります。") {
		@gentest.PromptHistory(p)
	}
}
