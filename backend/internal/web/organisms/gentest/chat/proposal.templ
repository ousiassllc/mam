package chat

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/gentest/resulttile"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ProposalCard is the confirmation card of an estimate: what will be made, the total and the breakdown, and the two buttons. While it is open it is the only way a
// generation starts. The server holds the request and the estimate of the card; the button sends only the id of the card. Both buttons post to the thread: the
// closed card comes back out of band, and a refusal is a line added to the thread, so a failed press never takes the live card (and its buttons) away.
templ ProposalCard(p Proposal) {
	<section
		id={ ID(p.ID) }
		class="flex flex-col gap-3 rounded-lg border border-accent p-3 md:p-4"
		data-testid="gtc-proposal"
		data-state={ p.State }
		if p.Swap {
			hx-swap-oob="true"
		}
	>
		<h3 class="text-sm font-semibold">実行の確認</h3>
		<dl class="flex flex-col gap-1 text-sm" data-testid="gtc-facts">
			for _, kv := range p.Facts {
				<div class="flex flex-wrap gap-x-2">
					<dt class="text-mute">{ kv.Key }</dt>
					<dd class="break-words text-ink">{ kv.Value }</dd>
				</div>
			}
		</dl>
		<ul class="flex flex-col gap-1 text-sm" data-testid="gtc-prompts">
			for _, t := range p.Prompt {
				<li class="rounded-md bg-accent-soft px-2 py-1">
					<span class="whitespace-pre-wrap break-words">{ t.Text }</span>
					if t.Negative != "" {
						<span class="block whitespace-pre-wrap break-words text-xs text-mute">ネガティブ: { t.Negative }</span>
					}
				</li>
			}
		</ul>
		<p class="text-sm" data-testid="gtc-items">全部で <strong>{ itoa(p.Items) }</strong> 件を生成します。見積り合計は <strong data-testid="gtc-total">{ p.Total }</strong>（合計は見積りで、実際の請求は提供元で確認してください）。</p>
		<div class="overflow-x-auto">
			<table class="w-full min-w-max text-left text-sm" data-testid="gtc-lines">
				<thead class="text-xs text-mute">
					<tr><th class="py-1 pr-3 font-normal">モデル</th><th class="py-1 pr-3 font-normal">件数</th><th class="py-1 pr-3 font-normal">単価</th><th class="py-1 font-normal">小計</th></tr>
				</thead>
				<tbody>
					for _, l := range p.Lines {
						<tr class="border-t border-border" data-testid="gtc-line">
							<td class="py-1 pr-3">{ l.Label }</td>
							<td class="py-1 pr-3">{ itoa(l.Items) }</td>
							<td class="py-1 pr-3">{ l.Unit }</td>
							<td class="py-1">{ l.Subtotal }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if p.Unknown != "" {
			<p class="text-sm text-warning" data-testid="gtc-unknown">{ p.Unknown }</p>
		}
		if len(p.Warnings) > 0 {
			<ul class="list-disc pl-5 text-xs text-warning" data-testid="gtc-warnings">
				for _, w := range p.Warnings {
					<li>{ w }</li>
				}
			</ul>
		}
		if p.Open {
			<div class="flex flex-wrap items-center gap-2">
				<form
					hx-post={ confirmPath(p.ID) }
					hx-target={ "#" + ThreadID }
					hx-swap="beforeend"
					hx-sync="this:drop"
					hx-disabled-elt="find button"
				>
					<input type="hidden" name={ FieldSession } value={ p.SessionID }/>
					@atoms.Button(atoms.TonePrimary, "この内容で実行する", templ.Attributes{"type": "submit", "data-testid": "gtc-run"})
				</form>
				<form
					hx-post={ dismissPath(p.ID) }
					hx-target={ "#" + ThreadID }
					hx-swap="beforeend"
					hx-sync="this:drop"
					hx-disabled-elt="find button"
				>
					<input type="hidden" name={ FieldSession } value={ p.SessionID }/>
					@atoms.Button(atoms.ToneNeutral, "やめる", templ.Attributes{"type": "submit", "data-testid": "gtc-dismiss"})
				</form>
			</div>
		} else {
			<p class="text-sm text-mute" data-testid="gtc-closed">
				{ p.StateText }
				if p.Reason != "" {
					<span class="block break-words text-danger">{ p.Reason }</span>
				}
			</p>
		}
	</section>
}

// ResultBlock shows the results of a batch the user confirmed: its progress, and a tile per result (a tap opens the result in the modal of the screen). While
// anything waits or runs it asks for itself, and only itself, again every 2 seconds. The thread is a polite live region that announces additions, and every
// swap adds a new block, so a running block turns the announcement off (`aria-live="off"`): a screen reader does not read the progress again every 2 seconds.
// The block that comes back finished has no such attribute, so it is read once, as an addition to the thread.
templ ResultBlock(r Result) {
	<section
		id={ ResultID(r.BatchID) }
		class="flex flex-col gap-3 rounded-lg border border-border p-3 md:p-4"
		data-testid="gtc-result"
		data-state={ r.State }
		if !r.Finished {
			aria-live="off"
			hx-get={ batchPath(r.BatchID) }
			hx-trigger={ Polling }
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		<div class="flex flex-wrap items-center gap-2">
			<h3 class="text-sm font-semibold">生成の結果</h3>
			@atoms.BadgeWith(r.Tone, r.StateTxt, templ.Attributes{"data-testid": "gtc-result-state"})
			<span class="text-xs text-mute" data-testid="gtc-result-progress">{ itoa(r.Done) } / { itoa(r.Total) } 件（{ r.Counts }）</span>
			if r.Estimate != "" {
				<span class="text-xs text-mute">見積り { r.Estimate }</span>
			}
		</div>
		if !r.Finished {
			<progress class="h-2 w-full" max="100" value={ itoa(r.Percent) } aria-label="生成の進み具合"></progress>
		}
		if r.Error != "" {
			<p class="break-words text-sm text-danger">{ r.Error }</p>
		}
		<ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4" data-testid="gtc-tiles">
			for _, t := range r.Tiles {
				<li class="flex min-w-0 flex-col gap-1">
					@resulttile.Tile(t.Card, false)
					<span class="truncate text-xs text-mute">{ t.Model }</span>
				</li>
			}
		</ul>
		<p class="text-xs text-mute">タップすると詳細（プロンプト・設定・取り込み）が開きます。<a class="underline focus-visible:focus-ring" href={ templ.SafeURL(paths.GenerationTestHistory()) }>履歴</a>にも残ります。</p>
	</section>
}
