package molecules

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
	"github.com/ousiassllc/mam/backend/internal/web/selector"
)

// ShotCardData is a Shot with its storyboard frame and Takes.
type ShotCardData struct {
	ProjectID  string
	Shot       domain.Shot
	Storyboard *domain.ShotStoryboard // nil when the Shot has no storyboard frame
	Takes      []domain.Take
	Selected   bool
	// Repairable holds the Takes (by ID) whose Repair the server accepts now (domain.CheckRepair):
	// only they get a Repair button.
	Repairable map[string]bool
	// Candidates is whether 生成 starts Prompt Candidate Generation (the Quality Policy calls for it).
	Candidates bool
	// Judgeable holds the unjudged Takes (by ID) whose Judge run the server accepts now (domain.CheckJudge).
	Judgeable map[string]bool
}

func secondsText(d float64) string { return fmt.Sprintf("%.1f 秒", d) }

// shotURL selects the Shot on the Scene page.
func shotURL(projectID, sceneID, shotID string) string {
	return paths.Project(projectID, "scenes", sceneID) + "?shot=" + url.QueryEscape(shotID)
}

// inspectorURL is the Shot Inspector page.
func inspectorURL(shotID string) string { return paths.Shot(shotID) }

// SelectedParam is the request value in which a Take button says whether its Shot card is the selected one.
const SelectedParam = "selected"

// selectedVals is the hx-vals that make a Take button send SelectedParam.
func selectedVals(selected bool) string {
	return atoms.HxVals(map[string]string{SelectedParam: strconv.FormatBool(selected)})
}

func shotActionURL(shotID string, action ...string) string { return paths.Shot(shotID, action...) }

// generateURL is where the 生成 button of a Shot posts: Prompt Candidate Generation when the Quality
// Policy calls for it (domain-side decision, service marks it), the single generation otherwise.
func generateURL(shotID string, candidates bool) string {
	if candidates {
		return shotActionURL(shotID, "generate", "candidates")
	}
	return shotActionURL(shotID, "generate")
}

func shotProgressURL(shotID string) string { return paths.ShotProgress(shotID) }

// showsProgressPlayer reports whether the card carries a mam-video-player that follows the Shot's
// progress itself. That player is then the card's only /ws/shots/:id connection; shot.ts waits for its
// progress-finished. A card without one (repairing) is followed by shot.ts over data-ws-url.
func showsProgressPlayer(s domain.Shot) bool {
	return s.State == domain.ShotGenerating || s.State == domain.ShotJudging
}

func takeComparisonURL(shotID string) string { return paths.Shot(shotID, "takes") }

// shotTarget is the hx-target of the card of a Shot (id "shot-<id>"). IDs are limited to
// [A-Za-z0-9_-] (bundlepath.ValidID); the escape is defence in depth, were that limit ever relaxed.
func shotTarget(shotID string) string { return selector.ID("shot-", shotID) }

func takeJudgeResultURL(takeID string) string { return paths.APITake(takeID, "judge-result") }

func takeActionURL(takeID, action string) string { return paths.Take(takeID, action) }

// ShotActions starts the generation of a Shot (optionally with an additional direction) or the
// building of its Reference Pack. Both answer with the Shot card in the GENERATING state. The card
// draws them only while the Shot is not busy (domain.ShotState.Busy): the server refuses them then.
// "続きを作る" is drawn only when Continue is accepted (domain.CanContinue: a Take that was not rejected).
// The input is hx-preserve (its id is unique per Shot): the Take buttons of the card answer with the whole
// card, and htmx then keeps the input on the page, with what is typed in it, instead of the new empty one.
templ ShotActions(shotID string, canContinue bool, candidates bool) {
	<form
		class="mt-2 flex flex-wrap items-center gap-2"
		hx-post={ generateURL(shotID, candidates) }
		hx-target={ shotTarget(shotID) }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
	>
		<label class="sr-only" for={ "instruction-" + shotID }>追加の指示</label>
		@atoms.Input(atoms.FieldMd, "min-w-0 flex-1", templ.Attributes{
			"id":          "instruction-" + shotID,
			"hx-preserve": true,
			"name":        "additional_instruction",
			"type":        "text",
			"maxlength":   strconv.Itoa(domain.MaxInstructionRunes),
			"placeholder": "追加の指示（任意。例: もう少しカメラを寄せて）",
		})
		@atoms.Button(atoms.TonePrimary, "生成", templ.Attributes{"type": "submit"})
		@atoms.Button(atoms.ToneNeutral, "Reference Pack", templ.Attributes{
			"type":      "button",
			"hx-post":   shotActionURL(shotID, "reference-pack"),
			"hx-target": shotTarget(shotID),
			"hx-swap":   "outerHTML",
		})
		if canContinue {
			@atoms.Button(atoms.ToneNeutral, "続きを作る", templ.Attributes{
				"type":            "button",
				"hx-post":         shotActionURL(shotID, "continue"),
				"hx-swap":         "none",
				"hx-disabled-elt": "this",
			})
		}
	</form>
}

// TakeRow is one Take under a Shot: its status, and the buttons that select it (the user's choice
// replaces the AI Pick) or exclude it, and the one that repairs it. They answer with the Shot card,
// which has to be drawn as selected or not like the card they replace: the buttons send that in
// "selected" (selected is whether the card they sit on is the selected one). The Repair button is
// left out unless the server accepts it (domain.CheckRepair): the Take is judged and not accepted, and
// the Shot is not busy (generating or repairing). The Judge button runs the AI Video Judge on a Take that
// has no result (never judged, or the run failed); it is drawn only when domain.CheckJudge accepts it.
templ TakeRow(t domain.Take, selected bool, repairable bool, judgeable bool) {
	<li class="flex items-center justify-between gap-2 text-xs text-neutral-300">
		<span class="truncate">{ t.ModelName }</span>
		<span class="flex shrink-0 items-center gap-2">
			if t.Usable() {
				if t.Selectable() {
					@atoms.LinkButton(atoms.ToneNeutral, "選択", templ.Attributes{
						"type":      "button",
						"hx-post":   takeActionURL(t.ID, "select"),
						"hx-target": shotTarget(t.ShotID),
						"hx-swap":   "outerHTML",
						"hx-vals":   selectedVals(selected),
					})
				}
				@atoms.LinkButton(atoms.ToneNeutral, "除外", templ.Attributes{
					"type":       "button",
					"hx-delete":  paths.Take(t.ID),
					"hx-target":  shotTarget(t.ShotID),
					"hx-swap":    "outerHTML",
					"hx-confirm": "この Take を除外しますか？",
					"hx-vals":    selectedVals(selected),
				})
			}
			@TakeStatusBadge(t.Status)
			if judgeable {
				@atoms.Button(atoms.ToneNeutral, "Judge", templ.Attributes{
					"type":      "button",
					"hx-post":   paths.Take(t.ID, "judge"),
					"hx-target": shotTarget(t.ShotID),
					"hx-swap":   "outerHTML",
					"hx-vals":   selectedVals(selected),
				})
			}
			if repairable {
				@atoms.Button(atoms.ToneNeutral, "Repair", templ.Attributes{
					"type":      "button",
					"hx-post":   paths.Take(t.ID, "repair"),
					"hx-target": shotTarget(t.ShotID),
					"hx-swap":   "outerHTML",
					"hx-vals":   selectedVals(selected),
				})
			}
		</span>
	</li>
}

// storyboardRows are the labelled lines of a storyboard frame that are not empty.
func storyboardRows(f domain.ShotStoryboard) [][2]string {
	var rows [][2]string
	for _, r := range [][2]string{
		{"画", f.Description}, {"サイズ", f.Framing}, {"カメラ", f.Camera},
		{"構図", f.Composition}, {"動き", f.Action}, {"セリフ", f.Dialogue},
	} {
		if r[1] != "" {
			rows = append(rows, r)
		}
	}
	return rows
}

// ShotCard is a Shot of the selected Scene: its objective, duration and state. Selecting it
// opens the storyboard frame; its Takes are listed below.
templ ShotCard(d ShotCardData) {
	<li
		id={ "shot-" + d.Shot.ID }
		class={ "rounded-md border p-3", templ.KV("border-indigo-400 bg-indigo-500/10", d.Selected), templ.KV("border-neutral-700 bg-neutral-900", !d.Selected) }
		if d.Selected {
			aria-current="true"
		}
		if d.Shot.State == domain.ShotGenerating || d.Shot.State == domain.ShotJudging || d.Shot.State == domain.ShotRepairing {
			data-shot-progress
			data-refresh-url={ shotURL(d.ProjectID, d.Shot.SceneID, d.Shot.ID) }
			if !showsProgressPlayer(d.Shot) {
				data-ws-url={ shotProgressURL(d.Shot.ID) }
			}
		}
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<a
				class="min-w-0 flex-1 font-medium hover:underline"
				href={ templ.SafeURL(shotURL(d.ProjectID, d.Shot.SceneID, d.Shot.ID)) }
				hx-get={ shotURL(d.ProjectID, d.Shot.SceneID, d.Shot.ID) }
				hx-target="#scene-shot-view"
				hx-swap="outerHTML"
				hx-push-url="true"
			>{ fmt.Sprintf("Shot %d: %s", d.Shot.OrderIndex+1, d.Shot.Objective) }</a>
			<span class="flex items-center gap-2 text-xs text-neutral-400">
				<a href={ templ.SafeURL(inspectorURL(d.Shot.ID)) } class="underline hover:text-neutral-100">Inspector</a>
				<span>{ secondsText(d.Shot.Duration) }</span>
				if d.Shot.State == domain.ShotGenerating {
					@atoms.Spinner("生成中")
				}
				if d.Shot.State == domain.ShotJudging {
					@atoms.Spinner("Judge 中")
				}
				if d.Shot.State == domain.ShotRepairing {
					@atoms.Spinner("Repair 中")
				}
				@atoms.Badge(atoms.BadgeNeutral, ShotStateLabel(d.Shot.State))
			</span>
		</div>
		if d.Selected && d.Storyboard != nil {
			<dl class="mt-2 grid grid-cols-[4rem_1fr] gap-x-2 gap-y-1 text-sm">
				for _, row := range storyboardRows(*d.Storyboard) {
					<dt class="text-neutral-400">{ row[0] }</dt>
					<dd class="whitespace-pre-wrap break-words">{ row[1] }</dd>
				}
			</dl>
		}
		if d.Selected && !d.Shot.State.Busy() {
			@ShotActions(d.Shot.ID, domain.CanContinue(d.Shot.State, d.Takes), d.Candidates)
		}
		if showsProgressPlayer(d.Shot) {
			<mam-video-player class="mt-2 block" ws-url={ shotProgressURL(d.Shot.ID) }></mam-video-player>
		}
		if len(d.Takes) > 0 {
			<ul class="mt-2 flex flex-col gap-1 border-t border-neutral-800 pt-2" aria-label="Take 一覧">
				for _, t := range d.Takes {
					@TakeRow(t, d.Selected, d.Repairable[t.ID], d.Judgeable[t.ID])
				}
			</ul>
			if len(d.Takes) > 1 {
				<a href={ templ.SafeURL(takeComparisonURL(d.Shot.ID)) } class="mt-1 inline-block text-xs text-neutral-400 underline hover:text-neutral-100">Take 比較</a>
			}
		} else if d.Selected {
			<p class="mt-2 text-xs text-neutral-500">Take はまだありません。</p>
		}
	</li>
}
