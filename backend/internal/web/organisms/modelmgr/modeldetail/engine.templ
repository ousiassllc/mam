package modeldetail

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	view "github.com/ousiassllc/mam/backend/internal/web/organisms/modelmgr"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// EngineDetail is the body of the modal that the card of the engine opens (#970): what the engine is, why it cannot run here (when it cannot),
// the version, the address, the place it is installed in, and where it comes from and its license. The card says none of it.
templ EngineDetail(e view.Engine) {
	{{ tone, label := view.EngineBadge(e) }}
	@modal.Frame(view.EngineName, "画像・動画のモデルを動かす ComfyUI を、mam が取得して起動・停止します。インストーラーには含まれず、ここから導入します。") {
		<div class={ "flex flex-wrap items-center gap-2", modal.StartClass } tabindex="-1" autofocus data-testid="mm-engine-detail" data-engine={ view.EnginePhase(e) }>
			@atoms.Badge(tone, label)
		</div>
		switch view.EnginePhase(e) {
			case "unsupported":
				<p class="rounded-md border border-amber-500/60 bg-amber-500/10 p-3 text-sm text-amber-300" role="note" data-testid="mm-engine-unsupported">
					同梱の ComfyUI は Windows 版のデスクトップアプリだけで使えます。この環境（ブラウザ版・サーバー版）では、別に動かしている ComfyUI の URL を
					<a class="underline" href={ templ.SafeURL(paths.Settings()) }>設定</a>の「ローカル・代替モデル」に登録して使ってください（モデルの導入は、その ComfyUI の側で行います）。
				</p>
			case "readonly":
				<div class="flex flex-col gap-1 rounded-md border border-amber-500/60 bg-amber-500/10 p-3 text-sm text-amber-300" role="alert" data-testid="mm-engine-readonly">
					<p>mam.exe のあるフォルダ（{ e.Dir }）に書き込めません。書き込める場所に置き直すか、外部の ComfyUI の URL を設定してください。</p>
					<p class="text-xs">{ e.WritableError }</p>
				</div>
			case "broken":
				<p class="text-sm text-amber-300" role="alert" data-testid="mm-engine-broken">導入済みの記録がありますが、エンジンのファイルが見つかりません。もう一度導入してください。</p>
		}
		<dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs text-neutral-300" data-testid="mm-engine-facts">
			if view.EnginePhase(e) == "installed" {
				<div class="col-span-2">
					<dt class="text-neutral-400">導入済み</dt>
					<dd>
						ComfyUI { e.Version }（{ e.VariantLabel }
						if e.CPU {
							・CPU 実行
						}
						）
					</dd>
				</div>
				if e.State == "running" {
					<div class="col-span-2"><dt class="text-neutral-400">待ち受け（この PC の中だけ）</dt><dd><code data-testid="mm-engine-url">{ e.URL }</code></dd></div>
				}
				if e.UpdateAvailable {
					<div class="col-span-2 text-amber-300" data-testid="mm-engine-update-note"><dt>更新</dt><dd>固定版 { e.PinnedVersion } があります（導入済み: { e.Version }）</dd></div>
				}
			}
			if e.Supported && e.Writable {
				<div class="col-span-2">
					<dt class="text-neutral-400">導入先（空き { e.Free }）</dt>
					<dd><code class="break-all" data-testid="mm-engine-dir">{ e.Dir }</code></dd>
				</div>
			}
		</dl>
		<p class="text-xs text-neutral-400">
			ComfyUI（GPL-3.0）は別のプログラムで、mam には含まれません。公式のリリース
			if e.PinnedVersion != "" {
				（{ e.PinnedVersion }）
			}
			を実行時に取得し、SHA-256 を確かめてから使います。
			if e.SourceURL != "" {
				<a class="underline" href={ templ.SafeURL(e.SourceURL) } target="_blank" rel="noopener noreferrer">ソース</a>
			}
			if e.LicenseURL != "" {
				／ <a class="underline" href={ templ.SafeURL(e.LicenseURL) } target="_blank" rel="noopener noreferrer">{ e.LicenseName }</a>
			}
		</p>
		@modal.Actions() {
			@atoms.Button(atoms.TonePrimary, "閉じる", templ.Attributes{"type": "button", "data-modal-close": true})
		}
	}
}
