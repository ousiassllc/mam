package gentestinpaint

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

const outID = "gt-inpaint-out"

// Form is the partial-redraw screen: the source, the mask painter, the prompt and the models that can redraw.
templ Form(p Page) {
	<form
		id="gt-inpaint"
		class="flex flex-col gap-4"
		enctype="multipart/form-data"
		hx-post={ paths.GenerationTestPart("inpaint", "estimate") }
		hx-target={ "#" + outID }
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type=submit]"
		data-testid="gt-inpaint-form"
	>
		if p.Error != "" {
			<p class="text-sm text-red-300" role="alert" data-testid="gt-inpaint-error">{ p.Error }</p>
		}
		<div class="flex flex-col gap-2">
			<h2 class="text-sm font-medium">元画像</h2>
			if p.SourceRef != "" {
				if p.SourceLabel != "" {
					<p class="text-xs text-neutral-400">{ p.SourceLabel }</p>
				}
				<input type="hidden" name="ref" value={ p.SourceRef }/>
			} else {
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-inpaint-source">
					<span>画像ファイル（PNG・JPEG・WebP）。履歴やプロジェクトの画像は、その画面のリンクからも開けます。</span>
					<input id="gt-inpaint-source" class="text-sm text-neutral-200" type="file" name="source" accept="image/png,image/jpeg,image/webp"/>
				</label>
			}
			<mam-mask-paint src={ p.SourceURL } source-input="gt-inpaint-source" data-testid="gt-mask"></mam-mask-paint>
			<input type="file" name="mask" accept="image/png" hidden data-testid="gt-inpaint-mask"/>
		</div>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-inpaint-prompt">
			<span>プロンプト（描き直した部分の内容）</span>
			@atoms.Textarea(atoms.FieldMd, "min-h-20", templ.Attributes{"id": "gt-inpaint-prompt", "name": "prompt", "required": true, "maxlength": "4000"}, "")
		</label>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-inpaint-negative">
			<span>ネガティブ（省略可）</span>
			@atoms.Input(atoms.FieldMd, "", templ.Attributes{"id": "gt-inpaint-negative", "name": "negative", "type": "text", "maxlength": "4000"})
		</label>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-inpaint-denoise">
			<span>描き直しの強さ（{ p.Denoise }。空にするとモデルの既定）</span>
			<input id="gt-inpaint-denoise" name="denoise" type="range" min="0.05" max="1" step="0.05" value={ p.Denoise }/>
		</label>
		<fieldset class="flex flex-col gap-2">
			<legend class="text-sm font-medium">モデル</legend>
			if !p.HasModel {
				<p class="text-sm text-neutral-400" data-testid="gt-inpaint-none">一部だけ描き直せるモデルがありません。SDXL か FLUX.1 dev のインペイントを導入してください。</p>
			}
			for _, m := range p.Models {
				<label class="flex items-start gap-2 text-sm" data-testid="gt-inpaint-model">
					if m.On {
						<input type="radio" name="model" value={ m.ID } checked?={ m.Pick } required/>
					} else {
						<input type="radio" name="model" value={ m.ID } disabled/>
					}
					<span>
						{ m.Label }
						if !m.On {
							<span class="text-xs text-neutral-400">（{ m.Reason }）</span>
						} else {
							<span class="text-xs text-neutral-400">（既定 { strconv.FormatFloat(m.Denoise, 'f', -1, 64) }）</span>
						}
					</span>
				</label>
			}
		</fieldset>
		<label class="flex items-center gap-2 text-sm" data-testid="gt-inpaint-translate">
			<input type="checkbox" name="translate" value="1" checked?={ p.Translate }/>
			英語に訳して送る
		</label>
		if p.HasModel {
			@atoms.Button(atoms.TonePrimary, "見積りを見る", templ.Attributes{"type": "submit", "data-testid": "gt-inpaint-estimate"})
		}
	</form>
	<div id={ outID } data-testid="gt-inpaint-out"></div>
}

// Confirm is the estimate. Running posts the same inputs back.
templ Confirm(c Box) {
	<div id={ outID } class="flex flex-col gap-3 rounded-md border border-indigo-400 p-4" data-testid="gt-inpaint-confirm">
		<h2 class="text-sm font-medium">実行の確認</h2>
		<p class="text-sm">全部で <strong>{ strconv.Itoa(c.Items) }</strong> 件。見積り合計は <strong>{ c.Total }</strong> です。結果は元の画像とは別のファイルになり、元の結果へのリンクが残ります。</p>
		if len(c.Warnings) > 0 {
			<ul class="list-disc pl-5 text-xs text-amber-300">
				for _, w := range c.Warnings {
					<li>{ w }</li>
				}
			</ul>
		}
		if c.Over != "" {
			<p class="text-sm text-red-300" role="alert">{ c.Over }</p>
		}
		<form
			hx-post={ paths.GenerationTestPart("inpaint", "run") }
			hx-target={ "#" + outID }
			hx-swap="outerHTML"
			hx-disabled-elt="find button[type=submit]"
		>
			for _, h := range c.Hidden {
				<input type="hidden" name={ h.Name } value={ h.Value }/>
			}
			if c.Over == "" {
				@atoms.Button(atoms.TonePrimary, "この内容で実行する", templ.Attributes{"type": "submit", "data-testid": "gt-inpaint-run"})
			}
		</form>
	</div>
}

// Failed is an estimate or a run that was refused, in the place of the confirmation.
templ Failed(msg string) {
	<div id={ outID } class="rounded-md border border-red-500/60 p-4" data-testid="gt-inpaint-failed">
		<p class="text-sm text-red-300" role="alert">{ msg }</p>
	</div>
}

// Started says the redraw was queued. The history keeps the new file.
templ Started(history string) {
	<div id={ outID } class="rounded-md border border-emerald-500/60 p-4" data-testid="gt-inpaint-started">
		<p class="text-sm text-emerald-300" role="status">描き直しを始めました。結果は履歴に、元の画像とは別のファイルで残ります。</p>
		<a class="text-sm text-neutral-300 underline" href={ templ.SafeURL(history) }>履歴を見る</a>
	</div>
}
