package gentest

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// inputFields are the input images: files to upload, and images picked from a Project or from the history.
templ inputFields(c Compose) {
	<fieldset class="flex flex-col gap-3" data-testid="gt-inputs">
		<legend class="mb-1 text-xs text-neutral-400">
			入力画像（省略可。最大 { itoa(c.MaxReferences) } 枚。PNG・JPEG・WebP）。使えないモデルには渡さず、見積りで知らせます
		</legend>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-upload">
			<span>
				if c.Media == "video" {
					参照画像をアップロード（自由な参照。複数可）
				} else {
					参照画像をアップロード（複数可）
				}
			</span>
			<input id="gt-upload" type="file" name={ FieldUpload } multiple accept="image/png,image/jpeg,image/webp" class="text-sm"/>
		</label>
		if c.Media == "video" {
			<div class="flex flex-wrap gap-4">
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-first">
					<span>最初のフレーム</span>
					<input id="gt-first" type="file" name={ FieldFirst } accept="image/png,image/jpeg,image/webp" class="text-sm"/>
				</label>
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-last">
					<span>最後のフレーム</span>
					<input id="gt-last" type="file" name={ FieldLast } accept="image/png,image/jpeg,image/webp" class="text-sm"/>
				</label>
			</div>
		}
		<ul id={ RefsID } class="flex flex-col gap-2" data-testid="gt-refs">
			for _, r := range c.Picked {
				@RefRow(r, c.Media)
			}
		</ul>
		<div class="flex flex-wrap items-end gap-3">
			<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-project">
				<span>プロジェクトの画像から選ぶ</span>
				@atoms.Select(atoms.FieldMd, "max-w-xs", templ.Attributes{
					"id": "gt-project", "name": "project", "hx-get": paths.GenerationTestPart("picker"), "hx-trigger": "change",
					"hx-target": "#" + PickerID, "hx-swap": "innerHTML", "hx-include": "this",
				}) {
					<option value="">（選んでください）</option>
					for _, p := range c.Projects {
						<option value={ p.ID }>{ p.Name }</option>
					}
				}
			</label>
			@atoms.SmallButtonFor(atoms.ToneNeutral, "履歴の画像から選ぶ", "生成テストの履歴", templ.Attributes{
				"type": "button", "hx-get": paths.GenerationTestPart("picker") + "?source=history", "hx-target": "#" + PickerID, "hx-swap": "innerHTML",
			})
		</div>
		<div id={ PickerID } data-testid="gt-picker"></div>
	</fieldset>
}

// RefRow is a chosen input image: a checkbox (untick to leave it out) with its role.
templ RefRow(r Ref, media string) {
	<li class="flex items-center gap-3 rounded-md border border-neutral-800 p-2 text-sm" data-testid="gt-ref" data-ref={ r.Value }>
		<label class="flex items-center gap-2">
			<input type="checkbox" name={ FieldRef } value={ r.Value } checked?={ r.Checked }/>
			if r.ThumbURL != "" {
				<img class="h-12 w-12 rounded object-cover" src={ r.ThumbURL } alt={ r.Label }/>
			}
			<span>{ r.Label }</span>
		</label>
		if media == "video" {
			@atoms.Select(atoms.FieldSm, "", templ.Attributes{"name": FieldRolePrefix + r.Value, "aria-label": "役割: " + r.Label}) {
				for _, o := range roleOptions {
					<option value={ o.Value } selected?={ o.Value == r.Role }>{ o.Label }</option>
				}
			}
		} else {
			<input type="hidden" name={ FieldRolePrefix + r.Value } value="reference"/>
		}
	</li>
}

type roleOption struct{ Value, Label string }

var roleOptions = []roleOption{{"reference", "参照"}, {"first_frame", "最初のフレーム"}, {"last_frame", "最後のフレーム"}}

// Picker lists images that can be added to the inputs: each has an "追加" button that appends its row.
templ Picker(rows []Ref, media, empty string) {
	if len(rows) == 0 {
		<p class="text-xs text-neutral-400" data-testid="gt-picker-empty">{ empty }</p>
	}
	<ul class="grid gap-2 sm:grid-cols-3">
		for _, r := range rows {
			<li class="flex flex-col gap-1 rounded-md border border-neutral-800 p-2 text-xs" data-testid="gt-pick">
				if r.ThumbURL != "" {
					<img class="h-24 w-full rounded object-cover" src={ r.ThumbURL } alt={ r.Label }/>
				}
				<span class="break-words text-neutral-300">{ r.Label }</span>
				@atoms.SmallButtonFor(atoms.ToneNeutral, "追加", r.Label, templ.Attributes{
					"type": "button", "hx-get": paths.GenerationTestPart("ref-row") + "?ref=" + r.Value, "hx-target": "#" + RefsID, "hx-swap": "beforeend",
					"hx-include": "#" + ComposeID + " [name=media]",
				})
			</li>
		}
	</ul>
}
