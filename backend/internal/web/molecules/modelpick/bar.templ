package modelpick

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
)

// Bar is the filter bar of a list of models: the search box and the funnel that opens the panel of detailed filters (number of filters in force on it). A change of
// a control asks the server for the list again (hx-get of Action, with every field of the bar and of Include, into Target), so the list is what the server's
// modelfilter lets through; the text is sent a moment after the last key. The bar does not hold the list or the chips: they are in the results, which the answer
// replaces, so that the panel stays open while the list changes.
templ Bar(b Filter) {
	<div
		id={ b.ID }
		class="relative flex flex-col gap-2"
		data-model-pick-bar
		data-pick-key={ b.Key }
		data-testid="model-pick-bar"
		hx-get={ b.Action }
		hx-trigger="change, input from:find [data-mp-search] delay:300ms, search from:find [data-mp-search]"
		hx-include={ b.include() }
		hx-target={ b.Target }
		hx-swap="outerHTML"
		hx-sync="this:replace"
	>
		<input type="hidden" name={ KeyMarker } value="1" form={ FormNone }/>
		<div class="flex flex-wrap items-center gap-2">
			<label class="sr-only" for={ b.searchID() }>モデルを探す（名前・タグ）</label>
			@atoms.Input(atoms.FieldMd, "min-w-0 flex-1 sm:max-w-sm", templ.Attributes{
				"id": b.searchID(), "type": "search", "name": "q", "form": FormNone, "value": b.Cond.Text, "autocomplete": "off",
				"placeholder": "モデル名・タグで探す", "data-mp-search": true, "data-testid": "model-pick-search",
			})
			<button
				type="button"
				class="relative inline-flex cursor-pointer items-center gap-2 rounded-md border border-mute bg-bone px-3 py-1 text-sm text-ink hover:border-accent focus-visible:focus-ring"
				aria-expanded="false"
				aria-controls={ b.panelID() }
				data-mp-toggle
				data-testid="model-pick-toggle"
			>
				@atoms.Icon(atoms.IconFilter, "h-4 w-4 shrink-0")
				<span>絞り込み</span>
				@Count(b, false)
			</button>
		</div>
		@Panel(b, false)
	</div>
}

// Count is the number of filters in force, on the funnel: nothing while none is. oob draws it out of band (the answer to a chip).
templ Count(b Filter, oob bool) {
	<span
		id={ b.countID() }
		class="inline-flex min-w-5 items-center justify-center rounded-md bg-accent px-2 text-xs text-bone"
		hidden?={ b.Active() == 0 }
		data-testid="model-pick-count"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		if b.Active() > 0 {
			{ strconv.Itoa(b.Active()) }
			<span class="sr-only">件の絞り込み</span>
		}
	</span>
}

// Oob is what every answer to the bar's request carries besides the results: the number on the funnel and, for the answer to a chip or a button (which changed the
// condition without the panel), the panel itself. The screen's results end with it.
templ Oob(b Filter) {
	@Count(b, true)
	if b.Sync {
		@Panel(b, true)
	}
}

// include is the hx-include of the bar: its own fields (the search box and the panel's choices), and the selectors of the screen's (the models that are ticked).
func (b Filter) include() string {
	if b.Include == "" {
		return "#" + b.ID
	}
	return "#" + b.ID + ", " + b.Include
}

// clearInclude is the hx-include of a control that states the whole condition in its address (a chip, the clear button): the screen's own fields only, never the
// bar's (which the bar element's include would pass down, and the two would disagree). "unset" stops the inheritance.
func (b Filter) clearInclude() string {
	if b.Include == "" {
		return "unset"
	}
	return b.Include
}

func boolText(v bool) string {
	if v {
		return "true"
	}
	return "false"
}

// chipClass is the look of a chip of the panel's choices.
const chipClass = "inline-block rounded-md border border-border px-2 py-1 text-xs text-ink hover:border-mute peer-checked:border-accent peer-checked:bg-accent-soft peer-focus-visible:focus-ring"
