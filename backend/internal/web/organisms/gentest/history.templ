package gentest

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/commercial"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pick"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/refresh"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/gentest/exportbar"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/gentest/resulttile"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// HistoryID is the DOM id of the history list.
const HistoryID = "gt-history"

// HistoryLiveID is the DOM id of the part of the history that changes while something runs: the spend, the refresh button
// and the results. The filter is outside of it, so that a polling swap never takes a choice the reader is making.
const HistoryLiveID = "gt-history-live"

// HistoryList is the history (newest first) with its filter, the total spend, a refresh button and a button for the next page.
templ HistoryList(h History) {
	<section id={ HistoryID } class="flex flex-col gap-4" data-testid="gt-history">
		<form
			class="flex flex-wrap items-end gap-3"
			hx-get={ paths.GenerationTestHistory() }
			hx-target={ "#" + HistoryID }
			hx-swap="outerHTML"
			hx-push-url="true"
			data-testid="gt-filter"
		>
			<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-filter-model">
				<span>モデル</span>
				@atoms.Select(atoms.FieldMd, "max-w-xs", templ.Attributes{"id": "gt-filter-model", "name": FieldModel}) {
					<option value="">すべて</option>
					for _, m := range h.Models {
						<option value={ m } selected?={ m == h.Filter.Model }>{ m }</option>
					}
				}
			</label>
			<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-filter-media">
				<span>種類</span>
				@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": "gt-filter-media", "name": FieldMedia}) {
					<option value="">すべて</option>
					<option value="image" selected?={ h.Filter.Media == "image" }>画像</option>
					<option value="video" selected?={ h.Filter.Media == "video" }>動画</option>
				}
			</label>
			<label class="flex items-center gap-1 text-sm">
				<input type="checkbox" name="favorite" value="1" checked?={ h.Filter.Favorite }/>
				<span>お気に入りだけ</span>
			</label>
			@commercial.Choice(h.Commercial)
			@atoms.Button(atoms.ToneNeutral, "絞り込む", templ.Attributes{"type": "submit"})
		</form>
		@exportbar.Bar(h.Export)
		@HistoryLive(h)
	</section>
}

// HistoryLive is the part of the history that refreshes: the spend, when it was read and the refresh button, then the results
// and the button for the next page. While a result waits or runs it asks for itself again every 2 seconds, and stops when
// none does (the answer that shows the last one finished has no polling).
templ HistoryLive(h History) {
	<div
		id={ HistoryLiveID }
		class="flex flex-col gap-4"
		data-testid="gt-history-live"
		data-active={ boolText(h.Active) }
		if h.Active {
			hx-get={ h.Refresh }
			hx-trigger={ Polling }
			hx-swap="outerHTML"
		}
	>
		@notice(h.Message, "gt-history")
		<div class="flex items-center justify-between gap-3">
			<p class="text-sm text-neutral-300" data-testid="gt-spend">{ h.Spend }</p>
			@refresh.Bar(h.Refresh, HistoryLiveID, h.UpdatedAt)
		</div>
		if len(h.Cards) == 0 {
			<p class="text-sm text-neutral-400" data-testid="gt-history-empty">条件に合う結果はありません。</p>
		}
		<ul class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-3">
			for _, c := range h.Cards {
				<li id={ resulttile.ID(c.ID) } class="contents" data-testid="gt-history-item">
					@HistoryCard(c)
				</li>
			}
		</ul>
		if h.Next != "" {
			<div>
				@atoms.Button(atoms.ToneNeutral, "さらに表示", templ.Attributes{
					"type": "button", "hx-get": h.Next, "hx-target": "#" + HistoryID, "hx-swap": "outerHTML", "data-testid": "gt-more",
				})
			</div>
		}
	</div>
}

// HistoryCard is a result of the history: its tile (the picture, a badge of its state, the heart; a tap opens the detail in the modal, Issue #1004). A
// result that made a file can be chosen for the ZIP export (#932), as the model cards of the form are chosen (#906): a check box in the corner of the
// tile (a real checkbox, the peer of the frame, so the keyboard and a screen reader have it) lights the frame and holds the state, static/src/components/
// gentest/export-pick.ts keeps it over the refresh of the list; the detail offers the same choice. A card without a file is not offered.
templ HistoryCard(c resulttile.Card) {
	<div
		class="relative"
		if c.FileURL != "" {
			data-gt-pick={ c.ID }
		}
	>
		if c.FileURL != "" {
			<input type="checkbox" id={ "gt-pick-" + c.ID } class="peer sr-only" aria-label="書き出しに選ぶ" data-gt-pick-input data-testid="gt-pick"/>
		}
		<div class={ "overflow-hidden rounded-lg border border-neutral-800", pick.Glow }>
			@resulttile.Tile(c, true)
		</div>
		if c.FileURL != "" {
			<label
				for={ "gt-pick-" + c.ID }
				class="absolute left-1.5 top-1.5 z-10 flex h-6 w-6 cursor-pointer items-center justify-center rounded-md border border-neutral-600 bg-neutral-900 text-indigo-300 hover:border-indigo-400 peer-checked:border-indigo-400 peer-checked:bg-indigo-500/20 [&_svg]:opacity-0 peer-checked:[&_svg]:opacity-100"
				aria-hidden="true"
				data-testid="gt-pick-mark"
			>
				@atoms.Icon(atoms.IconCheck, "h-4 w-4")
			</label>
		}
	</div>
}
