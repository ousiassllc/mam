package organisms

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// SeriesMembership is on the World State page: the Series the Project belongs to, or the form
// that makes a Series of it (its Characters, Products and Locations become the canon).
templ SeriesMembership(p domain.Project) {
	<section aria-label="Series" class="mb-6 flex flex-col gap-2 rounded-md border border-neutral-700 p-3">
		<h2 class="text-sm font-semibold text-neutral-200">Series</h2>
		if p.SeriesID != "" {
			<a class="text-sm text-indigo-300 underline" href={ templ.SafeURL(paths.Series(p.SeriesID)) }>Series の正本と Episode を開く（この Project は第{ strconv.Itoa(p.EpisodeNumber) }話）</a>
		} else {
			<form class="flex flex-wrap items-end gap-2" hx-post={ paths.SeriesList() } hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
				<input type="hidden" name="from_project_id" value={ p.ID }/>
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="series-name">
					Series 名（この Project の Character / Product / Location を正本として登録します）
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{
						"id":          "series-name",
						"name":        "name",
						"type":        "text",
						"maxlength":   intText(domain.MaxSeriesNameRunes),
						"placeholder": p.Name,
					})
				</label>
				@atoms.Button(atoms.ToneNeutral, "Series にする", templ.Attributes{"type": "submit"})
			</form>
		}
	</section>
}
