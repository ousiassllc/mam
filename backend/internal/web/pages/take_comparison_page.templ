package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
)

// TakeComparisonPage is GET /shots/:id/takes: the Take comparison in an auxiliary view.
templ TakeComparisonPage(csrfToken string, d organisms.TakeComparisonData) {
	@layout.AppLayout("Take 比較: "+d.Project.Name, csrfToken) {
		<main class="mx-auto max-w-5xl p-8">
			@atoms.ChatBackLink(d.Project.ID)
			<p class="mb-6 mt-3 text-sm text-neutral-400">{ d.Project.Name }</p>
			@organisms.TakeComparison(d)
		</main>
	}
}
