package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/shotinspector"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ShotInspectorPage is GET /shots/:id: the Shot Inspector in an auxiliary view.
templ ShotInspectorPage(csrfToken string, d shotinspector.Data) {
	@layout.AppLayout("Shot Inspector: "+d.Project.Name, csrfToken, sidenav.InProject(sidenav.SceneShot, d.Project)) {
		@pagehead.Main(pagehead.Medium) {
			<div class="flex flex-col gap-3">
				@atoms.BackLink(shotInspectorBack(d))
				@pagehead.Header("Shot Inspector", d.Project.Name, "")
			</div>
			@shotinspector.View(d)
		}
	}
}

// shotInspectorBack is where "back" goes from the Inspector: the Scene page for a trunk Shot, the Branch
// page for a Branch Shot (a Branch's Scenes are not on the trunk's Scene pages, so that link is a 404).
func shotInspectorBack(d shotinspector.Data) (string, string) {
	if d.Scene.BranchID != "" {
		return paths.Branch(d.Scene.BranchID), "← Branch に戻る"
	}
	return paths.Project(d.Project.ID, "scenes", d.Scene.ID), "← Scene / Shot に戻る"
}
