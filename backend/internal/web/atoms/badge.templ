package atoms

// BadgeTone selects the badge colours.
type BadgeTone string

// Badge tones.
const (
	BadgeNeutral BadgeTone = "neutral"
	BadgeInfo    BadgeTone = "info"
	BadgeWarn    BadgeTone = "warn"
	BadgeOK      BadgeTone = "ok"
	BadgeError   BadgeTone = "error"
)

func badgeClass(tone BadgeTone) string {
	return "inline-block rounded-full px-2 py-1 text-xs " + badgeColors(tone)
}

// badgeColors are the colours of a tone: the background and the text (the palette of spec/components/color-rules.md).
func badgeColors(tone BadgeTone) string {
	switch tone {
	case BadgeInfo:
		return "bg-info/20 text-info"
	case BadgeWarn:
		return "bg-warning/20 text-warning"
	case BadgeOK:
		return "bg-success/20 text-success"
	case BadgeError:
		return "bg-danger/20 text-danger"
	}
	return "bg-accent-soft text-ink"
}

// Badge is a small status label.
templ Badge(tone BadgeTone, text string) {
	@BadgeWith(tone, text, nil)
}

// BadgeWith is a Badge whose element carries attrs too (an id, a data attribute, hx-swap-oob).
templ BadgeWith(tone BadgeTone, text string, attrs templ.Attributes) {
	<span class={ badgeClass(tone) } { attrs... }>{ text }</span>
}

// BadgeIcon is a Badge with an icon before the text (the way a model uses input images): the icon is decoration, the words say it.
templ BadgeIcon(tone BadgeTone, icon IconName, text string, attrs templ.Attributes) {
	<span class={ "inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs " + badgeColors(tone) } { attrs... }>
		@Icon(icon, "h-4 w-4 shrink-0")
		<span>{ text }</span>
	</span>
}
