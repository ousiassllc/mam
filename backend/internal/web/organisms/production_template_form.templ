package organisms

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pick"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// PolicyFormData is the state of a settings form. Errors are keyed by form field name; Typed holds the
// values of a rejected submission.
type PolicyFormData struct {
	Project   domain.Project
	Policy    domain.ProjectPolicy
	Effective domain.EffectivePolicy
	Errors    map[string]string
	Typed     map[string]string
	Saved     bool
}

// ProductionTemplateForm switches the Production Template (F-21) and shows the evaluation axes
// the Judge and the Editor use, from the highest priority to the lowest. A change is saved at once.
templ ProductionTemplateForm(d PolicyFormData) {
	<form
		id="production-template-form"
		class="flex flex-col gap-3"
		hx-put={ paths.Project(d.Project.ID, "production-template") }
		hx-trigger="change"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<fieldset class="flex flex-col gap-3">
			<legend class="sr-only">Production Template</legend>
			for _, t := range domain.ProductionTemplates() {
				@pick.Card(templ.Attributes{"type": "radio", "name": "production_template", "value": string(t), "checked": t == d.Policy.Template}, "flex flex-col gap-1 p-3") {
					<span class="text-sm font-medium">{ t.Label() }</span>
					<ol class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-mute">
						for i, a := range t.Axes() {
							<li>
								{ a.Label() } <span class="text-mute">{ axisWeightPercent(t, a) }</span>
								if i < len(t.Axes())-1 {
									<span aria-hidden="true">›</span>
								}
							</li>
						}
					</ol>
				}
			}
		</fieldset>
		if msg := d.Errors["production_template"]; msg != "" {
			<p class="text-sm text-danger" role="alert">{ msg }</p>
		}
	</form>
}
