package molecules

import (
	"slices"
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
)

// WorldStateFieldData is one field of the World State. Locked fields cannot be edited (F-10, §9.3).
type WorldStateFieldData struct {
	// ID is the DOM id of the input, unique on the page; the element around it has the id ID + "-field".
	ID     string
	Name   string // form field name
	Label  string
	Value  string
	Locked bool
	// OOB makes the field replace the one already on the page, so the response to a LOCK switch can
	// redraw this field alone (the other fields of the form keep what the user has typed).
	OOB bool
}

// WorldStateField is a labelled text input; when the field is LOCKed it is read-only and marked.
templ WorldStateField(d WorldStateFieldData) {
	<div
		id={ d.ID + "-field" }
		if d.OOB {
			hx-swap-oob="true"
		}
	>
		<label for={ d.ID } class="mb-1 flex items-center gap-2 text-xs text-neutral-400">
			{ d.Label }
			if d.Locked {
				@atoms.Badge(atoms.BadgeWarn, "LOCK")
			}
		</label>
		@atoms.Input(atoms.FieldMd, "w-full disabled:opacity-60", templ.Attributes{
			"id":        d.ID,
			"name":      d.Name,
			"type":      "text",
			"value":     d.Value,
			"maxlength": strconv.Itoa(domain.MaxWorldValueRunes),
			"disabled":  d.Locked,
		})
	</div>
}

// WorldStateSave is the save button of an entity's edit form (id is the DOM id of its element; subject names
// the entity in its accessible name). The inputs of
// LOCKed fields are disabled, so the browser does not send them: when every field is LOCKed a save would carry
// nothing and the server would refuse it (422), so the reason is shown instead of a button that always fails.
// oob makes it replace the one already on the page (the response to a LOCK switch).
templ WorldStateSave(id, subject string, fields []WorldStateFieldData, oob bool) {
	<div
		id={ id }
		if oob {
			hx-swap-oob="true"
		}
	>
		if slices.ContainsFunc(fields, func(f WorldStateFieldData) bool { return !f.Locked }) {
			@atoms.ButtonFor(atoms.TonePrimary, "保存", subject, templ.Attributes{"type": "submit"})
		} else {
			<p class="text-sm text-neutral-400" data-entity-edit-blocked>すべての項目が LOCK 中のため編集できません。</p>
		}
	</div>
}

// WorldStateReadonly is a labelled value that the user does not edit (Camera and Story follow the shots).
templ WorldStateReadonly(label, value string, locked bool) {
	<div class="flex items-baseline gap-2 text-sm">
		<dt class="w-40 shrink-0 text-xs text-neutral-400">{ label }</dt>
		<dd class="flex items-center gap-2">
			if value == "" {
				<span class="text-neutral-400">未設定</span>
			} else {
				{ value }
			}
			if locked {
				@atoms.Badge(atoms.BadgeWarn, "LOCK")
			}
		</dd>
	</div>
}
