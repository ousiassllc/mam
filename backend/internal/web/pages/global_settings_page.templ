package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// GlobalSettingsPage is GET /settings: the settings that belong to no Project (API keys, the LLM of
// each Agent and the image / video models).
templ GlobalSettingsPage(csrfToken string, d organisms.GlobalSettingsBodyData) {
	@layout.AppLayout("設定", csrfToken) {
		<main class="mx-auto flex max-w-3xl flex-col gap-8 p-8">
			<div>
				@atoms.BackLink(paths.Home(), "← プロジェクト一覧に戻る")
				<h1 class="mb-1 mt-3 text-xl font-semibold">設定</h1>
				<p class="text-sm text-neutral-400">すべてのプロジェクトで共通の設定です。</p>
			</div>
			@organisms.GlobalSettingsBody(d)
		</main>
	}
}
