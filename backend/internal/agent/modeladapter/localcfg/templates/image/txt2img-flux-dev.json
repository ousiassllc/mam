{
 "id": "txt2img-flux-dev",
 "label": "FLUX.1 dev: テキストから画像",
 "media": "image",
 "description": "ComfyUI 標準ノードだけの FLUX.1 dev（fp8 チェックポイント flux1-dev-fp8.safetensors）のワークフロー。FluxGuidance 3.5、20 ステップ、cfg 1。非商用ライセンスのモデル。GPU では未実行（構造のテストのみ）。",
 "model": {
  "media": "image",
  "workflow": {
   "graph": {
    "4": {
     "class_type": "CheckpointLoaderSimple",
     "inputs": {
      "ckpt_name": "flux1-dev-fp8.safetensors"
     }
    },
    "6": {
     "class_type": "CLIPTextEncode",
     "inputs": {
      "text": "",
      "clip": [
       "4",
       1
      ]
     }
    },
    "10": {
     "class_type": "FluxGuidance",
     "inputs": {
      "guidance": 3.5,
      "conditioning": [
       "6",
       0
      ]
     }
    },
    "11": {
     "class_type": "ConditioningZeroOut",
     "inputs": {
      "conditioning": [
       "6",
       0
      ]
     }
    },
    "5": {
     "class_type": "EmptySD3LatentImage",
     "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
     }
    },
    "3": {
     "class_type": "KSampler",
     "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
       "4",
       0
      ],
      "positive": [
       "10",
       0
      ],
      "negative": [
       "11",
       0
      ],
      "latent_image": [
       "5",
       0
      ]
     }
    },
    "8": {
     "class_type": "VAEDecode",
     "inputs": {
      "samples": [
       "3",
       0
      ],
      "vae": [
       "4",
       2
      ]
     }
    },
    "9": {
     "class_type": "SaveImage",
     "inputs": {
      "filename_prefix": "mam/image",
      "images": [
       "8",
       0
      ]
     }
    }
   },
   "assignments": [
    {
     "param": "prompt",
     "node": "6",
     "input": "text"
    },
    {
     "param": "seed",
     "node": "3",
     "input": "seed"
    },
    {
     "param": "width",
     "node": "5",
     "input": "width"
    },
    {
     "param": "height",
     "node": "5",
     "input": "height"
    }
   ],
   "output_node": "9"
  }
 }
}
