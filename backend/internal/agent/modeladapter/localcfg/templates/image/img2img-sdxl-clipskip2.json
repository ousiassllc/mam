{
 "id": "img2img-sdxl-clipskip2",
 "label": "SDXL（clip skip 2）: 参照画像から画像",
 "media": "image",
 "description": "参照画像 1 枚を VAEEncode して denoise 0.6 で描き直す SDXL 系ワークフロー。CLIPSetLastLayer で clip skip 2 にする（Pony Diffusion とその派生用）。標準ノードだけ。GPU では未実行（構造のテストのみ）。",
 "model": {
  "media": "image",
  "workflow": {
   "graph": {
    "4": {
     "class_type": "CheckpointLoaderSimple",
     "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
     }
    },
    "6": {
     "class_type": "CLIPTextEncode",
     "inputs": {
      "text": "",
      "clip": [
       "12",
       0
      ]
     }
    },
    "7": {
     "class_type": "CLIPTextEncode",
     "inputs": {
      "text": "",
      "clip": [
       "12",
       0
      ]
     }
    },
    "8": {
     "class_type": "VAEDecode",
     "inputs": {
      "samples": [
       "3",
       0
      ],
      "vae": [
       "4",
       2
      ]
     }
    },
    "9": {
     "class_type": "SaveImage",
     "inputs": {
      "filename_prefix": "mam/image",
      "images": [
       "8",
       0
      ]
     }
    },
    "10": {
     "class_type": "LoadImage",
     "inputs": {
      "image": "example.png"
     }
    },
    "11": {
     "class_type": "VAEEncode",
     "inputs": {
      "pixels": [
       "10",
       0
      ],
      "vae": [
       "4",
       2
      ]
     }
    },
    "3": {
     "class_type": "KSampler",
     "inputs": {
      "seed": 0,
      "steps": 25,
      "cfg": 7,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.6,
      "model": [
       "4",
       0
      ],
      "positive": [
       "6",
       0
      ],
      "negative": [
       "7",
       0
      ],
      "latent_image": [
       "11",
       0
      ]
     }
    },
    "12": {
     "class_type": "CLIPSetLastLayer",
     "inputs": {
      "stop_at_clip_layer": -2,
      "clip": [
       "4",
       1
      ]
     }
    }
   },
   "assignments": [
    {
     "param": "prompt",
     "node": "6",
     "input": "text"
    },
    {
     "param": "negative_prompt",
     "node": "7",
     "input": "text"
    },
    {
     "param": "seed",
     "node": "3",
     "input": "seed"
    },
    {
     "param": "reference_image",
     "node": "10",
     "input": "image",
     "index": 0
    }
   ],
   "output_node": "9"
  }
 }
}
