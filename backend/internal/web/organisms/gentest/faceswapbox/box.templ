package faceswapbox

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Box is the "swap the face" box of the detail of a result: one picture of a face, the three models, one button. The result is made as a
// result of its own in the history (and in the job list); the box says where it came from when this result is itself a swap.
templ Box(f Form) {
	if f.Show || f.SourceURL != "" {
		<div id={ ID } class="flex flex-col gap-2 rounded-md border border-border p-4" data-testid="gt-faceswap">
			if f.SourceURL != "" {
				<p class="text-sm" data-testid="gt-faceswap-source">
					<a class="underline" href={ templ.SafeURL(f.SourceURL) }>{ f.SourceText }</a>
				</p>
			}
			if f.Show {
				<h3 class="text-sm font-medium">顔を入れ替える（FaceFusion）</h3>
				if f.Notice != "" {
					<p class="text-sm text-success" role="status" data-testid="gt-faceswap-notice">{ f.Notice }</p>
				}
				if f.Error != "" {
					<p class="text-sm text-danger" role="alert" data-testid="gt-faceswap-error">{ f.Error }</p>
				}
				<ul class="flex list-disc flex-col gap-1 pl-5 text-xs text-warning" data-testid="gt-faceswap-notes">
					for _, n := range f.Notes {
						<li>{ n }</li>
					}
				</ul>
				if f.Problem != "" {
					<p class="text-sm text-mute" data-testid="gt-faceswap-problem">
						{ f.Problem }
						<a class="underline" href={ templ.SafeURL(f.SettingsURL) }>設定の「FaceFusion」</a>で、入れた場所を指定してください。
					</p>
				} else {
					<form
						class="flex flex-col gap-3"
						hx-post={ paths.GenerationTestPart("results", f.ResultID, "face-swap") }
						hx-encoding="multipart/form-data"
						hx-target={ "#" + ID }
						hx-swap="outerHTML"
						hx-sync="this:drop"
						hx-disabled-elt="find button[type=submit]"
					>
						<label class="flex flex-col gap-1 text-xs text-mute" for="gt-faceswap-face">
							<span>顔の画像（入れ替える顔。いちばん大きい顔が使われます。PNG・JPEG・WebP）</span>
							<input id="gt-faceswap-face" type="file" name={ FieldFace } accept="image/png,image/jpeg,image/webp" required data-testid="gt-faceswap-face"/>
						</label>
						<div class="flex flex-wrap items-end gap-3">
							@modelSelect("gt-faceswap-swapper", FieldSwapper, "入れ替えモデル", f.Swappers, f.WarningsURL)
							@modelSelect("gt-faceswap-detector", FieldDetector, "顔検出モデル", f.Detectors, f.WarningsURL)
							@modelSelect("gt-faceswap-enhancer", FieldEnhancer, "顔の復元モデル", f.Enhancers, f.WarningsURL)
						</div>
						@Warnings(f.Warnings)
						@atoms.Button(atoms.TonePrimary, "顔を入れ替える", templ.Attributes{"type": "submit", "data-testid": "gt-faceswap-submit"})
					</form>
				}
			}
		</div>
	}
}

// Warnings are the cautions of the models selected now; the three selects replace it (by WarningsID) when one changes. Empty when the models are
// cleared for commercial use.
templ Warnings(list []string) {
	<div id={ WarningsID } class="flex flex-col gap-1" data-testid="gt-faceswap-warnings" aria-live="polite">
		for _, w := range list {
			<p class="text-sm text-danger" role="alert">{ w }</p>
		}
	</div>
}

templ modelSelect(id, name, label string, choices []Choice, warningsURL string) {
	<label class="flex flex-col gap-1 text-xs text-mute" for={ id }>
		<span>{ label }</span>
		@atoms.Select(atoms.FieldMd, "max-w-xs", templ.Attributes{
			"id": id, "name": name, "data-testid": id,
			"hx-get": warningsURL, "hx-trigger": "change", "hx-include": "closest form", "hx-params": "swapper,detector,enhancer",
			"hx-target": "#" + WarningsID, "hx-swap": "outerHTML",
		}) {
			for _, c := range choices {
				<option value={ c.ID } selected?={ c.Selected }>{ c.Label }</option>
			}
		}
	</label>
}
