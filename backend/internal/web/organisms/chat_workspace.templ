package organisms

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ChatWorkspace is the standard screen: one Project = one chat thread (F-30). The way to the other views of the Project is
// the side menu (organisms/sidenav), not a menu of its own. It listens to /ws/projects/:id (see static/src/chat.ts) for new messages and card changes.
templ ChatWorkspace(p domain.Project, msgs []domain.ThreadMessage) {
	<main
		id="chat-workspace"
		class="mx-auto flex h-screen max-w-3xl flex-col"
		data-messages-url={ paths.Project(p.ID, "messages") }
		data-ws-url={ paths.ProjectEvents(p.ID) }
	>
		<header class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-800 px-4 py-3">
			<div class="flex min-w-0 items-center gap-3">
				<h1 class="truncate text-base font-semibold">{ "PROJECT: " + p.Name }</h1>
				@ProjectStateBadge(p.State, false)
			</div>
			<div class="flex flex-wrap items-center gap-3">
				@molecules.ConfirmationControl(p)
			</div>
		</header>
		@ChatThread(msgs)
		@ChatComposer(p)
	</main>
}
