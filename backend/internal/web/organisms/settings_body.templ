package organisms

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// SettingsBodyData is everything the settings screen shows.
type SettingsBodyData struct {
	Policy    PolicyFormData
	Cost      domain.CostSummary
	Storage   StoragePanelData
	Brand     BrandConstraintListData
	Templates BrandTemplatePanelData
	// Credentials is which provider has an API key; never a key.
	Credentials CredentialPanelData
}

// SettingsBody is the sections of the settings screen without the page frame.
templ SettingsBody(d SettingsBodyData) {
	<div id="settings-body" class="flex flex-col gap-8">
		@molecules.SettingsSection("Production Template", "選ぶと Judge / Editor の評価軸の優先度が切り替わります。") {
			@ProductionTemplateForm(d.Policy)
		}
		@molecules.SettingsSection("Quality Policy", "FAST は少ない Take と高速モデル、BALANCED は標準、MAX QUALITY は複数 Take と厳格な判定。空欄の項目は Policy の既定値を使います。") {
			@PolicyForm(d.Policy)
		}
		@molecules.SettingsSection("予算", "") {
			@BudgetForm(d.Policy)
		}
		@molecules.SettingsSection("コスト", "") {
			@CostSummaryPanel(d.Policy.Project.ID, d.Cost)
		}
		@molecules.SettingsSection("ディスク", "生成前に空き容量を見積もり、不足なら警告します。") {
			@StoragePanel(d.Storage)
		}
		@molecules.SettingsSection("Brand / Safety Constraints", "ブランドガイドライン・禁止表現・免責表記などを登録します。Prompt 生成・AI Video Judge・Final QC のすべてで守らせ、LOCK の制約に違反した Take・成果物はスコアに関係なく不合格になります（Advisory は警告のみ）。") {
			@BrandConstraintList(d.Brand)
		}
		@molecules.SettingsSection("Brand Templates", "制約のセットをテンプレートとして保存し、別の Project や Series の Episode を作るときに適用します。適用は制約のコピーで、テンプレートを更新・削除しても既存の Project には反映されません。") {
			@BrandTemplatePanel(d.Templates)
		}
		@molecules.SettingsSection("API キー", "外部モデルの API キーを登録します。キーは OS のセキュアストレージに保存され、画面には設定済みかどうかだけが表示されます。保存したキーは再起動なしで次の呼び出しから使われます。") {
			@CredentialPanel(d.Credentials)
		}
		@molecules.SettingsSection("プロジェクトバンドル", "プロジェクトのデータとアセットを 1 つの ZIP に書き出します。プロジェクト一覧の読み込みフォームから、この端末でも別の端末でも復元できます。") {
			<div>
				@atoms.ButtonLink(atoms.ToneNeutral, "バンドルを書き出す（ZIP）", templ.SafeURL(paths.Project(d.Policy.Project.ID, "bundle")), templ.Attributes{"download": true})
			</div>
		}
	</div>
}
