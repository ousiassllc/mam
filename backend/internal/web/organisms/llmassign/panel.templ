package llmassign

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Target is one provider and one model name.
type Target struct {
	Provider string
	Model    string
}

// Row is the assignment of one Agent: the primary target, the fallback used when it fails, and the defaults
// the program ships (shown beside the fields, so that a change can be undone by hand).
type Row struct {
	Agent           string
	Label           string
	Primary         Target
	Fallback        Target
	DefaultPrimary  Target
	DefaultFallback Target
}

// Data is the "LLM の割り当て" section. Rows are the Agents that run; Unused are the Agents whose route no
// code reads yet, listed apart. Providers are the choices of a provider. Pinned means the operator fixed the
// file by a start option: the assignment is shown and cannot be edited. Problem is why the saved file could
// not be read; Notice is a success, Error is why a save was refused (the Rows then hold what was typed).
// MaxModelLength is the longest model name the server accepts.
type Data struct {
	Rows           []Row
	Unused         []Row
	Providers      []string
	Pinned         bool
	Problem        string
	Notice         string
	Error          string
	MaxModelLength int
}

// Section is the "LLM の割り当て" section of the global settings screen: Panel under its title.
templ Section(d Data) {
	@molecules.SettingsSectionAt(molecules.HeadingNone, "LLM の割り当て", "Agent ごとに、最初に呼ぶ LLM（プライマリ）と、失敗したときに切り替える LLM（代替）を選びます。変更は保存したあとアプリを再起動すると反映されます。") {
		@Panel(d)
	}
}

// SectionIf is Section, or nothing when d is nil.
templ SectionIf(d *Data) {
	if d != nil {
		@Section(*d)
	}
}

// Panel is the form that saves the assignment (PUT) with the button that returns it to the defaults
// (DELETE); both answer with the panel itself. A pinned file is listed read-only, without a form.
templ Panel(d Data) {
	<section id="llm-assignment-panel" class="flex flex-col gap-3">
		if d.Pinned {
			<p class="text-sm text-neutral-300" data-testid="llm-pinned">起動オプション（--llm-config / MAM_LLM_CONFIG）で固定されています。この画面では変更できません。</p>
		}
		if d.Problem != "" {
			<p class="text-sm text-amber-300" role="alert" data-testid="llm-problem">保存済みの設定ファイルを読み込めません（表示は既定値です）: { d.Problem }</p>
		}
		if d.Notice != "" {
			<p class="text-sm text-emerald-300" role="status" data-testid="llm-notice">{ d.Notice }</p>
		}
		if d.Error != "" {
			<p class="text-sm text-red-300" role="alert" data-testid="llm-error">{ d.Error }</p>
		}
		<p class="text-xs text-neutral-400" data-testid="llm-chatgpt-note">
			プロバイダー「chatgpt-subscription」を選ぶと、ChatGPT のプランを使います（Using ChatGPT plan）。組織（Business / Enterprise / Edu）のアカウントは、設定画面の Codex 経由でログインして、プロバイダー「chatgpt-codex」を選びます（テキスト生成だけ）。モデル名は、ログインしたあと、設定画面の ChatGPT の欄で確認できます。
			<a class="underline" href="https://chatgpt.com/settings/usage" target="_blank" rel="noopener noreferrer">Manage usage</a>
		</p>
		if d.Pinned {
			@readOnlyList(d.Rows)
			@readOnlyUnused(d.Unused)
		} else {
			<form
				class="flex flex-col gap-4"
				hx-put={ paths.LLMSettings() }
				hx-target="#llm-assignment-panel"
				hx-swap="outerHTML"
				hx-sync="this:drop"
				hx-disabled-elt="find button[type=submit]"
				autocomplete="off"
			>
				<div class="flex flex-col divide-y divide-neutral-800">
					for _, r := range d.Rows {
						@routeFields(r, d)
					}
				</div>
				if len(d.Unused) > 0 {
					<details class="rounded-md border border-neutral-800 px-3 py-2" data-testid="llm-unused">
						<summary class="cursor-pointer text-sm text-neutral-300">現在は使われません</summary>
						<p class="mt-2 text-xs text-neutral-400">これらの Agent は今のところ LLM を呼びません。割り当ては保存され、使われるようになったときに効きます。</p>
						<div class="flex flex-col divide-y divide-neutral-800">
							for _, r := range d.Unused {
								@routeFields(r, d)
							}
						</div>
					</details>
				}
				<div class="flex flex-wrap items-center gap-2">
					@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
					@atoms.Button(atoms.ToneNeutral, "既定に戻す", templ.Attributes{
						"type":            "button",
						"hx-delete":       paths.LLMSettings(),
						"hx-params":       "none", // inside the form: never send its values in the DELETE URL
						"hx-target":       "#llm-assignment-panel",
						"hx-swap":         "outerHTML",
						"hx-sync":         "closest form:drop", // a save and a reset never run together
						"hx-disabled-elt": "this",
						"hx-confirm":      "すべての Agent の LLM の割り当てを既定に戻します。よろしいですか？",
					})
				</div>
			</form>
		}
	</section>
}

// routeFields is the two targets of one Agent as form fields. The names are "<agent>.primary.provider",
// "<agent>.primary.model", "<agent>.fallback.provider" and "<agent>.fallback.model".
templ routeFields(r Row, d Data) {
	<fieldset class="flex flex-col gap-2 py-3" data-testid="llm-route" data-agent={ r.Agent }>
		<legend class="font-medium text-sm">{ r.Label }</legend>
		<div class="flex flex-col gap-2">
			@targetFields(r.Agent, "primary", "プライマリ", r.Primary, r.DefaultPrimary, d)
			@targetFields(r.Agent, "fallback", "代替", r.Fallback, r.DefaultFallback, d)
		</div>
	</fieldset>
}

templ targetFields(agent, role, roleLabel string, t, def Target, d Data) {
	<div class="flex flex-wrap items-end gap-2">
		<span class="w-20 text-xs text-neutral-400">{ roleLabel }</span>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for={ fieldID(agent, role, "provider") }>
			<span><span class="sr-only">{ roleLabel }の</span>プロバイダー</span>
			@atoms.Select(atoms.FieldMd, "", templ.Attributes{
				"id":   fieldID(agent, role, "provider"),
				"name": agent + "." + role + ".provider",
			}) {
				for _, p := range d.Providers {
					<option value={ p } selected?={ p == t.Provider }>{ p }</option>
				}
			}
		</label>
		<label class="flex min-w-0 flex-1 flex-col gap-1 text-xs text-neutral-400" for={ fieldID(agent, role, "model") }>
			<span><span class="sr-only">{ roleLabel }の</span>モデル（既定: { def.Provider } / { def.Model }）</span>
			@atoms.Input(atoms.FieldMd, "min-w-0", templ.Attributes{
				"id":           fieldID(agent, role, "model"),
				"name":         agent + "." + role + ".model",
				"type":         "text",
				"value":        t.Model,
				"placeholder":  def.Model,
				"required":     true,
				"maxlength":    strconv.Itoa(d.MaxModelLength),
				"autocomplete": "off",
			})
		</label>
	</div>
}

func fieldID(agent, role, field string) string { return "llm-" + agent + "-" + role + "-" + field }

// readOnlyList is the assignment of a pinned file: one line per Agent.
templ readOnlyList(rows []Row) {
	<ul class="flex flex-col divide-y divide-neutral-800 text-sm" data-testid="llm-readonly">
		for _, r := range rows {
			@readOnlyRow(r)
		}
	</ul>
}

templ readOnlyUnused(rows []Row) {
	if len(rows) > 0 {
		<details class="rounded-md border border-neutral-800 px-3 py-2">
			<summary class="cursor-pointer text-sm text-neutral-300">現在は使われません</summary>
			<ul class="flex flex-col divide-y divide-neutral-800 text-sm">
				for _, r := range rows {
					@readOnlyRow(r)
				}
			</ul>
		</details>
	}
}

templ readOnlyRow(r Row) {
	<li class="flex flex-col gap-1 py-2" data-agent={ r.Agent }>
		<span class="font-medium">{ r.Label }</span>
		<span class="text-xs text-neutral-400">プライマリ: { r.Primary.Provider } / { r.Primary.Model }　代替: { r.Fallback.Provider } / { r.Fallback.Model }</span>
	</li>
}
