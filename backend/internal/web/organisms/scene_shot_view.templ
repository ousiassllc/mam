package organisms

import (
	"fmt"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
)

// SceneItem is one entry of the Scene list.
type SceneItem struct {
	Scene     domain.Scene
	ShotCount int
}

// SceneShotData is the state of the Scene / Shot hierarchy view. The error maps are keyed by
// form field name; the Input fields hold the user's rejected input.
type SceneShotData struct {
	Project domain.Project
	Scenes  []SceneItem
	Scene   *domain.Scene // nil when the Project has no Scene
	Shots   []molecules.ShotCardData

	SceneErrors map[string]string
	SceneInput  SceneInput
	ShotErrors  map[string]string
	ShotInput   ShotInput
}

// SceneInput is the Scene form's rejected input.
type SceneInput struct{ Title, Location, Time, Objective string }

// ShotInput is the Shot form's rejected input.
type ShotInput struct{ Objective, DurationSeconds string }

func sceneURL(projectID, sceneID string) string {
	return "/projects/" + projectID + "/scenes/" + sceneID
}

func sceneSummary(s domain.Scene) string {
	text := ""
	for _, part := range []string{s.Location, s.Time} {
		if part == "" {
			continue
		}
		if text != "" {
			text += " / "
		}
		text += part
	}
	return text
}

// SceneShotView is the Scene / Shot / Take hierarchy (F-04): the Scene list on the left, the
// selected Scene with its Shots and their Takes on the right, and the forms to add either.
// HTMX swaps the whole view, so selecting and adding never reloads the page.
templ SceneShotView(d SceneShotData) {
	<div id="scene-shot-view" class="grid gap-6 md:grid-cols-[16rem_1fr]">
		<nav aria-label="Scene 一覧" class="flex flex-col gap-3">
			<ol class="flex flex-col gap-1">
				for _, item := range d.Scenes {
					<li>
						<a
							class={ "block rounded-md border px-3 py-2 text-sm", templ.KV("border-indigo-400 bg-indigo-500/10", d.Scene != nil && d.Scene.ID == item.Scene.ID), templ.KV("border-neutral-700 hover:bg-neutral-800", d.Scene == nil || d.Scene.ID != item.Scene.ID) }
							href={ templ.SafeURL(sceneURL(d.Project.ID, item.Scene.ID)) }
							hx-get={ sceneURL(d.Project.ID, item.Scene.ID) }
							hx-target="#scene-shot-view"
							hx-swap="outerHTML"
							hx-push-url="true"
							if d.Scene != nil && d.Scene.ID == item.Scene.ID {
								aria-current="true"
							}
						>
							<span class="font-medium">{ fmt.Sprintf("Scene %d: %s", item.Scene.OrderIndex+1, item.Scene.Title) }</span>
							<span class="block text-xs text-neutral-400">{ fmt.Sprintf("%d Shot", item.ShotCount) }</span>
						</a>
					</li>
				}
			</ol>
			if len(d.Scenes) == 0 {
				<p class="text-sm text-neutral-400">Scene はまだありません。企画が進むと AI が作成します。手動でも追加できます。</p>
			}
			@sceneForm(d)
		</nav>
		<section aria-label="Scene 詳細" class="flex flex-col gap-4">
			if d.Scene != nil {
				<header>
					<h2 class="text-lg font-semibold">{ fmt.Sprintf("Scene %d: %s", d.Scene.OrderIndex+1, d.Scene.Title) }</h2>
					if sceneSummary(*d.Scene) != "" {
						<p class="text-sm text-neutral-400">{ sceneSummary(*d.Scene) }</p>
					}
					if d.Scene.Objective != "" {
						<p class="mt-1 text-sm">{ d.Scene.Objective }</p>
					}
				</header>
				if len(d.Shots) == 0 {
					<p class="text-sm text-neutral-400">この Scene に Shot はまだありません。</p>
				} else {
					<ol class="flex flex-col gap-2" aria-label="Shot 一覧">
						for _, sh := range d.Shots {
							@molecules.ShotCard(sh)
						}
					</ol>
				}
				@shotForm(d)
			}
		</section>
	</div>
}

templ fieldError(errs map[string]string, field string) {
	if msg := errs[field]; msg != "" {
		<p class="mt-1 text-sm text-red-300" role="alert">{ msg }</p>
	}
}

templ sceneForm(d SceneShotData) {
	<form
		class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3"
		hx-post={ "/projects/" + d.Project.ID + "/scenes" }
		hx-target="#scene-shot-view"
		hx-swap="outerHTML"
	>
		<p class="text-sm font-medium">Scene を追加</p>
		if d.Scene != nil {
			<input type="hidden" name="current_scene_id" value={ d.Scene.ID }/>
		}
		<div>
			<label for="scene-title" class="mb-1 block text-xs text-neutral-400">見出し（必須）</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":       "scene-title",
				"name":     "title",
				"type":     "text",
				"required": true,
				"value":    d.SceneInput.Title,
			})
			@fieldError(d.SceneErrors, "title")
		</div>
		<div>
			<label for="scene-location" class="mb-1 block text-xs text-neutral-400">場所</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":    "scene-location",
				"name":  "location",
				"type":  "text",
				"value": d.SceneInput.Location,
			})
			@fieldError(d.SceneErrors, "location")
		</div>
		<div>
			<label for="scene-time" class="mb-1 block text-xs text-neutral-400">時間帯</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":    "scene-time",
				"name":  "time",
				"type":  "text",
				"value": d.SceneInput.Time,
			})
			@fieldError(d.SceneErrors, "time")
		</div>
		<div>
			<label for="scene-objective" class="mb-1 block text-xs text-neutral-400">狙い</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":    "scene-objective",
				"name":  "objective",
				"type":  "text",
				"value": d.SceneInput.Objective,
			})
			@fieldError(d.SceneErrors, "objective")
		</div>
		@atoms.Button(atoms.TonePrimary, "Scene を追加", templ.Attributes{"type": "submit"})
	</form>
}

templ shotForm(d SceneShotData) {
	<form
		class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3"
		hx-post={ "/scenes/" + d.Scene.ID + "/shots" }
		hx-target="#scene-shot-view"
		hx-swap="outerHTML"
	>
		<p class="text-sm font-medium">Shot を追加</p>
		<div>
			<label for="shot-objective" class="mb-1 block text-xs text-neutral-400">この Shot で見せること（必須）</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":       "shot-objective",
				"name":     "objective",
				"type":     "text",
				"required": true,
				"value":    d.ShotInput.Objective,
			})
			@fieldError(d.ShotErrors, "objective")
		</div>
		<div>
			<label for="shot-duration" class="mb-1 block text-xs text-neutral-400">長さ（秒）</label>
			@atoms.Input(atoms.FieldMd, "w-32", templ.Attributes{
				"id":       "shot-duration",
				"name":     "duration_seconds",
				"type":     "number",
				"step":     "0.1",
				"min":      "0.1",
				"required": true,
				"value":    d.ShotInput.DurationSeconds,
			})
			@fieldError(d.ShotErrors, "duration_seconds")
		</div>
		@atoms.Button(atoms.TonePrimary, "Shot を追加", templ.Attributes{"type": "submit"})
	</form>
}
