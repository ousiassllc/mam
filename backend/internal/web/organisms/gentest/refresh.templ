package gentest

import "github.com/ousiassllc/mam/backend/internal/web/atoms"

// RefreshBar is when a part of the screen was read (small, "15:04:05") and the button that reads it again: the icon only, named
// "更新" for the screen reader. The button swaps the part it sits in (the element with id target) by what url answers; while
// the request is out the icon turns. Its id is fixed so that HTMX gives it the focus again when a swap replaces it.
templ RefreshBar(url, target, updatedAt string) {
	<div class="flex shrink-0 items-center gap-2">
		if updatedAt != "" {
			<span class="text-xs text-neutral-400" data-testid="gt-updated">最終更新 <time>{ updatedAt }</time></span>
		}
		<button
			type="button"
			id={ target + "-refresh" }
			class="group inline-flex h-7 w-7 items-center justify-center rounded-md border border-neutral-700 text-neutral-300 transition-colors hover:border-neutral-600 hover:text-neutral-100 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 motion-reduce:transition-none"
			hx-get={ url }
			hx-target={ "#" + target }
			hx-swap="outerHTML"
			hx-sync={ "#" + target + ":replace" }
			aria-label="更新"
			title="更新"
			data-testid="gt-refresh"
		>
			@atoms.Icon(atoms.IconUpdate, "h-4 w-4 group-[.htmx-request]:animate-spin motion-reduce:animate-none")
		</button>
	</div>
}
