package gentest

import (
	"github.com/ousiassllc/mam/backend/internal/web/molecules/help"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modelcard"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modelpick"
)

// sectionTitle is the title of a section of the form with its "?" help (spec/components/shared-ui-parts.md §9): the
// explanation is behind the button, not under the title. The title has an id so that the section (a fieldset) is named by
// it.
templ sectionTitle(id, title string, explanation templ.Component) {
	@help.Row(help.ID(title), title, explanation) {
		<span id={ id } class="text-sm font-medium text-ink">{ title }</span>
	}
}

// modelChoices are the models as cards under the filter bar: tapping a card ticks or unticks it (more than one can be chosen). The bar's funnel opens the panel of
// detailed filters (molecules/modelpick: the same on the model manager and every screen that chooses a model); what it narrows is asked of the server, which answers
// the results again (ModelResults). Every model that can be called now can be chosen; one that cannot is not offered at first ("N 件は今は選べません"), and when the
// panel's "選べるものだけ" is off it is shown dimmed with why and where to fix it.
templ modelChoices(c Compose) {
	<fieldset id="gt-models" class="flex flex-col gap-3" aria-labelledby="gt-models-title" data-testid="gt-models">
		@sectionTitle("gt-models-title", "モデル", modelsHelp(c))
		@modelpick.Bar(c.Filter)
		@ModelResults(c)
	</fieldset>
}

// ModelResults are the chips of the filters in force and the cards of the models that pass them: the part a changed filter draws again (id gt-model-results).
templ ModelResults(c Compose) {
	<div id={ ModelResultsID } class="flex flex-col gap-3" data-model-results data-testid="gt-model-results">
		@modelpick.Summary(c.Filter)
		<ul role="list" class="grid gap-3 sm:grid-cols-2" data-testid="gt-model-list">
			for _, m := range c.Models {
				@modelcard.PickItem(modelCardOf(m))
			}
		</ul>
	</div>
}

// ModelResultsAnswer is the answer to the request of the bar: the results and, out of band, the number on the funnel (and the panel, for a chip).
templ ModelResultsAnswer(c Compose) {
	@ModelResults(c)
	@modelpick.Oob(c.Filter)
}

// modelsHelp is the explanation of the models: how to choose, and for each model what it takes (the seed, the negative
// prompt, reference images) or why it cannot be chosen.
templ modelsHelp(c Compose) {
	<p>複数選べます。代替のモデルへは切り替えません。</p>
	<ul class="mt-2 flex flex-col gap-1.5" data-testid="gt-models-help">
		for _, m := range c.Models {
			<li class="break-words">
				<span class="text-ink">{ m.Label }</span>: { modelNote(m) }
				<span class="block text-mute" data-testid="gt-models-help-license">商用利用: { m.Answer.Level.Label() } ／ { m.Answer.Detail() }</span>
			</li>
		}
	</ul>
}

// modelNote is what the help says of a model: why it cannot be chosen, else what it takes.
func modelNote(m ModelChoice) string {
	if m.Reason != "" {
		return m.Reason
	}
	return m.Features
}
