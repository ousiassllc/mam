package pages

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
)

// ProjectsPage is the landing page: start a new Project from a first message, or open an existing one. The other screens
// are reached from the side menu. The whole page is one column of max-w-5xl (spec/components/home-screen.md §2).
templ ProjectsPage(csrfToken string, projects []domain.Project, form organisms.NewProjectFormData) {
	@layout.AppLayout("プロジェクト", csrfToken, sidenav.At(sidenav.Projects)) {
		@pagehead.Main(pagehead.Wide) {
			@pagehead.Header("mam", "Autonomous Shot Studio", "")
			@organisms.NewProjectForm(form)
			@organisms.ProjectImportForm(organisms.ProjectImportFormData{})
			<h2 class="text-sm font-medium text-ink">プロジェクト</h2>
			@organisms.ProjectList(projects)
		}
	}
}
