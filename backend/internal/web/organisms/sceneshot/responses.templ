package sceneshot

import "github.com/ousiassllc/mam/backend/internal/web/molecules"

// The Scene form and the Shot form share the screen with the list they add to, so an add answers with the
// form that sent it and the part it changes, never the whole view: the whole view would replace the other
// form and the selected Shot card with empty ones and discard what was typed into them (#733).

// SceneAdded answers the creation of a Scene while the page shows the Scene currentSceneID: an empty Scene
// form, and the new Scene (the last of the list) appended to the Scene list. The Scene shown keeps being
// shown, with its Shots and its Shot form. A page that shows no Scene gets the whole view, with the new
// Scene selected (d.Scene).
templ SceneAdded(d Data, currentSceneID string) {
	if currentSceneID == "" {
		@View(d)
	} else {
		@sceneForm(d, currentSceneID)
		if n := len(d.Scenes); n > 0 {
			<ol hx-swap-oob="beforeend:#scene-list">
				@sceneItem(d.Project.ID, d.Scenes[n-1], false)
			</ol>
		}
	}
}

// SceneRejected answers a rejected Scene: the Scene form with the error and the user's input, still
// carrying the Scene the page shows (currentSceneID). A page that shows no Scene has only that form to keep, and gets the whole view.
templ SceneRejected(d Data, currentSceneID string) {
	if currentSceneID == "" {
		@View(d)
	} else {
		@sceneForm(d, currentSceneID)
	}
}

// ShotAdded answers the creation of a Shot: an empty Shot form, the new Shot (the last of the Shots) appended
// to the Shot list, and the Shot count of its Scene in the Scene list. The Shots already listed are not part
// of the response, so the instruction typed into the selected card survives; the new Shot is not selected.
templ ShotAdded(d Data) {
	@shotForm(d)
	if n := len(d.Shots); n > 0 {
		<ol hx-swap-oob="beforeend:#shot-list">
			@molecules.ShotCard(unselected(d.Shots[n-1]))
		</ol>
	}
	if len(d.Shots) == 1 {
		<li id="shot-empty" hx-swap-oob="delete"></li>
	}
	@shotCount(d.Scene.ID, d.shotCountOf(d.Scene.ID), true)
}

// ShotRejected answers a rejected Shot: the Shot form with the error and the user's input.
templ ShotRejected(d Data) {
	@shotForm(d)
}
