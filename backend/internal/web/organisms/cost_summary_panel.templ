package organisms

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// CostSummaryPanel shows the estimated and the actual cost by Project, Scene and Shot
// (spec/requirements/non-functional.md §6). It refreshes itself while the page is open.
templ CostSummaryPanel(projectID string, s domain.CostSummary) {
	<section
		id="cost-summary-panel"
		class="flex flex-col gap-3"
		hx-get={ paths.Project(projectID, "cost-summary") }
		hx-trigger="every 15s"
		hx-swap="outerHTML"
	>
		<dl class="grid grid-cols-1 gap-3 sm:grid-cols-3">
			<div class="rounded-md border border-neutral-700 p-3">
				<dt class="text-xs text-neutral-400">Project 推定コスト</dt>
				<dd class="text-lg font-semibold" data-testid="project-estimated">{ usd(s.Project.Estimated) }</dd>
				<dd class="text-xs text-neutral-400">上限: { ceilingText(s.ProjectCeiling) }</dd>
				if s.ProjectCeiling != nil {
					<dd class="mt-1">
						<progress class={ meterClass(spentPercent(s.Project.Estimated, s.ProjectCeiling)) } value={ intText(spentPercent(s.Project.Estimated, s.ProjectCeiling)) } max="100" aria-label="Project budget の消化率"></progress>
					</dd>
				}
			</div>
			<div class="rounded-md border border-neutral-700 p-3">
				<dt class="text-xs text-neutral-400">Project 実コスト（ベンダー報告）</dt>
				<dd class="text-lg font-semibold" data-testid="project-actual">{ actualText(s.Project) }</dd>
				<dd class="text-xs text-neutral-400">{ intText(s.Project.ActualEntries) } / { intText(s.Project.Entries) } 件で報告あり</dd>
			</div>
			<div class="rounded-md border border-neutral-700 p-3">
				<dt class="text-xs text-neutral-400">Shot 上限</dt>
				<dd class="text-lg font-semibold">{ ceilingText(s.ShotCeiling) }</dd>
			</div>
		</dl>
		if len(s.Scenes) == 0 {
			<p class="text-sm text-neutral-400">Scene がまだありません。</p>
		} else {
			<table class="w-full text-left text-sm">
				<thead class="text-xs text-neutral-400">
					<tr>
						<th scope="col" class="py-1 pr-2 font-medium">Scene / Shot</th>
						<th scope="col" class="py-1 pr-2 text-right font-medium">推定</th>
						<th scope="col" class="py-1 text-right font-medium">実コスト</th>
					</tr>
				</thead>
				<tbody>
					for _, sc := range s.Scenes {
						<tr class="border-t border-neutral-800 font-medium">
							<th scope="row" class="py-1 pr-2 text-left">{ "Scene " + intText(sc.OrderIndex+1) + ": " + sc.Title }</th>
							<td class="py-1 pr-2 text-right">{ usd(sc.Totals.Estimated) }</td>
							<td class="py-1 text-right">{ actualText(sc.Totals) }</td>
						</tr>
						for _, sh := range sc.Shots {
							<tr class="text-neutral-300">
								<th scope="row" class="py-0.5 pl-4 pr-2 text-left font-normal">{ "Shot " + intText(sh.OrderIndex+1) + shotLabel(sh.Objective) }</th>
								<td class="py-0.5 pr-2 text-right">{ usd(sh.Totals.Estimated) }</td>
								<td class="py-0.5 text-right">{ actualText(sh.Totals) }</td>
							</tr>
						}
					}
					if s.Unassigned.Entries > 0 {
						<tr class="border-t border-neutral-800 text-neutral-300">
							<th scope="row" class="py-1 pr-2 text-left font-normal">Shot に紐づかないコスト</th>
							<td class="py-1 pr-2 text-right">{ usd(s.Unassigned.Estimated) }</td>
							<td class="py-1 text-right">{ actualText(s.Unassigned) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<p class="text-xs text-neutral-500">推定コストは生成時の見積り、実コストはベンダーが報告した金額です（* は一部のみ報告）。</p>
	</section>
}
