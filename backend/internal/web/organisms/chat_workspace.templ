package organisms

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
)

// ChatWorkspace is the standard screen: one Project = one chat thread (F-30). It
// listens to /ws/projects/:id (see static/src/chat.ts) for new messages and card changes.
templ ChatWorkspace(p domain.Project, msgs []domain.ThreadMessage) {
	<div
		id="chat-workspace"
		class="mx-auto flex h-screen max-w-3xl flex-col"
		data-project-id={ p.ID }
		data-ws-url={ "/ws/projects/" + p.ID }
	>
		<header class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-800 px-4 py-3">
			<div class="flex min-w-0 items-center gap-3">
				<a href="/projects" class="text-neutral-400 hover:text-neutral-100" aria-label="プロジェクト一覧へ">←</a>
				<h1 class="truncate text-base font-semibold">{ "PROJECT: " + p.Name }</h1>
				@ProjectStateBadge(p.State, false)
			</div>
			<div class="flex flex-wrap items-center gap-3">
				@molecules.ConfirmationControl(p)
				<details class="relative text-sm">
					<summary class="cursor-pointer list-none rounded-md border border-neutral-600 px-2 py-1 hover:bg-neutral-800">⋯ 補助ビュー</summary>
					<ul class="absolute right-0 z-10 mt-1 w-40 rounded-md border border-neutral-700 bg-neutral-900 py-1 shadow-lg">
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/brief") }>Brief</a></li>
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/scenes") }>Scene / Shot</a></li>
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/edit") }>編集 / 書き出し</a></li>
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/settings") }>設定 / コスト</a></li>
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/analytics") }>制作指標</a></li>
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/world-state") }>World State</a></li>
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/references") }>Reference Library</a></li>
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/notes") }>Notes</a></li>
						<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/projects/" + p.ID + "/reviews") }>レビュー</a></li>
						if p.SeriesID != "" {
							<li><a class="block px-3 py-1.5 hover:bg-neutral-800" href={ templ.SafeURL("/series/" + p.SeriesID) }>Series</a></li>
						}
					</ul>
				</details>
			</div>
		</header>
		@ChatThread(msgs)
		@ChatComposer(p)
	</div>
}
