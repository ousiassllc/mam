package loraimport

import (
	"fmt"
	"strings"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
)

// metaFields are the fields of what is known of a LoRA: the base model, the recommended strength, the trigger words and the license. Each starts at what the
// file says, or is empty ("未設定"); nothing is filled in by a guess.
templ metaFields(s Staged) {
	<fieldset class="flex flex-col gap-1" aria-describedby="mm-lora-base-help" data-testid="mm-lora-base">
		<legend class="text-xs text-mute">対応するベースモデル</legend>
		<div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
			for _, f := range s.Families {
				<label class="flex items-center gap-1">
					@atoms.Choice("", templ.Attributes{"type": "checkbox", "name": FieldBase, "value": f.Key, "checked": f.Checked})
					<span>{ f.Label }</span>
				</label>
			}
		</div>
		<p id="mm-lora-base-help" class="text-sm text-ink">合わないモデルで使うと警告します。複数選べます。</p>
		if s.FromFile {
			<p class="text-sm text-ink" data-testid="mm-lora-base-note">ファイルの情報から読み取りました。違うときは直してください。</p>
		} else {
			<p class="text-sm text-mute" data-testid="mm-lora-base-note">ファイルに書かれていないため、未設定です（選ばなければ未設定のまま追加します）。</p>
		}
	</fieldset>
	<div class="flex flex-col gap-1">
		<label class="text-xs text-mute" for="mm-lora-strength">推奨の強さ</label>
		@atoms.Input(atoms.FieldMd, "w-28", templ.Attributes{"id": "mm-lora-strength", "name": FieldStrength, "type": "number", "min": "0.05", "max": "1", "step": "0.05", "placeholder": "未設定", "inputmode": "decimal", "aria-describedby": "mm-lora-strength-help", "data-testid": "mm-lora-strength"})
		<p id="mm-lora-strength-help" class="text-sm text-ink">0.05〜1。空欄は未設定。選ぶと単発生成の強さの初期値になります。</p>
	</div>
	<div class="flex flex-col gap-1">
		<label class="text-xs text-mute" for="mm-lora-triggers">トリガー語</label>
		@atoms.Textarea(atoms.FieldMd, "w-full max-w-md", templ.Attributes{"id": "mm-lora-triggers", "name": FieldTriggers, "rows": "2", "maxlength": fmt.Sprint(TriggersMaxLen), "placeholder": "未設定", "aria-describedby": "mm-lora-triggers-help", "data-testid": "mm-lora-triggers"}, s.Triggers)
		<p id="mm-lora-triggers-help" class="text-sm text-ink">プロンプトに入れる言葉。カンマか改行で区切る。空欄は未設定。</p>
		if len(s.Candidates) > 0 {
			<p class="text-sm text-mute" data-testid="mm-lora-candidates">学習で多く使われたタグ（候補です。トリガー語かどうかは分かりません）: { strings.Join(s.Candidates, "、") }</p>
		}
	</div>
	<div class="flex flex-wrap items-end gap-3">
		<div class="flex flex-col gap-1">
			<label class="text-xs text-mute" for="mm-lora-license">ライセンス</label>
			@atoms.Input(atoms.FieldMd, "w-72 max-w-full", templ.Attributes{"id": "mm-lora-license", "name": FieldLicense, "type": "text", "value": s.License, "maxlength": fmt.Sprint(LicenseMaxLen), "placeholder": "不明", "aria-describedby": "mm-lora-license-help", "data-testid": "mm-lora-license"})
			<p id="mm-lora-license-help" class="text-sm text-ink">任意。空欄は「不明」と表示します。</p>
		</div>
		@commercialSelect("mm-lora-commercial", "")
	</div>
}

// commercialSelect is the answer to "商用利用は？": the unknown answer first. There is no 商用OK to pick: what a user types is a declaration, and a declaration alone
// is never 商用OK in mam (the answer is 条件つき).
templ commercialSelect(id, current string) {
	<label class="flex flex-col gap-1 text-xs text-mute" for={ id }>
		<span>商用利用（既定は不明）</span>
		@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": id, "name": FieldCommercial, "data-testid": id}) {
			<option value="" selected?={ current == "" }>不明（確認していない）</option>
			<option value="conditional" selected?={ current == "conditional" }>条件つき（配布元で商用可と確認した・自己申告）</option>
			<option value="no" selected?={ current == "no" }>商用NG</option>
		}
	</label>
}
