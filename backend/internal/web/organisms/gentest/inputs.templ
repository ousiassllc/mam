package gentest

import (
	"fmt"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/help"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// inputsHelp is the rules of the input images, behind the "?" of the section and as the tooltip of the drop zone; the
// browser says so (in one small line) only when one is broken.
func inputsHelp(c Compose) string {
	t := fmt.Sprintf("最大 %d 枚。PNG・JPEG・WebP。番号の順にモデルへ渡します。", c.MaxReferences)
	if c.Media == "video" {
		t += "\n「参照」は自由な参照、最初・最後のフレームはそれぞれの位置に使います。"
	}
	return t
}

// dropHint is the tooltip of the drop zone: the rules in a few words (the long form is behind the "?").
func dropHint(c Compose) string {
	return fmt.Sprintf("PNG・JPEG・WebP / 最大 %d 枚", c.MaxReferences)
}

// pickerDialogID is the dialog that lists the images of a Project or of the history.
const pickerDialogID = "gt-picker-dialog"

// inputFields are the input images: one drop zone (drop, click, or pick from a Project or the history), the chosen images as a
// grid of thumbnails with their number, role and strength, and the options that go with them. static/src/components/gentest/
// inputs.ts draws the images chosen in the browser, the reordering, the lightbox and the dialog.
templ inputFields(c Compose) {
	<fieldset
		class="flex flex-col gap-3"
		aria-labelledby="gt-inputs-title"
		data-testid="gt-inputs"
		data-gt-inputs
		data-max={ itoa(c.MaxReferences) }
		data-max-bytes={ itoa(c.MaxImageBytes) }
		data-media={ c.Media }
	>
		@sectionTitle("gt-inputs-title", "入力画像（省略可）", help.Text(inputsHelp(c)))
		<div
			data-gt-dropzone
			title={ dropHint(c) }
			class="flex flex-col items-center gap-2 rounded-md border border-dashed border-neutral-600 p-4 text-center text-sm text-neutral-300 transition-colors motion-reduce:transition-none"
		>
			<p>画像をドロップ、またはクリック</p>
			<div class="flex flex-wrap justify-center gap-2">
				<input id="gt-upload" type="file" name={ FieldUpload } multiple accept="image/png,image/jpeg,image/webp" class="peer sr-only" data-gt-file/>
				<label for="gt-upload" class="inline-flex cursor-pointer items-center justify-center rounded-md border border-neutral-600 px-2 py-1 text-xs font-medium text-neutral-200 transition hover:bg-neutral-800 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400">ファイルを選ぶ</label>
				@atoms.SmallButton(atoms.ToneNeutral, "プロジェクトの画像から選ぶ", templ.Attributes{"type": "button", "data-gt-open-picker": "project"})
				@atoms.SmallButton(atoms.ToneNeutral, "履歴の画像から選ぶ", templ.Attributes{
					"type": "button", "data-gt-open-picker": "history", "hx-get": paths.GenerationTestPart("picker") + "?source=history",
					"hx-target": "#" + PickerID, "hx-swap": "innerHTML",
				})
			</div>
		</div>
		if c.Media == "video" {
			<div class="flex flex-wrap gap-4">
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-first">
					<span>最初のフレーム</span>
					<input id="gt-first" type="file" name={ FieldFirst } accept="image/png,image/jpeg,image/webp" class="text-sm"/>
				</label>
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="gt-last">
					<span>最後のフレーム</span>
					<input id="gt-last" type="file" name={ FieldLast } accept="image/png,image/jpeg,image/webp" class="text-sm"/>
				</label>
			</div>
		}
		<p class="text-xs text-red-300" role="alert" data-gt-error data-testid="gt-inputs-error" hidden></p>
		<p class="text-xs text-amber-300" role="status" data-gt-noref data-testid="gt-noref" hidden?={ c.NoRefNotice() == "" }>{ c.NoRefNotice() }</p>
		<div class="flex items-center justify-between text-xs text-neutral-400">
			<span data-gt-count data-testid="gt-count" aria-live="polite">{ itoa(len(c.Picked)) } / { itoa(c.MaxReferences) }</span>
		</div>
		<ul id={ RefsID } class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-5" data-testid="gt-refs" data-gt-list>
			for _, r := range c.Picked {
				@RefRow(r, c.Media, c.RefUI())
			}
		</ul>
		<template data-gt-template>
			@RefRow(Ref{Value: UploadPlaceholder, Label: "__NAME__"}, c.Media, c.RefUI())
		</template>
		@refOptions(c)
		@pickerDialog(c)
		@lightbox()
	</fieldset>
}

// lightbox is the dialog that shows a chosen image large.
templ lightbox() {
	<dialog
		data-gt-lightbox
		aria-label="入力画像の拡大"
		class="m-auto max-h-[90vh] max-w-[92vw] rounded-lg border border-neutral-700 bg-neutral-900 p-2 backdrop:bg-black/70"
	>
		<img alt="" class="max-h-[80vh] max-w-full rounded object-contain" data-gt-lightbox-image/>
		<div class="mt-2 flex justify-end">
			@atoms.SmallButton(atoms.ToneNeutral, "閉じる", templ.Attributes{"type": "button", "data-gt-lightbox-close": ""})
		</div>
	</dialog>
}
