package gentesttier

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ComfyOpenID is the part that says what "今の設定を ComfyUI で開く" could not do (when it works, the browser goes to the node screen).
const ComfyOpenID = "gt-comfy-open"

// OpenInComfy is the button "今の設定を ComfyUI で開く" of the easy and the detail tier (Issue #977): the form's settings (the model, the prompt, the size and
// the values of the settings) become a graph that the node screen opens. It sits in the compose form and sends it.
templ OpenInComfy() {
	@atoms.SmallButton(atoms.ToneNeutral, "今の設定を ComfyUI で開く", templ.Attributes{
		"type": "button", "hx-post": paths.GenerationTestPart("comfy", "open"), "hx-include": "#" + FormID, "hx-target": "#" + ComfyOpenID, "hx-swap": "outerHTML",
		"hx-disabled-elt": "this", "data-testid": "gt-comfy-open-button",
	})
}

// ComfyOpenResult is where a refusal of the button is said ("" draws the empty place).
templ ComfyOpenResult(msg string) {
	<div id={ ComfyOpenID } aria-live="polite" data-testid="gt-comfy-open-result">
		if msg != "" {
			<p class="text-sm text-warning" role="alert">{ msg }</p>
		}
	</div>
}
