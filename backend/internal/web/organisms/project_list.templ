package organisms

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ProjectList lists the Projects, newest first.
templ ProjectList(projects []domain.Project) {
	<ul id="project-list" class="mt-4 divide-y divide-neutral-800 rounded-md border border-neutral-800">
		if len(projects) == 0 {
			<li class="px-4 py-6 text-center text-sm text-neutral-400">まだプロジェクトがありません。上の入力欄から作りたい動画を伝えてください。</li>
		}
		for _, p := range projects {
			<li>
				<a class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-neutral-800/60" href={ templ.SafeURL(paths.Project(p.ID)) }>
					<span class="truncate font-medium">{ p.Name }</span>
					<span class="flex shrink-0 items-center gap-3 text-xs text-neutral-400">
						@atoms.Badge(stateTone(p.State), stateLabel(p.State))
						<time datetime={ p.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ p.CreatedAt.Local().Format("2006/01/02 15:04") }</time>
					</span>
				</a>
			</li>
		}
	</ul>
}
