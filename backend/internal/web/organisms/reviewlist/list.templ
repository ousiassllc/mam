package reviewlist

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Item is a review request with the Export it carries.
type Item struct {
	Item   domain.ReviewItem
	Export domain.Export
}

// Data is the state of the owner's review screen (reviews_page).
type Data struct {
	ProjectID string
	Exports   []domain.Export // the Exports a review can be requested for, newest first
	Items     []Item
	// Touched is the review request a create or an import answers about ("" for the whole list).
	Touched string
}

// touched is the item of d.Touched.
func (d Data) touched() (Item, bool) {
	for _, it := range d.Items {
		if it.Item.Request.ID == d.Touched {
			return it, true
		}
	}
	return Item{}, false
}

func reviewStatusTone(s domain.ReviewStatus) atoms.BadgeTone {
	switch s {
	case domain.ReviewApproved:
		return atoms.BadgeOK
	case domain.ReviewChangesRequested:
		return atoms.BadgeWarn
	}
	return atoms.BadgeNeutral
}

func exportLabel(e domain.Export) string {
	return e.Resolution + " / " + e.AspectRatio + " / " + e.Codec + "（" + e.ExportedAt.Local().Format("2006-01-02 15:04") + "）"
}

func resolvedValue(resolved bool) string {
	if resolved {
		return "false"
	}
	return "true"
}

func resolvedLabel(resolved bool) string {
	if resolved {
		return "未解決に戻す"
	}
	return "解決済みにする"
}

// List is the owner's review screen (Team Collaboration, spec/spec.md §27.1): the form that
// makes a Review Package from an Export, the form that imports a Review Response, and per review
// request its status, the download link of the package and the responses with their comments.
// The two forms and the cards are answered separately (Created, Imported, Card),
// so working with one never discards what was typed or chosen in another (#730, #743).
templ List(d Data) {
	<div id="review-list" class="flex flex-col gap-6">
		<section class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3">
			<h2 class="text-sm font-semibold">レビューを依頼する</h2>
			<p class="text-xs text-neutral-400">
				選んだ書き出し（動画 1 本）とメモだけを ZIP（Review Package）にして渡します。Project の内容（Brief・チャット・Notes・参照画像・顔データ・設定）と API キーは含まれません。共有される名前は Project 名です。
			</p>
			if len(d.Exports) == 0 {
				<p class="text-sm text-neutral-400">書き出しがまだありません。編集 / 書き出しで Final Export を作ると、レビューを依頼できます。</p>
			} else {
				@reviewRequestForm(d)
			}
		</section>
		<section class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3">
			<h2 class="text-sm font-semibold">レビュアーの応答を取り込む</h2>
			<p class="text-xs text-neutral-400">レビュアーから届いた応答ファイル（JSON）を選びます。レビュアーの名前は本人の自己申告で、確認はされません。</p>
			@reviewImportForm(d)
		</section>
		<div id="review-list-items" class="flex flex-col gap-6">
			if len(d.Items) == 0 {
				<p id="review-empty" class="text-sm text-neutral-400">レビュー依頼はまだありません。</p>
			}
			for _, it := range d.Items {
				@Card(d.ProjectID, it)
			}
		</div>
	</div>
}

// Created answers the creation of a review request: the form that sent it, emptied, and the new
// request (d.Touched) put at the head of the list. The form that imports a response is not part of it.
templ Created(d Data) {
	@reviewRequestForm(d)
	if it, ok := d.touched(); ok {
		<div hx-swap-oob="afterbegin:#review-list-items">
			@Card(d.ProjectID, it)
		</div>
		<p id="review-empty" hx-swap-oob="delete"></p>
	}
}

// Imported answers the import of a response: the form that sent it, emptied, and the review request
// that holds the response (d.Touched) in its place. The form that makes a request is not part of it.
templ Imported(d Data) {
	@reviewImportForm(d)
	if it, ok := d.touched(); ok {
		@reviewCard(d.ProjectID, it, true)
	}
}

// reviewRequestForm is the form that makes a review request from an Export (it replaces itself).
templ reviewRequestForm(d Data) {
	<form class="flex flex-col gap-2" hx-post={ paths.Project(d.ProjectID, "reviews") } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="review-export">
			書き出し
			@atoms.Select(atoms.FieldMd, "", templ.Attributes{
				"id":       "review-export",
				"name":     "export_id",
				"required": true,
			}) {
				for _, e := range d.Exports {
					<option value={ e.ID }>{ exportLabel(e) }</option>
				}
			}
		</label>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="review-note">
			レビュアーへのメモ（任意、1000 文字まで）
			@atoms.Textarea(atoms.FieldMd, "", templ.Attributes{
				"id":        "review-note",
				"name":      "note",
				"rows":      "3",
				"maxlength": strconv.Itoa(domain.MaxReviewNoteRunes),
			}, "")
		</label>
		<div>
			@atoms.Button(atoms.TonePrimary, "レビュー依頼を作る", templ.Attributes{"type": "submit"})
		</div>
	</form>
}

// reviewImportForm is the form that imports a Review Response (it replaces itself).
templ reviewImportForm(d Data) {
	<form class="flex flex-wrap items-center gap-2" hx-post={ paths.Project(d.ProjectID, "reviews", "feedback") } hx-encoding="multipart/form-data" hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
		<input id="review-response-file" type="file" name="response" required accept=".json,application/json" aria-label="応答ファイル" class="text-xs"/>
		@atoms.Button(atoms.ToneNeutral, "取り込む", templ.Attributes{"type": "submit"})
	</form>
}

// Card is one review request; resolving a comment swaps only it (the id comes from the request).
templ Card(projectID string, it Item) {
	@reviewCard(projectID, it, false)
}

// reviewCard is Card; oob makes it replace the card of the request on the page.
templ reviewCard(projectID string, it Item, oob bool) {
	<article
		id={ "review-" + it.Item.Request.ID }
		class="flex flex-col gap-3 rounded-md border border-neutral-700 p-3"
		aria-label={ "レビュー依頼 " + it.Item.Request.CreatedAt.Local().Format("2006-01-02 15:04") }
		if oob {
			hx-swap-oob="true"
		}
	>
		<header class="flex flex-wrap items-center gap-3">
			@atoms.Badge(reviewStatusTone(it.Item.Status()), it.Item.Status().Label())
			<span class="text-sm">{ exportLabel(it.Export) }</span>
			<span class="text-xs text-neutral-400">依頼: { it.Item.Request.CreatedAt.Local().Format("2006-01-02 15:04") }</span>
			if n := it.Item.OpenComments(); n > 0 {
				<span class="text-xs text-amber-300">未解決のコメント { strconv.Itoa(n) } 件</span>
			}
			<div class="ml-auto">
				@atoms.ButtonLink(atoms.ToneNeutral, "パッケージをダウンロード（ZIP）", templ.SafeURL(paths.Project(projectID, "reviews", it.Item.Request.ID, "package")), templ.Attributes{"download": true})
			</div>
		</header>
		if it.Item.Request.Note != "" {
			<p class="whitespace-pre-wrap text-sm text-neutral-300">{ it.Item.Request.Note }</p>
		}
		if len(it.Item.Responses) == 0 {
			<p class="text-xs text-neutral-400">応答はまだ取り込まれていません。</p>
		}
		for _, r := range it.Item.Responses {
			<section class="flex flex-col gap-2 rounded-md bg-neutral-900 p-3" aria-label={ "応答 " + r.ReviewerName }>
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-sm font-medium">{ r.ReviewerName }</span>
					@atoms.Badge(organisms.ReviewDecisionTone(r.Decision), r.Decision.Label())
					<span class="text-xs text-neutral-400">{ r.CreatedAt.Local().Format("2006-01-02 15:04") }</span>
				</div>
				if r.Comment != "" {
					<p class="whitespace-pre-wrap text-sm">{ r.Comment }</p>
				}
				if len(r.Comments) > 0 {
					<ul class="flex flex-col gap-2">
						for _, c := range r.Comments {
							<li class="flex flex-wrap items-start gap-2 text-sm">
								<span class="w-14 shrink-0 font-mono text-xs text-neutral-400">{ organisms.TimecodeLabel(c.TimecodeMs) }</span>
								if c.Resolved {
									<span class="min-w-0 flex-1 whitespace-pre-wrap text-neutral-400 line-through">{ c.Body }</span>
								} else {
									<span class="min-w-0 flex-1 whitespace-pre-wrap">{ c.Body }</span>
								}
								<form hx-put={ paths.Project(projectID, "review-comments", c.ID) } hx-target="closest article" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
									<input type="hidden" name="resolved" value={ resolvedValue(c.Resolved) }/>
									@atoms.ButtonFor(atoms.ToneNeutral, resolvedLabel(c.Resolved), organisms.TimecodeLabel(c.TimecodeMs)+" "+c.Body, templ.Attributes{"type": "submit"})
								</form>
							</li>
						}
					</ul>
				}
			</section>
		}
	</article>
}
