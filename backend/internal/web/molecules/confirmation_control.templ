package molecules

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

type levelOption struct {
	Level domain.ConfirmationLevel
	Label string
}

var levelOptions = []levelOption{
	{domain.ConfirmFullAuto, "FULL AUTO"},
	{domain.ConfirmKeyCheck, "KEY CHECK"},
	{domain.ConfirmCustomCheck, "CUSTOM CHECK"},
}

func hasCheckpoint(p domain.Project, c domain.Checkpoint) bool {
	for _, x := range p.CustomCheckpoints {
		if x == c {
			return true
		}
	}
	return false
}

// ConfirmationControl switches the Confirmation Level (F-03). Choosing CUSTOM CHECK
// shows the checkpoint selection. Every change is saved at once (no save button).
templ ConfirmationControl(p domain.Project) {
	<form
		id="confirmation-control"
		class="flex flex-wrap items-center gap-2 text-xs"
		hx-put={ paths.Project(p.ID, "confirmation-level") }
		hx-trigger="change"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<label for="confirmation-level" class="text-neutral-400">確認レベル</label>
		@atoms.Select(atoms.FieldMd, "", templ.Attributes{
			"id":   "confirmation-level",
			"name": "level",
		}) {
			for _, o := range levelOptions {
				<option value={ string(o.Level) } selected?={ o.Level == p.ConfirmationLevel }>{ o.Label }</option>
			}
		}
		if p.ConfirmationLevel == domain.ConfirmCustomCheck {
			<fieldset class="flex flex-wrap gap-x-3 gap-y-1">
				<legend class="sr-only">確認ポイント</legend>
				for _, c := range domain.SelectableCheckpoints() {
					<label class="flex items-center gap-1">
						@atoms.Choice("", templ.Attributes{
							"type":    "checkbox",
							"name":    "checkpoints",
							"value":   string(c),
							"checked": hasCheckpoint(p, c),
						})
						{ c.Label() }
					</label>
				}
			</fieldset>
		}
	</form>
}
