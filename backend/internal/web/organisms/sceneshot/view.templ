package sceneshot

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// View is the Scene / Shot / Take hierarchy (F-04): the Scene list on the left, the selected Scene
// with its Shots and their Takes on the right, and the forms to add either. Selecting a Scene or a
// Shot swaps the whole view; adding one answers with the part it changes (see responses.templ), so
// what is typed into the other form survives (#733).
templ View(d Data) {
	<div id="scene-shot-view" class="grid gap-6 md:grid-cols-[16rem_1fr]">
		<nav aria-label="Scene 一覧" class="flex flex-col gap-3">
			<ol id="scene-list" class="flex flex-col gap-1">
				for _, item := range d.Scenes {
					@sceneItem(d.Project.ID, item, item.Scene.ID == d.currentSceneID())
				}
			</ol>
			if len(d.Scenes) == 0 {
				<p class="text-sm text-neutral-400">Scene はまだありません。企画が進むと AI が作成します。手動でも追加できます。</p>
			}
			@sceneForm(d, d.currentSceneID())
		</nav>
		<section aria-label="Scene 詳細" class="flex flex-col gap-4">
			if d.Scene != nil {
				<header>
					<h2 class="text-lg font-semibold">{ sceneLabel(*d.Scene) }</h2>
					if sceneSummary(*d.Scene) != "" {
						<p class="text-sm text-neutral-400">{ sceneSummary(*d.Scene) }</p>
					}
					if d.Scene.Objective != "" {
						<p class="mt-1 text-sm">{ d.Scene.Objective }</p>
					}
				</header>
				<ol id="shot-list" class="flex flex-col gap-2" aria-label="Shot 一覧">
					if len(d.Shots) == 0 {
						<li id="shot-empty" class="text-sm text-neutral-400">この Scene に Shot はまだありません。</li>
					}
					for _, sh := range d.Shots {
						@molecules.ShotCard(sh)
					}
				</ol>
				@shotForm(d)
			}
		</section>
	</div>
}

// sceneItem is one link of the Scene list; current marks the Scene the view shows.
templ sceneItem(projectID string, item Item, current bool) {
	<li>
		<a
			class={ "block rounded-md border px-3 py-2 text-sm", templ.KV("border-indigo-400 bg-indigo-500/10", current), templ.KV("border-neutral-700 hover:bg-neutral-800", !current) }
			href={ templ.SafeURL(sceneURL(projectID, item.Scene.ID)) }
			hx-get={ sceneURL(projectID, item.Scene.ID) }
			hx-target="#scene-shot-view"
			hx-swap="outerHTML"
			hx-push-url="true"
			if current {
				aria-current="true"
			}
		>
			<span class="font-medium">{ sceneLabel(item.Scene) }</span>
			@shotCount(item.Scene.ID, item.ShotCount, false)
		</a>
	</li>
}

// shotCount is the number of Shots of a Scene in the Scene list; oob makes it replace the one on the page.
templ shotCount(sceneID string, n int, oob bool) {
	<span
		id={ shotCountID(sceneID) }
		class="block text-xs text-neutral-400"
		if oob {
			hx-swap-oob="true"
		}
	>{ shotCountText(n) }</span>
}

templ fieldError(errs map[string]string, field string) {
	if msg := errs[field]; msg != "" {
		<p class="mt-1 text-sm text-red-300" role="alert">{ msg }</p>
	}
}

// sceneForm adds a Scene. It answers itself (the error, or an empty form), so the Shot form beside it is
// not replaced; currentSceneID is the Scene the page shows. With none, the form is the whole view's only
// content to keep and the answer is the whole view (sceneFormTarget).
templ sceneForm(d Data, currentSceneID string) {
	<form id="scene-form" class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3" hx-post={ paths.Project(d.Project.ID, "scenes") } hx-target={ sceneFormTarget(currentSceneID) } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
		<p class="text-sm font-medium">Scene を追加</p>
		if currentSceneID != "" {
			<input type="hidden" name="current_scene_id" value={ currentSceneID }/>
		}
		<div>
			<label for="scene-title" class="mb-1 block text-xs text-neutral-400">見出し（必須）</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":        "scene-title",
				"name":      "title",
				"type":      "text",
				"maxlength": strconv.Itoa(domain.MaxSceneTitleRunes),
				"required":  true,
				"value":     d.SceneInput.Title,
			})
			@fieldError(d.SceneErrors, "title")
		</div>
		<div>
			<label for="scene-location" class="mb-1 block text-xs text-neutral-400">場所</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":        "scene-location",
				"name":      "location",
				"type":      "text",
				"maxlength": strconv.Itoa(domain.MaxSceneMetaRunes),
				"value":     d.SceneInput.Location,
			})
			@fieldError(d.SceneErrors, "location")
		</div>
		<div>
			<label for="scene-time" class="mb-1 block text-xs text-neutral-400">時間帯</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":        "scene-time",
				"name":      "time",
				"type":      "text",
				"maxlength": strconv.Itoa(domain.MaxSceneMetaRunes),
				"value":     d.SceneInput.Time,
			})
			@fieldError(d.SceneErrors, "time")
		</div>
		<div>
			<label for="scene-objective" class="mb-1 block text-xs text-neutral-400">狙い</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":        "scene-objective",
				"name":      "objective",
				"type":      "text",
				"maxlength": strconv.Itoa(domain.MaxObjectiveRunes),
				"value":     d.SceneInput.Objective,
			})
			@fieldError(d.SceneErrors, "objective")
		</div>
		@atoms.Button(atoms.TonePrimary, "Scene を追加", templ.Attributes{"type": "submit"})
	</form>
}

// shotForm adds a Shot to the shown Scene. It answers itself, so the Scene form is not replaced.
templ shotForm(d Data) {
	<form id="shot-form" class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3" hx-post={ paths.Scene(d.Scene.ID, "shots") } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
		<p class="text-sm font-medium">Shot を追加</p>
		<div>
			<label for="shot-objective" class="mb-1 block text-xs text-neutral-400">この Shot で見せること（必須）</label>
			@atoms.Input(atoms.FieldMd, "w-full", templ.Attributes{
				"id":        "shot-objective",
				"name":      "objective",
				"type":      "text",
				"maxlength": strconv.Itoa(domain.MaxObjectiveRunes),
				"required":  true,
				"value":     d.ShotInput.Objective,
			})
			@fieldError(d.ShotErrors, "objective")
		</div>
		<div>
			<label for="shot-duration" class="mb-1 block text-xs text-neutral-400">長さ（秒）</label>
			@atoms.Input(atoms.FieldMd, "w-32", templ.Attributes{
				"id":       "shot-duration",
				"name":     "duration_seconds",
				"type":     "number",
				"step":     "0.1",
				"min":      "0.1",
				"max":      strconv.Itoa(domain.MaxShotSeconds),
				"required": true,
				"value":    d.ShotInput.DurationSeconds,
			})
			@fieldError(d.ShotErrors, "duration_seconds")
		</div>
		@atoms.Button(atoms.TonePrimary, "Shot を追加", templ.Attributes{"type": "submit"})
	</form>
}
