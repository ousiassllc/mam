package atoms

// ConnectionNotice is the one definition of the "connection lost" notice's markup, shown when a
// WebSocket has used up its reconnection attempts. The page shell embeds it once as
// <template id="connection-notice-template">; static/src/components/lib/ui/connection-notice.ts clones
// it, fills data-connection-lost-message and wires the two buttons (data-action).
templ ConnectionNotice() {
	<div class="pointer-events-auto flex max-w-full flex-wrap items-center gap-3 rounded-md border border-warning/40 bg-warning/10 px-4 py-2 text-sm text-warning" role="alert" data-connection-lost="">
		@Icon(IconWarning, "size-icon-sm shrink-0")
		<span data-connection-lost-message></span>
		@SmallButton(ToneNeutral, "再接続", templ.Attributes{"type": "button", "data-action": "reconnect"})
		@SmallButton(ToneNeutral, "再読み込み", templ.Attributes{"type": "button", "data-action": "reload"})
	</div>
}
