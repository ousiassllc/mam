package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
)

// BriefPage is GET /projects/:id/brief: the Creative Brief in an auxiliary view.
templ BriefPage(csrfToken string, d organisms.BriefFormData) {
	@layout.AppLayout("Brief: "+d.Project.Name, csrfToken) {
		<main class="mx-auto max-w-2xl p-8">
			@atoms.ChatBackLink(d.Project.ID)
			<h1 class="mb-1 mt-3 text-xl font-semibold">Creative Brief</h1>
			<p class="mb-6 text-sm text-neutral-400">{ d.Project.Name }</p>
			@organisms.BriefForm(d)
		</main>
	}
}
