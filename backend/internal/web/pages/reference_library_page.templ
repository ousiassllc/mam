package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
)

// ReferenceLibraryPage is GET /projects/:id/references: the Reference Library in an auxiliary view.
templ ReferenceLibraryPage(csrfToken string, d organisms.ReferenceLibraryData) {
	@layout.AppLayout("Reference Library: "+d.Project.Name, csrfToken, sidenav.InProject(sidenav.References, d.Project)) {
		@pagehead.Main(pagehead.Wide) {
			@pagehead.Header("Reference Library", d.Project.Name, "")
			@organisms.ReferenceLibrary(d)
		}
	}
}
