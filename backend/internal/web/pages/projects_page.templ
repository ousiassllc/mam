package pages

import (
	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
)

// ProjectsPage is the landing page: start a new Project from a first message, or open an existing one.
templ ProjectsPage(csrfToken string, projects []domain.Project, form organisms.NewProjectFormData) {
	@layout.AppLayout("プロジェクト", csrfToken) {
		<main class="mx-auto max-w-3xl p-8">
			<h1 class="text-2xl font-semibold">mam</h1>
			<p class="mb-6 mt-1 text-neutral-400">Autonomous Shot Studio</p>
			@organisms.NewProjectForm(form)
			<h2 class="mt-8 text-sm font-medium text-neutral-300">プロジェクト</h2>
			@organisms.ProjectList(projects)
		</main>
	}
}
