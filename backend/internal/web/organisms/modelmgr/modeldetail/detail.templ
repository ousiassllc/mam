package modeldetail

import (
	"strconv"
	"strings"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/commercial"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	view "github.com/ousiassllc/mam/backend/internal/web/organisms/modelmgr"
)

func joinNames(names []string) string { return strings.Join(names, "、") }

// Detail is the body of the modal of a model. Its title is the name of the model, and the description of the dialog is what the model is.
templ Detail(m view.Model) {
	{{ tone, label := view.StateTone(m.State) }}
	@modal.Frame(m.Name, m.Description) {
		<div class={ "flex flex-wrap items-center gap-2", modal.StartClass } tabindex="-1" autofocus data-testid="mm-model-detail" data-model={ m.ID }>
			@atoms.Badge(atoms.BadgeInfo, m.KindLabel)
			if m.Adult {
				@atoms.Badge(atoms.BadgeError, "成人向け")
			}
			if m.Advanced {
				@atoms.Badge(atoms.BadgeWarn, "ライセンスの同意が必要")
			}
			if m.NeedsToken {
				@atoms.Badge(atoms.BadgeWarn, "HF トークンが必要")
			}
			@atoms.Badge(tone, label)
			@commercial.Badge(m.License.Answer)
		</div>
		if view.ShowsTokenGuide(m) {
			<p class="text-sm text-amber-300" data-testid="mm-token-guide">{ m.TokenGuide } <a class="underline" href={ "#" + view.HFID } data-modal-close>トークンの区画へ</a></p>
		}
		@commercial.Note(m.License.Answer)
		if m.License.Regions != "" {
			<p class="text-sm text-amber-300" data-testid="mm-regions">{ m.License.Regions }</p>
		}
		<dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs text-neutral-300" data-testid="mm-model-meta">
			<div><dt class="text-neutral-400">大きさ</dt><dd>{ m.Size }</dd></div>
			<div><dt class="text-neutral-400">VRAM の目安</dt><dd data-testid="mm-vram">{ m.VRAM }</dd></div>
			<div class="min-w-0">
				<dt class="text-neutral-400">ライセンス</dt>
				<dd class="break-words"><a class="underline" href={ templ.SafeURL(m.License.URL) } target="_blank" rel="noopener noreferrer">{ m.License.Name }</a></dd>
			</div>
			<div><dt class="text-neutral-400">商用利用</dt><dd data-testid="mm-commercial">{ m.License.Commercial }</dd></div>
			if len(m.TriggerWords) > 0 {
				<div class="col-span-2"><dt class="text-neutral-400">トリガー語（プロンプトに入れる）</dt><dd class="break-words" data-testid="mm-trigger-words">{ joinNames(m.TriggerWords) }</dd></div>
			}
			if len(m.Sources) > 0 {
				<div class="col-span-2"><dt class="text-neutral-400">原本の場所</dt><dd class="break-words" data-testid="mm-sources">{ joinNames(m.Sources) }</dd></div>
			}
		</dl>
		if m.VRAMFitText != "" {
			<p class={ "text-xs " + view.FitClass(m.VRAMFit) } data-testid="mm-vram-fit-text" data-fit={ m.VRAMFit }>{ m.VRAMFitText }</p>
		}
		if m.State != "installed" && m.State != "installing" {
			<p class={ "text-xs " + view.NeedClass(m.LowDisk) } data-testid="mm-need">
				必要な空き容量: { m.Need }
				if m.LowDisk {
					（空きが足りません。導入できません）
				}
			</p>
		}
		<section class="flex flex-col gap-2" aria-labelledby="mm-files-title">
			<h3 id="mm-files-title" class="text-sm font-semibold">ファイル（{ strconv.Itoa(len(m.Files)) }）</h3>
			<ul class="flex flex-col gap-2 text-xs text-neutral-300" role="list" data-testid="mm-files">
				for _, f := range m.Files {
					<li class="break-all rounded-md border border-neutral-800 p-2">
						<code>{ f.Path }</code> { f.Size }
						if f.Present {
							<span class="text-emerald-300">あり</span>
						}
						<span class="block text-neutral-400">SHA-256 <code data-testid="mm-sha256">{ f.SHA256 }</code></span>
						if len(f.Shared) > 0 {
							<span class="block text-neutral-400">（{ joinNames(f.Shared) } と共有。使うモデルが残る間は消えません）</span>
						}
					</li>
				}
			</ul>
			<p class="text-xs text-neutral-400" data-testid="mm-model-ids">導入されるモデル: { joinNames(m.ModelIDs) }／{ m.WorkflowCheck }</p>
		</section>
		@modal.Actions() {
			@atoms.Button(atoms.TonePrimary, "閉じる", templ.Attributes{"type": "button", "data-modal-close": true})
		}
	}
}

// HFDetail is the body of the modal of a file the user added from Hugging Face: its repository at the commit it is pinned to, its license
// (the answer for commercial use), its size and SHA-256, and the models made for it.
templ HFDetail(m view.HFModel) {
	@modal.Frame(m.Name, "") {
		<div class={ "flex flex-wrap items-center gap-2", modal.StartClass } tabindex="-1" autofocus data-testid="mm-hfi-model-detail">
			@atoms.Badge(atoms.BadgeInfo, m.Folder)
			if m.Missing {
				@atoms.Badge(atoms.BadgeWarn, "ファイルが見つかりません")
			} else {
				@atoms.Badge(atoms.BadgeOK, "導入済み")
			}
			@commercial.Badge(m.Answer)
		</div>
		@commercial.Note(m.Answer)
		<dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs text-neutral-300">
			<div class="col-span-2"><dt class="text-neutral-400">取得元</dt><dd class="break-all"><code>{ m.Repo }</code>（コミット <code>{ m.Commit }</code>）</dd></div>
			<div><dt class="text-neutral-400">大きさ</dt><dd>{ m.Size }</dd></div>
			<div><dt class="text-neutral-400">導入した日時</dt><dd>{ m.At }</dd></div>
			<div class="col-span-2"><dt class="text-neutral-400">ライセンス</dt><dd class="break-words">{ m.License }</dd></div>
			<div class="col-span-2"><dt class="text-neutral-400">導入先のファイル</dt><dd class="break-all"><code>{ m.Path }</code></dd></div>
			<div class="col-span-2"><dt class="text-neutral-400">SHA-256</dt><dd class="break-all"><code data-testid="mm-sha256">{ m.SHA256 }</code></dd></div>
			if len(m.ModelIDs) > 0 {
				<div class="col-span-2"><dt class="text-neutral-400">作ったモデル</dt><dd class="break-all" data-testid="mm-hfi-model-ids">{ joinNames(m.ModelIDs) }</dd></div>
			}
		</dl>
		if m.Gated {
			<p class="text-xs text-amber-300">gated のリポジトリです（取得にはトークンとアクセスの許可が要ります）。</p>
		}
		if m.NFAA {
			<p class="text-xs text-amber-300">成人向け（NFAA）のリポジトリです。</p>
		}
		if len(m.Shared) > 0 {
			<p class="text-xs text-neutral-400">{ joinNames(m.Shared) } と共有しています。使うモデルが残る間は、ファイルは消えません。</p>
		}
		@modal.Actions() {
			@atoms.Button(atoms.TonePrimary, "閉じる", templ.Attributes{"type": "button", "data-modal-close": true})
		}
	}
}

// ExternalDetail is the body of the modal of a model on an external ComfyUI: the files it has there and the ones it lacks.
templ ExternalDetail(endpoint string, m view.ExternalModel) {
	@modal.Frame(m.Name, "") {
		<div class={ "flex flex-wrap items-center gap-2", modal.StartClass } tabindex="-1" autofocus data-testid="mm-external-model-detail">
			@atoms.Badge(atoms.BadgeInfo, "外部の ComfyUI・"+endpoint)
			if m.Complete {
				@atoms.Badge(atoms.BadgeOK, "そろっています")
			} else {
				@atoms.Badge(atoms.BadgeWarn, "足りないファイルがあります")
			}
		</div>
		if len(m.Missing) > 0 {
			<p class="text-sm text-amber-300" data-testid="mm-external-missing">足りない: { joinNames(m.Missing) }</p>
		}
		if len(m.Present) > 0 {
			<section class="flex flex-col gap-1" aria-labelledby="mm-external-present-title">
				<h3 id="mm-external-present-title" class="text-sm font-semibold">ある（{ strconv.Itoa(len(m.Present)) }）</h3>
				<ul class="text-xs text-neutral-300" role="list" data-testid="mm-external-present">
					for _, f := range m.Present {
						<li class="break-all"><code>{ f }</code></li>
					}
				</ul>
			</section>
		}
		<p class="text-xs text-neutral-400">外部の ComfyUI へのモデルの導入は、その ComfyUI の側で行ってください（mam は読むだけです）。そろっているモデルは、接続先にワークフローを登録すると使えます。</p>
		@modal.Actions() {
			@atoms.Button(atoms.TonePrimary, "閉じる", templ.Attributes{"type": "button", "data-modal-close": true})
		}
	}
}
