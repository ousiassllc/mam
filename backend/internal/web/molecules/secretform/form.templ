// Package secretform is the masked field of a confirmation card that asks for a secret (an API key, #1140). It is a package of its own because molecules is near its size limit.
package secretform

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Form is the masked field of a card that asks for a secret (an API key, #1140). The value goes to the dedicated endpoint of the card, never into the composer or
// a chat message, and the field is never filled in. The card's button "やめる" answers it as any other.
templ Form(m domain.ThreadMessage, field domain.SecretField) {
	<form
		class="mt-3 flex flex-col gap-2"
		method="post"
		hx-post={ paths.Project(m.ProjectID, "messages", m.ID, "secret") }
		hx-target="#chat-thread"
		hx-swap="beforeend"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		autocomplete="off"
		data-secret-form
	>
		<label class="flex flex-col gap-1 text-sm" for={ "secret-" + m.ID }>
			<span>{ field.Label } の API キー</span>
			@atoms.Input(atoms.FieldMd, "w-full", secretAttrs(m, field))
		</label>
		<p class="text-xs text-mute">入力した値はこのカードから直接保存され、チャットの履歴には残りません。</p>
		<div class="flex flex-wrap gap-2">
			@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
		</div>
	</form>
}

// secretAttrs: a password field that the browser does not remember and that is never refilled.
func secretAttrs(m domain.ThreadMessage, field domain.SecretField) templ.Attributes {
	a := templ.Attributes{
		"id":           "secret-" + m.ID,
		"name":         "secret",
		"type":         "password",
		"autocomplete": "off",
		"spellcheck":   "false",
		"required":     true,
		"placeholder":  "API キーを貼り付け",
	}
	if field.MaxBytes > 0 {
		a["maxlength"] = strconv.Itoa(field.MaxBytes)
	}
	return a
}
