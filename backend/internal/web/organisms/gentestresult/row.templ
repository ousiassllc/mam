package gentestresult

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/gentest/inpaintlink"
)

// Row is the buttons under the picture. 「一部だけ描き直す」 and the link back to the picture a redraw came from are the parts of Issue #974 and 「大きくする」 jumps to the
// box of #975 below; the other three open the compose form: the same settings with a new seed, the same settings with the same seed, and
// this picture as the face to keep.
templ Row(a Actions) {
	if a.Show() {
		<div class="flex flex-wrap items-center gap-2" data-testid="gt-next" role="group" aria-label="この結果から続ける">
			@inpaintlink.Links(a.InpaintURL, a.RedrawFrom)
			if a.Upscale {
				@atoms.ButtonLink(atoms.ToneNeutral, "大きくする", templ.SafeURL(UpscaleAnchor), templ.Attributes{"data-testid": "gt-next-upscale"})
			}
			if a.VideoEnhance {
				@atoms.ButtonLink(atoms.ToneNeutral, "大きくする", templ.SafeURL(VideoUpscaleAnchor), templ.Attributes{"data-testid": "gt-next-video-upscale"})
				@atoms.ButtonLink(atoms.ToneNeutral, "滑らかにする", templ.SafeURL(VideoInterpolateAnchor), templ.Attributes{"data-testid": "gt-next-video-interpolate"})
			}
			if a.UpscaleAgainURL != "" {
				@atoms.ButtonLink(atoms.ToneNeutral, "同じ倍率でもう一度大きくする", templ.SafeURL(a.UpscaleAgainURL), templ.Attributes{"data-testid": "gt-next-upscale-again"})
			}
			if a.SimilarURL != "" {
				@atoms.ButtonLink(atoms.ToneNeutral, "似た感じでもう1枚", templ.SafeURL(a.SimilarURL), templ.Attributes{"data-testid": "gt-next-similar"})
			}
			if a.FaceURL != "" {
				@atoms.ButtonLink(atoms.ToneNeutral, "この顔で作る", templ.SafeURL(a.FaceURL), templ.Attributes{"data-testid": "gt-next-face"})
			}
			if a.ReplayURL != "" {
				@atoms.ButtonLink(atoms.ToneNeutral, "この設定でもう一度", templ.SafeURL(a.ReplayURL), templ.Attributes{"data-testid": "gt-next-replay"})
			}
		</div>
		if a.Note != "" {
			<p class="text-xs text-mute" data-testid="gt-next-note">{ a.Note }</p>
		}
	}
}

// Panel is the settings the result was made with, folded: the model, the steps, the cfg, the sampler, the scheduler, the seed, the LoRA and the
// size. "この設定でもう一度" makes the same picture again from them.
templ Panel(u Used) {
	if len(u.Rows) > 0 {
		<details class="rounded-lg border border-border p-3 text-sm" data-testid="gt-used">
			<summary class="cursor-pointer text-sm font-semibold text-ink">使った設定</summary>
			<dl class="mt-3 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1">
				for _, r := range u.Rows {
					<dt class="text-xs text-mute">{ r.Key }</dt>
					<dd class="break-words" data-testid="gt-used-value">{ r.Value }</dd>
				}
			</dl>
		</details>
	}
}
