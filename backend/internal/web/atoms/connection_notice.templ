package atoms

// ConnectionNotice is the one definition of the "connection lost" notice's markup, shown when a
// WebSocket has used up its reconnection attempts. The page shell embeds it once as
// <template id="connection-notice-template">; static/src/components/lib/connection-notice.ts clones
// it, fills data-connection-lost-message and wires the two buttons (data-action).
templ ConnectionNotice() {
	<div class="pointer-events-auto flex items-center gap-3 rounded-md border border-warning/60 bg-surface px-4 py-2 text-sm text-warning shadow-lg" role="alert" data-connection-lost="">
		@Icon(IconWarning, "h-4 w-4 shrink-0")
		<span data-connection-lost-message></span>
		<button type="button" class="rounded border border-warning/60 px-2 py-1 hover:bg-accent-soft" data-action="reconnect">再接続</button>
		<button type="button" class="rounded border border-warning/60 px-2 py-1 hover:bg-accent-soft" data-action="reload">再読み込み</button>
	</div>
}
