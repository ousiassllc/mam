package gentesttier

import "github.com/ousiassllc/mam/backend/internal/web/paths"

const tabClass = "rounded-md px-3 py-2 text-mute transition-colors hover:bg-accent-soft/60 hover:text-ink focus-visible:focus-ring motion-reduce:transition-none"

// Tabs is the switch かんたん / こだわり / ComfyUI at the top of the image form: the current tier is lit (aria-current, like the tabs of the
// pages of the generation test). Inside the form the first two swap the form in place keeping what was typed and chosen (the address follows); a
// link works without the script too. ComfyUI is another screen's way in, so it is a plain link, and the page of it has no form to keep.
templ Tabs(d Data) {
	<nav class="flex flex-wrap gap-1 border-b border-border pb-2 text-sm" aria-label="作り方" data-testid="gt-tiers">
		for _, t := range tabs {
			if t.ID == d.Tier {
				<span class="rounded-md bg-accent-soft px-3 py-2 text-ink" aria-current="page" data-testid={ "gt-tier-" + t.ID }>{ t.Label }</span>
			} else if t.ID == TierComfy || d.IsComfy() {
				<a class={ tabClass } href={ templ.SafeURL(Href(t.ID)) } data-testid={ "gt-tier-" + t.ID }>{ t.Label }</a>
			} else {
				<a class={ tabClass } { SwitchAttrs(t.ID)... } data-testid={ "gt-tier-" + t.ID }>{ t.Label }</a>
			}
		}
	</nav>
}

// ComfyPanel is the ComfyUI tier: where the node-level work is done today. Nothing is drawn that does not work: it links to the screens that
// exist (the node screen, the saved workflows, the settings of the models, the model manager).
templ ComfyPanel() {
	<section class="flex flex-col gap-4 rounded-lg border border-border p-4" aria-labelledby="gt-comfy-title" data-testid="gt-comfy">
		<h2 id="gt-comfy-title" class="text-sm font-semibold text-ink">ComfyUI で細かく作る</h2>
		<p class="text-sm text-ink">ノードをつないで作るときは、次の画面を使います。ここ（生成テスト）の「かんたん」「こだわり」は、画像のモデルを選んで作る画面です。動画・音声はこれまでどおりです。</p>
		<p class="text-sm text-ink">今のかんたん・こだわりの設定をそのままグラフにして開くには、それぞれのフォームの「今の設定を ComfyUI で開く」を使います。</p>
		<ul class="grid gap-3 sm:grid-cols-2">
			for _, l := range comfyLinks() {
				<li class="flex flex-col gap-1 rounded-lg border border-border p-3">
					<a class="text-sm text-ink underline" href={ templ.SafeURL(l.Href) } data-testid={ l.TestID }>{ l.Label }</a>
					<span class="text-xs text-mute">{ l.Text }</span>
				</li>
			}
		</ul>
	</section>
}

type comfyLink struct{ Label, Text, Href, TestID string }

func comfyLinks() []comfyLink {
	return []comfyLink{
		{"ノード画面を開く", "ComfyUI のノードの画面です。つなぎ方を自由に変えられます。", paths.Nodes(), "gt-comfy-nodes"},
		{"ワークフローを取り込む・直す", "API 形式のワークフローを取り込み、入力の割り当てを決めて、生成テストのモデルとして使います。", paths.Workflows(), "gt-comfy-workflows"},
		{"画面に出す値を選ぶ", "モデルのワークフローのノードの入力（例 KSampler.steps・CLIPTextEncode.text）を選ぶと、こだわりの画面に入力欄として出ます。", ExposedPickerHref(""), "gt-comfy-exposed"},
		{"モデルの設定", "ローカルのモデルとその ComfyUI のワークフローの設定（ステップ数・サンプラーなどの受け取り方）です。", paths.LocalModels(), "gt-comfy-local"},
		{"モデルマネージャー", "同梱の ComfyUI と画像・動画のモデルを導入します。", paths.ModelManager(), "gt-comfy-models"},
	}
}
