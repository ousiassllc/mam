package llm

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modelpick"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// Modal is the body of the modal that edits the LLM of one Agent: the primary and the fallback (a provider and a model
// name each, with the default beside the model), "保存" for this Agent, and "この Agent を既定に戻す". A refusal draws it again
// with what was typed and why.
templ Modal(f Form) {
	@modal.Frame(f.Row.Label+" の LLM", f.Row.Purpose+"。保存すると、次の呼び出しからすぐ使われます。") {
		if f.Error != "" {
			@modal.Error(f.Error)
		}
		<form
			class="flex flex-col gap-4"
			method="post"
			hx-put={ paths.LLMAgent(f.Row.Agent) }
			hx-target={ "#" + modal.BodyID }
			hx-swap="innerHTML"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type=submit]"
			autocomplete="off"
		>
			@targetFields(f, "primary", "プライマリ", f.Row.Primary, f.Primary)
			@targetFields(f, "fallback", "代替", f.Row.Fallback, f.Fallback)
			@modal.Actions() {
				// The form's hx-disabled-elt is looked up from the control that sends, so the reset button locks itself.
				@atoms.Button(atoms.ToneNeutral, "この Agent を既定に戻す", templ.Attributes{
					"type":            "button",
					"hx-delete":       paths.LLMAgent(f.Row.Agent),
					"hx-target":       "#" + modal.BodyID,
					"hx-swap":         "innerHTML",
					"hx-sync":         "closest form:drop", // a save and a reset never run together
					"hx-disabled-elt": "this",
					"hx-params":       "none",
				})
				@modal.Cancel("キャンセル")
				@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
			}
		</form>
	}
}

// targetFields is the provider and the model of one target, chosen together in the model picker (the same filter bar, panel and cards as every list of models): the field posts
// "<role>.provider" and "<role>.model" (hidden inputs the picker sets), and "<role>.model_custom", a name typed for a model no list has, which wins when it is filled.
templ targetFields(f Form, role, roleLabel string, t Target, m ModelField) {
	<fieldset class="flex min-w-0 flex-col gap-2">
		<legend class="mb-1 text-sm font-medium">{ roleLabel }</legend>
		@modelpick.Field(m.Field)
		<p class="text-xs text-neutral-400" data-testid={ "llm-" + m.Role + "-default" }>既定: { m.Default.Summary() }</p>
		if m.Unusable != "" {
			<p class="text-xs text-amber-300" data-testid={ "llm-" + m.Role + "-unusable" }>
				{ m.Provider } は今は使えません: { m.Unusable }（保存はできます）
				if m.Route != "" {
					<a class="underline" href={ templ.SafeURL(m.Route) } data-testid={ "llm-" + m.Role + "-route" }>設定を開く</a>
				}
			</p>
		}
		if m.Unlisted {
			<p class="text-xs text-amber-300" data-testid={ "llm-" + m.Role + "-model-unlisted" }>「{ m.Selected }」は { m.Provider } の一覧にありません。使えないかもしれません（保存はできます）。</p>
		}
		<label class="flex min-w-0 flex-col gap-1 text-xs text-neutral-400" for={ fieldID(m.Role, "model-custom") }>
			<span>一覧にないモデル名を使うときだけ入力（入れると上の選択より優先）</span>
			@atoms.Input(atoms.FieldMd, "min-w-0", templ.Attributes{
				"id":           fieldID(m.Role, "model-custom"),
				"name":         m.Role + ".model_custom",
				"type":         "text",
				"maxlength":    strconv.Itoa(f.MaxModelLength),
				"autocomplete": "off",
				"spellcheck":   "false",
				"placeholder":  m.Default.Model,
			})
		</label>
	</fieldset>
}
