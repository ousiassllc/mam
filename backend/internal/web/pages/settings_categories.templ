package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/molecules/help"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/settingsui"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/audio"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/chatgpt"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/credentials"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/ffmpeg"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/licenses"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/llm"
	local "github.com/ousiassllc/mam/backend/internal/web/organisms/settings/local"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/mcp"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/media"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/settings/overview"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/updatepanel"
)

// The bodies of the categories of the global settings screen (spec/components/settings-screen.md §2): each is the h2 of
// the category and what it holds. An HTMX request for a category gets this alone; the page puts it in its frame.

// SettingsOverviewBody is the overview: a card for each category.
templ SettingsOverviewBody(d overview.Data) {
	@settingsui.Category("概要", help.Text("各分類の状態です。カードを開くと、その分類の設定に移ります。")) {
		@overview.Overview(d)
		if d.Guide {
			@overview.GuideSection()
		}
	}
}

// SettingsAPIKeysBody is "API キーとログイン": the API keys and the ChatGPT login (nil: the service is not there).
templ SettingsAPIKeysBody(keys credentials.Data, login *chatgpt.Data) {
	@settingsui.Category("API キーとログイン", nil) {
		@credentials.Section(keys)
		@chatgpt.SectionIf(login)
	}
}

// SettingsLLMBody is "テキスト生成（LLM）".
templ SettingsLLMBody(d llm.Data) {
	@settingsui.Category("テキスト生成（LLM）", help.Text("Agent ごとに、最初に呼ぶ LLM（プライマリ）と、失敗したときに切り替える LLM（代替）を選びます。")) {
		@llm.Section(d)
	}
}

// SettingsModelsBody is "画像・動画モデル".
templ SettingsModelsBody(d media.Data) {
	@settingsui.Category("画像・動画モデル", help.Text("画像の用途ごと・Quality Policy ごとに、主モデルと、主モデルが使えないときの代替モデルを選びます。\n保存した内容は <データフォルダ>/models.json に書かれ、すぐに反映されます。「ローカル・代替モデル」で登録したモデルも選べます。")) {
		@media.Section(d)
	}
}

// SettingsLocalModelsBody is "ローカル・代替モデル".
templ SettingsLocalModelsBody(d local.Data) {
	@settingsui.Category("ローカル・代替モデル", help.Text(local.Description)) {
		@local.Section(d)
	}
}

// SettingsLocalEndpointBody is the page of one local endpoint, under the title of "ローカル・代替モデル".
templ SettingsLocalEndpointBody(d local.Data, e local.Endpoint) {
	@settingsui.Category("ローカル・代替モデル", nil) {
		@local.Page(d, e)
	}
}

// SettingsFFmpegBody is "ffmpeg".
templ SettingsFFmpegBody(d ffmpeg.Data) {
	@settingsui.Category("ffmpeg", help.Text(ffmpeg.Description)) {
		@ffmpeg.Section(d)
	}
}

// SettingsAudioBody is "音声・口パク".
templ SettingsAudioBody(d audio.Data) {
	@settingsui.Category("音声・口パク", help.Text(audio.Description)) {
		@audio.Section(d)
	}
}

// SettingsMCPBody is "MCP サーバー".
templ SettingsMCPBody(d mcp.Data) {
	@settingsui.Category("MCP サーバー", help.Text(mcp.Description)) {
		@mcp.Section(d)
	}
}

// SettingsLicensesBody is "第三者のライセンス".
templ SettingsLicensesBody(d licenses.Data) {
	@settingsui.Category("第三者のライセンス", help.Text(licenses.Description)) {
		@licenses.Section(d)
	}
}

// SettingsUpdateBody is "バージョンとアップデート".
templ SettingsUpdateBody(d updatepanel.Data) {
	@settingsui.Category("バージョンとアップデート", nil) {
		@updatepanel.Section(d)
	}
}
