package gentest

import (
	"github.com/ousiassllc/mam/backend/internal/apperr"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/errorbox"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/help"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/gentest/inputnotice"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/gentest/rolenotice"
)

// ConfirmEmpty is the placeholder the confirmation is drawn into.
templ ConfirmEmpty() {
	<div id={ ConfirmID } data-testid="gt-confirm-empty"></div>
}

// ConfirmFailed is the confirmation of a request that could not be priced: the reason, in the place of the estimate.
templ ConfirmFailed(msg string) {
	<div id={ ConfirmID } class="rounded-md border border-danger/60 p-4" data-testid="gt-confirm-failed">
		<p class="text-sm text-danger" role="alert" data-testid="gt-confirm-error">{ msg }</p>
	</div>
}

// ConfirmBlocked is the confirmation of a request that was stopped before it was sent, as the common error: the cause and the fix first, the detail folded.
templ ConfirmBlocked(v apperr.View) {
	<div id={ ConfirmID } class="rounded-md" data-testid="gt-confirm-failed">
		@errorbox.Box(errorbox.Props{View: v, Lang: apperr.LangJa, ID: "gt-confirm"})
	</div>
}

// ConfirmNote is a calm notice in the place of the confirmation (words that were added to a match that is running).
templ ConfirmNote(msg string) {
	<div id={ ConfirmID } class="rounded-md border border-success/60 p-4" data-testid="gt-confirm-note">
		<p class="text-sm text-success" role="status">{ msg }</p>
	</div>
}

// ConfirmBox is the estimate of a batch: how many results, what each model costs, what is not priced and the warnings. The
// batch runs only from this box, with the estimate it shows.
templ ConfirmBox(c Confirm) {
	<div id={ ConfirmID } class="flex flex-col gap-3 rounded-md border border-accent p-4" data-testid="gt-confirm">
		@notice(c.Message, "gt-confirm")
		<h2 class="text-sm font-semibold">実行の確認</h2>
		if c.Match {
			<p class="text-sm" data-testid="gt-confirm-items">最大 <strong>{ itoa(c.Items) }</strong> 回まで生成します（目標に届けばそこで止まります）。見積り合計は <strong data-testid="gt-confirm-total">{ c.Total }</strong> です。</p>
		} else {
			<p class="text-sm" data-testid="gt-confirm-items">全部で <strong>{ itoa(c.Items) }</strong> 件を生成します。見積り合計は <strong data-testid="gt-confirm-total">{ c.Total }</strong> です。</p>
		}
		<table class="w-full text-left text-sm" data-testid="gt-confirm-lines">
			<thead class="text-xs text-mute">
				<tr><th class="py-1 pr-2 font-normal">モデル</th><th class="py-1 pr-2 font-normal">件数</th><th class="py-1 pr-2 font-normal">単価</th><th class="py-1 font-normal">小計</th></tr>
			</thead>
			<tbody>
				for _, l := range c.Lines {
					<tr class="border-t border-border" data-testid="gt-confirm-line">
						<td class="py-1 pr-2">{ l.Label }</td>
						<td class="py-1 pr-2">{ itoa(l.Items) }</td>
						<td class="py-1 pr-2">{ l.Unit }</td>
						<td class="py-1">{ l.Subtotal }</td>
					</tr>
				}
			</tbody>
		</table>
		if c.Unknown != "" {
			<p class="text-sm text-warning" data-testid="gt-confirm-unknown">{ c.Unknown }</p>
		}
		if len(c.InputWarnings) > 0 {
			@inputnotice.Warnings(c.InputWarnings, "gt-confirm-input-warnings")
		}
		if len(c.Warnings) > 0 {
			<ul class="list-disc pl-5 text-xs text-warning" data-testid="gt-confirm-warnings">
				for _, w := range c.Warnings {
					<li>{ w }</li>
				}
			</ul>
		}
		if c.OverLimit != "" {
			<p class="text-sm text-danger" role="alert" data-testid="gt-confirm-over">{ c.OverLimit }</p>
		}
		<form
			class="flex flex-wrap items-center gap-3"
			hx-post={ c.runPath() }
			hx-target={ "#" + BatchID }
			hx-swap="outerHTML"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type=submit]"
		>
			for _, h := range c.Hidden {
				<input type="hidden" name={ h.Name } value={ h.Value }/>
			}
			@atoms.Button(atoms.TonePrimary, "この内容で実行する", rolenotice.RunAttrs(c.OverLimit != "", len(c.RoleNotes)))
			@help.Toggle(help.ID("実行"), "実行")
			@help.Panel(help.ID("実行"), "実行") {
				@help.Text("モデルとプロンプトは補正も代替もせず、そのまま呼びます。\n結果は履歴に残り、Take やコスト台帳には入りません。")
			}
		</form>
	</div>
}
