package pages

import "github.com/ousiassllc/mam/backend/internal/web/layout"

// HomePage is the landing page shown when the browser is opened at startup.
// It is replaced by the project list once Projects exist.
templ HomePage(csrfToken string) {
	@layout.AppLayout("Home", csrfToken) {
		<main class="mx-auto max-w-3xl p-8">
			<h1 class="text-2xl font-semibold">mam</h1>
			<p class="mt-2 text-neutral-400">Autonomous Shot Studio</p>
		</main>
	}
}
