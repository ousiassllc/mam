    "91": {"class_type": "LoraLoaderModelOnly", "inputs": {"lora_name": "Qwen-Image-Edit-2511-Lightning-8steps-V1.0-bf16.safetensors", "strength_model": 1, "model": ["37", 0]}},
    "66": {"class_type": "ModelSamplingAuraFlow", "inputs": {"shift": 3.1, "model": ["37", 0]}},
    "75": {"class_type": "CFGNorm", "inputs": {"strength": 1, "model": ["66", 0]}},
