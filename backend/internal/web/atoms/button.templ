package atoms

// ButtonTone selects the button colours.
type ButtonTone string

// Button tones.
const (
	ToneNeutral ButtonTone = "neutral"
	TonePrimary ButtonTone = "primary"
	ToneDanger  ButtonTone = "danger"
)

func buttonClass(tone ButtonTone, small bool) string {
	base := "inline-flex items-center justify-center rounded-md font-medium transition disabled:cursor-not-allowed disabled:opacity-50 "
	if small {
		base += "px-2 py-1 text-xs "
	} else {
		base += "px-3 py-1.5 text-sm "
	}
	switch tone {
	case TonePrimary:
		return base + "bg-indigo-500 text-white hover:bg-indigo-400"
	case ToneDanger:
		return base + "border border-red-500/60 text-red-300 hover:bg-red-500/10"
	}
	return base + "border border-neutral-600 text-neutral-200 hover:bg-neutral-800"
}

// Button is a button element. attrs carry the HTMX attributes, type, name and value.
templ Button(tone ButtonTone, label string, attrs templ.Attributes) {
	<button class={ buttonClass(tone, false) } { attrs... }>{ label }</button>
}

// SmallButton is the compact Button for actions inside a list row or card.
templ SmallButton(tone ButtonTone, label string, attrs templ.Attributes) {
	<button class={ buttonClass(tone, true) } { attrs... }>{ label }</button>
}

// ButtonLink is a link (<a>) that looks like a Button, for a navigation or a download; attrs carry
// for example download.
templ ButtonLink(tone ButtonTone, label string, href templ.SafeURL, attrs templ.Attributes) {
	<a href={ href } class={ buttonClass(tone, false) } { attrs... }>{ label }</a>
}

// LinkButton is a text-only button rendered like a link (for example "返信", "除外"). TonePrimary
// colours it as an accent; any other tone is the muted default.
templ LinkButton(tone ButtonTone, label string, attrs templ.Attributes) {
	if tone == TonePrimary {
		<button class="text-xs text-indigo-300 underline" { attrs... }>{ label }</button>
	} else {
		<button class="text-xs text-neutral-400 underline hover:text-neutral-200" { attrs... }>{ label }</button>
	}
}

// IconButton is a bare glyph button (for example the × that cancels a reply); label goes in
// attrs as aria-label because the glyph is not a name.
templ IconButton(glyph string, attrs templ.Attributes) {
	<button class="text-neutral-400 hover:text-neutral-100" { attrs... }>{ glyph }</button>
}

// ButtonFor is the Button of one row of a list: its accessible name says which row it acts on
// (RowLabel), while the visible text stays label.
templ ButtonFor(tone ButtonTone, label, subject string, attrs templ.Attributes) {
	<button class={ buttonClass(tone, false) } aria-label={ RowLabel(label, subject) } { attrs... }>{ label }</button>
}

// SmallButtonFor is the SmallButton of one row of a list: its accessible name says which row it acts on
// (RowLabel), while the visible text stays label.
templ SmallButtonFor(tone ButtonTone, label, subject string, attrs templ.Attributes) {
	<button class={ buttonClass(tone, true) } aria-label={ RowLabel(label, subject) } { attrs... }>{ label }</button>
}

// LinkButtonFor is the LinkButton of one row of a list, named after the row like SmallButtonFor.
templ LinkButtonFor(label, subject string, attrs templ.Attributes) {
	<button class="text-xs text-neutral-400 underline hover:text-neutral-200" aria-label={ RowLabel(label, subject) } { attrs... }>{ label }</button>
}

// SmallButtonLinkFor is a link that looks like the SmallButtonFor of one row of a list (the page the row opens): its
// accessible name says which row it acts on (RowLabel), while the visible text stays label.
templ SmallButtonLinkFor(tone ButtonTone, label, subject string, href templ.SafeURL, attrs templ.Attributes) {
	<a href={ href } class={ buttonClass(tone, true) } aria-label={ RowLabel(label, subject) } { attrs... }>{ label }</a>
}
