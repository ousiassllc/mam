package modelmgr

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// AdultCard is the setting "成人向けモデルを表示する" (off by default). Turning it on the first time opens the dialog that
// asks the age confirmation and the agreement to the notice; the server records it and enforces it (the screen is only how
// the user gives it).
templ AdultCard(a Adult) {
	<div id={ AdultID } class="flex flex-col gap-2 rounded-lg border border-border p-3" data-testid="mm-adult">
		@notice(a.Message, "mm-adult")
		if a.Enabled {
			<p class="text-sm" data-testid="mm-adult-status">成人向けモデルを表示しています（確認: { a.ConfirmedAt }）。</p>
			@atoms.Button(atoms.ToneNeutral, "成人向けモデルを隠す", templ.Attributes{
				"type": "button", "hx-put": paths.ModelManagerPart("adult"), "hx-vals": atoms.HxVals(map[string]string{FieldOn: "0"}),
				"hx-target": "#" + AdultID, "hx-swap": "outerHTML", "hx-sync": "this:drop", "hx-disabled-elt": "this",
				"aria-pressed": "true", "data-testid": "mm-adult-off",
			})
		} else {
			<p class="text-sm text-ink" data-testid="mm-adult-status">成人向けモデルは表示していません。</p>
			if a.Confirmed {
				@atoms.Button(atoms.ToneNeutral, "成人向けモデルを表示する", templ.Attributes{
					"type": "button", "hx-put": paths.ModelManagerPart("adult"), "hx-vals": atoms.HxVals(map[string]string{FieldOn: "1"}),
					"hx-target": "#" + AdultID, "hx-swap": "outerHTML", "hx-sync": "this:drop", "hx-disabled-elt": "this",
					"aria-pressed": "false", "data-testid": "mm-adult-on",
				})
			} else {
				@atoms.Button(atoms.ToneNeutral, "成人向けモデルを表示する…", templ.Attributes{
					"type": "button", "hx-get": paths.ModelManagerPart("adult", "confirm"), "hx-target": "#" + DialogID, "hx-swap": "innerHTML",
					"aria-pressed": "false", "data-testid": "mm-adult-open",
				})
			}
		}
	</div>
}

// AdultDialog is the age confirmation and the notice for adult models, with the form that turns the setting on.
templ AdultDialog(d AdultConfirm) {
	<section
		class="flex flex-col gap-3 p-5 focus-visible:focus-ring"
		role="dialog"
		aria-labelledby="mm-adult-title"
		tabindex="-1"
		data-inline-dialog
		data-return-focus={ "#" + AdultID }
		data-testid="mm-adult-dialog"
	>
		<h3 id="mm-adult-title" class="text-sm font-semibold">成人向けモデルを表示する前の確認</h3>
		if d.Error != "" {
			<p class="text-sm text-danger focus-visible:outline-none" role="alert" tabindex="-1" data-testid="mm-adult-dialog-error">{ d.Error }</p>
		}
		<p class="text-sm text-ink" data-testid="mm-adult-notice">{ d.Notice }</p>
		<p class="text-sm text-mute">モデルの重みは mam が再配布するものではありません。モデルごとのライセンスへの同意は、導入のときに別に取ります。生成物の内容は mam では選別しません。ローカルでの利用はあなたの責任です。</p>
		<form
			class="flex flex-col gap-3"
			hx-put={ paths.ModelManagerPart("adult") }
			hx-target={ "#" + AdultID }
			hx-swap="outerHTML"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type=submit]"
			data-testid="mm-adult-form"
		>
			<input type="hidden" name={ FieldOn } value="1"/>
			<input type="hidden" name={ FieldNoticeV } value={ d.NoticeVersion }/>
			<label class="flex items-start gap-2 text-sm">
				@atoms.Choice("mt-1", templ.Attributes{"type": "checkbox", "name": FieldAgree, "value": "1", "required": true, "data-testid": "mm-adult-agree"})
				<span>私は 18 歳以上（またはお住まいの地域で成年）であり、上の注意書きに同意します</span>
			</label>
			<div class="flex gap-2">
				@atoms.Button(atoms.TonePrimary, "確認して表示する", templ.Attributes{"type": "submit"})
				@atoms.Button(atoms.ToneNeutral, "閉じる", templ.Attributes{
					"type": "button", "hx-get": paths.ModelManagerPart("dialog"), "hx-target": "#" + DialogID, "hx-swap": "innerHTML",
					"data-inline-dialog-close": true,
				})
			</div>
		</form>
	</section>
}

// CommercialCard is the setting "商用OKのモデルだけを使う" (#928). Turning the setting on makes the commercial-use choice of every model filter start at "商用OKのみ" (this
// screen, the generation test, the MCP lists); it narrows the lists and does not stop a generation. The choice itself is in the panel of the filter bar above the list.
templ CommercialCard(c CommercialPanel) {
	<div
		id={ CommercialID }
		class="flex flex-col gap-2 rounded-md border border-border p-3"
		data-testid="mm-commercial-setting"
		if c.OOB {
			hx-swap-oob="true"
		}
	>
		@notice(c.Message, "mm-commercial-setting")
		<div class="flex flex-wrap items-center justify-between gap-2">
			<p class="text-sm text-ink">商用利用で絞り込む（一覧の絞り込みの初めの状態）</p>
			@atoms.Button(atoms.ToneNeutral, commercialToggleLabel(c.Only), templ.Attributes{
				"type": "button", "hx-put": paths.ModelManagerPart("commercial"), "hx-vals": atoms.HxVals(map[string]string{FieldOn: commercialToggleValue(c.Only)}),
				"hx-target": "#" + CommercialID, "hx-swap": "outerHTML", "hx-sync": "this:drop", "hx-disabled-elt": "this",
				"aria-pressed": commercialPressed(c.Only), "data-testid": "mm-commercial-only",
			})
		</div>
	</div>
}

func commercialToggleLabel(only bool) string {
	if only {
		return "商用OKのモデルだけを使う: オン"
	}
	return "商用OKのモデルだけを使う: オフ"
}

func commercialToggleValue(only bool) string {
	if only {
		return "0"
	}
	return "1"
}

func commercialPressed(only bool) string {
	if only {
		return "true"
	}
	return "false"
}
