package voicetrainpanel

import (
	"github.com/ousiassllc/mam/backend/internal/domain/voiceref"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/errorbox"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/voicereference"
)

// Loader is the element a page holds in place of the panel: it asks for the panel when it is loaded and again when the reference voice of the
// Character changed.
templ Loader(p Placeholder) {
	<div
		id={ p.DOMID }
		hx-get={ p.URL }
		hx-trigger={ "load, " + ChangedEvent + " from:body" }
		hx-swap="outerHTML"
		class="border-t border-border pt-2 text-xs text-mute"
	>声の学習の状態を読み込んでいます…</div>
}

// Panel is the voice training of one Character. It is replaced alone by the answer of each of its actions (and polls itself while a training
// runs), so what is typed in another form is kept.
templ Panel(d Data) {
	<section
		id={ d.DOMID }
		class="flex flex-col gap-2 border-t border-border pt-2"
		data-testid="voice-train-panel"
		if d.running() {
			hx-get={ d.URL }
			hx-trigger={ "every " + PollEvery }
			hx-swap="outerHTML"
		}
	>
		<div class="flex flex-wrap items-center gap-2">
			<p class="text-xs font-medium text-ink">声の学習（fine-tune）</p>
			switch  {
				case d.running():
					@atoms.Badge(atoms.BadgeInfo, "学習中")
				case d.Trained != nil:
					@atoms.Badge(atoms.BadgeOK, "学習済み")
				default:
					@atoms.Badge(atoms.BadgeNeutral, "未学習（ゼロショット）")
			}
		</div>
		<p class="text-xs text-mute">この PC の GPT-SoVITS で、手持ちの音声からこの登場人物の声を学習します（参照音声だけで作るゼロショットより、声が近くなります）。学習した声は、この登場人物の声の合成に使われます（Series の正本で学習すると、以後に作る Episode に引き継がれます）。</p>
		<p class="text-xs text-warning" role="note" data-testid="voice-train-consent-notice">声の持ち主本人の同意を得た音声だけで学習してください。同意なしに実在の人（声優・有名人など）の声をコピーしたり、なりすましや人をだます合成音声に使ったりしてはいけません。mam は同意を確かめません。</p>
		if !d.HasReference {
			<p class="text-xs text-ink" data-testid="voice-train-need-reference">学習は、参照音声を設定した登場人物だけでできます。先に上の「参照音声」を設定してください。</p>
		}
		if d.running() {
			<div class="flex flex-col gap-1" data-testid="voice-train-progress">
				<progress class="h-2 w-full" max="100" value={ d.percent() } aria-label={ d.Name + " の学習の進み具合" }></progress>
				<p class="break-words text-xs text-ink">{ d.percent() }%<span class="text-mute">· { d.Text }</span></p>
				<p class="text-xs text-mute">学習は mam を再起動すると途中から再開せず、やり直しになります。中止すると途中までの結果は残りません。</p>
			</div>
			@atoms.Button(atoms.ToneDanger, "学習を中止", templ.Attributes{
				"type": "button", "hx-post": d.URL + "/cancel", "hx-target": "#" + d.DOMID, "hx-swap": "outerHTML",
				"hx-confirm": "学習を中止しますか？（途中までの結果は残りません）",
			})
		}
		if d.failed() {
			@errorbox.Box(errorbox.Props{View: d.failure(), Lang: "ja", ID: d.DOMID})
		}
		if d.cancelled() {
			<p class="text-xs text-ink" data-testid="voice-train-cancelled">学習を中止しました（途中までの結果は残していません）。</p>
		}
		if d.Trained != nil {
			<p class="text-xs text-ink" data-testid="voice-train-trained">学習済みの声: { trained(d.Trained) }</p>
			<p class="text-xs text-mute">プロジェクトの書き出し（バンドル）には学習した重みは入りません。取り込んだ先では、参照音声のゼロショットの声になります。</p>
		}
		<div class="flex flex-col gap-1">
			<p class="text-xs font-medium text-ink">学習に使う音声（{ itoa(len(d.Clips)) } 個・合計 { seconds(d.DataSeconds) }）</p>
			<p class="text-xs text-mute">{ limits(d.Limits) }。話している人が 1 人だけの、ノイズの少ない録音と、その書き起こしを入れてください。</p>
			if len(d.Clips) > 0 {
				<ul class="flex flex-col gap-1" data-testid="voice-train-clips">
					for _, c := range d.Clips {
						<li class="flex flex-wrap items-center gap-2 text-xs text-ink">
							<span class="text-mute">{ clipSeconds(c) }</span>
							<span class="min-w-0 flex-1 break-words">{ c.Text }</span>
							if !d.running() {
								@atoms.SmallButton(atoms.ToneDanger, "削除", templ.Attributes{
									"type": "button", "hx-delete": d.URL + "/clips/" + c.ID, "hx-target": "#" + d.DOMID, "hx-swap": "outerHTML",
									"aria-label": c.Text + " を削除",
									"hx-confirm": "この音声を学習に使う音声から削除しますか？",
								})
							}
						</li>
					}
				</ul>
			}
			for _, p := range d.Problems {
				<p class="text-xs text-warning" data-testid="voice-train-problem">{ p }</p>
			}
		</div>
		if !d.running() {
			<form
				class="grid gap-2 sm:grid-cols-2"
				hx-post={ d.URL + "/clips" }
				hx-encoding="multipart/form-data"
				hx-target={ "#" + d.DOMID }
				hx-swap="outerHTML"
				hx-sync="this:drop"
				hx-disabled-elt="find button"
			>
				<label class="flex flex-col gap-1 text-xs text-mute" for={ d.DOMID + "-file" }>
					音声ファイル
					<input id={ d.DOMID + "-file" } name="file" type="file" accept={ voicereference.Accept() } required class="text-sm text-ink"/>
				</label>
				<label class="flex flex-col gap-1 text-xs text-mute" for={ d.DOMID + "-text" }>
					書き起こし（音声が言っている内容）
					@atoms.Input(atoms.FieldMd, "", templ.Attributes{"id": d.DOMID + "-text", "name": "text", "type": "text", "required": "required", "maxlength": itoa(voiceref.MaxTextRunes)})
				</label>
				<div class="sm:col-span-2">
					@atoms.ButtonFor(atoms.ToneNeutral, "音声を追加", d.Name, templ.Attributes{"type": "submit"})
				</div>
			</form>
			<form
				class="flex flex-wrap items-end gap-2"
				hx-post={ d.URL }
				hx-target={ "#" + d.DOMID }
				hx-swap="outerHTML"
				hx-sync="this:drop"
				hx-disabled-elt="find button"
				hx-confirm="学習には数十分かかり、その間 GPU を使います（同梱の ComfyUI の生成と同時には動かせません）。mam を再起動すると学習はやり直しになります。声の持ち主本人の同意を得た音声ですか？ 始めますか？"
			>
				<label class="flex flex-col gap-1 text-xs text-mute" for={ d.DOMID + "-s2" }>
					SoVITS のエポック数（1〜{ itoa(d.Max.SoVITS) }）
					@atoms.Input(atoms.FieldMd, "w-24", templ.Attributes{"id": d.DOMID + "-s2", "name": "epochs_sovits", "type": "number", "min": "1", "max": itoa(d.Max.SoVITS), "value": itoa(d.Defaults.SoVITS)})
				</label>
				<label class="flex flex-col gap-1 text-xs text-mute" for={ d.DOMID + "-s1" }>
					GPT のエポック数（1〜{ itoa(d.Max.GPT) }）
					@atoms.Input(atoms.FieldMd, "w-24", templ.Attributes{"id": d.DOMID + "-s1", "name": "epochs_gpt", "type": "number", "min": "1", "max": itoa(d.Max.GPT), "value": itoa(d.Defaults.GPT)})
				</label>
				if d.canStart() {
					@atoms.ButtonFor(atoms.TonePrimary, "学習を始める", d.Name, templ.Attributes{"type": "submit"})
				} else {
					@atoms.ButtonFor(atoms.TonePrimary, "学習を始める", d.Name, templ.Attributes{"type": "submit", "disabled": "disabled"})
				}
			</form>
			if d.GPUBusy {
				<p class="text-xs text-warning">別の登場人物の学習が GPU を使っています。終わってから始めてください。</p>
			}
			<p class="text-xs text-mute" data-testid="voice-train-eta-note">見込み時間は、学習を始める前には出せません（実際の PC で測っていないため）。始めると、最初のエポックが終わった時点から、段階ごとの残り時間を表示します。VRAM の目安や学習の質は、実機では確かめていません。</p>
			if d.Trained != nil {
				@atoms.Button(atoms.ToneDanger, "学習した声を削除（ゼロショットに戻す）", templ.Attributes{
					"type": "button", "hx-delete": d.URL + "/voice", "hx-target": "#" + d.DOMID, "hx-swap": "outerHTML",
					"hx-confirm": "学習した声を削除しますか？（参照音声は残り、ゼロショットの声に戻ります。学習し直すには、最初からやり直しです）",
				})
			}
		}
	</section>
}
