package localmodels

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// EditorBody is what #local-models-editor holds: the form an action opened, or nothing. A button that opens a
// form fetches this alone (the panel is not redrawn).
templ EditorBody(d Data) {
	if d.Editor.Endpoint != nil {
		@endpointForm(*d.Editor.Endpoint, d.Editor.Error)
	}
	if d.Editor.Start != nil {
		@startForm(*d.Editor.Start, d.Templates, d.Editor.Error)
	}
	if d.Editor.Model != nil {
		@ModelFormView(*d.Editor.Model, d.Editor.Error)
	}
}

// closeButton closes the open form by drawing the panel again (without it).
templ closeButton() {
	@atoms.Button(atoms.ToneNeutral, "閉じる", templ.Attributes{
		"type":      "button",
		"hx-get":    paths.LocalModels(),
		"hx-target": "#" + PanelID,
		"hx-swap":   "outerHTML",
	})
}

templ formError(msg string) {
	if msg != "" {
		<p class="text-sm text-red-300" role="alert" data-testid="local-form-error">{ msg }</p>
	}
}

templ endpointForm(f EndpointForm, errMsg string) {
	<form
		class="flex flex-col gap-3 rounded-md border border-neutral-700 p-4"
		if f.Edit {
			hx-put={ paths.LocalEndpoint(f.Name) }
		} else {
			hx-post={ paths.LocalEndpoints() }
		}
		hx-target={ "#" + PanelID }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		autocomplete="off"
		data-testid="local-endpoint-form"
	>
		<h3 class="text-sm font-semibold">
			if f.Edit {
				接続先「{ f.Name }」を編集
			} else {
				接続先を追加
			}
		</h3>
		@formError(errMsg)
		if f.Edit {
			<p class="text-sm" data-testid="local-endpoint-fixed">
				<span class="text-neutral-400">名前:</span> <code>{ f.Name }</code>
				<span class="ml-3 text-neutral-400">種類:</span> { kindLabel(f.Kind) }
			</p>
			<p class="text-xs text-neutral-400">名前と種類は変えられません（Take とコスト台帳に残る識別子が名前でできているため）。変えたいときは、削除して作り直してください。</p>
		} else {
			<div class="flex flex-wrap items-end gap-3">
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="local-endpoint-name">
					<span>名前（英小文字・数字・. _ -）</span>
					@atoms.Input(atoms.FieldMd, "w-48", templ.Attributes{
						"id": "local-endpoint-name", "name": FieldName, "type": "text", "value": f.Name, "required": true,
						"maxlength": itoa(MaxNameLen), "pattern": NamePattern, "autocomplete": "off",
					})
				</label>
				<label class="flex flex-col gap-1 text-xs text-neutral-400" for="local-endpoint-kind">
					<span>種類</span>
					@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": "local-endpoint-kind", "name": FieldKind}) {
						<option value={ KindComfyUI } selected?={ f.Kind != KindOpenAICompat }>ComfyUI（画像・動画）</option>
						<option value={ KindOpenAICompat } selected?={ f.Kind == KindOpenAICompat }>OpenAI 互換（画像のみ）</option>
					}
				</label>
			</div>
		}
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="local-endpoint-url-input">
			<span>base_url（例: http://127.0.0.1:8188、http://192.168.0.10:1234、http://100.101.102.103:8188）</span>
			@atoms.Input(atoms.FieldMd, "w-full max-w-xl", templ.Attributes{
				"id": "local-endpoint-url-input", "name": FieldBaseURL, "type": "url", "value": f.BaseURL, "required": true,
				"maxlength": itoa(MaxURLLen), "autocomplete": "off", "inputmode": "url",
			})
		</label>
		<div class="flex flex-wrap items-end gap-3">
			<label class="flex flex-col gap-1 text-xs text-neutral-400" for="local-endpoint-concurrency">
				<span>同時実行数（空: 1）</span>
				@atoms.Input(atoms.FieldMd, "w-24", templ.Attributes{
					"id": "local-endpoint-concurrency", "name": FieldConcurrency, "type": "number", "min": "1", "step": "1", "value": f.MaxConcurrency,
				})
			</label>
			<label class="flex flex-col gap-1 text-xs text-neutral-400" for="local-endpoint-timeout">
				<span>タイムアウト（秒。空: ComfyUI 3600・互換 900）</span>
				@atoms.Input(atoms.FieldMd, "w-32", templ.Attributes{
					"id": "local-endpoint-timeout", "name": FieldTimeout, "type": "number", "min": "1", "step": "1", "value": f.TimeoutSeconds,
				})
			</label>
		</div>
		if !f.Edit {
			<label class="flex flex-col gap-1 text-xs text-neutral-400" for="local-endpoint-key-input">
				<span>API キー（任意。保存後は設定済みかどうかと末尾 4 文字だけを表示します）</span>
				@atoms.Input(atoms.FieldMd, "w-full max-w-xl", templ.Attributes{
					"id": "local-endpoint-key-input", "name": FieldAPIKey, "type": "password", "autocomplete": "new-password",
				})
			</label>
		}
		<div class="flex flex-wrap items-center gap-2">
			@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
			@atoms.Button(atoms.ToneNeutral, "入力中の内容で接続テスト", templ.Attributes{
				"type":            "button",
				"hx-post":         paths.LocalEndpoints() + "/test",
				"hx-include":      "closest form",
				"hx-vals":         vals(f),
				"hx-target":       "#local-form-test",
				"hx-swap":         "innerHTML",
				"hx-sync":         "closest form:drop",
				"hx-disabled-elt": "this",
			})
			@closeButton()
		</div>
		<div id="local-form-test" role="status" aria-live="polite" data-testid="local-form-test"></div>
	</form>
}

// vals is the hx-vals of the draft's connection test: an edit has no name or kind field, so the form says
// which endpoint (its saved key is used when none is typed) and what kind.
func vals(f EndpointForm) string {
	if !f.Edit {
		return atoms.HxVals(nil)
	}
	return atoms.HxVals(map[string]string{FieldName: f.Name, FieldKind: f.Kind})
}

templ startForm(s ModelStart, templates []TemplateOption, errMsg string) {
	<form
		class="flex flex-col gap-3 rounded-md border border-neutral-700 p-4"
		hx-post={ paths.LocalEndpoint(s.Endpoint, "models", "start") }
		hx-target={ "#" + EditorID }
		hx-swap="innerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		autocomplete="off"
		data-testid="local-model-start"
	>
		<h3 class="text-sm font-semibold">接続先「{ s.Endpoint }」にモデルを追加（ステップ 1: ワークフロー）</h3>
		@formError(errMsg)
		<fieldset class="flex flex-col gap-2">
			<legend class="text-xs text-neutral-400">組み込みのテンプレートから始める（モデルのファイル名は、接続先にあるものに直してください）</legend>
			for _, t := range templates {
				<label class="flex items-start gap-2 text-sm">
					@atoms.Choice("mt-1", templ.Attributes{"type": "radio", "name": FieldTemplate, "value": t.ID, "checked": t.ID == s.TemplateID})
					<span>
						<span class="font-medium">{ t.Label }</span>
						<span class="ml-1 text-xs text-neutral-400">（{ mediaLabel(t.Media) }）</span>
						<span class="block text-xs text-neutral-400">{ t.Description }</span>
					</span>
				</label>
			}
			<label class="flex items-start gap-2 text-sm">
				@atoms.Choice("mt-1", templ.Attributes{"type": "radio", "name": FieldTemplate, "value": "", "checked": s.TemplateID == ""})
				<span class="font-medium">自分のワークフローを取り込む（下の欄に JSON を貼り付け）</span>
			</label>
		</fieldset>
		<fieldset class="flex flex-col gap-2">
			<legend class="text-xs text-neutral-400">取り込むワークフローの種類（テンプレートを選んだときは無視されます）</legend>
			<div class="flex items-center gap-4 text-sm">
				<label class="flex items-center gap-1">
					@atoms.Choice("", templ.Attributes{"type": "radio", "name": FieldMedia, "value": MediaImage, "checked": s.Media != MediaVideo})
					画像
				</label>
				<label class="flex items-center gap-1">
					@atoms.Choice("", templ.Attributes{"type": "radio", "name": FieldMedia, "value": MediaVideo, "checked": s.Media == MediaVideo})
					動画
				</label>
			</div>
		</fieldset>
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for="local-workflow-json">
			<span>ワークフローの JSON（ComfyUI の「Save (API Format)」で保存したもの。エディタ形式は取り込めません）</span>
			@atoms.Textarea(atoms.FieldMd, "h-40 w-full font-mono text-xs", templ.Attributes{
				"id": "local-workflow-json", "name": FieldWorkflowText, "spellcheck": "false",
			}, s.WorkflowText)
		</label>
		<div class="flex flex-wrap items-center gap-2">
			@atoms.Button(atoms.TonePrimary, "次へ（割り当てを設定）", templ.Attributes{"type": "submit"})
			@closeButton()
		</div>
	</form>
}
