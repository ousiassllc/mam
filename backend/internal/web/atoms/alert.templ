package atoms

// AlertKind is the meaning of an Alert: one of the four states of the UI guide.
type AlertKind string

// Alert kinds.
const (
	AlertInfo    AlertKind = "info"
	AlertSuccess AlertKind = "success"
	AlertWarning AlertKind = "warning"
	AlertError   AlertKind = "error"
)

// ErrorAlertTitle is the heading of the alert that says an action did not go through.
const ErrorAlertTitle = "操作を完了できませんでした"

func alertClass(kind AlertKind) string {
	base := "pointer-events-auto flex items-start gap-3 rounded-md border p-3 text-sm "
	switch kind {
	case AlertSuccess:
		return base + "border-success/60 bg-success/10"
	case AlertWarning:
		return base + "border-warning/60 bg-warning/10"
	case AlertError:
		return base + "border-danger/60 bg-danger/10"
	}
	return base + "border-info/60 bg-info/10"
}

func alertTone(kind AlertKind) string {
	switch kind {
	case AlertSuccess:
		return "text-success"
	case AlertWarning:
		return "text-warning"
	case AlertError:
		return "text-danger"
	}
	return "text-info"
}

func alertIcon(kind AlertKind) IconName {
	switch kind {
	case AlertSuccess:
		return IconSuccess
	case AlertWarning:
		return IconWarning
	case AlertError:
		return IconDanger
	}
	return IconInfo
}

// alertRole is how a screen reader hears it: an error and a warning interrupt (alert), the others wait their turn (status).
func alertRole(kind AlertKind) string {
	if kind == AlertError || kind == AlertWarning {
		return "alert"
	}
	return "status"
}

// Alert is the inline alert of the UI guide (O3, the four kinds): the icon of its state, a heading and the text, with a button that closes it. It stays
// until it is closed, because what it says may be long (a refused action, an exceeded budget, a LOCK) and has to be read at the reader's own pace
// (WCAG 2.2.1); the state is told by the icon and the words, not by the colour alone. The page shell embeds one as <template id="alert-template">, which
// static/src/components/alert/alert.ts clones for the alerts it raises itself.
templ Alert(kind AlertKind, title, body string) {
	<div class={ alertClass(kind) } role={ alertRole(kind) } data-alert data-kind={ string(kind) }>
		@Icon(alertIcon(kind), "mt-1 h-5 w-5 shrink-0 "+alertTone(kind))
		<div class="flex min-w-0 flex-1 flex-col gap-1">
			<p class={ "font-semibold", alertTone(kind) }>{ title }</p>
			<p class="whitespace-pre-line break-words text-ink" data-alert-message>{ body }</p>
		</div>
		<button type="button" class="shrink-0 rounded-md p-1 text-mute transition-colors hover:bg-accent-soft hover:text-ink focus-visible:focus-ring motion-reduce:transition-none" aria-label="閉じる" data-alert-close data-ripple>
			@Icon(IconClose, "h-4 w-4")
		</button>
	</div>
}

// ErrorAlertOOB puts an alert that an action did not go through in #alert-region at the top of the page (out-of-band swap). Business errors (403 / 409 / 423, an
// exceeded budget, ...) are shown this way instead of replacing the target: the response leaves the swap target untouched.
templ ErrorAlertOOB(message string) {
	<div id="alert-region" hx-swap-oob="beforeend">
		@Alert(AlertError, ErrorAlertTitle, message)
	</div>
}
