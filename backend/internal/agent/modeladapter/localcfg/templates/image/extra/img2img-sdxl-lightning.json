{
 "id": "img2img-sdxl-lightning",
 "label": "SDXL Lightning: 参照画像から画像",
 "media": "image",
 "description": "参照画像 1 枚を VAEEncode して denoise 0.6 で描き直す SDXL Lightning 系ワークフロー（5 ステップ・cfg 1.5・dpmpp_sde/karras が既定）。標準ノードだけ。GPU では未実行（構造のテストのみ）。",
 "model": {
  "media": "image",
  "workflow": {
   "prompt_weight": "supported",
   "graph": {
    "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
    "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
    "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "mam/image", "images": ["8", 0]}},
    "10": {"class_type": "LoadImage", "inputs": {"image": "example.png"}},
    "11": {"class_type": "VAEEncode", "inputs": {"pixels": ["10", 0], "vae": ["4", 2]}},
    "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 5, "cfg": 1.5, "sampler_name": "dpmpp_sde", "scheduler": "karras", "denoise": 0.6, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["11", 0]}}
   },
   "assignments": [
    {"param": "prompt", "node": "6", "input": "text"},
    {"param": "negative_prompt", "node": "7", "input": "text"},
    {"param": "seed", "node": "3", "input": "seed"},
    {"param": "reference_image", "node": "10", "input": "image", "index": 0},
    {"param": "steps", "node": "3", "input": "steps"},
    {"param": "cfg", "node": "3", "input": "cfg"},
    {"param": "sampler", "node": "3", "input": "sampler_name"},
    {"param": "scheduler", "node": "3", "input": "scheduler"}
   ],
   "output_node": "9"
  }
 }
}
