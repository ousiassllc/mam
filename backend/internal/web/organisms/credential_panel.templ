package organisms

import "github.com/ousiassllc/mam/backend/internal/service"

// CredentialPanelData is the API keys on the settings screen: which provider has a key. The value of
// a key is never part of it. Error and ErrorProvider say why the last save was refused.
type CredentialPanelData struct {
	Providers     []service.CredentialStatus
	Error         string
	ErrorProvider string
}

// CredentialPanel lists the providers with "設定済み" / "未設定", a form to save a key (PUT) and a
// button to delete it (DELETE). The key is sent once and never rendered again.
templ CredentialPanel(d CredentialPanelData) {
	<section id="credential-panel" class="flex flex-col gap-3">
		<ul class="flex flex-col divide-y divide-neutral-800 text-sm">
			for _, p := range d.Providers {
				<li class="flex flex-col gap-2 py-3" data-testid="credential-row" data-provider={ p.Provider }>
					<div class="flex flex-wrap items-center justify-between gap-2">
						<span class="font-medium">{ p.Label }</span>
						if p.Configured {
							<span class="rounded-full bg-emerald-900/60 px-2 py-0.5 text-xs text-emerald-200">設定済み</span>
						} else {
							<span class="rounded-full bg-neutral-800 px-2 py-0.5 text-xs text-neutral-300">未設定</span>
						}
					</div>
					<form
						class="flex flex-wrap items-center gap-2"
						hx-put={ "/credentials/" + p.Provider }
						hx-target="#credential-panel"
						hx-swap="outerHTML"
						autocomplete="off"
					>
						<label class="sr-only" for={ "api-key-" + p.Provider }>{ p.Label } の API キー</label>
						<input
							id={ "api-key-" + p.Provider }
							name="api_key"
							type="password"
							autocomplete="off"
							placeholder={ keyPlaceholder(p.Configured) }
							class="min-w-0 flex-1 rounded-md border border-neutral-600 bg-neutral-950 px-3 py-1.5 text-sm"
						/>
						<button type="submit" class="rounded-md bg-indigo-500 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-400">保存</button>
						if p.Configured {
							<button
								type="button"
								class="rounded-md border border-neutral-600 px-3 py-1.5 text-sm hover:bg-neutral-800"
								hx-delete={ "/credentials/" + p.Provider }
								hx-target="#credential-panel"
								hx-swap="outerHTML"
								hx-confirm={ p.Label + " の API キーを削除します。よろしいですか？" }
							>削除</button>
						}
					</form>
					if d.Error != "" && d.ErrorProvider == p.Provider {
						<p class="text-sm text-red-300" role="alert">{ d.Error }</p>
					}
				</li>
			}
		</ul>
	</section>
}

func keyPlaceholder(configured bool) string {
	if configured {
		return "新しいキーで置き換える"
	}
	return "API キーを貼り付け"
}
