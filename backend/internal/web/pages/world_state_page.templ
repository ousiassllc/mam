package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
)

// WorldStatePage is GET /projects/:id/world-state: the current World State in an auxiliary view.
templ WorldStatePage(csrfToken string, d organisms.WorldStateData) {
	@layout.AppLayout("World State: "+d.Project.Name, csrfToken) {
		<main class="mx-auto max-w-5xl p-8">
			<a href={ templ.SafeURL("/projects/" + d.Project.ID) } class="text-sm text-neutral-400 hover:text-neutral-100">← チャットに戻る</a>
			<h1 class="mb-1 mt-3 text-xl font-semibold">World State</h1>
			<p class="mb-6 text-sm text-neutral-400">{ d.Project.Name }</p>
			@organisms.WorldStateView(d)
		</main>
	}
}
