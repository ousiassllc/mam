{
 "id": "txt2img-sdxl-lightning",
 "label": "SDXL Lightning: テキストから画像",
 "media": "image",
 "description": "SDXL Lightning（蒸留で 4〜8 ステップ・cfg 1〜2 の少ない手数で描く）系チェックポイントのワークフロー。既定は作者（RealVisXL V5.0 Lightning のカード）の推奨に合わせ、5 ステップ・cfg 1.5・dpmpp_sde/karras。標準ノードだけ。チェックポイント名は使うモデルに合わせて変える。GPU では未実行（構造のテストのみ）。",
 "model": {
  "media": "image",
  "workflow": {
   "prompt_weight": "supported",
   "graph": {
    "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
    "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
    "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "mam/image", "images": ["8", 0]}},
    "5": {"class_type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 5, "cfg": 1.5, "sampler_name": "dpmpp_sde", "scheduler": "karras", "denoise": 1, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}}
   },
   "assignments": [
    {"param": "prompt", "node": "6", "input": "text"},
    {"param": "negative_prompt", "node": "7", "input": "text"},
    {"param": "seed", "node": "3", "input": "seed"},
    {"param": "width", "node": "5", "input": "width"},
    {"param": "height", "node": "5", "input": "height"},
    {"param": "steps", "node": "3", "input": "steps"},
    {"param": "cfg", "node": "3", "input": "cfg"},
    {"param": "sampler", "node": "3", "input": "sampler_name"},
    {"param": "scheduler", "node": "3", "input": "scheduler"}
   ],
   "output_node": "9"
  }
 }
}
