package media

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modal"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/modelpick"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// ImageModal is the body of the modal that edits the models of one image purpose: the primary and the fallback model (with
// the "fast variant" where a model has one). The fields are the ones of the whole assignment (ImageModelField, ImageFastField),
// so that one parser reads both. A model the saved route names but that cannot be chosen is shown as it is, selected, with
// "（現在は使えません）".
templ ImageModal(f ImageForm) {
	@modal.Frame(f.Row.Label+" の画像モデル", f.Row.Hint+"。保存するとすぐに反映されます。") {
		if f.Error != "" {
			@modal.Error(f.Error)
		}
		<form
			class="flex flex-col gap-4"
			method="post"
			data-testid="media-image-form"
			hx-put={ paths.ModelImage(f.Row.Purpose) }
			hx-target={ "#" + modal.BodyID }
			hx-swap="innerHTML"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type=submit]"
			autocomplete="off"
			id="media-image-form"
		>
			@imageSlot(f, SlotPrimary, "主モデル", f.Primary, f.Row.Primary)
			@imageSlot(f, SlotFallback, "代替モデル", f.Fallback, f.Row.Fallback)
			@modal.Actions() {
				@modal.Cancel("キャンセル")
				@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
			}
		</form>
	}
}

templ imageSlot(f ImageForm, slot, slotLabel string, field modelpick.FieldData, t ImageTarget) {
	<div class="flex flex-wrap items-start gap-3">
		<span id={ field.ID + "-label" } class="w-24 pt-2 text-sm font-medium">{ slotLabel }</span>
		<div class="min-w-0 flex-1">
			@modelpick.Field(field)
		</div>
		if showFast(t, f.Models) {
			<label class="flex items-center gap-1 pt-2 text-xs">
				@atoms.Choice("", templ.Attributes{"type": "checkbox", "name": ImageFastField(f.Row.Purpose, slot), "value": "1", "checked": t.Fast})
				高速版<span class="sr-only">（{ slotLabel }）</span>
			</label>
		}
	</div>
}

// PolicyModal is the body of the modal that edits the video models and the Takes of one Quality Policy. Each option of a
// model is the model at a resolution it supports.
templ PolicyModal(f PolicyForm) {
	@modal.Frame(f.Row.Label+" の動画モデル", "モデルは、そのモデルが対応する解像度との組み合わせで選びます。保存するとすぐに反映されます。") {
		if f.Error != "" {
			@modal.Error(f.Error)
		}
		<form
			class="flex flex-col gap-4"
			method="post"
			data-testid="media-policy-form"
			hx-put={ paths.ModelPolicy(f.Row.Policy) }
			hx-target={ "#" + modal.BodyID }
			hx-swap="innerHTML"
			hx-sync="this:drop"
			hx-disabled-elt="find button[type=submit]"
			autocomplete="off"
			id="media-policy-form"
		>
			@policySlot(SlotPrimary, "主モデル", f.Primary)
			@policySlot(SlotFallback, "代替モデル", f.Fallback)
			<div class="flex flex-wrap items-center gap-3">
				<label for={ PolicyTakesField(f.Row.Policy) } class="w-24 text-sm font-medium">テイク数</label>
				@atoms.Input(atoms.FieldMd, "w-20", blamed(templ.Attributes{
					"id":    PolicyTakesField(f.Row.Policy),
					"name":  PolicyTakesField(f.Row.Policy),
					"type":  "number",
					"min":   "1",
					"step":  "1",
					"value": strconv.Itoa(f.Row.Takes),
				}, f.Blame == BlameTakes))
			</div>
			@modal.Actions() {
				@modal.Cancel("キャンセル")
				@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
			}
		</form>
	}
}

templ policySlot(slot, slotLabel string, field modelpick.FieldData) {
	<div class="flex flex-wrap items-start gap-3">
		<span id={ field.ID + "-label" } class="w-24 pt-2 text-sm font-medium">{ slotLabel }</span>
		<div class="min-w-0 flex-1">
			@modelpick.Field(field)
		</div>
	</div>
}

// blamed marks the field a refusal is about: what says so (aria-invalid, the reason as its description) and the focus.
func blamed(a templ.Attributes, blame bool) templ.Attributes {
	if blame {
		a["aria-invalid"], a["aria-describedby"], a["autofocus"] = "true", modal.ErrorID, true
	}
	return a
}
