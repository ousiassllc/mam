package modelassignment

import (
	"slices"
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// The two models of a route.
const (
	SlotPrimary  = "primary"
	SlotFallback = "fallback"
)

// ImageModelField is the name of the model <select> of an image purpose's slot.
func ImageModelField(purpose, slot string) string { return "image_" + purpose + "_" + slot + "_model" }

// ImageFastField is the name of the "fast variant" checkbox of an image purpose's slot.
func ImageFastField(purpose, slot string) string { return "image_" + purpose + "_" + slot + "_fast" }

// PolicyTargetField is the name of the <select> of a Quality Policy's slot: its options carry a model and
// a resolution together (see VideoChoice), so that only a resolution the model supports can be picked.
func PolicyTargetField(policy, slot string) string { return "policy_" + policy + "_" + slot }

// PolicyTakesField is the name of the number of Takes of a Quality Policy.
func PolicyTakesField(policy string) string { return "policy_" + policy + "_takes" }

// ImageModel is an image model that may be chosen. Fast: it has a fast variant. AcceptsReferences:
// the Model Adapter hands it reference images.
type ImageModel struct {
	Name              string
	Fast              bool
	AcceptsReferences bool
}

// ImageTarget is the saved choice of one slot of an image purpose.
type ImageTarget struct {
	Model string
	Fast  bool
}

// ImageRow is one image purpose. ReferenceNote, when set, says which of its models do not use reference images.
type ImageRow struct {
	Purpose       string
	Label         string
	Hint          string
	Primary       ImageTarget
	Fallback      ImageTarget
	ReferenceNote string
}

// VideoChoice is one option of a video slot: a model at a resolution it supports (Value is
// "<model>@<resolution>").
type VideoChoice struct {
	Value string
	Label string
}

// PolicyRow is one Quality Policy: the video models (a VideoChoice.Value each) and the number of Takes.
type PolicyRow struct {
	Policy   string
	Label    string
	Primary  string
	Fallback string
	Takes    int
}

// Data is the "画像・動画モデル" section: the saved assignment (the app applies a
// saved change at once) and what it may be set to. Pinned: the file was fixed by a start-up option, so the
// section is read-only and PinnedNote names that option. Notice is the confirmation of a save or a
// reset; Error is why the last save was refused (the form then shows what was submitted). Problem means
// the settings file cannot be read: the section then says so and offers nothing.
type Data struct {
	Pinned     bool
	PinnedNote string
	Customized bool
	Notice     string
	Error      string
	Problem    string
	// OOB: the form is sent out of band, to replace the one on the screen (an action of another section changed
	// what can be chosen: the local models).
	OOB          bool
	Images       []ImageRow
	ImageModels  []ImageModel
	Policies     []PolicyRow
	VideoChoices []VideoChoice
}

const sectionID = "model-assignment"

// SectionIf is Section, or nothing when d is nil.
templ SectionIf(d *Data) {
	if d != nil {
		@Section(*d)
	}
}

// Section is the "画像・動画モデル" section of the global settings screen.
templ Section(d Data) {
	@molecules.SettingsSectionAt(molecules.HeadingNone, "画像・動画モデル", "画像の用途ごと・Quality Policy ごとに、主モデルと、主モデルが使えないときの代替モデルを選びます。保存した内容は <データフォルダ>/models.json に書かれ、すぐに反映されます。「ローカル・代替モデル」で登録したモデルも選べます。") {
		if d.Problem != "" {
			<div id={ sectionID }>
				<p class="text-sm text-red-300" role="alert" data-testid="model-assignment-problem">{ d.Problem }</p>
			</div>
		} else {
			@Form(d)
		}
	}
}

// Form is the whole assignment in one form: Save (PUT) stores it, "既定に戻す" (DELETE) removes the
// overrides. Both answer with this form again, so a refused save keeps what was typed.
templ Form(d Data) {
	<form
		id={ sectionID }
		class="flex flex-col gap-4"
		hx-put={ paths.ModelSettings() }
		hx-target={ "#" + sectionID }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button"
		autocomplete="off"
		data-testid="model-assignment"
		if d.OOB {
			hx-swap-oob="true"
		}
	>
		if d.Pinned {
			<p class="text-sm text-amber-300" role="status" data-testid="model-assignment-pinned">{ d.PinnedNote }</p>
		}
		if d.Notice != "" {
			<p class="text-sm text-emerald-300" role="status" data-testid="model-assignment-notice">{ d.Notice }</p>
		}
		if d.Error != "" {
			<p class="text-sm text-red-300" role="alert" data-testid="model-assignment-error">{ d.Error }</p>
		}
		<fieldset class="flex flex-col gap-2" disabled?={ d.Pinned }>
			<legend class="text-sm font-medium">画像モデル</legend>
			<p class="text-xs text-neutral-400">代替モデルは、主モデルが使えないとき（連続失敗で遮断中、またはリトライしても失敗したとき）に使われます。「高速版」は、高速版を持つモデルでだけ保存できます。</p>
			<p class="text-xs text-amber-300" data-testid="model-assignment-reference-warning">参照画像を使えないモデルで画像を作るとき、その生成には参照画像は渡されず、Prompt だけで画像を作ります（ログに警告が残ります）。代替モデルに選んだ場合も、主モデルが使えなくなったときに同じ扱いになります。</p>
			<ul class="flex flex-col divide-y divide-neutral-800 text-sm">
				for _, r := range d.Images {
					@imageRow(r, d.ImageModels)
				}
			</ul>
		</fieldset>
		<fieldset class="flex flex-col gap-2" disabled?={ d.Pinned }>
			<legend class="text-sm font-medium">動画モデル（Quality Policy ごと）</legend>
			<p class="text-xs text-neutral-400">モデルは、そのモデルが対応する解像度との組み合わせで選びます。テイク数は 1 以上です。</p>
			<ul class="flex flex-col divide-y divide-neutral-800 text-sm">
				for _, r := range d.Policies {
					@policyRow(r, d.VideoChoices)
				}
			</ul>
		</fieldset>
		if !d.Pinned {
			<div class="flex flex-wrap items-center gap-2">
				@atoms.Button(atoms.TonePrimary, "保存", templ.Attributes{"type": "submit"})
				if d.Customized {
					@atoms.Button(atoms.ToneNeutral, "既定に戻す", templ.Attributes{
						"hx-disabled-elt": "this",
						"hx-sync":         "closest form:drop", // a save and a reset never run together
						"type":            "button",
						"hx-delete":       paths.ModelSettings(),
						"hx-params":       "none", // inside the form: never send its values with a DELETE
						"hx-target":       "#" + sectionID,
						"hx-swap":         "outerHTML",
						"hx-confirm":      "画像・動画モデルの割り当てを既定に戻します。よろしいですか？",
					})
				}
			</div>
		}
	</form>
}

templ imageRow(r ImageRow, models []ImageModel) {
	<li class="flex flex-col gap-2 py-3" data-testid="model-assignment-image" data-purpose={ r.Purpose }>
		<div>
			<span class="font-medium">{ r.Label }</span>
			<p class="text-xs text-neutral-400">{ r.Hint }</p>
		</div>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			@imageSlot(r.Purpose, SlotPrimary, "主モデル", r.Label, r.Primary, models)
			@imageSlot(r.Purpose, SlotFallback, "代替モデル", r.Label, r.Fallback, models)
		</div>
		if r.ReferenceNote != "" {
			<p class="text-xs text-amber-300" role="status" data-testid="model-assignment-reference-note">{ r.ReferenceNote }</p>
		}
	</li>
}

// showFast reports whether a slot offers the "fast variant" checkbox: only when a model has a fast variant
// (models.<id>.fast_model; no built-in model has one) or the saved route already asks for it.
func showFast(t ImageTarget, models []ImageModel) bool {
	return t.Fast || slices.ContainsFunc(models, func(m ImageModel) bool { return m.Fast })
}

templ imageSlot(purpose, slot, slotLabel, purposeLabel string, t ImageTarget, models []ImageModel) {
	<div class="flex flex-wrap items-center gap-2">
		<label for={ ImageModelField(purpose, slot) }>{ slotLabel }<span class="sr-only">（{ purposeLabel }）</span></label>
		@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": ImageModelField(purpose, slot), "name": ImageModelField(purpose, slot)}) {
			for _, m := range models {
				<option value={ m.Name } selected?={ m.Name == t.Model }>{ m.Name }</option>
			}
		}
		if showFast(t, models) {
			<label class="flex items-center gap-1 text-xs">
				@atoms.Choice("", templ.Attributes{"type": "checkbox", "name": ImageFastField(purpose, slot), "value": "1", "checked": t.Fast})
				高速版<span class="sr-only">（{ slotLabel }、{ purposeLabel }）</span>
			</label>
		}
	</div>
}

templ policyRow(r PolicyRow, choices []VideoChoice) {
	<li class="flex flex-col gap-2 py-3" data-testid="model-assignment-policy" data-policy={ r.Policy }>
		<span class="font-medium">{ r.Label }</span>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			@policySlot(r.Policy, SlotPrimary, "主モデル", r.Label, r.Primary, choices)
			@policySlot(r.Policy, SlotFallback, "代替モデル", r.Label, r.Fallback, choices)
			<div class="flex items-center gap-2">
				<label for={ PolicyTakesField(r.Policy) }>テイク数<span class="sr-only">（{ r.Label }）</span></label>
				@atoms.Input(atoms.FieldMd, "w-20", templ.Attributes{
					"id":    PolicyTakesField(r.Policy),
					"name":  PolicyTakesField(r.Policy),
					"type":  "number",
					"min":   "1",
					"step":  "1",
					"value": strconv.Itoa(r.Takes),
				})
			</div>
		</div>
	</li>
}

templ policySlot(policy, slot, slotLabel, policyLabel, selected string, choices []VideoChoice) {
	<div class="flex flex-wrap items-center gap-2">
		<label for={ PolicyTargetField(policy, slot) }>{ slotLabel }<span class="sr-only">（{ policyLabel }）</span></label>
		@atoms.Select(atoms.FieldMd, "", templ.Attributes{"id": PolicyTargetField(policy, slot), "name": PolicyTargetField(policy, slot)}) {
			for _, c := range choices {
				<option value={ c.Value } selected?={ c.Value == selected }>{ c.Label }</option>
			}
		}
	</div>
}
