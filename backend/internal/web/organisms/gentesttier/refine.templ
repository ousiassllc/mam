package gentesttier

import "github.com/ousiassllc/mam/backend/internal/web/atoms"

// Refine is the top of the detail tier: the tabs' line of what came from the easy tier, the place where the values that were changed from
// where the tier began are listed (each with a way back, and one for all), and the choices of the easy tier carried to the way back. The list is
// drawn by static/src/components/gentest-tiers/refine.ts; the controls themselves stay where they are (the prompts, the detailed settings, the
// LoRA and the strength of the input images), each marked while it differs from its starting value.
templ Refine(d Data) {
	<input type="hidden" name={ FieldTier } value={ TierDetail }/>
	<input type="hidden" name={ FieldKeepIntent } value={ d.KeepIntent }/>
	<input type="hidden" name={ FieldKeepQuality } value={ d.KeepQuality }/>
	<section class="flex flex-col gap-2 rounded-lg border border-border p-3 text-sm" aria-labelledby="gt-refine-title" data-gt-refine data-testid="gt-refine">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h2 id="gt-refine-title" class="text-sm font-semibold text-ink">こだわり</h2>
			@atoms.SmallButton(atoms.ToneNeutral, "全部を元に戻す", templ.Attributes{"type": "button", "hidden": true, "data-gt-reset-all": "", "data-testid": "gt-reset-all"})
		</div>
		if d.Carried != "" {
			<p class="text-sm text-ink" data-testid="gt-carried">{ d.Carried }</p>
		}
		<p class="text-sm text-mute" data-gt-refine-empty data-testid="gt-refine-empty">変えた項目はまだありません。変えると、ここに並び、元に戻せます。</p>
		<ul class="flex flex-col gap-1" data-gt-refine-list data-testid="gt-refine-list" aria-live="polite"></ul>
	</section>
}
