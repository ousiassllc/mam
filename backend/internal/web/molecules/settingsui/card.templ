package settingsui

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/help"
)

// Card is one row of a list of the settings screen drawn as a card (shared-ui-parts.md §5): a name, a state, what it is
// for and the buttons that act on it. The id of the row is what a save replaces out of band.
type Card struct {
	// ID is the id of the <li> (credential-row-<provider>); TestID is its data-testid ("settings-card" when empty).
	ID, TestID string
	// Attrs are more attributes of the <li> (data-provider).
	Attrs templ.Attributes
	Title string
	// TitleLevel is the level of the heading of the title: 3 or 4 (under an h3 of a section). Zero is 3.
	TitleLevel int
	Tone       atoms.BadgeTone
	State      string // the text of the Badge; empty draws none
	// Marks are more badges beside State for what must not be missed even when the details are behind a button: "非公式",
	// "商用注意". They come before State.
	Marks []Mark
	// Class is more classes of the <li> (the look of a card that is chosen: has-[:checked]:...).
	Class string
	// Help is the explanation of the row behind a "?" button beside its title (nil: none): what is too long for the card.
	Help templ.Component
	// HelpPanelElsewhere leaves the panel of Help out of the card: the card draws only the "?" button (aria-controls =
	// help.ID(ID)) and the caller draws the panel with that id somewhere a swap of the card does not reach. For a card
	// that is swapped while the help may be open (a polled panel): a panel inside the swap closes with it.
	HelpPanelElsewhere bool
	// Description is what the row is for; Summary is its current value (what is set, who is signed in).
	Description, Summary string
	// Details is more of the row between its summary and its buttons (a card whose state needs more than a line).
	Details templ.Component
	// Notice is a short confirmation of what the last action did (role="status"); it is gone when the page is read again.
	Notice string
	// OOB makes the <li> replace the one with its id out of band.
	OOB bool
}

// Mark is a badge of a card that says a risk or a condition: the tone and the words (never colour alone).
type Mark struct {
	Tone atoms.BadgeTone
	Text string
}

func (c Card) testID() string {
	if c.TestID == "" {
		return "settings-card"
	}
	return c.TestID
}

// CardItem is a Card as a list item; the actions are its children, a row of buttons. Put the cards in one
// <ul role="list">.
templ CardItem(c Card) {
	<li
		id={ c.ID }
		data-testid={ c.testID() }
		class={ "flex min-w-0 flex-col gap-2 rounded-lg border border-border bg-surface p-4", c.Class }
		{ c.Attrs... }
		if c.OOB {
			hx-swap-oob="true"
		}
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div class="flex min-w-0 items-center gap-2">
				if c.TitleLevel == 4 {
					<h4 class="min-w-0 break-words text-sm font-semibold text-ink">{ c.Title }</h4>
				} else {
					<h3 class="min-w-0 break-words text-sm font-semibold text-ink">{ c.Title }</h3>
				}
				if c.Help != nil {
					@help.Toggle(help.ID(c.ID), c.Title)
					if !c.HelpPanelElsewhere {
						@help.Panel(help.ID(c.ID), c.Title) {
							@c.Help
						}
					}
				}
			</div>
			if c.State != "" || len(c.Marks) > 0 {
				<div class="flex min-w-0 max-w-full flex-wrap items-center gap-1 [&>*]:max-w-full [&>*]:break-words" data-testid="settings-card-badges">
					for _, m := range c.Marks {
						@atoms.Badge(m.Tone, m.Text)
					}
					if c.State != "" {
						@atoms.Badge(c.Tone, c.State)
					}
				</div>
			}
		</div>
		if c.Description != "" {
			<p class="break-words text-sm text-mute">{ c.Description }</p>
		}
		if c.Summary != "" {
			<p class="break-words text-sm text-ink">{ c.Summary }</p>
		}
		if c.Details != nil {
			@c.Details
		}
		if c.Notice != "" {
			<p class="text-sm text-success" role="status">{ c.Notice }</p>
		}
		<div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
			{ children... }
		</div>
	</li>
}
