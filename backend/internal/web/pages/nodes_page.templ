package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/workflows"
)

// NodesPage is GET /nodes: the ComfyUI node UI in an iframe, and the way to the saved workflows. The response
// carries frame-src for exactly the ComfyUI it shows (middleware.AllowFrame).
templ NodesPage(csrfToken string, d workflows.NodeData) {
	@layout.AppLayout("ノード", csrfToken, sidenav.At(sidenav.Nodes)) {
		@pagehead.Main(pagehead.Full) {
			@pagehead.Header("ノード", "", "ComfyUI のノード画面です。作ったワークフローはワークフローに保存すると、Shot の生成方法に使えます。")
			@workflows.Node(d)
		}
	}
}
