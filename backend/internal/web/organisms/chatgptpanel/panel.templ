package chatgptpanel

import (
	"time"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

const (
	usageURL     = "https://chatgpt.com/settings/usage"
	panelTarget  = "#chatgpt-panel"
	officialKind = "official"
	imageKind    = "image"
	codexKind    = "codex"
)

// Section is the "ChatGPT でログイン" section of the global settings screen: Panel under its title.
templ Section(d Data) {
	@molecules.SettingsSection("ChatGPT でログイン", "ChatGPT のサブスク（Plus / Pro など）を、API キーの代わりに使えます。テキスト生成には方式が 2 つあります。個人（Go / Plus / Pro）は OpenAI 公式の Sign in with ChatGPT（プロバイダー「chatgpt-subscription」）、組織（Business / Enterprise / Edu）のアカウントは Codex 経由（プロバイダー「chatgpt-codex」）です。LLM の割り当てで選ぶと使われます。画像生成は非公式の経路で、別のログインと確認が必要です。") {
		@Panel(d)
	}
}

// SectionIf is Section, or nothing when d is nil.
templ SectionIf(d *Data) {
	if d != nil {
		@Section(*d)
	}
}

// Panel is the whole section. Every action answers with the panel itself; while a login is pending the panel polls itself.
templ Panel(d Data) {
	<section
		id="chatgpt-panel"
		class="flex flex-col gap-6"
		if polling(d) {
			hx-get={ methodURL(d.Method) }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		if d.Notice != "" {
			<p class="text-sm text-emerald-300" role="status" data-testid="chatgpt-notice">{ d.Notice }</p>
		}
		if d.Error != "" {
			<p class="text-sm text-red-300" role="alert" data-testid="chatgpt-error">{ d.Error }</p>
		}
		@methodTabs(d)
		if d.Method == MethodCodex {
			@codexBlock(d)
		} else {
			@officialBlock(d)
		}
		@imageBlock(d)
	</section>
}

func polling(d Data) bool {
	return (d.Official.Login != nil && d.Official.Login.Pending) || (d.Image.Login != nil && d.Image.Login.Pending) ||
		(d.Codex.Login != nil && d.Codex.Login.Pending) || d.Codex.Engine.Install.Running
}

templ officialBlock(d Data) {
	<div class="flex flex-col gap-3" data-testid="chatgpt-official">
		<h3 class="text-sm font-semibold">ChatGPT サブスク（公式・テキスト生成）</h3>
		@accountStatus(officialKind, d.Official)
		@loginMessage(d.Official.Login)
		@codexGuidance(d)
		if d.Official.SignedIn && !d.Official.NeedsRelogin {
			<p class="text-xs text-neutral-400" data-testid="chatgpt-using-plan">
				{ "Using ChatGPT plan" }
				／
				<a class="underline" href={ templ.SafeURL(usageURL) } target="_blank" rel="noopener noreferrer">Manage usage</a>
				（使用量の確認と上限の設定は ChatGPT の画面で行います）
			</p>
		}
		<div class="flex flex-wrap items-center gap-2">
			if !d.Official.SignedIn || d.Official.NeedsRelogin || !d.Official.PlanUsageGranted {
				@loginButton(officialKind, "browser", loginLabel(d.Official), d.Official.Login)
			}
			if d.Official.SignedIn {
				@logoutButton(officialKind)
			}
		</div>
		<p class="text-xs text-neutral-400" data-testid="chatgpt-official-remote">
			ブラウザは、mam が動いているこの PC で開きます。tailnet などの別のマシンから操作しているときは、先にこの PC でログインしてください（公式のログインにはデバイスコードの方式がありません）。
		</p>
		@models(d)
	</div>
}

func loginLabel(a Account) string {
	if a.SignedIn && a.NeedsRelogin {
		return "ログインし直す（Continue with ChatGPT）"
	}
	if a.SignedIn && !a.PlanUsageGranted {
		return "プランの利用を許可する（Continue with ChatGPT）"
	}
	return "Continue with ChatGPT"
}

templ accountStatus(kind string, a Account) {
	<div class="flex flex-col gap-1 text-sm" data-testid={ "chatgpt-status-" + kind }>
		if !a.SignedIn {
			<p class="text-neutral-300">ログインしていません</p>
		} else {
			<p>
				if a.NeedsRelogin {
					@atoms.Badge(atoms.BadgeError, "再ログインが必要")
				} else if kind == officialKind && !a.PlanUsageGranted {
					@atoms.Badge(atoms.BadgeError, "プランの利用が未許可")
				} else {
					@atoms.Badge(atoms.BadgeOK, "ログイン済み")
				}
				<span class="ml-2 font-medium" data-testid="chatgpt-email">{ a.Email }</span>
				if a.Plan != "" {
					<span class="ml-2 text-xs text-neutral-400" data-testid="chatgpt-plan">プラン: { a.Plan }</span>
				}
			</p>
			if a.NeedsRelogin {
				<p class="text-amber-300" role="alert" data-testid="chatgpt-relogin">ログインの有効期限が切れました。もう一度ログインしてください。それまでこの経路は使われません。</p>
			}
			if !a.ExpiresAt.IsZero() {
				<p class="text-xs text-neutral-400">アクセストークンの期限: <time datetime={ a.ExpiresAt.UTC().Format(time.RFC3339) }>{ a.ExpiresAt.Local().Format("2006-01-02 15:04") }</time>（期限の前に自動で更新します）</p>
			}
		}
	</div>
}

templ loginMessage(l *Login) {
	if l != nil {
		if l.Pending && l.Device {
			<div class="flex flex-col gap-2 rounded-md border border-neutral-700 px-3 py-2" role="status" data-testid="chatgpt-device">
				<p class="text-sm">1. 別の端末でも構いません。次の URL を開いて ChatGPT にログインします。</p>
				<a class="break-all text-sm underline" href={ templ.SafeURL(l.VerificationURL) } target="_blank" rel="noopener noreferrer" data-testid="chatgpt-device-url">{ l.VerificationURL }</a>
				<p class="text-sm">2. 次のコードを入力します（有効期限: { l.ExpiresAt.Local().Format("15:04") } まで）。</p>
				<code class="w-fit rounded bg-neutral-950 px-3 py-1 text-lg tracking-widest select-all" data-testid="chatgpt-device-code">{ l.UserCode }</code>
				<p class="text-xs text-neutral-400">自分で始めたログインのときだけ続けてください。人やサイトに教えられたコードは入力しないでください。完了すると、この表示は自動で変わります。</p>
			</div>
		} else if l.Pending {
			<div class="flex flex-col gap-2 rounded-md border border-neutral-700 px-3 py-2" role="status" data-testid="chatgpt-browser-login">
				<p class="text-sm">{ l.Message }</p>
				if l.AuthURL != "" && !l.BrowserOpened {
					<a class="break-all text-sm underline" href={ templ.SafeURL(l.AuthURL) } target="_blank" rel="noopener noreferrer" data-testid="chatgpt-auth-url">ログインのページを開く</a>
				}
				<p class="text-xs text-neutral-400">完了すると、この表示は自動で変わります。</p>
			</div>
		} else if l.Failed {
			<p class="text-sm text-red-300" role="alert" data-testid="chatgpt-login-failed">{ l.Message }</p>
		}
	}
}

templ loginButton(kind, method, label string, l *Login) {
	<form
		hx-post={ paths.ChatGPTLogin(kind) }
		hx-target={ panelTarget }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
	>
		<input type="hidden" name="method" value={ method }/>
		@atoms.Button(atoms.TonePrimary, label, templ.Attributes{"type": "submit", "data-testid": "chatgpt-login-" + kind + "-" + method})
	</form>
	if l != nil && l.Pending {
		<form hx-post={ paths.ChatGPTLoginCancel(kind) } hx-target={ panelTarget } hx-swap="outerHTML" hx-sync="this:drop" hx-params="none" hx-disabled-elt="find button[type=submit]">
			@atoms.Button(atoms.ToneNeutral, "ログインを中止", templ.Attributes{"type": "submit", "data-testid": "chatgpt-cancel-" + kind})
		</form>
	}
}

templ logoutButton(kind string) {
	<form
		hx-delete={ paths.ChatGPTAccount(kind) }
		hx-target={ panelTarget }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-params="none"
		hx-disabled-elt="find button[type=submit]"
		hx-confirm="ログアウトします。保存したトークンを削除し、可能なら OpenAI 側でも失効させます。よろしいですか？"
	>
		@atoms.Button(atoms.ToneDanger, "ログアウト", templ.Attributes{"type": "submit", "data-testid": "chatgpt-logout-" + kind})
	</form>
}

templ models(d Data) {
	if d.Official.SignedIn && !d.Official.NeedsRelogin && d.Official.PlanUsageGranted {
		<div class="flex flex-col gap-2" data-testid="chatgpt-models">
			<form hx-get={ paths.ChatGPTModels() } hx-target={ panelTarget } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]">
				@atoms.Button(atoms.ToneNeutral, "利用できるモデルを表示", templ.Attributes{"type": "submit", "data-testid": "chatgpt-models-show"})
			</form>
			if d.ModelsAsked && d.Error == "" {
				if len(d.Models) == 0 {
					<p class="text-sm text-neutral-400">表示できるモデルがありません。</p>
				} else {
					<p class="text-xs text-neutral-400">「LLM の割り当て」のモデル欄に、次のモデル名（太字）を入力します。名前はアカウントと時期で変わります。</p>
					<ul class="flex flex-col gap-1 text-sm" data-testid="chatgpt-model-list">
						for _, m := range d.Models {
							<li><code class="font-medium select-all">{ m.Slug }</code> <span class="text-xs text-neutral-400">{ m.DisplayName }</span></li>
						}
					</ul>
				}
			}
		</div>
	}
}

templ imageBlock(d Data) {
	<div class="flex flex-col gap-3 border-t border-neutral-800 pt-4" data-testid="chatgpt-image">
		<h3 class="text-sm font-semibold">ChatGPT 画像生成（非公式）</h3>
		<div class="flex flex-col gap-2 rounded-md border border-amber-500/50 px-3 py-2" data-testid="chatgpt-risks">
			<p class="text-sm font-medium text-amber-300">オンにする前に、次のリスクを確認してください。</p>
			<ul class="list-disc pl-5 text-sm">
				for _, r := range d.Risks {
					<li>{ r }</li>
				}
			</ul>
			<p class="text-xs text-neutral-400">
				<a class="underline" href={ templ.SafeURL(usageURL) } target="_blank" rel="noopener noreferrer">Manage usage</a>
				で、プランの利用状況を確認できます。
			</p>
		</div>
		if d.ImageEnabled {
			<p class="text-sm" data-testid="chatgpt-image-state">
				@atoms.Badge(atoms.BadgeWarn, "オン")
				画像の用途に、この経路のモデルを選べます。
			</p>
			<form
				hx-put={ paths.ChatGPTImageEnabled() }
				hx-target={ panelTarget }
				hx-swap="outerHTML"
				hx-sync="this:drop"
				hx-disabled-elt="find button[type=submit]"
			>
				<input type="hidden" name="enabled" value="false"/>
				@atoms.Button(atoms.ToneNeutral, "オフにする", templ.Attributes{"type": "submit", "data-testid": "chatgpt-image-off"})
			</form>
			@accountStatus(imageKind, d.Image)
			@loginMessage(d.Image.Login)
			<div class="flex flex-wrap items-center gap-2">
				if !d.Image.SignedIn || d.Image.NeedsRelogin {
					@loginButton(imageKind, "browser", "ブラウザでログイン", d.Image.Login)
					@loginButton(imageKind, "device", "デバイスコードでログイン", nil)
				}
				if d.Image.SignedIn {
					@logoutButton(imageKind)
				}
			</div>
		} else {
			<p class="text-sm text-neutral-300" data-testid="chatgpt-image-state">
				@atoms.Badge(atoms.BadgeNeutral, "オフ")
				オフの間は、この経路を一切呼びません。
			</p>
			<form
				class="flex flex-col gap-2"
				hx-put={ paths.ChatGPTImageEnabled() }
				hx-target={ panelTarget }
				hx-swap="outerHTML"
				hx-sync="this:drop"
				hx-disabled-elt="find button[type=submit]"
				hx-confirm="非公式の経路で画像を生成します。予告なく使えなくなることがあり、公式のプレビューでは画像生成はサポート外で、ChatGPT のプランの利用上限を消費します。オンにしますか？"
			>
				<input type="hidden" name="enabled" value="true"/>
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="acknowledge_risks" value="true" required data-testid="chatgpt-image-ack"/>
					上のリスクを理解したうえで、オンにします
				</label>
				@atoms.Button(atoms.TonePrimary, "オンにする", templ.Attributes{"type": "submit", "data-testid": "chatgpt-image-on"})
			</form>
		}
	</div>
}
