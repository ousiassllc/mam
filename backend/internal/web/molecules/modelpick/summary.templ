package modelpick

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/web/atoms"
)

// Summary is what stands above a list of models, inside the results the answer replaces: why the condition could not be read, the filters in force as chips (each
// with an ×; "すべてクリア"), how many models are shown, and the note 「N 件は今は選べません」 with the button that shows them.
templ Summary(b Filter) {
	<div class="flex flex-col gap-2" data-testid="model-pick-summary">
		if b.Error != "" {
			<p class="text-sm text-danger" role="alert" data-testid="model-pick-error">{ b.Error }（絞り込みは始めの状態に戻しました）</p>
		}
		if chips := b.Chips(); len(chips) > 0 {
			<ul class="flex flex-wrap items-center gap-2" aria-label="かかっている条件" data-testid="model-pick-chips">
				for _, chip := range chips {
					<li>
						<span class="inline-flex items-center gap-1 rounded-md bg-accent-soft py-1 pl-3 pr-1 text-xs text-accent" data-testid="model-pick-chip">
							{ chip.Label }
							<button
								type="button"
								class="cursor-pointer rounded-sm p-1 text-accent hover:text-ink focus-visible:focus-ring"
								aria-label={ chip.Label + "を外す" }
								hx-get={ chip.Remove }
								hx-include={ b.clearInclude() }
								hx-target={ b.Target }
								hx-swap="outerHTML"
								data-testid="model-pick-chip-remove"
							>
								@atoms.Icon(atoms.IconClose, "h-3.5 w-3.5")
							</button>
						</span>
					</li>
				}
				<li>
					<button
						type="button"
						class="cursor-pointer rounded-md px-2 py-1 text-xs text-ink underline hover:text-ink focus-visible:focus-ring"
						hx-get={ b.URL(b.ClearAll()) }
						hx-include={ b.clearInclude() }
						hx-target={ b.Target }
						hx-swap="outerHTML"
						data-testid="model-pick-clear-all"
					>すべてクリア</button>
				</li>
			</ul>
		}
		<p class="text-sm text-mute" role="status" aria-live="polite" data-testid="model-pick-total">
			{ strconv.Itoa(b.Shown) } 件
			if b.Shown != b.Total {
				（全 { strconv.Itoa(b.Total) } 件のうち）
			}
			if b.Cond.AvailableOnly && b.Hidden > 0 {
				<span data-testid="model-pick-hidden">
					・{ strconv.Itoa(b.Hidden) } 件は今は選べません
					<button
						type="button"
						class="ml-1 cursor-pointer text-accent underline decoration-mute hover:text-ink focus-visible:focus-ring"
						hx-get={ b.ShowHidden() }
						hx-include={ b.clearInclude() }
						hx-target={ b.Target }
						hx-swap="outerHTML"
						data-testid="model-pick-show-hidden"
					>使えないものも表示</button>
				</span>
			}
		</p>
	</div>
}
