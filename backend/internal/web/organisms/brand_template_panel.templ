package organisms

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// BrandTemplatePanelData is the Brand Templates on the settings screen of a Project. Typed and Errors
// are what the user typed and why it was rejected.
type BrandTemplatePanelData struct {
	ProjectID string
	Templates []domain.BrandTemplate
	Typed     map[string]string
	Errors    map[string]string
}

// BrandTemplateSelect is the optional choice of a Brand Template for a new Project or Episode; it
// renders nothing while there are no templates. The constraints are copied into the new Project.
templ BrandTemplateSelect(id string, templates []domain.BrandTemplate) {
	if len(templates) > 0 {
		<label class="flex flex-col gap-1 text-xs text-neutral-400" for={ id }>
			Brand Template（制約をコピーして開始）
			@atoms.Select(atoms.FieldMd, "", templ.Attributes{
				"id":   id,
				"name": "brand_template_id",
			}) {
				<option value="">（使わない）</option>
				for _, t := range templates {
					<option value={ t.ID }>{ t.Name }（{ strconv.Itoa(len(t.Constraints)) } 件）</option>
				}
			}
		</label>
	}
}

// BrandTemplatePanel saves the Project's Brand / Safety Constraints as a template and lists the
// templates (F-23, M3). Applying a template copies its constraints into this Project; it never
// links them, so later edits on either side do not reach the other.
// The list (#brand-template-list) is what the removal of a template replaces; the form that saves one
// is outside it, so a removal never discards the name typed in it.
templ BrandTemplatePanel(d BrandTemplatePanelData) {
	<section id="brand-template-panel" class="flex flex-col gap-4">
		@BrandTemplateItems(d)
		@brandTemplateForm(d, false)
	</section>
}

// BrandTemplateSaved answers the saving of a template (accepted or refused): the list, and the form
// out of band, emptied or with the input and the error.
templ BrandTemplateSaved(d BrandTemplatePanelData) {
	@BrandTemplateItems(d)
	@brandTemplateForm(d, true)
}

// BrandTemplateItems is the list of the Brand Templates.
templ BrandTemplateItems(d BrandTemplatePanelData) {
	<div id="brand-template-list">
		if len(d.Templates) == 0 {
			<p class="text-sm text-neutral-400">保存されたテンプレートはありません。</p>
		} else {
			<ul class="flex flex-col divide-y divide-neutral-800 text-sm">
				for _, t := range d.Templates {
					<li class="flex flex-wrap items-start justify-between gap-2 py-2" data-testid="brand-template">
						<div class="min-w-0 flex-1">
							<span class="font-medium">{ t.Name }</span>
							<span class="ml-2 text-xs text-neutral-400">{ strconv.Itoa(len(t.Constraints)) } 件の制約</span>
							<ul class="mt-1 list-disc pl-5 text-xs text-neutral-400">
								for _, c := range t.Constraints {
									<li class="flex flex-wrap items-center gap-2">
										<span>{ c.Type.Label() }</span> @molecules.ConstraintLevelBadge(c.Level)
										<span>{ c.Text }</span>
									</li>
								}
							</ul>
						</div>
						<div class="flex gap-2">
							@atoms.SmallButton(atoms.ToneNeutral, "この Project に適用", templ.Attributes{
								"type":       "button",
								"hx-post":    paths.Project(d.ProjectID, "brand-templates", t.ID, "apply"),
								"hx-target":  "#brand-constraint-list",
								"hx-swap":    "outerHTML",
								"hx-confirm": "このテンプレートの制約をこの Project にコピーします（同じ制約はスキップ）。よろしいですか？",
							})
							@atoms.SmallButton(atoms.ToneNeutral, "削除", templ.Attributes{
								"type":       "button",
								"hx-delete":  paths.Project(d.ProjectID, "brand-templates", t.ID),
								"hx-target":  "#brand-template-list",
								"hx-swap":    "outerHTML",
								"hx-confirm": "このテンプレートを削除します。適用済みの Project の制約は変わりません。よろしいですか？",
							})
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

// brandTemplateForm saves the Project's constraints as a template; oob makes it replace the one on the page.
templ brandTemplateForm(d BrandTemplatePanelData, oob bool) {
	<form
		id="brand-template-form"
		class="flex flex-col gap-2 rounded-md border border-neutral-700 p-3"
		hx-post={ paths.Project(d.ProjectID, "brand-templates") }
		hx-target="#brand-template-list"
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt="find button[type=submit]"
		if oob {
			hx-swap-oob="true"
		}
	>
		<label for="brand-template-name" class="text-sm font-medium">この Project の制約をテンプレートとして保存</label>
		@atoms.Input(atoms.FieldLg, "w-full", templ.Attributes{
			"id":          "brand-template-name",
			"name":        "name",
			"type":        "text",
			"maxlength":   intText(domain.MaxBrandTemplateNameRunes),
			"value":       d.Typed["name"],
			"placeholder": "例: ブランドA 標準",
		})
		if msg := d.Errors["name"]; msg != "" {
			<p class="text-sm text-red-300" role="alert">{ msg }</p>
		}
		<p class="text-xs text-neutral-400">保存するのは現在の制約のコピーです。以後この Project の制約を変えてもテンプレートは変わらず、テンプレートを削除しても適用済みの Project には影響しません。</p>
		<div>
			@atoms.Button(atoms.TonePrimary, "テンプレートを保存", templ.Attributes{
				"type": "submit",
			})
		</div>
	</form>
}
