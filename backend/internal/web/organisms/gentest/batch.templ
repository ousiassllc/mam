package gentest

import (
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/commercial"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/gentest/resulttile"
	"github.com/ousiassllc/mam/backend/internal/web/paths"
)

// BatchList is the list the blocks of the runs are appended to (#1109): each "この内容で実行する" adds a block (BatchBox) at the end and
// leaves the ones before it.
templ BatchList() {
	<div id={ BatchesID } class="flex flex-col gap-4" data-testid="gt-batches"></div>
}

// BatchBox is the block of one run: its progress and the comparison grid of its batch (rows: models, columns: prompts). It has an id of its
// own (BatchBlockID), and while anything waits or runs it asks for itself, and only itself, again every 2 seconds; a block that is over
// does not ask. A block with no batch (a run that was refused) has no id and no key.
templ BatchBox(b Batch) {
	<section
		if b.ID != "" {
			id={ BatchBlockID(b.ID) }
			data-batch={ b.ID }
		}
		class="flex flex-col gap-3 rounded-md border border-border p-4"
		data-testid="gt-batch"
		data-state={ b.StateTone }
		if !b.Finished {
			hx-get={ paths.GenerationTestPart("batches", b.ID) }
			hx-trigger={ Polling }
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		@notice(b.Message, "gt-batch")
		<div class="flex flex-wrap items-center gap-3">
			<h2 class="text-sm font-semibold">生成の結果</h2>
			if b.ID != "" {
				<span class="text-xs text-mute" data-testid="gt-batch-key" title={ "履歴のこの実行の結果は、バッチ " + b.ID + " のもの" }>{ b.Started }・ID { shortID(b.ID) }</span>
			}
			@atoms.BadgeWith(batchTone(b.StateTone), b.StateText, templ.Attributes{"data-testid": "gt-batch-state"})
			<span class="text-xs text-mute" data-testid="gt-batch-progress">{ itoa(b.Done) } / { itoa(b.Total) } 件（{ b.Counts }）</span>
			if b.Estimate != "" {
				<span class="text-xs text-mute">見積り { b.Estimate }</span>
			}
			if !b.Finished {
				<form
					hx-post={ paths.GenerationTestPart("batches", b.ID, "cancel") }
					hx-target={ "#" + BatchBlockID(b.ID) }
					hx-swap="outerHTML"
					hx-sync="this:drop"
					hx-disabled-elt="find button[type=submit]"
					hx-confirm="まだ始めていない生成を取り消しますか？（呼び出し中のものは終わるまで待ちます）"
				>
					@atoms.SmallButtonFor(atoms.ToneDanger, "取り消す", "生成", templ.Attributes{"type": "submit", "id": "gt-cancel", "data-testid": "gt-cancel"})
				</form>
			}
		</div>
		if len(b.Params) > 0 {
			<dl class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-mute" data-testid="gt-batch-params">
				for _, kv := range b.Params {
					<div class="flex gap-1">
						<dt>{ kv.Key }</dt>
						<dd class="text-ink">{ kv.Value }</dd>
					</div>
				}
			</dl>
		}
		if !b.Finished {
			<progress class="h-2 w-full" max="100" value={ itoa(b.Percent) } aria-label="生成の進み具合" data-testid="gt-progress"></progress>
		}
		<div class="overflow-x-auto" data-keep-scroll="gt-grid">
			<table class="w-full min-w-max border-collapse text-sm" data-testid="gt-grid">
				<thead>
					<tr>
						<th class="p-2 text-left text-xs font-normal text-mute">モデル ＼ プロンプト</th>
						for _, c := range b.Cols {
							<th class="max-w-xs p-2 text-left align-top text-xs font-normal text-ink" data-testid="gt-col">
								<span class="line-clamp-3 whitespace-pre-wrap break-words">{ c.Text }</span>
								if c.Negative != "" {
									<span class="mt-1 block text-mute">ネガティブ: { c.Negative }</span>
								}
								if c.English != "" || c.EnglishNegative != "" {
									<span class="mt-1 block text-ink" data-testid="gt-col-english">
										英訳:
										<span class="line-clamp-3 whitespace-pre-wrap break-words">{ c.English }</span>
										if c.EnglishNegative != "" {
											<span class="block whitespace-pre-wrap break-words">ネガティブ: { c.EnglishNegative }</span>
										}
									</span>
								}
							</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, r := range b.Rows {
						<tr class="border-t border-border" data-testid="gt-row">
							<th class="p-2 text-left align-top text-xs font-semibold text-ink" scope="row">
								<span class="flex flex-col items-start gap-1">
									<span>{ r.Model }</span>
									@commercial.Badge(r.Answer)
									if r.Face != "" {
										<span class="font-normal text-mute" data-testid="gt-row-face">{ r.Face }</span>
									}
								</span>
							</th>
							for _, cell := range r.Cells {
								<td class="p-2 align-top" data-testid="gt-cell">
									<div class="flex flex-wrap gap-2">
										for _, card := range cell {
											<div id={ resulttile.ID(card.ID) } class="w-32">
												@resulttile.Tile(card, false)
											</div>
										}
									</div>
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

// shortID is the head of a batch id, enough to read a run by (the whole id is in the title and in data-batch).
func shortID(id string) string {
	if len(id) > 8 {
		return id[:8]
	}
	return id
}

func batchTone(tone string) atoms.BadgeTone {
	switch tone {
	case "succeeded":
		return atoms.BadgeOK
	case "failed", "cancelled":
		return atoms.BadgeError
	case "running", "queued":
		return atoms.BadgeInfo
	}
	return atoms.BadgeNeutral
}
