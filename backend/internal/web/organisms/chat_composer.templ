package organisms

import "github.com/ousiassllc/mam/backend/internal/domain"

type qualityOption struct {
	Value domain.QualityPolicy
	Label string
}

var qualityOptions = []qualityOption{
	{domain.QualityFast, "Fast"},
	{domain.QualityBalanced, "Balanced"},
	{domain.QualityMaxQuality, "Max Quality"},
}

// ChatComposer is the input area: message, attachments (［＋］ or drag and drop), reply
// target, and the MODE / Quality controls. Input stays enabled while generation runs.
// The MODE control only shows the current value here: switching it and interpreting
// director instructions belong to the DIRECTOR MODE feature. The Quality control switches the
// Quality Policy at once (F-22).
templ ChatComposer(p domain.Project) {
	<form
		id="chat-composer"
		class="border-t border-neutral-800 px-4 py-3"
		hx-post={ "/projects/" + p.ID + "/messages" }
		hx-encoding="multipart/form-data"
		hx-target="#chat-thread"
		hx-swap="beforeend"
	>
		<div id="reply-chip" class="mb-2 hidden items-center gap-2 text-xs text-neutral-300">
			<span>返信先:</span>
			<span id="reply-label" class="truncate"></span>
			<button type="button" id="reply-cancel" class="text-neutral-400 hover:text-neutral-100" aria-label="返信を取り消す">×</button>
		</div>
		<input type="hidden" name="reply_to_message_id" id="reply-to" value=""/>
		<ul id="attachment-names" class="mb-2 flex flex-wrap gap-2 text-xs text-neutral-300"></ul>
		<div class="flex items-end gap-2">
			<label for="composer-files" class="cursor-pointer rounded-md border border-neutral-600 px-3 py-1.5 text-sm hover:bg-neutral-800" title="画像・動画を添付">＋</label>
			<input id="composer-files" type="file" name="attachments" multiple accept={ AcceptedUploads } class="sr-only"/>
			<textarea
				id="composer-content"
				name="content"
				rows="2"
				maxlength="4000"
				placeholder="指示を入力…（Enter で送信、Shift+Enter で改行）"
				class="min-h-10 flex-1 resize-y rounded-md border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm"
			></textarea>
			<button type="submit" class="rounded-md bg-indigo-500 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-400">送信</button>
		</div>
		<div class="mt-2 flex flex-wrap items-center gap-4 text-xs text-neutral-400">
			<fieldset disabled class="flex items-center gap-2" title="MODE の切替は DIRECTOR MODE の機能で有効になります">
				<legend class="sr-only">MODE</legend>
				<span>MODE</span>
				<label class="flex items-center gap-1">
					<input type="radio" name="mode" value="auto" checked?={ p.Mode == domain.ModeAuto }/>
					AUTO
				</label>
				<label class="flex items-center gap-1">
					<input type="radio" name="mode" value="director" checked?={ p.Mode == domain.ModeDirector }/>
					DIRECTOR
				</label>
			</fieldset>
			<label class="flex items-center gap-2" title="Quality Policy（詳細は設定画面）">
				Quality
				<select
					name="quality_policy"
					hx-put={ "/projects/" + p.ID + "/quality-policy" }
					hx-trigger="change"
					hx-params="quality_policy"
					hx-encoding="application/x-www-form-urlencoded"
					hx-swap="none"
					class="rounded-md border border-neutral-700 bg-neutral-950 px-2 py-1"
				>
					for _, q := range qualityOptions {
						<option value={ string(q.Value) } selected?={ q.Value == p.QualityPolicy }>{ q.Label }</option>
					}
				</select>
			</label>
			<a href={ templ.SafeURL("/projects/" + p.ID + "/settings") } class="hover:text-neutral-100">設定</a>
		</div>
	</form>
}
