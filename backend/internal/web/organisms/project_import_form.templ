package organisms

// ProjectImportFormData is the state of the bundle import form.
type ProjectImportFormData struct {
	Error string
}

// ProjectImportForm imports a project bundle (POST /projects/import): the archive made by the
// bundle export of the settings screen, on this or another machine.
templ ProjectImportForm(d ProjectImportFormData) {
	<form
		id="project-import-form"
		class="mt-4 flex flex-wrap items-center gap-2 rounded-md border border-neutral-800 p-3 text-sm"
		hx-post="/projects/import"
		hx-encoding="multipart/form-data"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<label for="project-import-file" class="text-neutral-300">プロジェクトバンドルを読み込む</label>
		<input id="project-import-file" type="file" name="bundle" required accept=".zip,application/zip" class="text-xs"/>
		<button type="submit" class="rounded-md border border-neutral-600 px-3 py-1.5 text-sm font-medium text-neutral-200 hover:bg-neutral-800">読み込む</button>
		if d.Error != "" {
			<p class="basis-full text-sm text-red-300" role="alert">{ d.Error }</p>
		}
	</form>
}
