package pages

import (
	"github.com/ousiassllc/mam/backend/internal/web/layout"
	"github.com/ousiassllc/mam/backend/internal/web/molecules/pagehead"
	"github.com/ousiassllc/mam/backend/internal/web/organisms"
	"github.com/ousiassllc/mam/backend/internal/web/organisms/sidenav"
)

// SettingsPage is GET /projects/:id/settings: Production Template, Quality/Cost Policy, budget, the
// cost of the Project and its disk usage.
templ SettingsPage(csrfToken string, d organisms.SettingsBodyData) {
	@layout.AppLayout("設定: "+d.Policy.Project.Name, csrfToken, sidenav.InProject(sidenav.ProjectSettings, d.Policy.Project)) {
		@pagehead.Main(pagehead.Narrow) {
			@pagehead.Header("設定", d.Policy.Project.Name, "API キーとモデルの設定は、左メニューの設定にあります。")
			@organisms.SettingsBody(d)
		}
	}
}
