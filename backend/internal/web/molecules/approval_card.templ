package molecules

import (
	"strconv"

	"github.com/ousiassllc/mam/backend/internal/domain"
	"github.com/ousiassllc/mam/backend/internal/web/atoms"
	"github.com/ousiassllc/mam/backend/internal/web/selector"
)

// approvalCommentMaxRunes is how much the comment field takes: a limit of the form only, the server
// accepts what a chat message accepts (domain.MaxMessageRunes).
const approvalCommentMaxRunes = 500

// ApprovalCard presents the artifact of a checkpoint. It is answered with the
// buttons (承認 / 修正を依頼) or by replying in words. A disabled submit button comes first so
// that pressing Enter in the comment field is a no-op (the default button of a form is the first
// submit button; when it is disabled implicit submission does nothing) instead of approving.
templ ApprovalCard(m domain.ThreadMessage) {
	@MessageFrame(m) {
		<p class="mb-1 flex items-center gap-2">
			<span class="text-xs text-neutral-400">{ approvalLabel(m.ChatMessage) }</span>
			{{ tone, label := approvalBadge(m.ApprovalStatus) }}
			@atoms.Badge(tone, label)
		</p>
		<p class="whitespace-pre-wrap break-words font-medium">{ m.Content }</p>
		if m.ApprovalStatus == domain.ApprovalPending {
			<form
				class="mt-3 flex flex-wrap items-center gap-2"
				hx-post={ approvalURL(m.ProjectID, m.ID) }
				hx-target={ selector.ID("msg-", m.ID) }
				hx-swap="outerHTML"
				hx-sync="this:drop"
				hx-disabled-elt="find button[value=approve], find button[value=request_changes]"
			>
				<button type="submit" disabled hidden tabindex="-1" aria-hidden="true"></button>
				@atoms.Input(atoms.FieldMd, "min-w-0 flex-1", templ.Attributes{
					"type":        "text",
					"name":        "comment",
					"maxlength":   strconv.Itoa(approvalCommentMaxRunes),
					"placeholder": "コメント（任意）",
					"aria-label":  atoms.RowLabel("コメント", excerpt(m.ChatMessage)),
				})
				@atoms.ButtonFor(atoms.TonePrimary, "承認", excerpt(m.ChatMessage), submitAttrs("approve"))
				@atoms.ButtonFor(atoms.ToneNeutral, "修正を依頼", excerpt(m.ChatMessage), submitAttrs("request_changes"))
			</form>
			<div class="mt-1">
				@ReplyButton(m)
			</div>
		}
	}
}
